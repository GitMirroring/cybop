<node>

    <node name="startup_server" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <!--
        The name="enable_server" with operation "activate/enable" is NOT necessary,
        since EACH client has its own "feel/sense" thread.
    -->

    <node name="open_client" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="port" channel="inline" format="number/integer" model="0"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="sender" channel="inline" format="number/integer" model="0"/>
        <node name="handler" channel="inline" format="text/cybol-path" model=".handle"/>
    </node>

    <!--
        The name="sense_client" with operation "feel/sense" is NOT necessary,
        since it is called AUTOMATICALLY by "dispatch/open" within cyboi.
    -->

    <node name="send_client" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_counter.txt"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
--
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Hello World!"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="receive_client" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="counter/simple/app.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
--
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="port" channel="inline" format="number/integer" model="0"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".tui.command"/>
        <node name="sender" channel="inline" format="number/integer" model=".tui.terminal_id"/>
    </node>

</node>
