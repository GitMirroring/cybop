          <diagram xmi.id="rtBHrl7hdK9k" name="data_structure_cyboi" type="1" documentation="" backgroundcolor="#ffffff" usebackgroundcolor="0" fillcolor="#ffff00" font="DejaVu Sans,9,-1,5,50,2,0,0,0,0,Oblique" griddotcolor="#d3d3d3" linecolor="#ff0000" linewidth="0" textcolor="#000000" usefillcolor="1" showattribassocs="1" showatts="1" showattsig="1" showops="1" showopsig="1" showpackage="1" showpubliconly="0" showscope="1" showstereotype="1" localid="" showgrid="0" snapgrid="1" snapcsgrid="1" snapx="10" snapy="10" zoom="123" canvasheight="640" canvaswidth="650" isopen="1">
            <widgets>
              <classwidget xmi.id="5Ks67bUnc6QZ" localid="I48B4yWCfwN2" textcolor="none" linecolor="none" linewidth="none" usefillcolor="1" usesdiagramfillcolor="0" usesdiagramusefillcolor="1" fillcolor="#ffff7f" font="DejaVu Sans,9,-1,5,50,0,0,0,0,0,Oblique" autoresize="0" x="560" y="-50" width="70" height="40" isinstance="0" showstereotype="1" showoperations="1" showpubliconly="0" showopsigs="601" showpackage="1" showscope="1" showattributes="1" showattsigs="601"/>
              <notewidget xmi.id="iM3PIGx0UNoA" localid="kVH4BVOiHi9v" textcolor="none" linecolor="none" linewidth="none" usefillcolor="1" usesdiagramfillcolor="0" usesdiagramusefillcolor="0" fillcolor="#ffff7f" font="DejaVu Sans,9,-1,5,50,0,0,0,0,0,Oblique" autoresize="1" x="-160" y="70" width="600" height="380" isinstance="0" showstereotype="0" text="Data structures of the CYBOI interpreter at runtime:&#10;&#10;part:&#10;It contains a model which may be primitive data (like a number) or compound data (child parts).&#10;The part keeps properties (meta information) about the model it points to.&#10;Properties are always a (compound) part that contains other (property) parts.&#10;Further, it keeps the type of the model and a unique name for it.&#10;The internal type reflects the format.&#10;A fraction number can be given in two different formats, a complex number as well.&#10;But internally, they are mapped to the same type, for easier handling and calculation.&#10;The references are an attribute that is only used in cyboi for rubbish (garbage) collection.&#10;&#10;item:&#10;It ist just a pointer to data (an array) combined with&#10;the size (maximum number of elements)&#10;and count (current number of elements).&#10;&#10;array:&#10;An allocated area in memory that contains values which may be&#10;accessed via indices (calculated with pointer arithmetics).&#10;&#10;value:&#10;Some primitive like an integer number, a double number, a void* pointer etc.&#10;" noteType="0"/>
              <classwidget xmi.id="j8V04zDCJp4z" localid="AhSDNAe1k1Xy" textcolor="none" linecolor="none" linewidth="none" usefillcolor="1" usesdiagramfillcolor="0" usesdiagramusefillcolor="1" fillcolor="#ffff7f" font="DejaVu Sans,9,-1,5,50,0,0,0,0,0,Oblique" autoresize="0" x="400" y="-50" width="70" height="40" isinstance="0" showstereotype="1" showoperations="1" showpubliconly="0" showopsigs="601" showpackage="1" showscope="1" showattributes="1" showattsigs="601"/>
