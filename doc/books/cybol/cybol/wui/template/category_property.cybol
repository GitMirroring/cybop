<model>
    <part name="category_property_header" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="Properties">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="h5"/>
        <property name="align" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="center"/>
    </part>
    <part name="category_property_table" channel="file" encoding="utf-8" language="text/cybol" format="element/part" model="cybol/wui/template/category_property_header.cybol">
	<property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="table"/>
        <property name="class" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="property_table"/>
        <property name="border" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="1"/>
    </part>
</model>
