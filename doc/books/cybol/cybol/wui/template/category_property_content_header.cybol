<model>
    <part name="column_name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="name">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="th"/>
    </part>
    <part name="column_description" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="description">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="th"/>
    </part>
    <part name="column_required" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="required">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="th"/>
    </part>
    <part name="column_format" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="format">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="th"/>
    </part>
    <part name="column_model" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="model">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="th"/>
    </part>
</model>
