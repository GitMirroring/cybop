    <part name="heading" channel="inline" format="text/plain" model="CYBOL Version 2013-05-09 API Specification">
        <property name="tag" channel="inline" format="text/plain" model="div"/>
        <property name="style" channel="inline" format="text/plain" model="padding: 10px; text-align: center; font-size: 14pt;"/>
    </part>
</model>
