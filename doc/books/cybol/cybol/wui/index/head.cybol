<model>
    <part name="http-equiv" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="meta"/>
        <property name="http-equiv" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="content-type"/>
        <property name="content" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/html; charset=utf-8"/>
    </part>
    <part name="author" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="meta"/>
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="author"/>
        <property name="content" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="Generated by CYBOI; See http://www.cybop.org/"/>
    </part>
    <part name="css" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="link"/>
        <property name="rel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="stylesheet"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/css"/>
        <property name="href" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cybol.css"/>
    </part>
    <part name="title" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="CYBOL Specification">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="title"/>
    </part>
</model>
