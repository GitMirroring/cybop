<model>
    <part name="heading" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="CYBOL Specification">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="h1"/>
        <property name="align" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="center"/>
    </part>
    <part name="remark" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="Der Inhalt folgt hier dynamisch generiert ...">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="p"/>
    </part>
    <part name="content" channel="file" encoding="utf-8" language="text/cybol" format="element/part" model="cybol/wui/index/table.cybol">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="table"/>
        <property name="width" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="100%"/>
        <property name="cellspacing" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="0"/>
        <property name="cellpadding" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="2"/>
        <property name="border" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="1"/>
    </part>
    <part name="break" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="br"/>
    </part>
    <part name="website" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="CYBOP Website">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="a"/>
        <property name="href" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="http://www.cybop.org/"/>
    </part>
</model>
