<model>
    <!-- The loop models. -->
    <part name="specification_count" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
    <part name="specification_index" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
    <part name="specification_break" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="false"/>
    <part name="topic_count" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
    <part name="topic_index" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
    <part name="topic_break" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="false"/>
