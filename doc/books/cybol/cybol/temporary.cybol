    <part name="properties_count" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
    <part name="properties_index" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
    <part name="properties_break" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="false"/>
    <!-- selected part names -->
    <part name="selected_specification" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
    <part name="selected_topic" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
