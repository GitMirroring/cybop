<model>

    <!-- Create parts. -->
    <part name="create_specification" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="specification"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_wui" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="wui"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_logic" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="logic"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_temporary" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="temporary"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>

    <!-- Initialise parts. -->
    <part name="initialise_specification" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/specification.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".specification"/>
    </part>
    <part name="initialise_wui" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".wui"/>
    </part>
    <part name="initialise_logic" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/logic.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".logic"/>
    </part>
    <part name="initialise_temp" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/temporary.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".temporary"/>
    </part>

    <!-- Execute application logic. -->
    <part name="translate_specification" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.translate_specification"/>
    </part>

    <!-- Generate application main knowledge part tree views (just for test purposes). -->
    <part name="test_knowledge_tree_spec" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".specification"/>
        <property name="receiver" channel="inline" format="text/plain" model="Specification.txt"/>
    </part>
    <part name="test_knowledge_tree_temp" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".temporary"/>
        <property name="receiver" channel="inline" format="text/plain" model="Temporary.txt"/>
    </part>
    <part name="test_knowledge_tree_logic" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".logic"/>
        <property name="receiver" channel="inline" format="text/plain" model="Logic.txt"/>
    </part>
    <part name="test_knowledge_tree_wui_index" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".wui.index"/>
        <property name="receiver" channel="inline" format="text/plain" model="wui_index.txt"/>
    </part>

    <!-- Print part of knowledge tree as html file. -->
    <part name="generate_html" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/html">
            <constraint name="indentation" channel="inline" format="logicvalue/boolean" model="true"/>
        </property>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".wui.index"/>
        <property name="receiver" channel="inline" format="text/plain" model="cybol.html"/>
    </part>

    <!-- Exit application. -->
    <part name="exit_application" channel="inline" format="live/exit" model=""/>

</model>
