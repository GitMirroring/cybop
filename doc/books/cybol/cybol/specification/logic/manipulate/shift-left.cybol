<model>
    <part name="name" channel="inline" format="text/plain" model="shift-left"/>
    <part name="description" channel="inline" format="text/plain" model="Shifts all bits of value to the left by position."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/manipulate/shift-left/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="manipulate/shift-left"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/manipulate/shift-left/properties.cybol"/>
</model>