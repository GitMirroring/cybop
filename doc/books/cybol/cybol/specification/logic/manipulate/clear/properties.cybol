<model>
    <part name="value" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="value"/>
        <property name="description" channel="inline" format="text/plain" model="The knowledge model representing the value."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/*"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
    <part name="position" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="position"/>
        <property name="description" channel="inline" format="text/plain" model="The bit position within the value."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | number/*"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
    <part name="type" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="type"/>
        <property name="description" channel="inline" format="text/plain" model="The value type."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | meta/type"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
        <part name="count" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="count"/>
        <property name="description" channel="inline" format="text/plain" model="The number of values to be manipulated (if null, the value part model count will be used instead)."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | number/*"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
        <part name="index" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="index"/>
        <property name="description" channel="inline" format="text/plain" model="The index from which to start manipulating values (if null, an index of zero will be used instead)."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | number/*"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
</model>