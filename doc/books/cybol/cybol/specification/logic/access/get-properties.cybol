<model>
    <part name="name" channel="inline" format="text/plain" model="get-properties"/>
    <part name="description" channel="inline" format="text/plain" model="Get a part's properties."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/access/get-properties/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="access/get-properties"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/access/get-properties/properties.cybol"/>
</model>
