<model>
	<part name="output" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="output"/>
        <property name="description" channel="inline" format="text/plain" model="the knowledge model in which the output is stored; used as first input operand"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/knowledge"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
	<part name="input" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="input"/>
        <property name="description" channel="inline" format="text/plain" model="the second input operand"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/knowledge"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
</model>
