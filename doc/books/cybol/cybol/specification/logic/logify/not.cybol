<model>
    <part name="name" channel="inline" format="text/plain" model="not"/>
    <part name="description" channel="inline" format="text/plain" model="Applies the boolean logic operation NOT.
	The 'output' parametre represents the first operand;
  the 'input' parametre the second."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/logify/not/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="logify/not"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/logify/not/properties.cybol"/>
</model>