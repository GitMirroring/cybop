<model>
    <part name="name" channel="inline" format="text/plain" model="negate"/>
    <part name="description" channel="inline" format="text/plain" model="Negates a given number."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/calculate/negate/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="calculate/negate"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/calculate/negate/properties.cybol"/>
</model>
