<model>
    <part name="result" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="result"/>
        <property name="description" channel="inline" format="text/plain" model="The output resulting from the negation."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="integer | double | knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="a number or a knowledge model path"/>
    </part>
    <part name="operand" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="operand"/>
        <property name="description" channel="inline" format="text/plain" model="The number which is to negate."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="integer | double | knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="a number or a knowledge model path"/>
    </part>
    <part name="type" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="type"/>
        <property name="description" channel="inline" format="text/plain" model="The number type. It has to be identical for all parametres."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="number/integer | number/float | path/knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="a mime type format"/>
    </part>
</model>
