<model>
    <part name="criterion" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="criterion"/>
        <property name="description" channel="inline" format="text/plain" model="the flag specifying which of the two models to execute"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>		
	<part name="true" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="true"/>
        <property name="description" channel="inline" format="text/plain" model="the logic knowledge model to be executed if the condition is true"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="element/part"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>	
	<part name="false" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="false"/>
        <property name="description" channel="inline" format="text/plain" model="the logic knowledge model to be executed if the condition is false"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="element/part"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>	
</model>
