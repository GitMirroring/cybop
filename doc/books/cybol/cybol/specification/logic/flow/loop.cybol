<model>
    <part name="name" channel="inline" format="text/plain" model="loop"/>
    <part name="description" channel="inline" format="text/plain" model="Loops the programme flow endlessly, until the break flag is set."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/flow/loop/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="flow/loop"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/flow/loop/properties.cybol"/>
</model>