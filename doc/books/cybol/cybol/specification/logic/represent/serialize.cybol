<model>
    <part name="name" channel="inline" format="text/plain" model="serialize"/>
    <part name="description" channel="inline" format="text/plain" model="Serialises the source- into the destination part."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/represent/serialize/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="logic/represent"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/represent/serialize/properties.cybol"/>
</model>