<model>
    <part name="name" channel="inline" format="text/plain" model="append"/>
    <part name="description" channel="inline" format="text/plain" model="Appends the source- to the destination part."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/modify/append/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="modify/append"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/modify/append/properties.cybol"/>
</model>