<model>
    <part name="name" channel="inline" format="text/plain" model="fill"/>
    <part name="description" channel="inline" format="text/plain" model="Fills the part up with a given element."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/modify/fill/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="modify/fill"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/modify/fill/properties.cybol"/>
</model>