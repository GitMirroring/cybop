<model>
	<part name="part" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="part"/>
        <property name="description" channel="inline" format="text/plain" model="the part"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/knowledge"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
	<part name="element" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="element"/>
        <property name="description" channel="inline" format="text/plain" model="the element"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="element/*"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
	<part name="count" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="count"/>
        <property name="description" channel="inline" format="text/plain" model="If null, the part model count will be used instead. The number of elements to be filled in."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="number/integer"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
	<part name="index" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="index"/>
        <property name="description" channel="inline" format="text/plain" model="If null, an index of zero will be used instead. The index from which to start copying elements to."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="number/integer"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
	<part name="adjust" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="index"/>
        <property name="description" channel="inline" format="text/plain" model="The default is 'true'. If null, the count WILL BE adjusted. The flag indicating whether or not the part shall be adjusted to."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
</model>
