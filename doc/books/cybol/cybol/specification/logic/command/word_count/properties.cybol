<model>
    <part name="path" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="path"/>
        <property name="description" channel="inline" format="text/plain" model="path to the file or directory"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="text/plain"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>		
	<part name="bytes" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="bytes"/>
        <property name="description" channel="inline" format="text/plain" model="Outputs the number of bytes"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>	
	<part name="chars" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="chars"/>
        <property name="description" channel="inline" format="text/plain" model="Outputs the number of chars"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>	
	<part name="lines" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="lines"/>
        <property name="description" channel="inline" format="text/plain" model="Outputs the number of lines"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>	
	<part name="max-line-length" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="max-line-length"/>
        <property name="description" channel="inline" format="text/plain" model="Outputs the length of the longest line"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>	
	<part name="words" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="words"/>
        <property name="description" channel="inline" format="text/plain" model="Outputs the number of words"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>	
</model>
