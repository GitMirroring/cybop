<model>
    <part name="name" channel="inline" format="text/plain" model="word-count"/>
    <part name="description" channel="inline" format="text/plain" model="Moving files and directories from a path to another.."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/command/word_count/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="command/change-permission"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/command/word_count/properties.cybol"/>
</model> 
