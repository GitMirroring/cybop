<model>
    <part name="name" channel="inline" format="text/plain" model="directory-contents"/>
    <part name="description" channel="inline" format="text/plain" model="Lists the directory contents."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/command/directory_contents/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="command/change-permission"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/command/directory_contents/properties.cybol"/>
</model> 
