<model>
    <part name="name" channel="inline" format="text/plain" model="remove-file"/>
    <part name="description" channel="inline" format="text/plain" model="Moving files and directories from a path to another.."/>
    <part name="example" channel="file" format="text/plain" model="cybol/specification/logic/command/remove_file/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="command/change-permission"/>
    <part name="properties" channel="file" format="element/part" model="cybol/specification/logic/command/remove_file/properties.cybol"/>
</model> 
