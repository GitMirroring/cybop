<model>
    <part name="position" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="position"/>
        <property name="description" channel="inline" format="text/plain" model="The position (x, y) in unit [character], starting from zero, in relation to the surrounding parent element's origo."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="number/integer | path/knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="a two-dimensional vector"/>
    </part>
    <part name="size" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="size"/>
        <property name="description" channel="inline" format="text/plain" model="The size (width, height) in unit [character], starting from zero."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="number/integer | path/knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="a two-dimensional vector"/>
    </part>
    <part name="background" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="background"/>
        <property name="description" channel="inline" format="text/plain" model="The background colour. The default is the terminal's current background."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="colour/terminal | path/knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="black | blue | cyan | green | magenta | red | white | yellow"/>
    </part>
    <part name="foreground" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="foreground"/>
        <property name="description" channel="inline" format="text/plain" model="The foreground colour. The default is the terminal's current foreground."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="colour/terminal | path/knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="black | blue | cyan | green | magenta | red | white | yellow"/>
    </part>
    <part name="bold" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="bold"/>
        <property name="description" channel="inline" format="text/plain" model="The flag indicating whether or not to use bold foreground."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="logicvalue/boolean | path/knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="false | true"/>
    </part>
    <part name="intense" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="intense"/>
        <property name="description" channel="inline" format="text/plain" model="The flag indicating whether or not to use intense colour. This property is evaluated by win32 console only."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="logicvalue/boolean | path/knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="false | true"/>
    </part>
    <part name="border" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="border"/>
        <property name="description" channel="inline" format="text/plain" model="The kind of border characters to apply."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="text/plain | path/knowledge | path/reference"/>
        <property name="model" channel="inline" format="text/plain" model="ascii | simple | double | round"/>
    </part>
</model>
