<model>
    <part name="build_index_string" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.build_category_index_string"/>
    </part>
    <part name="build_html_template" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.build_category"/>
    </part>
    <part name="count_operations" channel="inline" format="access/count" model="">
        <property name="count" channel="inline" format="path/knowledge" model=".temporary.operation_count"/>
        <property name="part" channel="inline" format="path/reference" model=".temporary.category_link"/>
    </part>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".temporary.operation_break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".temporary.operation_index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".temporary.operation_count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="translate_operation" channel="inline" format="flow/loop" model="">
        <property name="break" channel="inline" format="path/knowledge" model=".temporary.operation_break"/>
        <property name="model" channel="inline" format="path/knowledge" model=".logic.translate_operation"/>
    </part>
    <part name="increment_index" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".temporary.category_index"/>
        <property name="operand" channel="inline" format="number/integer" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".temporary.category_break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".temporary.category_index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".temporary.category_count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
</model>
