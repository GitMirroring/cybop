<model>
    <!-- create operation knowlegdepath in wui.index.body.toc -->
    <part name="create_operation_knowledgepath_in_toc" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="path/knowledge" model=".temporary.selected_operation"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/reference" model=".temporary.category_toc_path"/>
    </part>
    <!-- copy operation toc template for description to wui.index.body.toc -->
    <part name="copy_wui_operation_toc_template" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui/template/operation_toc.cybol"/>
        <property name="model" channel="inline" format="path/reference" model=".temporary.operation_toc_path"/>
    </part>
    <part name="clear_operation_toc_div" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.operation_toc_path_div"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_operation_path_to_div" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.operation_toc_path_div"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.operation_toc_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_tag_to_operation_div" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.operation_toc_path_div"/>
        <property name="source" channel="inline" format="text/plain" model="#tag"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="clear_operation_toc_class" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.operation_toc_path_div_class"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_operation_path_to_class" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.operation_toc_path_div_class"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.operation_toc_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_tag_to_operation_class" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.operation_toc_path_div_class"/>
        <property name="source" channel="inline" format="text/plain" model="#class"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- add div tag to operation toc -->
    <part name="create_div_tag_for_operation_toc_node" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="tag"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="property"/>
        <property name="whole" channel="inline" format="path/reference" model=".temporary.operation_toc_path"/>
    </part>
    <part name="copy_div_tag_to_knowledge_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.operation_toc_path_div"/>
        <property name="source" channel="inline" format="text/plain" model="div"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <!-- set div class tag of operation toc -->
    <part name="create_class_for_operation_toc_tag" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="class"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="property"/>
        <property name="whole" channel="inline" format="path/reference" model=".temporary.operation_toc_path"/>
    </part>
    <part name="copy_class_to_style_tag" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.operation_toc_path_div_class"/>
        <property name="source" channel="inline" format="text/plain" model="operation_toc"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- copy operation name to html toc -->
    <part name="copy_operation_name_to_toc" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.operation_toc_path_name"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_operation"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <!-- copy sharp to html toc href -->
    <part name="copy_sharp_to_toc_href" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.operation_toc_path_href"/>
        <property name="source" channel="inline" format="text/plain" model="#"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- copy operation name to html toc href -->
    <part name="copy_operation_name_to_toc_href" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.operation_toc_path_href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_operation"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

</model>
