<model>
    <!-- indicate executing this file -->
    <part name="print_static_api" channel="inline" encoding="utf-8" language="text/cybol" format="communicate/send" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" encoding="utf-8" language="text/cybol" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="api"/>
        <property name="new_line" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="true"/>
        <property name="clean" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="false"/>
    </part>

    <!-- count the specification parts; result initialized with 0 -->
    <part name="get_specification_count" channel="inline" encoding="utf-8" language="text/cybol" format="access/count" model="">
        <property name="count" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_count"/>
        <property name="part" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".specification"/>
    </part>
    
    <!-- post execution of loop check (necessary if no specification entry found); break variable initialized with false -->
    <!-- Question: executes loop even if specification_count = 0--> 
    <part name="exists_specification_entries" channel="inline" encoding="utf-8" language="text/cybol" format="compare/unequal" model="">
        <property name="left" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_count"/>
        <property name="right" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model="0"/>
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_break"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="all"/>
    </part>
    <part name="loop_specification" channel="inline" encoding="utf-8" language="text/cybol" format="flow/loop" model="">
        <property name="break" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_break"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.translate_specification"/>
    </part>
<!--
    HIERARCHY:
    translate_specification
    translate_topic
    translate_category
    translate_operation
    translate_properties
-->
</model>
