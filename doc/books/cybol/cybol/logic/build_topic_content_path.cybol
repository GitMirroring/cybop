<model>
    <!-- Empty. -->
    <part name="empty_path" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".temporary.topic_content_path"/>
    </part>
    <part name="empty_name" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".temporary.topic_content_path_name"/>
    </part>
    <part name="empty_anchor" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".temporary.topic_content_path_anchor"/>
    </part>

    <!-- Build path. -->
    <part name="add_path_static" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_content_path"/>
        <property name="source" channel="inline" format="text/plain" model=".wui.index.body.content."/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_path_dynamic" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_content_path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- Build name. -->
    <part name="add_name_dynamic" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_content_path_name"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_content_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_name_static" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_content_path_name"/>
        <property name="source" channel="inline" format="text/plain" model=".topic"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- Build anchor. -->
    <part name="add_anchor_dynamic" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_content_path_anchor"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_content_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_anchor_static" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_content_path_anchor"/>
        <property name="source" channel="inline" format="text/plain" model=".topic_anchor#name"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
</model>
