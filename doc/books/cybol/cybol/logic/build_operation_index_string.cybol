<model>
    <part name="clear_operation" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_link"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_topic_path_to_operation" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_link"/>
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_link"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_pre_to_operation_path" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=".["/>
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_link"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="clear_operation_link_number" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_link_number"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="serialise_index_to_operation_link_number" channel="inline" encoding="utf-8" language="text/cybol" format="represent/serialise" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_link_number"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_index"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/cybol"/>
    </part>
    <part name="add_operation_link_number_as_text" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_link_number"/>
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_link"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_post_to_operation_link" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="]"/>
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_link"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>

    <!-- copy selected operation name to temp -->
    <part name="add_name_of_operation_to_content_path" channel="inline" encoding="utf-8" language="text/cybol" format="access/get-name" model="">
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_operation"/>
        <property name="part" channel="inline" encoding="utf-8" language="text/cybol" format="path/reference" model=".temporary.operation_link"/>
    </part>

    <!-- build operation toc base path -->
    <part name="clear_operation_toc_path" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_toc_path"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_topic_path_to_operation_toc" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path"/>
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_toc_path"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dot_to_operation_toc_path" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_toc_path"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="."/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_operation_name_to_toc" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.operation_toc_path"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_operation"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
</model>
