<model>

    ADAPT TO NEW CYBOL FORMAT

    <part name="create_cybol" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="create">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cybol"/>
        <property name="abstraction" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="compound"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
    </part>
    <part name="create_record" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="create">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="record"/>
        <property name="abstraction" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="compound"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol"/>
    </part>
    <part name="create_temporary_variables" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="create">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="temporary"/>
        <property name="abstraction" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="compound"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol"/>
    </part>
    <part name="receive_temporary_variables" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="receive">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="file"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cybol/temporary.cybol"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol.temporary"/>
    </part>
    <part name="create_wui" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="create">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="wui"/>
        <property name="abstraction" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="compound"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol"/>
    </part>
    <part name="receive_wui" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="receive">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="file"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cybol/wui.cybol"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol.wui"/>
    </part>
    <!-- TEST http encoding; delete later! -->
    <part name="create_wui_response" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="create">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="response"/>
        <property name="abstraction" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="character"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol.wui"/>
    </part>
    <part name="create_logic" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="create">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="logic"/>
        <property name="abstraction" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="compound"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol"/>
    </part>
    <part name="receive_logic" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="receive">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="file"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cybol/logic.cybol"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol.logic"/>
    </part>
    <part name="create_logic_www_index_input" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="create">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="www_index_input"/>
        <!--
            CAUTION! Do use character and NOT wide_character here!
            The http message body may be encoded and has to be read as plain characters.
        -->
        <property name="abstraction" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="character"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol.logic.handler"/>
    </part>
    <part name="create_wui_index_actions" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="create">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="wui_index_actions"/>
        <property name="abstraction" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="compound"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol.logic.user_interface"/>
    </part>
    <part name="receive_wui_index_actions" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="receive">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="file"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cybol/wui/index/actions.cybol"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol.logic.user_interface.wui_index_actions"/>
    </part>
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="send">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="file"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/model-diagram"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol"/>
        <property name="receiver" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="TEST_RESIDENZ.txt"/>
    </part>
    <part name="startup_www_service" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="startup">
        <property name="service" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cyboi"/>
        <property name="namespace" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="ipv4"/>
        <property name="style" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="stream"/>
        <property name="address" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="any"/>
    </part>
    <part name="sense_http_client_requests" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="sense">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cyboi"/>
        <property name="handler" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol.logic.handler.handle_www_service"/>
    </part>
<!--
    <part name="import_xdt" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".cybol.logic.import.xdt"/>
-->
</model>
