<model>
    <part name="clear_category" channel="inline" format="modify/overwrite" model="">
	<property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_link"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_topic_path_to_category" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_link"/>
	<property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_pre_to_category_path" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="text/plain" model=".["/>
	<property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="clear_category_link_number" channel="inline" format="modify/overwrite" model="">
	<property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_link_number"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="serialise_index_to_category_link_number" channel="inline" format="represent/serialise" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_link_number"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.category_index"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </part>
    <part name="add_category_link_number_as_text" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.category_link_number"/>
	<property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_post_to_category_link" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="text/plain" model="]"/>
	<property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- copy selected category name to temp -->
    <part name="copy_name_of_category_to_temp" channel="inline" format="access/get-name" model="">
        <property name="element" channel="inline" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="part" channel="inline" format="path/reference" model=".temporary.category_link"/>
    </part>
</model>
