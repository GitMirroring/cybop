<model>
    <!-- create knowledge part in index.html -->
    <part name="create_wui_toc_part" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="path/knowledge" model=".temporary.selected_part"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/reference" model=".temporary.category_content_path"/>
    </part>

    <!-- copy part content template to wui.index.body.content -->
    <part name="initialise_wui_part_content_with_template" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui/template/part_name_content.cybol"/>
        <property name="model" channel="inline" format="path/reference" model=".temporary.part_content_path"/>
    </part>
    <!-- copy part name to html content -->
    <part name="copy_part_name" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.part_content_path_name"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_part"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_part_name_to_anchor" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.part_content_path_anchor"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_part"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
</model>
