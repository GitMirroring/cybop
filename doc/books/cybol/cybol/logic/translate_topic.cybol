<model>
    <!-- Get part at index and assign to tree model node handed over as property. -->
    <part name="get_model_part_at_index" channel="inline" encoding="utf-8" language="text/cybol" format="access/get" model="">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.model"/>
        <property name="index" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.loop.index"/>
    </part>
    <part name="create_wui_knowledge_chapter" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="summand_1"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".addition_application"/>
    </part>
    <part name="initialise_wui_knowledge_chapter" channel="inline" encoding="utf-8" language="text/cybol" format="communicate/receive" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" encoding="utf-8" language="text/cybol" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cybol/wui/topic_chapter.cybol"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".wui.index.body.content."/>
    </part>
    <!-- Copy knowledge data (fixed elements like name, description etc.). -->
    <part name="copy_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".wui.index.body.content.??.name"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.model#name"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".wui.index.body.content.??.description"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.model#description"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="translate_categories" channel="inline" encoding="utf-8" language="text/cybol" format="flow/sequence" model="">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.translate_categories(children??)"/>
    </part>
</model>
