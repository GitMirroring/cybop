<model>
    <part name="print_static_topic" channel="inline" encoding="utf-8" language="text/cybol" format="communicate/send" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" encoding="utf-8" language="text/cybol" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="topic"/>
        <property name="new_line" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="true"/>
        <property name="clean" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="false"/>
    </part>
    
    <!-- Debug: copy selected topic categories to temp -->
    <part name="copy_selected_specs_topics" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.categories"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".specification.logic#topics.calculate#categories"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="path/knowledge"/>
    </part>
    <!-- Debug: copy selected specification name to temp ('logic' has to be replaced by 'temp_specification') -->
    <part name="copy_selected_spec_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".specification.logic#topics.calculate#name"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="path/knowledge"/>
    </part>

    <!-- copy information from knowledge-tree-part 'topic' to knowledge-tree-part 'wui.index' -->
    <part name="build_topic_to_html" channel="inline" encoding="utf-8" language="text/cybol" format="flow/sequence" model="">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.build_topic"/>
    </part>

    <!-- read topic categories -->
    <!-- count the topics of the selected specification -->
    <part name="get_category_count" channel="inline" encoding="utf-8" language="text/cybol" format="access/count" model="">
        <property name="count" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_count"/>
        <property name="part" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.categories"/>
    </part>

    <!-- post execution of loop check (necessary if no topic entry found); break variable initialized with false -->
    <part name="exists_category_entries" channel="inline" encoding="utf-8" language="text/cybol" format="compare/unequal" model="">
        <property name="left" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_count"/>
        <property name="right" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model="0"/>
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_break"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="all"/>
    </part>
    <part name="loop_category_translation" channel="inline" encoding="utf-8" language="text/cybol" format="flow/loop" model="">
        <property name="break" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_break"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.translate_category"/>
    </part>

    <!-- handle topic loop after finished topic --> 
    <part name="increment_topic_count" channel="inline" encoding="utf-8" language="text/cybol" format="calculate/add" model="">
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_index"/>
        <property name="operand" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="1"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
    </part>
    <part name="compare_topic_count" channel="inline" encoding="utf-8" language="text/cybol" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_break"/>
        <property name="right" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_count"/>
        <property name="left" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_index"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="all"/>
    </part>
</model>
