<model>
    <!-- Build. -->
    <part name="build_index_string" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.build_topic_index_string"/>
    </part>
    <part name="build_html_template" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.build_topic"/>
    </part>

    <!-- Reset. -->
    <part name="reset_break" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_break"/>
        <property name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </part>
    <!--
        CAUTION! The count has to be reset even though it gets calculated below.
        The reason is that calculation might fail for non-existing parts,
        and using an invalid count of a previous part would lead to wrong results.
    -->
    <part name="reset_count" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_count"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="reset_index" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_index"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>

    <!-- Translate. -->
    <part name="count_parts" channel="inline" format="access/count" model="">
        <property name="count" channel="inline" format="path/knowledge" model=".temporary.category_count"/>
        <property name="part" channel="inline" format="path/reference" model=".temporary.topic_link"/>
    </part>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".temporary.category_break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".temporary.category_index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".temporary.category_count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="loop_parts" channel="inline" format="flow/loop" model="">
        <property name="break" channel="inline" format="path/knowledge" model=".temporary.category_break"/>
        <property name="model" channel="inline" format="path/knowledge" model=".logic.translate_category"/>
    </part>

    <!-- Index. -->
    <part name="increment_index" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".temporary.topic_index"/>
        <property name="operand" channel="inline" format="number/integer" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".temporary.topic_break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".temporary.topic_index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".temporary.topic_count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
</model>
