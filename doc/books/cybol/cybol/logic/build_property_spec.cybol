<model>
    <part name="clear_property" channel="inline" format="modify/overwrite" model="">
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.property_link"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_path_to_properties" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.link_spec_properties"/>
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.property_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_pre_to_property_link" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="text/plain" model=".["/>
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.property_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="clear_property_link_number" channel="inline" format="modify/overwrite" model="">
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.property_link_number"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="serialise_index_to_property_link_number" channel="inline" format="represent/serialise" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.property_link_number"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.properties_index"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </part>
    <part name="add_specification_link_number_as_text" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.property_link_number"/>
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.property_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_post_to_property_link" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="text/plain" model="]"/>
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.property_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- copy selected property name to temp -->
    <part name="copy_name_of_property_to_temp" channel="inline" format="access/get-name" model="">
        <property name="element" channel="inline" format="path/knowledge" model=".temporary.selected_property"/>
        <property name="part" channel="inline" format="path/reference" model=".temporary.property_link"/>
    </part>
</model>
