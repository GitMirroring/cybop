<model>
    <part name="print_static_specification" channel="inline" encoding="utf-8" language="text/cybol" format="communicate/send" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" encoding="utf-8" language="text/cybol" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="specification"/>
        <property name="new_line" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="true"/>
        <property name="clean" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="false"/>
    </part>

    <!-- create knowledge-tree-part for temporary specification -->
    <part name="create_temp_specification" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=".temporary.specification"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
    </part>
    <!-- get specification by index -->
    <!-- Hint: Does not work yet!!!!!!!!!!! 
    <part name="get_specification_by_index" channel="inline" encoding="utf-8" language="text/cybol" format="access/get" model="">
	<property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model="temp_specification"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".specification"/>
        <property name="index" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.loop_index"/>
    </part>
    -->
    <!-- Debug: copy selected specification to temp (replaces not working get part) -->
    <part name="copy_selected_specs_topics" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topics"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".specification.logic#topics"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="path/knowledge"/>
    </part>
    <!-- copy selected specification name to temp ('logic' has to be replaced by 'temp_specification') -->
    <part name="copy_selected_spec_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_specification"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".specification.logic#name"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="path/knowledge"/>
    </part>

    <!-- copy information from knowledge-tree-part 'specification' to knowledge-tree-part 'wui.index' -->
    <part name="build_specification_to_html" channel="inline" encoding="utf-8" language="text/cybol" format="flow/sequence" model="">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.build_specification"/>
    </part>

    <!-- read specification topics -->
    <!-- count the topics of the selected specification -->
    <part name="get_topic_count" channel="inline" encoding="utf-8" language="text/cybol" format="access/count" model="">
        <property name="count" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_count"/>
        <property name="part" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification"/>
    </part>

    <!-- post execution of loop check (necessary if no topic entry found); break variable initialized with false -->
    <part name="exists_topic_entries" channel="inline" encoding="utf-8" language="text/cybol" format="compare/unequal" model="">
        <property name="left" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_count"/>
        <property name="right" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model="0"/>
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_break"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="all"/>
    </part>
    <part name="loop_topic_translation" channel="inline" encoding="utf-8" language="text/cybol" format="flow/loop" model="">
        <property name="break" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_break"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.translate_topic"/>
    </part>

    <!-- Release temorary specification -->
    <part name="release_specification" channel="inline" abstraction="operation" model="memorise/destroy">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temp_specification"/>
    </part>

    <!-- handle specification loop after finished specification --> 
    <part name="increment_specification_count" channel="inline" encoding="utf-8" language="text/cybol" format="calculate/add" model="">
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_index"/>
        <property name="operand" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="1"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
    </part>
    <part name="compare_specification_count" channel="inline" encoding="utf-8" language="text/cybol" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_break"/>
        <property name="right" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_count"/>
        <property name="left" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_index"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="all"/>
    </part>
</model>
