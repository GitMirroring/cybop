<model>
    <!--
        HIERARCHY:
        translate_specification
        translate_topic
        translate_category
        translate_operation
        translate_properties
    -->
    <part name="get_topic_count" channel="inline" format="access/count" model="">
        <property name="count" channel="inline" format="path/knowledge" model=".temporary.topic_count"/>
        <property name="part" channel="inline" format="path/knowledge" model=".specification"/>
    </part>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".temporary.topic_break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".temporary.topic_index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".temporary.topic_count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="loop_topic" channel="inline" format="flow/loop" model="">
        <property name="break" channel="inline" format="path/knowledge" model=".temporary.topic_break"/>
        <property name="model" channel="inline" format="path/knowledge" model=".logic.translate_topic"/>
    </part>
</model>
