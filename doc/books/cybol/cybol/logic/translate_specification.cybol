<model>
    <!-- build specification access string and set specification name to temp var -->
    <part name="build_specification_index_string" channel="inline" encoding="utf-8" language="text/cybol" format="flow/sequence" model="">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.build_specification_index_string"/>
    </part>

    <!-- copy template to specific knowledge path in wui.index -->
    <part name="build_specification_to_html" channel="inline" encoding="utf-8" language="text/cybol" format="flow/sequence" model="">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.build_specification"/>
    </part>

    <!-- count the topics of the selected specification -->
    <part name="get_topic_count" channel="inline" encoding="utf-8" language="text/cybol" format="access/count" model="">
        <property name="count" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_count"/>
        <property name="part" channel="inline" encoding="utf-8" language="text/cybol" format="path/reference" model=".temporary.specification_link"/>
    </part>
    
    <!-- pre execution of topic loop check (necessary if no topic entry found) -->
    <part name="exists_topic_entries" channel="inline" encoding="utf-8" language="text/cybol" format="compare/equal" model="">
        <property name="left" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_count"/>
        <property name="right" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_break"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="all"/>
    </part>
    <!-- calls translate_topic foreach topic in specification part -->
    <part name="loop_topic_translation" channel="inline" encoding="utf-8" language="text/cybol" format="flow/loop" model="">
        <property name="break" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_break"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.translate_topic"/>
    </part>

    <!-- handle specification loop after finished specification --> 
    <part name="increment_specification_count" channel="inline" encoding="utf-8" language="text/cybol" format="calculate/add" model="">
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_index"/>
        <property name="operand" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="1"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
    </part>
    <part name="compare_specification_count" channel="inline" encoding="utf-8" language="text/cybol" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_break"/>
        <property name="right" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_count"/>
        <property name="left" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.specification_index"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="all"/>
    </part>
</model>
