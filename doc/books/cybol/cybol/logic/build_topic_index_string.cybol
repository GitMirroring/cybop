<model>
    <!-- Empty. -->
    <part name="empty_topic_link" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".temporary.topic_link"/>
    </part>
    <part name="empty_topic_link_number" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".temporary.topic_link_number"/>
    </part>

    <!-- Serialise. -->
    <part name="serialise_index_to_topic_link_number" channel="inline" format="represent/serialise" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_link_number"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_index"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </part>

    <!-- Build. -->
    <part name="add_prefix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_link"/>
        <property name="source" channel="inline" format="text/plain" model=".specification.["/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_topic_link_number_as_text" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_link"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_link_number"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_suffix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_link"/>
        <property name="source" channel="inline" format="text/plain" model="]"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- Copy. -->
    <part name="copy_topic_name" channel="inline" format="access/get-name" model="">
        <property name="element" channel="inline" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="part" channel="inline" format="path/reference" model=".temporary.topic_link"/>
    </part>
</model>
