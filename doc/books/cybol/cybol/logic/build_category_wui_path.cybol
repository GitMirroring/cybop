<model>
    <part name="clear_category_wui_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_path_to_category_to_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path"/>
	<property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_content_path"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_seperator_to_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path"/>
	<property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="."/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_category_name_to_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path"/>
	<property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>

    <part name="clear_category_wui_name_content" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path_name"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_path_to_category_to_name_content" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path_name"/>
	<property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_category_name_content" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path_name"/>
	<property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=".category_name"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>

    <part name="clear_category_wui_name_anchor" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
	<property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path_anchor"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_path_to_category_to_name_anchor" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path_anchor"/>
	<property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.category_content_path"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
