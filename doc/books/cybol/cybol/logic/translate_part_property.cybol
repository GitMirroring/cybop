<model>
    <!-- Reset. -->
    <part name="reset_break" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.properties_break"/>
        <property name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </part>
    <!--
        CAUTION! The count has to be reset even though it gets calculated below.
        The reason is that calculation might fail for non-existing parts,
        and using an invalid count of a previous part would lead to wrong results.
    -->
    <part name="reset_count" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.properties_count"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="reset_index" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.properties_index"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>

    <!-- Initialise. -->
    <part name="copy_part_content_html_template" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui/template/part_property_content.cybol"/>
        <property name="model" channel="inline" format="path/reference" model=".temporary.part_content_path"/>
    </part>

    <!-- Translate. -->
    <part name="count_parts" channel="inline" format="access/count" model="">
        <property name="count" channel="inline" format="path/knowledge" model=".temporary.properties_count"/>
        <property name="part" channel="inline" format="path/reference" model=".temporary.link_spec_properties"/>
    </part>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".temporary.properties_break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".temporary.properties_index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".temporary.properties_count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="loop_parts" channel="inline" format="flow/loop" model="">
        <property name="break" channel="inline" format="path/knowledge" model=".temporary.properties_break"/>
        <property name="model" channel="inline" format="path/knowledge" model=".logic.translate_properties"/>
    </part>
</model>
