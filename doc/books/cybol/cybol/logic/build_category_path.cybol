<model>
    <!-- build path to category content -->
    <part name="clear_category_content_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_content_path"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>^
    <part name="add_belonging_topic_knowledge_path" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_content_path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_content_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dot" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_content_path"/>
        <property name="source" channel="inline" format="text/plain" model="."/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_selected_category_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_content_path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- build path to category toc -->
    <part name="clear_category_toc_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_toc_path"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_path_to_toc" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_toc_path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dot_to_path_of_toc" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_toc_path"/>
        <property name="source" channel="inline" format="text/plain" model="."/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="add_selected_category_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.category_toc_path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
   
</model>
