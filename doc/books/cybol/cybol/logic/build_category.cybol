<model>

    <!-- build dynamic knowledgepath to selected category -->
    <part name="generate_category_path" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.build_category_path"/>
    </part>

    <!-- create category knowlegdepath in wui.index.body.content -->
    <part name="create_category_topic" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/reference" model=".temporary.topic_content_path"/>
    </part>

    <!-- copy category content template to wui.index.body.content -->
    <part name="initialise_wui_category_with_template_part" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui/template/category_content.cybol"/>
        <property name="model" channel="inline" format="path/reference" model=".temporary.category_content_path"/>
    </part>
    <part name="initialise_wui_category_with_template_properties" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/property"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui/template/properties.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".temporary.category_content_path"/>
    </part>

    <!-- create category knowlegdepath in wui.index.body.toc -->
    <part name="create_category_knowledgepath_in_toc" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/reference" model=".temporary.topic_toc_path"/>
    </part>

    <!-- copy category content template to wui.index.body.toc -->
    <part name="initialise_wui_category_toc_with_template" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui/template/category_toc.cybol"/>
        <property name="model" channel="inline" format="path/reference" model=".temporary.category_toc_path"/>
    </part>

    <!-- build dynamic knowledgepath to properties of the content template of the selected category -->
    <part name="generate_category_properties_content_path" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.build_category_content_path"/>
    </part>

    <!-- copy category name to html content -->
    <part name="copy_category_name" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.category_content_path_name"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_category_name_to_anchor" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.category_content_path_anchor"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- build dynamic knowledgepath to properties of the toc template of the selected category -->
    <part name="generate_category_properties_toc_path" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.build_category_toc_path"/>
    </part>

    <!-- copy category name to html toc -->
    <part name="copy_category_name_to_toc" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.category_toc_path_name"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_sharp_to_category_href" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.category_toc_path_href"/>
        <property name="source" channel="inline" format="text/plain" model="#"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_category_name_to_toc_href" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.category_toc_path_href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_category"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

</model>
