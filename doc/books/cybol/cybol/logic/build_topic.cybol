<model>
    <!-- build dynamic knowledgepath to selected topic -->
    <part name="generate_topic_path" channel="inline" encoding="utf-8" language="text/cybol" format="flow/sequence" model="">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.build_topic_path"/>
    </part>

    <!-- create topic knowlegdepath in wui.index.body.content -->
    <part name="create_topic_specification" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/encapsulated" model=".temporary.topic_content_path"/>
    </part>

    <!-- copy topic content template to wui.index.body.content -->
    <part name="initialise_wui_topic_with_template" channel="inline" encoding="utf-8" language="text/cybol" format="communicate/receive" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" encoding="utf-8" language="text/cybol" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cybol/wui/template/topic_content.cybol"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/encapsulated" model=".temporary.topic_content_path"/>
    </part>

    <!-- create topic knowlegdepath in wui.index.body.toc -->
    <part name="create_topic_knowledgepath_in_toc" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/encapsulated" model=".temporary.topic_toc_path"/>
    </part>

    <!-- copy topic content template to wui.index.body.toc -->
    <part name="initialise_wui_topic_toc_with_template" channel="inline" encoding="utf-8" language="text/cybol" format="communicate/receive" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" encoding="utf-8" language="text/cybol" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cybol/wui/template/topic_toc.cybol"/>
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/encapsulated" model=".temporary.topic_toc_path"/>
    </part>

    <!-- build dynamic knowledgepath to properties of the content template of the selected topic -->
    <part name="generate_topic_properties_content_path" channel="inline" encoding="utf-8" language="text/cybol" format="flow/sequence" model="">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.build_topic_content_path"/>
    </part>

    <!-- copy topic name to html content -->
    <part name="copy_topic_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/encapsulated" model=".temporary.topic_content_path_name"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_topic_name_to_href" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/encapsulated" model=".temporary.topic_content_path_href"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>

    <!-- build dynamic knowledgepath to properties of the toc template of the selected topic -->
    <part name="generate_topic_properties_toc_path" channel="inline" encoding="utf-8" language="text/cybol" format="flow/sequence" model="">
        <property name="model" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".logic.build_topic_toc_path"/>
    </part>

    <!-- copy topic name to html toc -->
    <part name="copy_topic_name_to_toc" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/encapsulated" model=".temporary.topic_toc_path_name"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_sharp_to_topic_href" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/encapsulated" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="#"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_topic_name_to_toc_href" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/encapsulated" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
</model>
