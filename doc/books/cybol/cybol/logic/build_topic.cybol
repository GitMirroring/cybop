<model>
    <!-- create placeholder for topic template to wui.index.body.content -->
    <part name="create_wui_topic" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/knowledge" model=".wui.index.body.content"/>
    </part>

    <!-- create dynamic reference of knowledge path to selected topic for content -->
    <part name="build_topic_content_to_html" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.build_topic_content_path"/>
    </part>
    <!-- copy topic template to wui.index.body.content -->
    <part name="initialise_wui_topic_with_template" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui/template/topic_content.cybol"/>
        <property name="model" channel="inline" format="path/reference" model=".temporary.topic_content_path"/>
    </part>

    <!-- copy name to header and anchor -->
    <part name="copy_topic_name" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.topic_content_path_name"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_topic_name_to_anchor" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.topic_content_path_anchor"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- create placeholder for template to wui.index.body.toc -->
    <part name="create_wui_toc_topic" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/knowledge" model=".wui.index.body.toc"/>
    </part>

    <!-- create knowledge path to selected topic for content -->
    <part name="build_path_to_spec_toc" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.build_topic_toc_path"/>
    </part>
    <!-- copy toc template to wui.index.body.toc -->
    <part name="initialise_wui_toc_topic_with_template" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui/template/topic_toc.cybol"/>
        <property name="model" channel="inline" format="path/reference" model=".temporary.topic_toc_path"/>
    </part>

    <!-- copy name to toc and link -->
    <part name="copy_topic_name_to_toc" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.topic_toc_path_name"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="copy_sharp_to_topic_href" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" format="text/plain" model="#"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_topic_name_to_href" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
</model>
