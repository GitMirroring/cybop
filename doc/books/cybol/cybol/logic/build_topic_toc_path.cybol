<model>
    <part name="clear_topic_toc_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="add_static_knowledge_path" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="source" channel="inline" format="text/plain" model=".wui.index.body.toc."/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_knowledge_path" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

<part name="clear_topic_toc_path_name" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_name"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_topic_path_to_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_name"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_name_to_topic_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_name"/>
        <property name="source" channel="inline" format="text/plain" model=".topic_toc"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="clear_topic_toc_href" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_topic_path_to_href" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_href_to_topic_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" format="text/plain" model=".topic_toc#href"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="clear_topic_toc_div" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_div"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_topic_path_to_div" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_div"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_tag_to_topic_div" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_div"/>
        <property name="source" channel="inline" format="text/plain" model="#tag"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="clear_topic_toc_class" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_div_class"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_topic_path_to_class" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_div_class"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_tag_to_topic_class" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.topic_toc_path_div_class"/>
        <property name="source" channel="inline" format="text/plain" model="#class"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- add div tag to topic toc -->
    <part name="create_div_tag_for_topic_toc_node" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="tag"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="property"/>
        <property name="whole" channel="inline" format="path/reference" model=".temporary.topic_toc_path"/>
    </part>
    <part name="copy_div_tag_to_knowledge_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.topic_toc_path_div"/>
        <property name="source" channel="inline" format="text/plain" model="div"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <!-- set div class tag of topic toc -->
    <part name="create_class_for_topic_toc_tag" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="class"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="property"/>
        <property name="whole" channel="inline" format="path/reference" model=".temporary.topic_toc_path"/>
    </part>
    <part name="copy_div_class_tag_to_knowledge_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.topic_toc_path_div_class"/>
        <property name="source" channel="inline" format="text/plain" model="topic_toc"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
</model> 
