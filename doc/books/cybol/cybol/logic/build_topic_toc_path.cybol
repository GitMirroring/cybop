<model>
    <part name="clear_topic_toc_path" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>

    <part name="add_static_knowledge_path" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=".wui.index.body.toc."/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_knowledge_path" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.selected_topic"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>

<part name="clear_topic_toc_path_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path_name"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_topic_path_to_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path_name"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_name_to_topic_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path_name"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=".topic_toc"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>

    <part name="clear_topic_toc_href" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=""/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dynamic_topic_path_to_href" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_href_to_topic_name" channel="inline" encoding="utf-8" language="text/cybol" format="modify/append" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".temporary.topic_toc_path_href"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model=".topic_toc#href"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
</model> 
