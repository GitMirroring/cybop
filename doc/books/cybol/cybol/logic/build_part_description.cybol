<model>
    <!-- copy part content template for description to wui.index.body.toc -->
    <part name="copy_wui_part_description_content_template" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="cybol/wui/template/part_description_content.cybol"/>
        <property name="model" channel="inline" format="path/reference" model=".temporary.part_content_path"/>
    </part>
    <!-- copy part description to html content -->
    <part name="copy_part_description" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".temporary.part_content_path_description"/>
        <property name="source" channel="inline" format="path/reference" model=".temporary.link_spec_description"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
</model>
