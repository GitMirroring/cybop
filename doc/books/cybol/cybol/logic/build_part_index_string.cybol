<model>
    <part name="clear_part" channel="inline" format="modify/overwrite" model="">
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_link"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_category_path_to_part" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.category_link"/>
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_static_pre_to_part_path" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="text/plain" model=".["/>
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="clear_part_link_number" channel="inline" format="modify/overwrite" model="">
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_link_number"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="serialise_index_to_part_link_number" channel="inline" format="represent/serialise" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_link_number"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.part_index"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </part>
    <part name="add_part_link_number_as_text" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.part_link_number"/>
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_post_to_part_link" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="text/plain" model="]"/>
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_link"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- copy selected part name to temp -->
    <part name="add_name_of_part_to_content_path" channel="inline" format="access/get-name" model="">
        <property name="element" channel="inline" format="path/knowledge" model=".temporary.selected_part"/>
        <property name="part" channel="inline" format="path/reference" model=".temporary.part_link"/>
    </part>

    <!-- build part toc base path -->
    <part name="clear_part_toc_path" channel="inline" format="modify/overwrite" model="">
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_toc_path"/>
        <property name="source" channel="inline" format="text/plain" model=""/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_category_path_to_part_toc" channel="inline" format="modify/append" model="">
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.category_toc_path"/>
    <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_toc_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_dot_to_part_toc_path" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_toc_path"/>
        <property name="source" channel="inline" format="text/plain" model="."/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_part_name_to_toc" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".temporary.part_toc_path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".temporary.selected_part"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
</model>
