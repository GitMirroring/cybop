<!--
    CAUTION! The CYBOL language does NOT need a root node.
    Its nodes all have the same identical attributes.

    Unfortunately, XML does require a root node for each document.
    Therefore, CYBOL uses one, too.
    However, it is actually superfluous and its attributes are as well.
-->

<!ELEMENT node (node*)>

<!ATTLIST node
    name CDATA #REQUIRED
    channel CDATA #REQUIRED
    format CDATA #REQUIRED
    model CDATA #REQUIRED>
