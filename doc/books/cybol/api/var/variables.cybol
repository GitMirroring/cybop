<node>

    <!-- The loop parametres. -->
    <node name="count" channel="inline" format="number/integer" model="0"/>
    <node name="index" channel="inline" format="number/integer" model="0"/>
    <node name="break" channel="inline" format="logicvalue/boolean" model="false"/>

    <!-- The element. -->
    <node name="number" channel="inline" format="text/plain" model=""/>
    <node name="root" channel="inline" format="text/plain" model=""/>
    <node name="name" channel="inline" format="text/plain" model=""/>
    <!-- This is only needed for accessing a part's properties. -->
    <node name="properties" channel="inline" format="text/plain" model=""/>

</node>
