<model>

    <!-- Identification. -->
    <part name="identify_topic_number" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.topic_number"/>
    </part>
    <part name="identify_topic_root" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.topic_root"/>
    </part>
    <part name="get_topic_name" channel="inline" format="access/get-name" model="">
        <property name="element" channel="inline" format="path/knowledge" model=".app.var.topic.name"/>
        <property name="part" channel="inline" format="path/reference" model=".app.var.topic.root"/>
    </part>

    <!-- Loop reset. -->
    <!--
        CAUTION! The count has to be reset even though it gets calculated below.
        The reason is that calculation might fail for non-existing children,
        and using an invalid count of a previous child would lead to wrong results.
    -->
    <part name="reset_count" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.category.count"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="reset_index" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.category.index"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="reset_break" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.category.break"/>
        <property name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </part>

    <!-- Model creation. -->
    <part name="create_wui_toc_topic" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.create.wui_toc_topic"/>
    </part>
    <part name="create_wui_content_topic" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.create.wui_content_topic"/>
    </part>

    <!-- Child translation. -->
    <part name="count_categories" channel="inline" format="access/count" model="">
        <property name="count" channel="inline" format="path/knowledge" model=".app.var.category.count"/>
        <property name="part" channel="inline" format="path/reference" model=".app.var.topic.root"/>
    </part>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.category.break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".app.var.category.index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".app.var.category.count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="loop_categories" channel="inline" format="flow/loop" model="">
        <property name="break" channel="inline" format="path/knowledge" model=".app.var.category.break"/>
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.translate.category"/>
    </part>

    <!-- Loop test. -->
    <part name="increment_index" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.topic.index"/>
        <property name="operand" channel="inline" format="number/integer" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.topic.break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".app.var.topic.index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".app.var.topic.count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>

</model>
