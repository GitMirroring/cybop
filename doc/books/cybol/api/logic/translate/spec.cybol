<model>

    <!-- Identification. -->
    <!-- It is NOT necessary to identify a number, since this spec is the root. -->
    <part name="identify_spec_root" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.spec_root"/>
    </part>
    <part name="get_spec_name" channel="inline" format="access/get-name" model="">
        <property name="element" channel="inline" format="path/knowledge" model=".app.var.spec.name"/>
        <property name="part" channel="inline" format="path/reference" model=".app.var.spec.root"/>
    </part>

    <!-- Loop reset. -->
    <!--
        CAUTION! The count has to be reset even though it gets calculated below.
        The reason is that calculation might fail for non-existing children,
        and using an invalid count of a previous child would lead to wrong results.
    -->
    <part name="reset_count" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.topic.count"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="reset_index" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.topic.index"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="reset_break" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.topic.break"/>
        <property name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </part>

    <!-- Model creation. -->
    <part name="create_page" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="path/knowledge" model=".app.var.topic.break"/>
        <property name="false" channel="inline" format="path/knowledge" model=".app.logic.create.wui_page"/>
    </part>

    <!-- Child translation. -->
    <part name="count_topics" channel="inline" format="access/count" model="">
        <property name="count" channel="inline" format="path/knowledge" model=".app.var.topic.count"/>
        <property name="part" channel="inline" format="path/reference" model=".app.var.spec.root"/>
    </part>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.topic.break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".app.var.topic.index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".app.var.topic.count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <!-- User information. -->
    <part name="show_message" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="path/knowledge" model=".app.var.topic.break"/>
        <property name="true" channel="inline" format="path/knowledge" model=".app.logic.show_failure"/>
        <property name="false" channel="inline" format="path/knowledge" model=".app.logic.show_success"/>
    </part>
    <part name="loop_topics" channel="inline" format="flow/loop" model="">
        <property name="break" channel="inline" format="path/knowledge" model=".app.var.topic.break"/>
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.translate.topic"/>
    </part>

    <!-- Loop test. -->
    <!-- It is NOT necessary, since this spec is NOT a child of some parent. -->

</model>
