<node>

    <!-- Identification. -->
    <node name="identify_part_number" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.identify.part_number"/>
    </node>
    <node name="identify_part_root" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.identify.part_root"/>
    </node>
        <!-- CAUTION! This is different from other such files. Between a part and a property, there is the part's "properties" to be used here. -->
    <node name="identify_part_properties" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.identify.part_properties"/>
    </node>
    <node name="get_part_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model=".var.part.name"/>
        <node name="part" channel="inline" format="text/cybol-path" model="*.var.part.root"/>
    </node>

    <!-- Loop reset. -->
    <!--
        CAUTION! The count has to be reset even though it gets calculated below.
        The reason is that calculation might fail for non-existing children,
        and using an invalid count of a previous child would lead to wrong results.
    -->
    <node name="reset_count" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.property.count"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="reset_index" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.property.index"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="reset_break" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.property.break"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>

    <!-- Model creation. -->
    <node name="create_wui_toc_part" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.create.wui_toc_part"/>
    </node>
    <node name="create_wui_content_part" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.create.wui_content_part"/>
    </node>

    <!-- Child translation. -->
    <node name="count_properties" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model=".var.property.count"/>
        <!-- CAUTION! This is different from other such files. Between a part and a property, there is the part's "properties" to be used here. -->
        <node name="part" channel="inline" format="text/cybol-path" model="*.var.part.properties"/>
    </node>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".var.property.break"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".var.property.index"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".var.property.count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>
    <node name="loop_properties" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".var.property.break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.properties"/>
    </node>

    <!-- Loop test. -->
    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".var.part.index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".var.part.break"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".var.part.index"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".var.part.count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

</node>
