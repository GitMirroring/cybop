<node>

    <!-- Identification. -->
    <node name="get_property_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#property_name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".spec.[#topic_index].[#category_index].[#part_index].properties.[#property_index]"/>
    </node>

<!--
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="TEST properties"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#property_name"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
-->

    <!-- Loop reset. -->
    <!-- It is NOT necessary, since there are NO children. -->

    <!-- Model creation. -->
    <!-- There is NO toc entry for the properties. -->
    <node name="create_wui_content_properties" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.create.wui_content_properties"/>
    </node>

    <!-- Child translation. -->
    <!-- It is NOT necessary, since there are NO children. -->

    <!-- Loop test. -->
    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#property_index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#property_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#property_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#property_count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

</node>
