<node>

    <node name="overwrite_part" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.property.root"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.part.root"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <!--
        CAUTION! This is different from other such files.
        Between a part and a property, there is the node called "properties" that has to be added here.
    -->
    <node name="append_properties" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.property.root"/>
        <node name="source" channel="inline" format="text/plain" model=".properties"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_prefix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.property.root"/>
        <node name="source" channel="inline" format="text/plain" model=".["/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_number" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.property.root"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.property.number"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_suffix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.property.root"/>
        <node name="source" channel="inline" format="text/plain" model="]"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

</node>
