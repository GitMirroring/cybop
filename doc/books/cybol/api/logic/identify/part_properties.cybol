<model>

    <part name="overwrite_root" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.part.properties"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.part.root"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_properties" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.part.properties"/>
        <property name="source" channel="inline" format="text/plain" model=".properties"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

</model>
