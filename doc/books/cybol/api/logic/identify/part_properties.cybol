<node>

    <node name="overwrite_root" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.part.properties"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.part.root"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_properties" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.part.properties"/>
        <node name="source" channel="inline" format="text/plain" model=".properties"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

</node>
