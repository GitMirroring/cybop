<model>

    <!--
        CAUTION! Do NOT delete this "empty" operation!
        The "serialise" operation below appends its result,
        so that previous results are not overwritten.
        Therefore, the result variable HAS TO BE emptied beforehand.
    -->
    <part name="empty" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".app.var.topic.number"/>
    </part>
    <part name="serialise_index" channel="inline" format="represent/serialise" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.topic.number"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.topic.index"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
    </part>

</model>
