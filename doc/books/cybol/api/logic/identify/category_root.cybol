<node>

    <node name="overwrite_topic" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.category.root"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.topic.root"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_prefix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.category.root"/>
        <node name="source" channel="inline" format="text/plain" model=".["/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_number" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.category.root"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.category.number"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_suffix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.category.root"/>
        <node name="source" channel="inline" format="text/plain" model="]"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

</node>
