<node>

    <node name="overwrite_category" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.part.root"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.category.root"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_prefix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.part.root"/>
        <node name="source" channel="inline" format="text/plain" model=".["/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_number" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.part.root"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.part.number"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_suffix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.part.root"/>
        <node name="source" channel="inline" format="text/plain" model="]"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

</node>
