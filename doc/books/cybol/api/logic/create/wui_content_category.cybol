<model>

    <part name="create_wui_content_category" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="path/knowledge" model=".app.var.category.name"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/knowledge" model=".app.wui.body.content.(.app.var.topic.name)"/>
    </part>

    <part name="initialise_wui_content_category_part" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="api/wui/content/category.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".app.wui.body.content.(.app.var.topic.name).(.app.var.category.name)"/>
    </part>
    <part name="initialise_wui_content_category_properties" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/property"/>
        <property name="message" channel="inline" format="text/plain" model="api/wui/content/category/category_properties.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".app.wui.body.content.(.app.var.topic.name).(.app.var.category.name)"/>
    </part>

    <part name="overwrite_heading" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.wui.body.content.(.app.var.topic.name).(.app.var.category.name).anchor.heading"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.category.name"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="overwrite_name" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.wui.body.content.(.app.var.topic.name).(.app.var.category.name).anchor#name"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.category.name"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

</model>
