<node>

    <node name="create_wui_content_properties" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/cybol-path" model="#property_name"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).(#category_name).(#part_name).properties.grid"/>
    </node>

    <node name="initialise_wui_content_properties_part" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="api/wui/content/properties/data.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).(#category_name).(#part_name).properties.grid.(#property_name)"/>
    </node>

    <node name="initialise_wui_content_properties_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="sender" channel="inline" format="text/plain" model="api/wui/content/properties/data_properties.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).(#category_name).(#part_name).properties.grid.(#property_name)"/>
    </node>
-->
    <node name="overwrite_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).(#category_name).(#part_name).properties.grid.(#property_name).name"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).(#category_name).(#part_name).properties.(#property_name):name"/>
    </node>
    <node name="overwrite_description" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).(#category_name).(#part_name).properties.grid.(#property_name).description"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).(#category_name).(#part_name).properties.(#property_name):description"/>
    </node>
    <node name="serialise_required" channel="inline" format="represent/serialise" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).(#category_name).(#part_name).properties.grid.(#property_name).required"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).(#category_name).(#part_name).properties.(#property_name):required"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
    </node>
    <node name="overwrite_format" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).(#category_name).(#part_name).properties.grid.(#property_name).format"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).(#category_name).(#part_name).properties.(#property_name):format"/>
    </node>
    <node name="overwrite_model" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).(#category_name).(#part_name).properties.grid.(#property_name).model"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).(#category_name).(#part_name).properties.(#property_name):model"/>
    </node>

</node>
