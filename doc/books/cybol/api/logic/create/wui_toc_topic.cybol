<node>

    <node name="create_wui_toc_topic_link" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="path/knowledge" model=".app.var.topic.name"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="path/knowledge" model=".app.wui.body.toc"/>
    </node>

    <node name="initialise_wui_toc_topic_part" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="api/wui/toc/container.cybol"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app.wui.body.toc.(.app.var.topic.name)"/>
    </node>
    <node name="initialise_wui_toc_topic_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="sender" channel="inline" format="text/plain" model="api/wui/toc/container_properties.cybol"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app.wui.body.toc.(.app.var.topic.name)"/>
    </node>

    <node name="overwrite_container_heading" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.wui.body.toc.(.app.var.topic.name).heading"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.topic.name"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="overwrite_anchor_sharp" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.wui.body.toc.(.app.var.topic.name).heading#href"/>
        <node name="source" channel="inline" format="text/plain" model="#"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <!-- CAUTION! Use "append" and NOT "overwrite" here! -->
    <node name="overwrite_anchor_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.wui.body.toc.(.app.var.topic.name).heading#href"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.topic.name"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="overwrite_anchor_class" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.wui.body.toc.(.app.var.topic.name)#class"/>
        <node name="source" channel="inline" format="text/plain" model="topic_toc"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

</node>
