<node>

    <node name="heading" channel="inline" format="text/plain" model="Properties">
        <node name="tag" channel="inline" format="text/plain" model="h5"/>
    </node>
    <node name="table" channel="file" format="element/part" model="api/wui/content/properties.cybol">
        <node name="tag" channel="inline" format="text/plain" model="table"/>
        <node name="border" channel="inline" format="text/plain" model="1"/>
        <node name="class" channel="inline" format="text/plain" model="property_table"/>
    </node>

</node>
