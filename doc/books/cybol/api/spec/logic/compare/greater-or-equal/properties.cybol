<model>
    <part name="result" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="result"/>
        <property name="description" channel="inline" format="text/plain" model="the knowledge model, in which the result is stored (of type boolean)"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
    <part name="left" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="left"/>
        <property name="description" channel="inline" format="text/plain" model="the left operand"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | number/* | text/plain"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
    <part name="right" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="right"/>
        <property name="description" channel="inline" format="text/plain" model="the right operand"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | number/* | text/plain"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
    <part name="type" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="type"/>
        <property name="description" channel="inline" format="text/plain" model="the operand type which is equal for both operands"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | meta/type"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
    <part name="selection" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="selection"/>
        <property name="description" channel="inline" format="text/plain" model="the area of two strings or number vectors to be compared"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | meta/type"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
</model>