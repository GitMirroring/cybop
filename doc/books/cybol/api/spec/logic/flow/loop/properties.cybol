<model>
    <part name="break" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="break"/>
        <property name="description" channel="inline" format="text/plain" model="the break flag; once set, the loop will be left (exited)"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>		
	<part name="model" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="model"/>
        <property name="description" channel="inline" format="text/plain" model="the logic knowledge model to be executed repeatedly by the loop"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | element/part"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
</model>
