<model>
    <part name="name" channel="inline" format="text/plain" model="rotate-right"/>
    <part name="description" channel="inline" format="text/plain" model="Rotates all bits of a value to the right by position."/>
    <part name="example" channel="file" format="text/plain" model="api/spec/logic/manipulate/rotate-right/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="manipulate/rotate-right"/>
    <part name="properties" channel="file" format="element/part" model="api/spec/logic/manipulate/rotate-right/properties.cybol"/>
</model>