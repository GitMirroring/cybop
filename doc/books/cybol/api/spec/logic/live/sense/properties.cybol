<node>
    <node name="channel" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="channel"/>
        <node name="description" channel="inline" format="text/plain" model="the channel via which to receive the message (terminal, www, x-window-system etc.)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | meta/channel"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="handler" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="handler"/>
        <node name="description" channel="inline" format="text/plain" model="the handler (usually a receive operation) that parses an input and filters out a command that the system is to react to"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/knowledge"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
