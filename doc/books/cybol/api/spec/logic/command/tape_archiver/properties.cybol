<node>
    <node name="source" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="source"/>
        <node name="description" channel="inline" format="text/plain" model="the source for archiving"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>		
	<node name="destination" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="destination"/>
        <node name="description" channel="inline" format="text/plain" model="the destination where the source is being archived"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>	
	<node name="force" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="force"/>
        <node name="description" channel="inline" format="text/plain" model="the force option for not asking for permission for overwriting files or directories"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>	
	<node name="gzip" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="gzip"/>
        <node name="description" channel="inline" format="text/plain" model="the gunzip option to indicate gunzip compression or extraction"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>	
	<node name="unpack" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="unpack"/>
        <node name="description" channel="inline" format="text/plain" model="the option for unpacking / extraction or else it will pack"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>	
	<node name="verbal" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="verbal"/>
        <node name="description" channel="inline" format="text/plain" model="shows which files and directories are being copied"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>	
	
</node>
