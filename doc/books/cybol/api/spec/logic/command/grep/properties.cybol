        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="file" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="file"/>
        <node name="description" channel="inline" format="text/plain" model="the file to search in"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
