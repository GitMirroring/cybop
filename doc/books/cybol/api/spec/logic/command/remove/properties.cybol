<node>
    <node name="path" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="path"/>
        <node name="description" channel="inline" format="text/plain" model=" the path including wildcards for deleting directories"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>    
    <node name="interactive" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="interactive"/>
        <node name="description" channel="inline" format="text/plain" model="the interactive option (askes everytime for permission of deleting a directory)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>    
    <node name="recursive" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="recursive"/>
        <node name="description" channel="inline" format="text/plain" model="the recursvie option (deletes all of its subdirectories)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="verbal" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="verbal"/>
        <node name="description" channel="inline" format="text/plain" model="the verbal option (shows what have been moved)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>    
</node>
