<node>
    <node name="source" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="source"/>
        <node name="description" channel="inline" format="text/plain" model="the source to be copied"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="destination" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="destination"/>
        <node name="description" channel="inline" format="text/plain" model="the destination to copy to"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="force" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="force"/>
        <node name="description" channel="inline" format="text/plain" model="the force option for not asking for permission for overwriting files or directories"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="interactive" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="interactive"/>
        <node name="description" channel="inline" format="text/plain" model="the interactive option which askes everytime for permission of overwriting a file or directory"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="preserve_all_attributes" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="preserve_all_attributes"/>
        <node name="description" channel="inline" format="text/plain" model="copied files and directories will have the same attributes as the originals"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="preserve_links" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="preserve_links"/>
        <node name="description" channel="inline" format="text/plain" model="preserves links so that they are not dereferenced while copying"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="recursive" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="recursive"/>
        <node name="description" channel="inline" format="text/plain" model="the option indicating that all sub directories should be copied as well"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="update" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="update"/>
        <node name="description" channel="inline" format="text/plain" model="the update option which just copies more recent data to a destination path"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="verbal" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="verbal"/>
        <node name="description" channel="inline" format="text/plain" model="shows which files and directories are being copied"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
