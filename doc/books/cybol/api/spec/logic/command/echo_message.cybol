<node>
    <node name="name" channel="inline" format="text/plain" model="echo-message"/>
    <node name="description" channel="inline" format="text/plain" model="Echos the message to standard output."/>
    <node name="example" channel="file" format="text/plain" model="api/spec/logic/command/echo_message/example.txt"/>
    <node name="format" channel="inline" format="text/plain" model="command/echo"/>
    <node name="properties" channel="file" format="element/part" model="api/spec/logic/command/echo_message/properties.cybol"/>
</node> 
