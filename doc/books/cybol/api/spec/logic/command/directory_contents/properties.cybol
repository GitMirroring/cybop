<node>
    <node name="path" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="path"/>
        <node name="description" channel="inline" format="text/plain" model="the listing for the given path (the default is the current directory)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="all" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="all"/>
        <node name="description" channel="inline" format="text/plain" model="the list all option (showing hidden, current . and upper .. directory)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="long" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="long"/>
        <node name="description" channel="inline" format="text/plain" model="the long listing option (showing user rights etc.)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="one row per entry" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="one row per entry"/>
        <node name="description" channel="inline" format="text/plain" model="the listing for showing one file or directory per row"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="recursive" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="recursive"/>
        <node name="description" channel="inline" format="text/plain" model="the list for all files and directories, looking up all directories recursively for additional files and directories for the listing"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="short" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="short"/>
        <node name="description" channel="inline" format="text/plain" model="the short version of the files and directory listing"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="sort by file size" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="sort by file size"/>
        <node name="description" channel="inline" format="text/plain" model="sorts the current listing by file size"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="sort by modification date" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="sort by modification date"/>
        <node name="description" channel="inline" format="text/plain" model="sorts the current listing by the file and directory modification date"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="sort by extension" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="sort by extension"/>
        <node name="description" channel="inline" format="text/plain" model="sorts the current listing alphabetically by file extension"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
