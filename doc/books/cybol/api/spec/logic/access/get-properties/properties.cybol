<model>
    <part name="element" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="element"/>
        <property name="description" channel="inline" format="text/plain" model="The part's element (properties)."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/*"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
    <part name="part" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="part"/>
        <property name="description" channel="inline" format="text/plain" model="The knowledge path to the part."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | number/*"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
</model>
