<node>
    <node name="element" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="element"/>
        <node name="description" channel="inline" format="text/plain" model="The part's element (language)."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/*"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="part" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="part"/>
        <node name="description" channel="inline" format="text/plain" model="The knowledge path to the part."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | number/*"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
