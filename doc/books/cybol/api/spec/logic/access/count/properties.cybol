<node>
    <node name="count" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="count"/>
        <node name="description" channel="inline" format="text/plain" model="The knowledge model in which to store the result."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/*"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="part" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="part"/>
        <node name="description" channel="inline" format="text/plain" model="The part whose elements to be counted."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | number/*"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="selection" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="selection"/>
        <node name="description" channel="inline" format="text/plain" model="The area of the elements names, to be compared. May be one of: all, suffix, prefix, subsequence. If null the element count is compared without comparison."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | meta/type"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="filter" channel="inline" format="text/plain" model="">
	<node name="name" channel="inline" format="text/plain" model="filter"/>
	<node name="description" channel="inline" format="text/plain" model="String to compare the elements with. Elements will only be counted if matching the filter string."/>
	<node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
	<node name="format" channel="inline" format="text/plain" model="path/* | meta/type"/>
	<node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
