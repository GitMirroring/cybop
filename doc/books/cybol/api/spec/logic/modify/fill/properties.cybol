<node>
	<node name="part" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="part"/>
        <node name="description" channel="inline" format="text/plain" model="the part"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="element" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="element"/>
        <node name="description" channel="inline" format="text/plain" model="the element"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="element/*"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="count" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="count"/>
        <node name="description" channel="inline" format="text/plain" model="If null, the part model count will be used instead. The number of elements to be filled in."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="number/integer"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="index" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="index"/>
        <node name="description" channel="inline" format="text/plain" model="If null, an index of zero will be used instead. The index from which to start copying elements to."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="number/integer"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="adjust" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="index"/>
        <node name="description" channel="inline" format="text/plain" model="The default is 'true'. If null, the count WILL BE adjusted. The flag indicating whether or not the part shall be adjusted to."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
