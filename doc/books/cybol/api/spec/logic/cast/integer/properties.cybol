<node>
    <node name="destination" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="destination"/>
        <node name="description" channel="inline" format="text/plain" model="The knowledge model to cast to."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/*"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="source" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="source"/>
        <node name="description" channel="inline" format="text/plain" model="The knowledge model to cast from."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | number/*"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="type" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="type"/>
        <node name="description" channel="inline" format="text/plain" model="The source type."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | meta/type"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
