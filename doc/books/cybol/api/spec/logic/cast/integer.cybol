<model>
    <part name="name" channel="inline" format="text/plain" model="integer"/>
    <part name="description" channel="inline" format="text/plain" model="Casts a value from one type to another."/>
    <part name="example" channel="file" format="text/plain" model="api/spec/logic/cast/integer/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="cast/integer"/>
    <part name="properties" channel="file" format="element/part" model="api/spec/logic/cast/integer/properties.cybol"/>
</model>
