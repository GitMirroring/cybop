<model>
    <part name="destination" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="destination"/>
        <property name="description" channel="inline" format="text/plain" model="The knowledge model to cast to."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/*"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
    <part name="source" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="source"/>
        <property name="description" channel="inline" format="text/plain" model="The knowledge model to cast from."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | number/*"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
    <part name="type" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="type"/>
        <property name="description" channel="inline" format="text/plain" model="The source type."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | meta/type"/>
        <property name="model" channel="inline" format="text/plain" model=""/>
    </part>
</model>
