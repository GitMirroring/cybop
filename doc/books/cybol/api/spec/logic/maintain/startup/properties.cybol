<node>
	<node name="channel" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="channel"/>
        <node name="description" channel="inline" format="text/plain" model="the channel on which to startup a service (terminal, display, tcp_socket, unix_socket, ...)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | meta/channel"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="namespace" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="namespace"/>
        <node name="description" channel="inline" format="text/plain" model="the address family, e.g. ip6"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="style" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="style"/>
        <node name="description" channel="inline" format="text/plain" model="the communication style, e.g. stream"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
	<node name="address" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="address"/>
        <node name="description" channel="inline" format="text/plain" model="the host address"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    
    	<node name="protocol" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="protocol"/>
        <node name="description" channel="inline" format="text/plain" model="the protocol, e.g. tcp"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    	<node name="id" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="id"/>
        <node name="description" channel="inline" format="text/plain" model="the service identification if having multiple terminals/displays/sockets etc., e.g. socket port 80; either port or service may be specified; port has higher priority; if missing, zero will be used (first io entry)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    	<node name="server" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="server"/>
        <node name="description" channel="inline" format="text/plain" model=""/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    	<node name="blocking" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="blocking"/>
        <node name="description" channel="inline" format="text/plain" model="the socket status, i.e. whether or not a socket is blocking"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    	<node name="connexions" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="connexions"/>
        <node name="description" channel="inline" format="text/plain" model="the number of possible pending client requests"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="number/integer"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>