<node>
    <node name="channel" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="channel"/>
        <node name="description" channel="inline" format="text/plain" model="the channel via which to send the message (e.g. http)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | meta/channel"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="encoding" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="encoding"/>
        <node name="description" channel="inline" format="text/plain" model="the encoding to be used, e.g. ascii; the default is utf-8"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="meta/encoding"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="language" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="language"/>
        <node name="description" channel="inline" format="text/plain" model="the language into which to serialise the message before sending it (e.g. html, model-diagram etc.)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="meta/language"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="format" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="format"/>
        <node name="description" channel="inline" format="text/plain" model="the format into which to serialise the message before sending (e.g. element/part, number/integer)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="meta/format"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="message" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="message"/>
        <node name="description" channel="inline" format="text/plain" model="the source message to be sent to another system"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" model="path/knowledge | text/plain" format="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="receiver" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="receiver"/>
        <node name="description" channel="inline" format="text/plain" model="the destination receiving the message"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="mode" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="mode"/>
        <node name="description" channel="inline" format="text/plain" model="the mode of communication, only if channel is http"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model=""/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="namespace" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="namespace"/>
        <node name="description" channel="inline" format="text/plain" model="the namespace of the socket, only if channel is http"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model=""/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="style" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="style"/>
        <node name="description" channel="inline" format="text/plain" model="the style of communicationl, only if channel is http"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="area" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="area"/>
        <node name="description" channel="inline" format="text/plain" model="the user interface area to be repainted, only if type is tui or gui"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model=""/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="clear" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="clear"/>
        <node name="description" channel="inline" format="text/plain" model="the flag indicating whether or not to clear the screen before painting a user interface, only if type is terminal or tui"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="newline" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="newline"/>
        <node name="description" channel="inline" format="text/plain" model="the flag indicating whether or not to add a new line after having printed the message on screen, only if channel is terminal"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="null_termination" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="null_termination"/>
        <node name="description" channel="inline" format="text/plain" model="the flag indicating whether or not to add an ascii null termination character '\0' at the end of the (multibyte) message (after encoding)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
