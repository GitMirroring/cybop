<node>
    <node name="name" channel="inline" format="text/plain" model="run"/>
    <node name="description" channel="inline" format="text/plain" model="Puts the executing thread to sleep for at least x microseconds (the actual duration may differ depending on the systems load and timer accuracy)"/>
    <node name="example" channel="file" format="text/plain" model="api/spec/logic/run/sleep/example.txt"/>
    <node name="format" channel="inline" format="text/plain" model="run/sleep"/>
    <node name="properties" channel="file" format="element/part" model="api/spec/logic/run/sleep/properties.cybol"/>
</node>