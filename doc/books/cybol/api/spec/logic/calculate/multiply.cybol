<model>
    <part name="name" channel="inline" format="text/plain" model="multiply"/>
    <part name="description" channel="inline" format="text/plain" model="Multiplies two numbers of the given format."/>
    <part name="example" channel="file" format="text/plain" model="api/spec/logic/calculate/multiply/example.txt"/>
    <part name="format" channel="inline" format="text/plain" model="calculate/multiply"/>
    <part name="properties" channel="file" format="element/part" model="api/spec/logic/calculate/multiply/properties.cybol"/>
</model>
