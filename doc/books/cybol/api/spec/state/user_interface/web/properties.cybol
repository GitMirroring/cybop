<model>
    <part name="tag" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="tag"/>
        <property name="description" channel="inline" format="text/plain" model="The html tag to use. Void tags are detected automatically."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | text/plain"/>
        <property name="model" channel="inline" format="text/plain" model="a valid html tag without arrow brackets"/>
    </part>
    <part name="class" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="class"/>
        <property name="description" channel="inline" format="text/plain" model="The 'class' html attribute."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | text/plain"/>
        <property name="model" channel="inline" format="text/plain" model="a css class as html attribute"/>
    </part>
    <part name="...(html attribute)..." channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="...(html attribute)..."/>
        <property name="description" channel="inline" format="text/plain" model="An arbitrary html attribute."/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | text/plain"/>
        <property name="model" channel="inline" format="text/plain" model="a valid html attribute"/>
    </part>
    <part name="preformatted" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="preformatted"/>
        <property name="description" channel="inline" format="text/plain" model="??"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | logicvalue/boolean"/>
        <property name="model" channel="inline" format="text/plain" model="??"/>
    </part>
    <part name="property" channel="inline" format="text/plain" model="">
        <property name="name" channel="inline" format="text/plain" model="property"/>
        <property name="description" channel="inline" format="text/plain" model="??"/>
        <property name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="format" channel="inline" format="text/plain" model="path/* | text/plain"/>
        <property name="model" channel="inline" format="text/plain" model="??"/>
    </part>
</model>
