<node>
    <node name="position" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="position"/>
        <node name="description" channel="inline" format="text/plain" model="The position (x, y) in unit [character], starting from zero, in relation to the surrounding parent element's origo."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | number/integer"/>
        <node name="model" channel="inline" format="text/plain" model="a two-dimensional vector"/>
    </node>
    <node name="size" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="size"/>
        <node name="description" channel="inline" format="text/plain" model="The size (width, height) in unit [character], starting from zero."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | number/integer"/>
        <node name="model" channel="inline" format="text/plain" model="a two-dimensional vector"/>
    </node>
    <node name="background" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="background"/>
        <node name="description" channel="inline" format="text/plain" model="The background colour. The default is the terminal's current background."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | colour/terminal"/>
        <node name="model" channel="inline" format="text/plain" model="black | blue | cyan | green | magenta | red | white | yellow"/>
    </node>
    <node name="foreground" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="foreground"/>
        <node name="description" channel="inline" format="text/plain" model="The foreground colour. The default is the terminal's current foreground."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | colour/terminal"/>
        <node name="model" channel="inline" format="text/plain" model="black | blue | cyan | green | magenta | red | white | yellow"/>
    </node>
    <node name="bold" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="bold"/>
        <node name="description" channel="inline" format="text/plain" model="The flag indicating whether or not to use bold foreground."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model="false | true"/>
    </node>
    <node name="intense" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="intense"/>
        <node name="description" channel="inline" format="text/plain" model="The flag indicating whether or not to use intense colour. This property is evaluated by win32 console only."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model="false | true"/>
    </node>
    <node name="border" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="border"/>
        <node name="description" channel="inline" format="text/plain" model="The kind of border characters to apply."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | text/plain"/>
        <node name="model" channel="inline" format="text/plain" model="ascii | simple | double | round"/>
    </node>
</node>
