<model>

    <part name="create" channel="file" format="element/part" model="api/logic/create.cybol"/>
    <part name="identify" channel="file" format="element/part" model="api/logic/identify.cybol"/>
    <part name="translate" channel="file" format="element/part" model="api/logic/translate.cybol"/>

    <part name="generate" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/html">
            <constraint name="indentation" channel="inline" format="logicvalue/boolean" model="true"/>
        </property>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.wui"/>
        <property name="receiver" channel="inline" format="path/knowledge" model=".app.var.file"/>
    </part>

    <part name="show_failure" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="text/plain" model="Error: Could not process files. Possibly, they have a wrong format."/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

    <part name="show_success" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="text/plain" model="Information: The files seem to have a valid format. Processing ..."/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

</model>
