heading external element/part {path/to/file.cybol}
    position internal number/integer {50,100}
    size internal number/integer {400,150}
    background internal colour/rgb {0,0,255}
    foreground internal colour/rgb {255,255,0}
    shape internal text/plain {rectangle}
    font internal text/plain {7x13}

heading: element/part = {path/to/file.cybol}
    position: number/integer {50,100}
    size: number/integer {400,150}
    background: colour/rgb {0,0,255}
    foreground: colour/rgb {255,255,0}
    shape: text/plain {rectangle}
    font: text/plain {7x13}

element/part heading = {path/to/file.cybol}
    number/integer position = {50,100}
    number/integer size = {400,150}
    colour/rgb background = {0,0,255}
    colour/rgb foreground = {255,255,0}
    text/plain shape = {rectangle}
    text/plain font = {7x13}

element/part test = {
    text/plain heading = {path/to/file.cybol}
        number/integer position = {50,100}
        number/integer size = {400,150}
        colour/rgb background = {0,0,255}
        colour/rgb foreground = {255,255,0}
        text/plain shape = {rectangle}
        text/plain font = {7x13}
}

