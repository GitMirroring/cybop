<model>
    <part name="menu_bar" channel="file" format="text/cybol" model="ui_control/gui/main_window/menu_bar.cybol">
        <property name="layout" channel="inline" format="text/plain" model="compass"/>
        <property name="cell" channel="inline" format="text/plain" model="north"/>
        <property name="position" channel="inline" format="number/integer" model="0,0,0"/>
        <property name="size" channel="inline" format="number/integer" model="780,20,1"/>
        <property name="left_release" channel="inline" format="path/knowledge" model=".ui_control.logic.exit_programme"/>
    </part>
<!--
    <part name="tool_bar" channel="file" format="text/cybol" model="ui_control/gui/main_window/tool_bar.cybol">
        <property name="layout" channel="inline" format="text/plain" model="compass"/>
        <property name="cell" channel="inline" format="text/plain" model="north"/>
        <property name="position" channel="inline" format="number/integer" model="0,0,0"/>
        <property name="size" channel="inline" format="number/integer" model="780,20,1"/>
    </part>
    <part name="contents_panel" channel="file" format="text/cybol" model="ui_control/gui/main_window/contents_panel.cybol">
        <property name="layout" channel="inline" format="text/plain" model="compass"/>
        <property name="cell" channel="inline" format="text/plain" model="centre"/>
        <property name="position" channel="inline" format="number/integer" model="0,0,0"/>
        <property name="size" channel="inline" format="number/integer" model="780,500,1"/>
    </part>
-->
    <part name="status_bar" channel="file" format="text/cybol" model="ui_control/gui/main_window/status_bar.cybol">
        <property name="layout" channel="inline" format="text/plain" model="compass"/>
        <property name="cell" channel="inline" format="text/plain" model="south"/>
        <property name="position" channel="inline" format="number/integer" model="0,20,0"/>
        <property name="size" channel="inline" format="number/integer" model="780,20,1"/>
    </part>
<!--
    <part name="resizable_flag" channel="inline" format="logicvalue/boolean" model="false"/>
-->
</model>

