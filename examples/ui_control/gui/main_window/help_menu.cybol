<model>
    <part name="about_ui_control_item" channel="inline" type="text/plain" model="About Revue">
        <property name="layout" channel="inline" type="text/plain" model="compass"/>
        <property name="cell" channel="inline" type="text/plain" model="north"/>
        <property name="position" channel="inline" type="number/integer" model="0,0,0"/>
        <property name="size" channel="inline" type="number/integer" model="0,0,0"/>
        <property name="mouse_over_action" channel="inline" type="text/plain" model="select"/>
        <property name="mouse_click_action" channel="inline" type="text/plain" model=".ui_control.logic.show_about_dialogue"/>
    </part>
    <part name="about_resmedicinae_item" channel="inline" type="text/plain" model="About Res Medicinae">
        <property name="layout" channel="inline" type="text/plain" model="compass"/>
        <property name="cell" channel="inline" type="text/plain" model="north"/>
        <property name="position" channel="inline" type="number/integer" model="0,0,0"/>
        <property name="size" channel="inline" type="number/integer" model="0,0,0"/>
        <property name="mouse_over_action" channel="inline" type="text/plain" model="select"/>
        <property name="mouse_click_action" channel="inline" type="text/plain" model=".ui_control.logic.show_about_dialogue"/>
    </part>
</model>

