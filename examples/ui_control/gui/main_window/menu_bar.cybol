<model>
    <part name="module_menu" channel="inline" format="text/plain" model="Module">
        <property name="layout" channel="inline" format="text/plain" model="compass"/>
        <property name="cell" channel="inline" format="text/plain" model="west"/>
        <property name="position" channel="inline" format="number/integer" model="0,0,0"/>
        <property name="size" channel="inline" format="number/integer" model="100,20,1"/>
        <property name="left_release" channel="inline" format="path/knowledge" model=".ui_control.logic.exit_programme"/>
    </part>
<!--
    <part name="view_menu" channel="inline" format="text/plain" model="View">
        <property name="layout" channel="inline" format="text/plain" model="compass"/>
        <property name="cell" channel="inline" format="text/plain" model="east"/>
        <property name="position" channel="inline" format="number/integer" model="0,0,0"/>
        <property name="size" channel="inline" format="number/integer" model="0,0,0"/>
    </part>
-->
    <part name="help_menu" channel="inline" format="text/plain" model="Help">
        <property name="layout" channel="inline" format="text/plain" model="compass"/>
        <property name="cell" channel="inline" format="text/plain" model="east"/>
        <property name="position" channel="inline" format="number/integer" model="200,0,0"/>
        <property name="size" channel="inline" format="number/integer" model="100,20,1"/>
    </part>
</model>

