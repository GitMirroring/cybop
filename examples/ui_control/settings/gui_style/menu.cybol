<model>
    <part name="width" channel="inline" format="number/integer" model="50"/>
    <part name="height" channel="inline" format="number/integer" model="20"/>
    <part name="left_border" channel="inline" format="text/plain" model="">
        <property name="colour" channel="inline" format="number/integer" model="0,0"/>
        <property name="colour_style" channel="inline" format="colour/rgb" model="rgb"/>
    </part>
</model>

