<model>
    <part name="title" channel="inline" format="text/plain" model="CYBOI Example -- Text User Interface (TUI) Application">
        <property name="super" channel="inline" format="path/knowledge" model=".ui_control.settings.tui.menu_header"/>
        <property name="position" channel="inline" format="number/integer" model="10,0"/>
        <property name="size" channel="inline" format="number/integer" model="58,1"/>
    </part>
</model>

