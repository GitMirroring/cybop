<model>
    <part name="select_current_part" channel="file" format="element/part" model="ui_control/logic/user_interface/select_current_part.cybol"/>
    <part name="select_previous_part" channel="file" format="element/part" model="ui_control/logic/user_interface/select_previous_part.cybol"/>
    <part name="select_next_part" channel="file" format="element/part" model="ui_control/logic/user_interface/select_next_part.cybol"/>
    <part name="enter" channel="file" format="element/part" model="ui_control/logic/user_interface/enter.cybol"/>
    <part name="show_about_information" channel="file" format="element/part" model="ui_control/logic/user_interface/show_about_information.cybol"/>
    <part name="hide_about_information" channel="file" format="element/part" model="ui_control/logic/user_interface/hide_about_information.cybol"/>
    <part name="refresh_gui" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="x-window-system"/>
        <property name="message" channel="inline" format="path/knowledge" model=".ui_control.gui.main_window"/>
    </part>
</model>

