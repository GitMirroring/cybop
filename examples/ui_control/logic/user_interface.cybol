<model>
    <part name="select_current_part" channel="file" encoding="utf-8" format="text/cybol" model="ui_control/logic/user_interface/select_current_part.cybol"/>
    <part name="select_previous_part" channel="file" encoding="utf-8" format="text/cybol" model="ui_control/logic/user_interface/select_previous_part.cybol"/>
    <part name="select_next_part" channel="file" encoding="utf-8" format="text/cybol" model="ui_control/logic/user_interface/select_next_part.cybol"/>
    <part name="enter" channel="file" encoding="utf-8" format="text/cybol" model="ui_control/logic/user_interface/enter.cybol"/>
    <part name="show_about_information" channel="file" encoding="utf-8" format="text/cybol" model="ui_control/logic/user_interface/show_about_information.cybol"/>
    <part name="hide_about_information" channel="file" encoding="utf-8" format="text/cybol" model="ui_control/logic/user_interface/hide_about_information.cybol"/>
    <part name="refresh_gui" channel="inline" encoding="utf-8" format="operation/plain" model="send">
        <property name="channel" channel="inline" encoding="utf-8" format="text/plain" model="x-window-system"/>
        <property name="receiver" channel="inline" encoding="utf-8" format="text/plain" model="user"/>
        <property name="message" channel="inline" encoding="utf-8" format="path/knowledge" model=".ui_control.gui.main_window"/>
    </part>
</model>

