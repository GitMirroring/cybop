<model>
    <part name="receive" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="gnu-linux-console"/>
        <property name="model" channel="inline" type="path/knowledge" model=".ui_control.logic.handler.gnu_linux_console_command"/>
    </part>
    <part name="assemble_command_model" channel="inline" type="operation/plain" model="add">
        <property name="summand_1" channel="inline" type="text/plain" model=".ui_control.logic.user_interface.about_dialogue_actions."/>
        <property name="summand_2" channel="inline" type="path/knowledge" model=".ui_control.logic.handler.gnu_linux_console_command"/>
        <property name="sum" channel="inline" type="path/knowledge" model=".ui_control.logic.handler.gnu_linux_console_command_model"/>
        <property name="abstraction" channel="inline" type="text/plain" model="wide_character"/>
    </part>
    <part name="send" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="signal"/>
        <property name="message" channel="inline" type="path/encapsulated" model=".ui_control.logic.handler.gnu_linux_console_command_model"/>
    </part>
</model>

