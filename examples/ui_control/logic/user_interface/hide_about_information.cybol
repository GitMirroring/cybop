<model>
    <part name="send" channel="inline" encoding="utf-8" type="operation/plain" model="send">
        <property name="channel" channel="inline" encoding="utf-8" type="text/plain" model="gnu-linux-console"/>
        <property name="message" channel="inline" encoding="utf-8" type="path/knowledge" model=".ui_control.tui.main_window"/>
        <property name="clean" channel="inline" encoding="utf-8" type="logicvalue/boolean" model="true"/>
    </part>
    <part name="sense" channel="inline" encoding="utf-8" type="operation/plain" model="sense">
<!--
        <property name="channel" channel="inline" encoding="utf-8" type="path/knowledge" model=".ui_control.settings.user_interface"/>
-->
