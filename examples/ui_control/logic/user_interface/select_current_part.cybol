<model>
    <part name="assemble_current_element_background_1" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".ui_control.temporary.character"/>
        <property name="source" channel="inline" format="path/knowledge" model=".ui_control.tui.main_window.menu#focus"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="assemble_current_element_background_2" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".ui_control.temporary.character"/>
        <property name="source" channel="inline" format="text/plain" model="#background"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="focus_background" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".ui_control.temporary.character"/>
        <property name="source" channel="inline" format="path/knowledge" model=".ui_control.settings.tui.selection.background"/>
        <property name="type" channel="inline" format="meta/type" model="colour/terminal"/>
    </part>
    <part name="assemble_current_element_foreground_1" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".ui_control.temporary.character"/>
        <property name="source" channel="inline" format="path/knowledge" model=".ui_control.tui.main_window.menu#focus"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="assemble_current_element_foreground_2" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".ui_control.temporary.character"/>
        <property name="source" channel="inline" format="text/plain" model="#foreground"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="focus_foreground" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/reference" model=".ui_control.temporary.character"/>
        <property name="source" channel="inline" format="path/knowledge" model=".ui_control.settings.tui.selection.foreground"/>
        <property name="type" channel="inline" format="meta/type" model="colour/terminal"/>
    </part>
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".ui_control"/>
        <property name="receiver" channel="inline" format="text/plain" model="TEST_UI_CONTROL.txt"/>
    </part>
    <part name="send_tui" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/ansi-escape-code"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".ui_control.tui.main_window"/>
        <property name="area" channel="inline" format="text/plain" model=".main_window.menu"/>
    </part>
</model>

