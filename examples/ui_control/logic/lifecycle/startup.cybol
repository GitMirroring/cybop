<model>
    <part name="create_ui_control" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="ui_control"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
    </part>
    <part name="create_temporary" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="temporary"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control"/>
    </part>
    <part name="create_character" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="character"/>
        <property name="abstraction" channel="inline" type="text/plain" model="wide_character"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control.temporary"/>
    </part>
    <part name="create_integer" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="integer"/>
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control.temporary"/>
    </part>
    <part name="create_application_information" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="application_information"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control"/>
    </part>
    <part name="receive_application_information" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="ui_control/application_information.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".ui_control.application_information"/>
    </part>
    <part name="create_settings" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="settings"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control"/>
    </part>
    <part name="receive_settings" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="ui_control/settings.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".ui_control.settings"/>
    </part>
    <part name="create_tui" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="tui"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control"/>
    </part>
    <part name="receive_tui" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="ui_control/tui.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".ui_control.tui"/>
    </part>
    <part name="create_gui" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="gui"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control"/>
    </part>
    <part name="receive_gui" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="ui_control/gui.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".ui_control.gui"/>
    </part>
    <part name="create_logic" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="logic"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control"/>
    </part>
    <part name="receive_logic" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="ui_control/logic.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".ui_control.logic"/>
    </part>
    <part name="create_tui_main_window_actions" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="main_window_actions"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control.logic.user_interface"/>
    </part>
    <part name="receive_tui_main_window_actions" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="ui_control/tui/main_window/actions.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".ui_control.logic.user_interface.main_window_actions"/>
    </part>
    <part name="create_tui_about_dialogue_actions" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="about_dialogue_actions"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control.logic.user_interface"/>
    </part>
    <part name="receive_tui_about_dialogue_actions" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="ui_control/tui/about_dialogue/actions.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".ui_control.logic.user_interface.about_dialogue_actions"/>
    </part>
<!--
    <part name="create_gui_main_window_actions" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="gui_main_window_actions"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".ui_control.logic.user_interface"/>
    </part>
    <part name="receive_gui_main_window_actions" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="ui_control/gui/main_window/actions.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".ui_control.logic.user_interface.gui_main_window_actions"/>
    </part>
-->
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/model-diagram"/>
        <property name="message" channel="inline" type="path/knowledge" model=".ui_control"/>
        <property name="receiver" channel="inline" type="text/plain" model="TEST_UI_CONTROL.txt"/>
    </part>
    <part name="startup_tui" channel="inline" type="operation/plain" model="startup">
        <property name="service" channel="inline" type="text/plain" model="gnu-linux-console"/>
    </part>
    <part name="startup_gui" channel="inline" type="operation/plain" model="startup">
        <property name="service" channel="inline" type="text/plain" model="x-window-system"/>
    </part>
    <part name="select_current_menu_item" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="signal"/>
        <property name="message" channel="inline" type="path/knowledge" model=".ui_control.logic.user_interface.select_current_part"/>
    </part>
    <part name="send_tui" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="gnu-linux-console"/>
        <property name="message" channel="inline" type="path/knowledge" model=".ui_control.tui.main_window"/>
        <property name="clean" channel="inline" type="logicvalue/boolean" model="true"/>
    </part>
<!--
    <part name="send_gui" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="x-window-system"/>
        <property name="receiver" channel="inline" type="text/plain" model="user"/>
        <property name="message" channel="inline" type="path/knowledge" model=".ui_control.gui.main_window"/>
    </part>
-->
    <part name="sense_tui_commands" channel="inline" type="operation/plain" model="sense">
        <property name="channel" channel="inline" type="text/plain" model="gnu-linux-console"/>
        <property name="handler" channel="inline" type="path/knowledge" model=".ui_control.logic.handler.handle_gnu_linux_console"/>
    </part>
<!--
    <part name="sense_gui_commands" channel="inline" type="operation/plain" model="sense">
        <property name="channel" channel="inline" type="text/plain" model="x-window-system"/>
        <property name="root" channel="inline" type="path/knowledge" model=".ui_control.gui"/>
        <property name="commands" channel="inline" type="path/knowledge" model=".ui_control.logic.user_interface.gui_main_window_actions"/>
        <property name="blocking" channel="inline" type="logicvalue/boolean" model="false"/>
    </part>
-->
</model>

