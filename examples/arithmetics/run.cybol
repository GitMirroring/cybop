<node>

    <node name="create_result" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="result"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <!-- CAUTION! This initialisation IS NECESSARY since otherwise, the result number would be empty (not zero, just plain empty without space in the array). -->
    <node name="initialise_result" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="inline"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="sender" channel="inline" format="text/plain" model="0"/>
        <node name="message" channel="inline" format="path/knowledge" model=".result"/>
    </node>
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <node name="init_add" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".result"/>
        <node name="source" channel="inline" format="number/integer" model="5"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="test_add" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".result"/>
        <node name="operand" channel="inline" format="number/integer" model="2"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="print_add" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="path/knowledge" model=".result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="init_subtract" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".result"/>
        <node name="source" channel="inline" format="number/integer" model="5"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="test_subtract" channel="inline" format="calculate/subtract" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".result"/>
        <node name="operand" channel="inline" format="number/integer" model="2"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="print_subtract" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="path/knowledge" model=".result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="init_multiply" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".result"/>
        <node name="source" channel="inline" format="number/integer" model="5"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="test_multiply" channel="inline" format="calculate/multiply" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".result"/>
        <node name="operand" channel="inline" format="number/integer" model="2"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="print_multiply" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="path/knowledge" model=".result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="init_divide" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".result"/>
        <node name="source" channel="inline" format="number/integer" model="5"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="test_divide" channel="inline" format="calculate/divide" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".result"/>
        <node name="operand" channel="inline" format="number/integer" model="2"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="print_divide" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="path/knowledge" model=".result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="init_modulo" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".result"/>
        <node name="source" channel="inline" format="number/integer" model="5"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="test_modulo" channel="inline" format="calculate/modulo" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".result"/>
        <node name="operand" channel="inline" format="number/integer" model="2"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="print_modulo" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="path/knowledge" model=".result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="test_negate" channel="inline" format="calculate/negate" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".result"/>
        <node name="operand" channel="inline" format="number/integer" model="2"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="print_negate" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="path/knowledge" model=".result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="test_absolute" channel="inline" format="calculate/absolute" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".result"/>
        <node name="operand" channel="inline" format="number/integer" model="-2"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="print_absolute" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="path/knowledge" model=".result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example applies a number of arithmetic operations.
-->

