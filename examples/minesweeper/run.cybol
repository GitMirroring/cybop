<node>

    <node name="create_app" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="app"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
         
    </node>
    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="minesweeper/app.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app"/>
    </node>



    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <!--<node name="send_terminal" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.tui.window"/>
        <node name="area" channel="inline" format="text/cybol-path" model=".app.tui.menu"/>
        <node name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>-->
    <node name="focus_current_menu_item" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.focus"/>
    </node>
    <node name="sense_commands" channel="inline" format="activate/enable" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="handler" channel="inline" format="text/cybol-path" model=".app.logic.handler.handle_main"/>
    </node>
<!--   TODO: AUSLAGERN in startup.cybol   -->
    <node name="init_focus" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.display_focus"/>
    </node>
    <node name="set_cursor" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.tui.cursor"/>
    </node>
    <node name="set_game_over" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.game_over"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="generate_mines" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".app.break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.randomizer"/>
    </node>

    <!--<node name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app"/>
        <node name="receiver" channel="inline" format="text/plain" model="test_minesweeper.txt"/>
    </node>-->

    <!--<node name="send_tui" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.tui.window"/>
        <node name="area" channel="inline" format="text/cybol-path" model=".app.tui.menu"/>
        <node name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>-->
    <node name="send_tui" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model="*.app.game_over"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.send_game_over_tui"/>
        <node name="false" channel="inline" format="text/cybol-path" model=".app.send_tui"/>
    </node>

</node>
