<node>
    <!--<node name="mark_field" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/reference" model=".app.focused_field_text"/>
        <node name="source" channel="inline" format="text/plain" model="xx"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>-->
    
    <node name="set_mine" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/reference" model=".app.field"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>
    
    <node name="increment_loop" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".app.count"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    
    <node name="compare_loop_count" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".app.break"/>
        <node name="left" channel="inline" format="path/knowledge" model=".app.count"/>
        <node name="right" channel="inline" format="number/integer" model="9"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>
</node>