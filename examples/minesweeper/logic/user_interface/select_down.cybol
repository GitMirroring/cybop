<node>

    <node name="set_navigation_destination" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.temporary.navigation"/>
        <node name="source" channel="inline" format="text/plain" model=":down"/>
    </node>

    <node name="update_focus" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.update_focus"/>
    </node>

</node>
