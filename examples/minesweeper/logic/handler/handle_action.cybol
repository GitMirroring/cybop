<node>

    <node name="copy_focused_part_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.temporary.action"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.tui.window.menu#focus"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    
    
    <node name="copy_action_property_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.temporary.action"/>
        <node name="source" channel="inline" format="text/plain" model="#action"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="get_action_reference" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.temporary.action"/>
        <node name="source" channel="inline" format="path/reference" model=".app.temporary.action"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <!--
        CAUTION! Do NOT use the "communicate/send" operation with "signal" channel here.
        Otherwise, another signal might be executed before, so that this signal could possibly
        not find all resources anymore, if they meanwhile have been manipulated by the other signal.
        The "flow/sequence" operation ensures that the given model is executed directly.
    -->
    <node name="execute_action" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/reference" model=".app.temporary.action"/>
    </node>
    
    <!--<node name="send_tui" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app.tui.window"/>
        <node name="area" channel="inline" format="path/knowledge" model=".app.tui.menu"/>
        <node name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>-->
    <node name="compare" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="path/knowledge" model=".app.game_over"/>
        <node name="true" channel="inline" format="path/knowledge" model=".app.send_game_over_tui"/>
        <node name="false" channel="inline" format="path/knowledge" model=".app.send_tui"/>
    </node> 

</node>
