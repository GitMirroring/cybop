<node>
    <node name="reset_mine_count" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.mine_count"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="reset_bool" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.bool"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>

    <!--   up   -->
    <node name="add_mine_if_present" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.tui.window.menu.7_8:mine"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.logic.functionality.add_mine"/>
    </node>

    <node name="reset_bool" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.bool"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>

    <!--   left   -->
    <node name="add_mine_if_present" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.tui.window.menu.8_7:mine"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.logic.functionality.add_mine"/>
    </node>

    <node name="reset_bool" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.bool"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>

    <!--   up/left   -->
    <node name="add_mine_if_present" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.tui.window.menu.7_7:mine"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.logic.functionality.add_mine"/>
    </node>
    <node name="reset_bool" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.bool"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>

    <!--   print number on selected field   -->
    <node name="are_mines_nearby" channel="inline" format="compare/unequal" model="">
        <node name="left" channel="inline" format="text/cybol-path" model=".app.mine_count"/>
        <node name="right" channel="inline" format="number/integer" model="0"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="result" channel="inline" format="text/cybol-path" model=".app.bool"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

    <node name="print_if_close_mines" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.bool"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.logic.functionality.print_minecount"/>
    </node>
</node>
