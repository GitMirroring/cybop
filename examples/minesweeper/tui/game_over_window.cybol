<node>
    <node name="menu" channel="file" format="element/part" model="minesweeper/tui/menu.cybol">
        <node name="position" channel="inline" format="number/integer" model="1,1"/>
        <node name="size" channel="inline" format="number/integer" model="55,37"/>
        <node name="background" channel="inline" format="colour/terminal" model="green"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="blue"/>
        <node name="bold" channel="inline" format="logicvalue/boolean" model="false"/>
        <!-- This property is evaluated by win32 console only. -->
        <node name="intense" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="border" channel="inline" format="text/plain" model="ascii"/>
        <node name="focus" channel="inline" format="text/plain" model=".app.tui.window.menu.0_0"/>
    </node>
    <node name="about" channel="file" format="element/part" model="minesweeper/tui/about.cybol">
        <node name="position" channel="inline" format="number/integer" model="57,1"/>
        <node name="size" channel="inline" format="number/integer" model="60,37"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="green"/>
        <node name="bold" channel="inline" format="logicvalue/boolean" model="false"/>
        
        <node name="intense" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="border" channel="inline" format="text/plain" model="ascii"/>
    </node>
    <node name="additional_info" channel="file" format="element/part" model="minesweeper/tui/info.cybol">
        <node name="position" channel="inline" format="number/integer" model="14,22"/>
        <node name="size" channel="inline" format="number/integer" model="29,3"/>
        <node name="background" channel="inline" format="colour/terminal" model="red"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="white"/>
        <node name="bold" channel="inline" format="logicvalue/boolean" model="false"/>
        
        <node name="intense" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="border" channel="inline" format="text/plain" model="ascii"/>
    </node>
    <node name="game_over" channel="file" format="element/part" model="minesweeper/tui/game_over.cybol">
        <node name="position" channel="inline" format="number/integer" model="20,18"/>
        <node name="size" channel="inline" format="number/integer" model="17,5"/>
        <node name="background" channel="inline" format="colour/terminal" model="red"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="white"/>
        <node name="bold" channel="inline" format="logicvalue/boolean" model="false"/>
        
        <node name="intense" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="border" channel="inline" format="text/plain" model="ascii"/>
    </node>
</node>