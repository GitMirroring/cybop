<model>

    <part name="print_accept" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="text/plain" model="Accepted server response at socket:"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="print_socket" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.var.client_socket"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

    <!-- CAUTION! If the response was not reset here, then the last valid previous response would be used again and again, neverendingly. -->
    <part name="reset_response" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".app.var.response"/>
    </part>
    <part name="receive_response" channel="inline" format="communicate/receive" model="">
        <property name="sender" channel="inline" format="path/knowledge" model=".app.var.client_socket"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.var.response"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="channel" channel="inline" format="meta/channel" model="socket"/>
    </part>
    <part name="print_response" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.var.response"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

    <part name="exit_programme" channel="inline" format="live/exit" model=""/>

</model>
