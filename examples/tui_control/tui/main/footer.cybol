<model>
    <part name="url" channel="inline" format="text/plain" model="http://www.cybop.org/">
        <property name="super" channel="inline" format="path/knowledge" model=".app.settings.menu_footer"/>
        <property name="position" channel="inline" format="number/integer" model="25,0"/>
        <property name="size" channel="inline" format="number/integer" model="24,1"/>
    </part>
</model>
