<node>
    <node name="arrow-down" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.select_next"/>
    <node name="arrow-up" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.select_previous"/>
    <node name="arrow-right" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.select_next"/>
    <node name="arrow-left" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.select_previous"/>
    <node name="enter" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.enter"/>
    <node name="escape" channel="inline" format="text/cybol-path" model=".app.logic.lifecycle.shutdown"/>
    <node name="m" channel="inline" format="text/cybol-path" model=".app.logic.functionality.start_mc"/>
    <node name="d" channel="inline" format="text/cybol-path" model=".app.logic.functionality.start_dosemu"/>
    <node name="x" channel="inline" format="text/cybol-path" model=".app.logic.functionality.show_x_window"/>
    <node name="a" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.show_about"/>
    <node name="e" channel="inline" format="text/cybol-path" model=".app.logic.lifecycle.shutdown"/>
</node>
