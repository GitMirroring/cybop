<model>
    <!--?? TODO:
        Delete the "background", "foreground" and "bold" properties later, since they are already part of the standard setting!
        But as long as CYBOI does not handle super templates at creation time, they must be added explicitly here.
    -->
    <part name="title" channel="inline" format="text/plain" model="Menu">
        <property name="super" channel="inline" format="path/knowledge" model=".tui_control.settings.tui.menu_title"/>
        <property name="position" channel="inline" format="number/integer" model="30,1"/>
        <property name="size" channel="inline" format="number/integer" model="4,1"/>
    </part>
    <part name="mc" channel="inline" format="text/plain" model="m - Start Midnight Commander (MC)">
        <property name="super" channel="inline" format="path/knowledge" model=".tui_control.settings.tui.menu_item"/>
        <property name="position" channel="inline" format="number/integer" model="1,3"/>
        <property name="size" channel="inline" format="number/integer" model="68,1"/>
        <property name="previous" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.exit"/>
        <property name="next" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.dosemu"/>
        <property name="button_press_action" channel="inline" format="text/plain" model=".tui_control.logic.functionality.start_mc"/>
        <property name="background" channel="inline" format="colour/terminal" model="blue"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="white"/>
        <property name="bold" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="dosemu" channel="inline" format="text/plain" model="d - Start DOS Emulator (DOSemu)">
        <property name="super" channel="inline" format="path/knowledge" model=".tui_control.settings.tui.menu_item"/>
        <property name="position" channel="inline" format="number/integer" model="1,4"/>
        <property name="size" channel="inline" format="number/integer" model="68,1"/>
        <property name="previous" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.mc"/>
        <property name="next" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.x_window"/>
        <property name="button_press_action" channel="inline" format="text/plain" model=".tui_control.logic.functionality.start_dosemu"/>
        <property name="background" channel="inline" format="colour/terminal" model="blue"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="white"/>
        <property name="bold" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="x_window" channel="inline" format="text/plain" model="x - Open an X Window">
        <property name="super" channel="inline" format="path/knowledge" model=".tui_control.settings.tui.menu_item"/>
        <property name="position" channel="inline" format="number/integer" model="1,5"/>
        <property name="size" channel="inline" format="number/integer" model="60,1"/>
        <property name="previous" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.dosemu"/>
        <property name="next" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.about"/>
        <property name="button_press_action" channel="inline" format="text/plain" model=".tui_control.logic.functionality.show_x_window"/>
        <property name="background" channel="inline" format="colour/terminal" model="blue"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="white"/>
        <property name="bold" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="about" channel="inline" format="text/plain" model="a - Show About Information">
        <property name="super" channel="inline" format="path/knowledge" model=".tui_control.settings.tui.menu_item"/>
        <property name="position" channel="inline" format="number/integer" model="1,7"/>
        <property name="size" channel="inline" format="number/integer" model="60,1"/>
        <property name="previous" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.x_window"/>
        <property name="next" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.exit"/>
        <property name="button_press_action" channel="inline" format="text/plain" model=".tui_control.logic.user_interface.show_about_information"/>
        <property name="background" channel="inline" format="colour/terminal" model="blue"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="white"/>
        <property name="bold" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="exit" channel="inline" format="text/plain" model="e - Exit Programme">
        <property name="super" channel="inline" format="path/knowledge" model=".tui_control.settings.tui.menu_item"/>
        <property name="position" channel="inline" format="number/integer" model="1,8"/>
        <property name="size" channel="inline" format="number/integer" model="60,1"/>
        <property name="previous" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.about"/>
        <property name="next" channel="inline" format="text/plain" model=".tui_control.tui.main_window.menu.mc"/>
        <property name="button_press_action" channel="inline" format="text/plain" model=".tui_control.logic.lifecycle.exit_programme"/>
        <property name="background" channel="inline" format="colour/terminal" model="blue"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="white"/>
        <property name="bold" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
</model>

