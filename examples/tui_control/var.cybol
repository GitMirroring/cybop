<node>

    <!--
        CAUTION! The format is "text/cybol-path" and NOT "text/plain".
        Otherwise, parts with a reference path pointing to here
        will not get processed correctly.
        A cybol-path is treated like a character array anyway.
    -->
    <node name="character" channel="inline" format="text/cybol-path" model=""/>

    <node name="integer" channel="inline" format="number/integer" model=""/>

    <!--
        CAUTION! The format is "text/cybol-path" and NOT "text/plain".
        Otherwise, parts with a reference path pointing to here
        will not get processed correctly.
        A cybol-path is treated like a character array anyway.
    -->
    <node name="path" channel="inline" format="text/cybol-path" model=""/>

    <node name="navigation" channel="inline" format="text/plain" model=""/>

</node>
