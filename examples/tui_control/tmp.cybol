<node>
    <node name="character" channel="inline" format="text/plain" model=""/>
    <node name="integer" channel="inline" format="number/integer" model=""/>
    <node name="command" channel="inline" format="text/plain" model=""/>
    <!--
        CAUTION! The path format is "path/knowledge" and NOT "text/plain".
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handler.cybol" file.
    -->
    <node name="path" channel="inline" format="path/knowledge" model=""/>
    <node name="navigation" channel="inline" format="text/plain" model=""/>
</node>
