<node>

    <node name="unfocus_part" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/knowledge" model=".app.logic.user_interface.unfocus"/>
    </node>

    <node name="assemble_next_element_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.tui.main.menu:focus"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.tmp.navigation"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <!-- Use element name assembled before to get the real element that the name points to. -->
    <node name="determine_real_element_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.tui.main.menu:focus"/>
        <node name="source" channel="inline" format="path/knowledge" model="*.app.tui.main.menu:focus"/>
<!--
        <node name="source" channel="inline" format="path/reference" model=".app.tui.main.menu:focus"/>
-->
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <node name="focus_part" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/knowledge" model=".app.logic.user_interface.focus"/>
    </node>

    <node name="send_tui" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app.tui.main"/>
        <node name="area" channel="inline" format="path/knowledge" model=".app.tui.main.menu"/>
        <node name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

</node>
