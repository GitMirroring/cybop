<node>
    <node name="get_command_of_current_element_1" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.tmp.character"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.tui.main.menu:focus"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="get_command_of_current_element_2" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.tmp.character"/>
        <node name="source" channel="inline" format="text/plain" model=":button_press_action"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="determine_real_command" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.tmp.character"/>
        <node name="source" channel="inline" format="path/knowledge" model="*.app.tmp.character"/>
<!--
        <node name="source" channel="inline" format="path/reference" model=".app.tmp.character"/>
-->
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="send_command" channel="inline" format="flow/sequence" model="">
        <!-- CAUTION! The format is "path/reference" and NOT "path/knowledge". -->
        <node name="model" channel="inline" format="path/knowledge" model="*.app.tmp.character"/>
<!--
        <node name="model" channel="inline" format="path/reference" model=".app.tmp.character"/>
-->
    </node>
</node>
