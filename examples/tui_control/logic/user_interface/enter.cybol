<model>
    <part name="get_command_of_current_element_1" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".tui_control.temporary.character"/>
        <property name="source" channel="inline" format="path/knowledge" model=".tui_control.tui.main_window.menu#focus"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="get_command_of_current_element_2" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".tui_control.temporary.character"/>
        <property name="source" channel="inline" format="text/plain" model="#button_press_action"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="determine_real_command" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".tui_control.temporary.character"/>
        <property name="source" channel="inline" format="path/reference" model=".tui_control.temporary.character"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="send_command" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="signal"/>
        <property name="message" channel="inline" format="path/reference" model=".tui_control.temporary.character"/>
    </part>
</model>

