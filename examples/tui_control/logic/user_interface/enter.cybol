<node>

    <node name="get_command_of_current_element_1" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".tmp.character"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".tui.main.menu:focus"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="get_command_of_current_element_2" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".tmp.character"/>
        <node name="source" channel="inline" format="text/plain" model=":button_press_action"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <node name="send_command" channel="inline" format="flow/sequence" model="">
        <!-- CAUTION! The path is a REFERENCE. -->
        <node name="model" channel="inline" format="text/cybol-path" model="**.tmp.character"/>
    </node>

</node>
