<model>
    <part name="set_navigation_destination" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.tmp.navigation"/>
        <property name="source" channel="inline" format="text/plain" model="#next"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="focus_part" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.user_interface.focus_part"/>
    </part>
</model>
