<node>

    <node name="assemble_current_element_background_1" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tmp.character"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.tui.main.menu:focus"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="assemble_current_element_background_2" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tmp.character"/>
        <node name="source" channel="inline" format="text/plain" model=":background"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="focus_background" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="*.app.tmp.character"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.settings.selection.background"/>
        <node name="type" channel="inline" format="meta/type" model="colour/terminal"/>
    </node>

    <node name="assemble_current_element_foreground_1" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tmp.character"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.tui.main.menu:focus"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="assemble_current_element_foreground_2" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tmp.character"/>
        <node name="source" channel="inline" format="text/plain" model=":foreground"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="focus_foreground" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="*.app.tmp.character"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.settings.selection.foreground"/>
        <node name="type" channel="inline" format="meta/type" model="colour/terminal"/>
    </node>

</node>
