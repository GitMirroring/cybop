<model>
    <part name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </part>
    <part name="focus_current_menu_item" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.user_interface.focus"/>
    </part>
    <!--
        CAUTION! Sending the tui to the terminal is NOT necessary here,
        since that refresh is already done within "focus_current_menu_item" above!
    -->
    <part name="sense_terminal" channel="inline" format="live/sense" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="handler" channel="inline" format="path/knowledge" model=".app.logic.handler.handle_main"/>
    </part>
</model>
