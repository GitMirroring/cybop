<model>
    <part name="start_mc" channel="inline" format="run/run" model="">
        <property name="programme" channel="inline" format="text/plain" model="mc"/>
    </part>
    <part name="start_dosemu" channel="inline" format="run/run" model="">
        <property name="programme" channel="inline" format="text/plain" model="xdosemu"/>
<!--
        <property name="programme" channel="inline" format="text/plain" model="dosemu.bin -E 'call c:\a\apwxms.exe christian\' -X"/>
-->
    </part>
    <part name="show_x_window" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="display"/>
        <property name="language" channel="inline" format="meta/language" model="message/gui"/>
    </part>
</model>
