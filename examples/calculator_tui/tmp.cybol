<node>

    <node name="character" channel="inline" format="text/plain" model=""/>
    <node name="integer" channel="inline" format="number/integer" model=""/>

    <node name="command" channel="inline" format="text/plain" model=""/>
    <node name="action" channel="inline" format="text/plain" model=""/>
    <!--
        CAUTION! The path format is "text/cybol-path" and NOT "text/plain".
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handler.cybol" file.
    -->
    <node name="path" channel="inline" format="text/cybol-path" model=""/>

    <node name="navigation" channel="inline" format="text/plain" model=""/>

    <!--
        CAUTION! The result MUST NOT be empty since otherwise,
        the calculation cannot happen due to unequal dimensions of operands.
        The result has to have exactly one integer number.
    -->
    <node name="result" channel="inline" format="number/integer" model="0"/>
    <node name="operand" channel="inline" format="number/integer" model=""/>

    <!--
        CAUTION! The path format is "text/cybol-path" and NOT "text/plain".
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handler.cybol" file.
    -->
    <node name="operation" channel="inline" format="text/cybol-path" model=".app.logic.functionality.calculate.add"/>

</node>
