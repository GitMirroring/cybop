//Test auf draw, wenn nicht -> computerturn
    <part name="if-then-else" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="path/knowledge" model=".temporary.wingame"/>
        <property name="true" channel="inline" format="path/knowledge" model=".computerturn"/>
        <property name="false" channel="inline" format="path/knowledge" model=".draw"/> 
    </part>
  

</model>

