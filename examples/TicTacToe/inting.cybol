    <part name="reset_field_7" channel="inline" format="modify/overwrite" model="">
	<property name="destination" channel="inline" format="path/knowledge" model=".temporary.field_7"/>
	<property name="source" channel="inline" format="text/plain" model="_"/>
	<property name="type" channel="inline" format="meta/type" model="text/plain"/>
