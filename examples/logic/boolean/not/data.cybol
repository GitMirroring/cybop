<model>
    <part name="result" channel="inline" format="logicvalue/boolean" model="true"/>
    <part name="operation" channel="inline" format="logify/not" model="">
        <property name="output" channel="inline" format="path/knowledge" model=".app.result"/>
        <property name="input" channel="inline" format="path/knowledge" model=".app.result"/>
	<property name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </part>
</model>
