<node>
    <node name="result" channel="inline" format="number/integer" model="13"/>
    <node name="operand" channel="inline" format="number/integer" model="7"/>
    <node name="operation" channel="inline" format="logify/and" model="">
        <node name="output" channel="inline" format="text/cybol-path" model=".app.result"/>
        <node name="input" channel="inline" format="text/cybol-path" model=".app.operand"/>
    <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
</node>
