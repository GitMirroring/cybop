<model>
    <part name="result" channel="inline" format="number/byte" model="25"/>
    <part name="operation" channel="inline" format="logify/neg" model="">
        <property name="output" channel="inline" format="path/knowledge" model=".app.result"/>
        <property name="input" channel="inline" format="path/knowledge" model=".app.result"/>
    <property name="type" channel="inline" format="meta/type" model="number/byte"/>
    </part>
</model>
