<node>
    <node name="result" channel="inline" format="number/byte" model="25"/>
    <node name="operand" channel="inline" format="number/byte" model="13"/>
    <node name="operation" channel="inline" format="logify/or" model="">
        <node name="output" channel="inline" format="path/knowledge" model=".app.result"/>
        <node name="input" channel="inline" format="path/knowledge" model=".app.operand"/>
    <node name="type" channel="inline" format="meta/type" model="number/byte"/>
    </node>
</node>
