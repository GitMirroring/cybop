<model>
<!--
    <part name="cli" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="text/plain" model="Hello, World!"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
-->
    <part name="tui" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/tui"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.tui.window"/>
        <property name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
<!--
    <part name="gui" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="display"/>
        <property name="language" channel="inline" format="meta/language" model="message/gui"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.gui"/>
    </part>
-->
<!--
    <part name="scene" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="display"/>
        <property name="language" channel="inline" format="meta/language" model="message/scene"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.scene"/>
    </part>
-->
    <part name="html" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/html">
            <constraint name="indentation" channel="inline" format="logicvalue/boolean" model="true"/>
        </property>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.wui.index"/>
        <property name="receiver" channel="inline" format="text/plain" model="wui.html"/>
    </part>
<!--
    <part name="http" channel="inline" format="represent/serialise" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.wui.http_response"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.wui.html">
            <constraint name="header" channel="inline" format="path/knowledge" model=".app.wui.http_metadata"/>
        </property>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="language" channel="inline" format="meta/language" model="message/http-response"/>
    </part>
    <part name="wui" channel="inline" format="operation/plain" model="send">
        <property name="channel" channel="inline" format="meta/channel" model="socket"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.wui.http_response"/>
        <property name="namespace" channel="inline" format="text/plain" model="ipv4"/>
        <property name="style" channel="inline" format="text/plain" model="stream"/>
        <property name="mode" channel="inline" format="text/plain" model="server"/>
    </part>
-->
</model>

