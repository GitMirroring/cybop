<model>
    <part name="copy" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.domain.greeting"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.cybop"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="translate" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.translate"/>
    </part>
    <part name="send" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.send"/>
    </part>
</model>

