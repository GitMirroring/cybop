<node>
    <!-- If the action was not reset here, then the last valid previous action would be executed again and again, neverendingly. -->
    <node name="reset" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.gui.action"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="receive" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <node name="language" channel="inline" format="meta/language" model="message/gui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.gui.action"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".app.gui.window"/>
    </node>
    <!--
        CAUTION! Do NOT use the "communicate/send" operation with "signal" channel here.
        Otherwise, another signal might be executed before, so that this signal could possibly
        not find all resources anymore, if they meanwhile have been manipulated by the other signal.
        The "flow/sequence" operation ensures that the given model is executed directly.
    -->
    <!-- CAUTION! The path has to be a REFERENCE here, since the action is just a string pointing to the actual model to be executed. -->
    <node name="execute" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model="*.app.gui.action"/>
    </node>
</node>
