<model>
    <part name="world" channel="inline" format="text/plain" model="Greet World">
        <property name="tag" channel="inline" format="text/plain" model="a"/>
        <property name="href" channel="inline" format="text/plain" model="http://localhost?action=greet_world"/>
    </part>
    <part name="cybop" channel="inline" format="text/plain" model="Greet CYBOP">
        <property name="tag" channel="inline" format="text/plain" model="a"/>
        <property name="href" channel="inline" format="text/plain" model="http://localhost?action=greet_cybop"/>
    </part>
</model>

