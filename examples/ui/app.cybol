<model>
    <part name="domain" channel="file" format="element/part" model="ui/domain.cybol"/>
    <part name="cli" channel="file" format="element/part" model="ui/cli.cybol"/>
    <part name="tui" channel="file" format="element/part" model="ui/tui.cybol"/>
    <part name="gui" channel="file" format="element/part" model="ui/gui.cybol"/>
    <part name="scene" channel="file" format="element/part" model="ui/scene.cybol"/>
    <part name="wui" channel="file" format="element/part" model="ui/wui.cybol"/>
    <part name="logic" channel="file" format="element/part" model="ui/logic.cybol"/>
</model>

