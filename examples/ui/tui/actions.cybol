<node>
    <node name="arrow-left" channel="inline" format="path/knowledge" model=".app.logic.greet_world"/>
    <node name="arrow-right" channel="inline" format="path/knowledge" model=".app.logic.greet_cybop"/>
    <node name="arrow-up" channel="inline" format="path/knowledge" model=".app.logic.greet_world"/>
    <node name="arrow-down" channel="inline" format="path/knowledge" model=".app.logic.greet_cybop"/>
    <node name="enter" channel="inline" format="path/knowledge" model=".app.logic.greet_world"/>
    <node name="escape" channel="inline" format="path/knowledge" model=".app.logic.exit"/>
    <node name="w" channel="inline" format="path/knowledge" model=".app.logic.greet_world"/>
    <node name="c" channel="inline" format="path/knowledge" model=".app.logic.greet_cybop"/>
    <node name="e" channel="inline" format="path/knowledge" model=".app.logic.exit"/>
</node>

