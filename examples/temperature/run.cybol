<model>
    <part name="startup_serial_port" channel="inline" format="maintain/startup" model="">
        <property name="service" channel="inline" format="meta/channel" model="serial-port"/>
        <property name="filename" channel="inline" format="text/plain" model="/dev/tty0"/>
        <property name="baudrate" channel="inline" format="number/integer" model="115200"/>
    </part>
    <part name="send_request" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="serial-port"/>
        <property name="message" channel="inline" format="text/plain" model="c01"/>
    </part>
    <part name="receive_response" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="serial-port"/>
        <property name="model" channel="inline" format="path/knowledge" model=".temperature"/>
    </part>
    <part name="shutdown_serial_port" channel="inline" format="maintain/shutdown" model="">
        <property name="service" channel="inline" format="meta/channel" model="serial-port"/>
    </part>
    <part name="exit_application" channel="inline" format="live/exit" model=""/>
</model>

