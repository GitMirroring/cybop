<node>

    <!-- boolean -->
    <node name="boolean" channel="inline" format="logicvalue/boolean" model="true"/>

    <!-- number -->
    <node name="complex" channel="inline" format="number/complex-cartesian" model="7.8,3.4"/>
    <node name="fraction" channel="inline" format="number/fraction-vulgar" model="3,4"/>
    <node name="integer" channel="inline" format="number/integer" model="56,7,1971,-8,74,-716,9,32,34,24"/>

    <!-- text -->
    <node name="ascii" channel="inline" format="application/octet-stream" model="a4v,e9-/3+*)#'123"/>
    <node name="wide" channel="inline" format="text/plain" model="w1i2d3e4%?⭝|฿Hઊ"/>

    <!-- part with model of type string | integer -->
    <node name="part" channel="file" format="element/part" model="sorter/part.cybol"/>
    <node name="integer_part" channel="file" format="element/part" model="sorter/integer_part.cybol"/>

    <!-- addressbook as part containing person parts to be sorted by a given criterion such as the family name -->
    <node name="addressbook" channel="file" format="element/part" model="sorter/addressbook.cybol"/>

    <!-- logic -->
    <node name="sort" channel="file" format="element/part" model="sorter/sort.cybol"/>
    <node name="print" channel="file" format="element/part" model="sorter/print.cybol"/>

    <!-- time -->
    <node name="before" channel="inline" format="number/integer" model="0"/>
    <node name="after" channel="inline" format="number/integer" model="0"/>
    <node name="print_time" channel="file" format="element/part" model="sorter/print_time.cybol"/>

</node>
