    </node>
    <node name="sort_fraction" channel="inline" format="sort/bubble" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".fraction"/>
    </node>
    <node name="sort_integer" channel="inline" format="sort/bubble" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".integer"/>
    </node>

    <!-- text -->

    <node name="sort_ascii" channel="inline" format="sort/bubble" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".ascii"/>
    </node>
    <node name="sort_wide" channel="inline" format="sort/bubble" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".wide"/>
    </node>

</node>
