<node>
    <node name="reset_voltage" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".settings.voltage"/>
        <node name="source" channel="inline" format="path/knowledge" model=".settings.voltage_default"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="reset_voltage_high_byte" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_high_byte"/>
        <node name="source" channel="inline" format="path/knowledge" model=".settings.voltage_high_byte_default"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="reset_voltage_low_byte" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_low_byte"/>
        <node name="source" channel="inline" format="path/knowledge" model=".settings.voltage_low_byte_default"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="reset_break" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_break"/>
        <node name="source" channel="inline" format="path/knowledge" model=".settings.voltage_break_default"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>
    <node name="reset_count" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_count"/>
        <node name="source" channel="inline" format="path/knowledge" model=".settings.voltage_count_default"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="reset_criterion" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_criterion"/>
        <node name="source" channel="inline" format="path/knowledge" model=".settings.voltage_criterion_default"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>
</node>