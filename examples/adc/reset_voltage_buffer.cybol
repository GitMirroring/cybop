<node>
    <node name="reset_buffer" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="reset_count" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_count"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_count_default"/>
    </node>
    <node name="reset_criterion" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_criterion"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_criterion_default"/>
    </node>
    <node name="reset_high_byte" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_high_byte"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_high_byte_default"/>
    </node>
    <node name="reset_low_byte" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_low_byte"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_low_byte_default"/>
    </node>
</node>
