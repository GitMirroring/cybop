<node>

    <!-- Duplicate song list. -->

    <!--
        CAUTION! Cloning it here in memory is much faster
        than receiving it a second time from some file.
    -->
    <node name="duplicate_songs" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".db.remain"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.song"/>
    </node>

    <!-- Iterate through rounds -->

    <node name="count_nodes" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model="#round_count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".db.round"/>
    </node>

    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#round_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#round_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#round_count"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

    <node name="loop_nodes" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model="#round_break"/>
        <node name="model" channel="inline" format="text/cybol-path" model="#round_model"/>
    </node>

</node>
