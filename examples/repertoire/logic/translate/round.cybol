<node>

    <node name="rounds" channel="file" format="element/part" model="repertoire/logic/translate/round/rounds.cybol">
        <node name="round_break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="round_count" channel="inline" format="number/integer" model="0"/>
        <node name="round_index" channel="inline" format="number/integer" model="0"/>
        <node name="round_model" channel="inline" format="text/cybol-path" model=".logic.translate.round.round"/>
        <node name="round_name" channel="inline" format="text/plain" model="EMPTY"/>
    </node>

    <node name="round" channel="file" format="element/part" model="repertoire/logic/translate/round/round.cybol">
        <node name="song_break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="song_count" channel="inline" format="number/integer" model="0"/>
        <node name="song_index" channel="inline" format="number/integer" model="0"/>
        <node name="song_model" channel="inline" format="text/cybol-path" model=".logic.translate.round.song"/>
        <node name="song_name" channel="inline" format="text/plain" model="EMPTY"/>
    </node>

    <node name="song" channel="file" format="element/part" model="repertoire/logic/translate/round/song.cybol"/>

</node>
