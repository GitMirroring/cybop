<node>

    <!-- Database with all details -->
    <node name="song" channel="file" format="element/part" model="repertoire/db/song.cybol"/>

    <!-- Extracts from database -->
    <node name="all" channel="inline" format="element/part" model=""/>
    <node name="artist" channel="inline" format="element/part" model=""/>
    <node name="title" channel="inline" format="element/part" model=""/>

    <!-- Document for website -->
    <node name="genre" channel="file" format="element/part" model="repertoire/db/genre.cybol"/>

    <!-- Internal document for usage by band -->
    <node name="round" channel="file" format="element/part" model="repertoire/db/round.cybol"/>

</node>
