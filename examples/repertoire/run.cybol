<node>

    <node name="initialise_application" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="repertoire/app.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
    </node>

    <!-- Write knowledge into file. -->
<!--
-->
    <node name="test_knowledge" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_repertoire.txt"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
    </node>

    <!-- TEST ONLY. DELETE LATER. -->
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <node name="startup" channel="inline" format="text/cybol-path" model=".logic.startup"/>
    <node name="shutdown" channel="inline" format="text/cybol-path" model=".logic.shutdown"/>

</node>

<!--
    Song list:
    - database of songs in form of cybol (xml) files
    - complete data with all details, as listed further below

    Generated files:
    - all.inc (complete list with all details)
    - artist.inc (sorted by artist)
    - title.inc (sorted by title)
    - genre.inc (for website)
    - round.inc (songs sorted by dance round)

    Song details:

    artist - Künstler, z. B. "ABBA"
    title - Titel, z. B. "I Have A Dream"
    genre - Musikrichtung, z. B. "1970er Disco"
    year - Erscheinungsjahr, z. B. "1978"

    time - Länge der eigenen Version in Minuten, z. B. "0:00"
    key - Tonart, z. B. "C-Dur"
    vocals - Sänger, z. B. "Kögi"
    remark - Kommentar, z. B. "Hintergrundgeschichte zum Lied"
-->
