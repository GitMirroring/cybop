<node>
    <node name="create_model" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="model"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>

    </node>
    <node name="initialise_model" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="fraction_comparison/model.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".model"/>
    </node>
    <node name="startup_terminal_service" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="test_knowledge_tree_pre" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".model"/>
        <node name="receiver" channel="inline" format="text/plain" model="test_fraction_comparison_pre.txt"/>
    </node>
    <node name="compare_operands" channel="inline" format="compare/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".model.result"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".model.left"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".model.right"/>
    </node>
    <node name="test_knowledge_tree_post" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".model"/>
        <node name="receiver" channel="inline" format="text/plain" model="test_fraction_comparison_post.txt"/>
    </node>
    <node name="print_operation" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Comparison: (3 / 2) == (6 / 4) = true (equal):"/>
    </node>
    <node name="print_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".model.result"/>
    </node>
    <node name="exit_application" channel="inline" format="live/exit" model=""/>
</node>
