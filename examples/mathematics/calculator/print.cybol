<node>

    <!-- basic operations -->

    <node name="print_result_add_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Result add:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_result_add" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result_add"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!-- minimum and maximum -->

    <node name="print_result_minimum_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Result minimum:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_result_minimum" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result_minimum"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

</node>
