<node>

    <node name="create_seed" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="seed"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
         
    </node>
    <node name="create_number" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="number"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
         
    </node>

    <node name="initialise_seed" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".seed"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>
    <node name="initialise_number" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".number"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <!--
        Operation calls using the same seed deliver identical pseudo random numbers.
        Ideally, the seed should change with every call, in C syntax e.g.: srand(time(0)).
        Therefore, the current time is determined as seed here.
    -->
    <node name="get_time" channel="inline" format="time/current" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".seed"/>
    </node>
    <!--
        By default, the current time is used as seed below:
        <node name="seed" channel="inline" format="text/cybol-path" model=".seed"/>
        Alternatively, a fixed integer number may be used as seed, e.g.:
        <node name="seed" channel="inline" format="number/integer" model="5"/>
    -->
    <node name="set_seed" channel="inline" format="randomise/sow" model="">
        <node name="seed" channel="inline" format="text/cybol-path" model=".seed"/>
    </node>

    <node name="get_random_number_1" channel="inline" format="randomise/retrieve" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".number"/>
        <node name="minimum" channel="inline" format="number/integer" model="1"/>
        <node name="maximum" channel="inline" format="number/integer" model="9"/>
    </node>
    <node name="print_random_number_1" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".number"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="get_random_number_2" channel="inline" format="randomise/retrieve" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".number"/>
        <node name="minimum" channel="inline" format="number/integer" model="30"/>
        <node name="maximum" channel="inline" format="number/integer" model="60"/>
    </node>
    <node name="print_random_number_2" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".number"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example generates a random number and displays it on terminal.
-->
