<node>

    <!-- Input -->

    <node name="open_stdin" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="device" channel="inline" format="text/plain" model="standard-output"/>
        <node name="identification" channel="inline" format="text/cybol-path" model="#stdin"/>
    </node>
    <node name="receive_summand_1" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="sender" channel="inline" format="text/cybol-path" model="#stdin"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#sum"/>
    </node>
    <node name="receive_summand_2" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="sender" channel="inline" format="text/cybol-path" model="#stdin"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#summand"/>
        <node name="asynchronicity" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="close_stdin" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="identification" channel="inline" format="text/cybol-path" model="#stdin"/>
    </node>

    <!-- Calculation -->

    <node name="add_operand" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#sum"/>
        <node name="operand" channel="inline" format="number/integer" model="#summand"/>
    </node>

    <!-- Output -->

    <node name="open_stdout" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="device" channel="inline" format="text/plain" model="standard-output"/>
        <node name="identification" channel="inline" format="text/cybol-path" model="#stdout"/>
    </node>
    <node name="print_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model="#stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#sum"/>
    </node>
    <node name="close_stdout" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="identification" channel="inline" format="text/cybol-path" model="#stdout"/>
    </node>

</node>
