<node>
    <!-- Creation -->
    <node name="create_result" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="result"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>

    </node>
    <node name="create_operand" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="operand"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>

    </node>

    <!-- Initialisation -->
    <node name="initialise_result" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="source" channel="inline" format="number/fraction-decimal" model="2.25,25.5"/>
    </node>
    <node name="initialise_operand" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".operand"/>
        <node name="source" channel="inline" format="number/fraction-decimal" model="10.5,11.11"/>
    </node>

    <!-- Service startup. -->
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <!-- Addition -->
    <node name="add_operand" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".operand"/>
    </node>
    <node name="print_addition" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Addition: 2.25 + 10.5 = 12.75, 25.5 + 11.11 = 36.61:"/>
    </node>
    <node name="print_addition_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result"/>
    </node>

    <!-- Multiplication -->
    <node name="multiply_operand" channel="inline" format="calculate/multiply" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".operand"/>
    </node>
    <node name="print_multiplication" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Multiplication: 12.75 * 10.5 = 133.875, 36.61 * 11.11 = 406.7371:"/>
    </node>
    <node name="print_multiplication_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result"/>
    </node>

    <!-- Subtraction -->
    <node name="subtract_operand" channel="inline" format="calculate/subtract" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".operand"/>
    </node>
    <node name="print_subtraction" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Subtraction: 133.875 - 10.5 = 123.375, 406.7371 - 11.11 = 395.6271:"/>
    </node>
    <node name="print_subtraction_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result"/>
    </node>

    <!-- Division -->
    <node name="divide_operand" channel="inline" format="calculate/divide" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".operand"/>
    </node>
    <node name="print_division" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Division: 123.375 / 10.5 = 11.75, 395.6271 / 11.11 = 35.61:"/>
    </node>
    <node name="print_division_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result"/>
    </node>

    <!-- Negation -->
    <node name="negate_operand" channel="inline" format="calculate/negate" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".operand"/>
    </node>
    <node name="print_negation" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Negation: neg 10.5 = -10.5, neg 11.11 = -11.11:"/>
    </node>
    <node name="print_negation_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result"/>
    </node>

    <!-- Absolution -->
    <node name="absolute_operand" channel="inline" format="calculate/absolute" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result"/>
        <!-- CAUTION! Do NOT use the "operand", but "result" instead, since it has a negative value. -->
        <node name="operand" channel="inline" format="text/cybol-path" model=".result"/>
    </node>
    <node name="print_absolution" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Absolution: abs -10.5 = 10.5, abs -11.11 = 11.11:"/>
    </node>
    <node name="print_absolution_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result"/>
    </node>

    <!-- Shutdown -->
    <node name="exit_application" channel="inline" format="live/exit" model=""/>
</node>

<!--
    This example calculates values of type "double".
-->
