<node>

    <node name="domain" channel="file" format="element/part" model="cybol-app/domain/domain.cybol"/>

    <node name="wui" channel="file" format="element/part" model="cybol-app/wui/wui.cybol">
        <node name="tag" channel="inline" format="text/plain" model="html"/>
        <node name="document_type" channel="inline" format="text/plain" model="html"/>
    </node>

    <node name="logic" channel="file" format="element/part" model="cybol-app/logic/logic.cybol"/>

</node>
