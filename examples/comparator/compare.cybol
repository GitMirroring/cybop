<node>

    <!-- boolean -->

    <node name="compare_boolean" channel="inline" format="compare/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_boolean"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".boolean_left"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".boolean_right"/>
    </node>

    <!-- number -->

    <node name="compare_complex" channel="inline" format="compare/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_complex"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".complex_left"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".complex_right"/>
    </node>

    <node name="compare_fraction" channel="inline" format="compare/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_fraction"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".fraction_left"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".fraction_right"/>
    </node>

    <node name="compare_integer" channel="inline" format="compare/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_integer"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".integer_left"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".integer_right"/>
    </node>

    <!-- text -->

    <node name="compare_ascii" channel="inline" format="check/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_ascii"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".ascii_left"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".ascii_right"/>
    </node>

    <node name="compare_wide" channel="inline" format="check/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_wide"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".wide_left"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".wide_right"/>
    </node>

    <!-- part -->

    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="compare pre"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="compare_ab" channel="inline" format="compare/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_person_ab"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".person_a"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".person_b"/>
    </node>

    <node name="compare_bc" channel="inline" format="compare/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_person_bc"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".person_b"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".person_c"/>
    </node>

    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="compare post"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

</node>
