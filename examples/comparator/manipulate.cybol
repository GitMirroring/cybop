<node>

    <!-- Person a remains as is -->

    <!-- Person b remains as is -->

    <!-- Person c -->

    <node name="modify_c_first_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".person_c.first_name"/>
        <node name="source" channel="inline" format="text/plain" model="Hans"/>
    </node>
    <node name="modify_c_age" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".person_c.age"/>
        <node name="source" channel="inline" format="number/integer" model="40"/>
    </node>
    <node name="modify_c_city" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".person_c.address.city"/>
        <node name="source" channel="inline" format="text/plain" model="Leipzig"/>
    </node>
    <node name="modify_c_postcode" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".person_c.address.postcode"/>
        <node name="source" channel="inline" format="number/integer" model="04000"/>
    </node>

</node>
