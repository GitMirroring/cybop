<model>
    <part name="create_application" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="shell_output_loop"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
    </part>
    <part name="create_break" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="break"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".shell_output_loop"/>
    </part>
    <part name="create_count" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="count"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
        <property name="whole" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".shell_output_loop"/>
    </part>
    <part name="initialise_break" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".shell_output_loop.break"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
    </part>
    <part name="initialise_count" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".shell_output_loop.count"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
    </part>
    <part name="print" channel="inline" encoding="utf-8" language="text/cybol" format="flow/loop" model="">
        <property name="break" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".shell_output_loop.break"/>
        <property name="model" channel="file" encoding="utf-8" language="text/cybol" format="element/part" model="shell_output_loop/model.cybol"/>
    </part>
    <part name="exit_application" channel="inline" encoding="utf-8" language="text/cybol" format="live/exit" model=""/>
</model>

<!--
    This example prints the famous "Hello, World!" string on terminal.
    It repeatedly calls an external model and executes its commands.
    Finally, an "exit" operation shuts down the application.
-->

