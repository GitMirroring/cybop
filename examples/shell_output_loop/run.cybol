<node>
    <node name="create_application" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="shell_output_loop"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="create_break" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="break"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=".shell_output_loop"/>
    </node>
    <node name="create_count" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="count"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=".shell_output_loop"/>
    </node>
    <node name="initialise_break" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".shell_output_loop.break"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>
    <node name="initialise_count" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".shell_output_loop.count"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_loop_count" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".shell_output_loop.break"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".shell_output_loop.count"/>
        <node name="right" channel="inline" format="number/integer" model="4"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>
    <node name="print" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".shell_output_loop.break"/>
        <node name="model" channel="file" format="element/part" model="shell_output_loop/model.cybol"/>
    </node>
    <node name="exit_application" channel="inline" format="live/exit" model=""/>
</node>

<!--
    This example prints the famous "Hello, World!" string on terminal.
    It repeatedly calls an external model and executes its commands.
    Finally, an "exit" operation shuts down the application.
-->

