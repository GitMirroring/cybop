<model>
    <part name="create_part_1" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="part_1"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_part_2" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="part_2"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_part_1" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".part_1"/>
        <property name="source" channel="inline" format="number/integer" model="2"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="initialise_part_2" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".part_2"/>
        <property name="source" channel="inline" format="number/integer" model="blubla"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_name_of_part_1_into_model_of_part_2" channel="inline" format="access/get-name" model="">
        <property name="element" channel="inline" format="path/knowledge" model=".part_2"/>
        <property name="part" channel="inline" format="path/knowledge" model=".part_1"/>
    </part>
    <part name="print_model_of_part_2" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="path/knowledge" model=".part_2"/>
        <property name="new_line" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="exit_application" channel="inline" format="live/exit" model=""/>
</model>

<!--
    This example creates and initialises two values:
    one of type integer and another one of type character.
    The "access/get-name" operation copies the name of part_1 into the model of part_2.
    Afterwards, the model of part_2 is printed on screen.
    The example demonstrates how node names may be accessed.
    However, they CANNOT be modified, only copied since otherwise,
    the application's knowledge tree might get mixed up.
-->

