<model>
    <part name="create_app" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="counter"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_count" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="count"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/knowledge" model=".counter"/>
    </part>
    <part name="initialise_count" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".counter.count"/>
        <property name="source" channel="file" format="number/integer" model="counter_storage/count.txt"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </part>
    <part name="print_count" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" format="path/knowledge" model=".counter.count"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="increment_count" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".counter.count"/>
        <property name="operand" channel="inline" format="number/integer" model="3"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="store_count" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" format="path/knowledge" model=".counter.count"/>
        <property name="receiver" channel="inline" format="text/plain" model="counter_storage/count.txt"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="exit_application" channel="inline" format="live/exit" model=""/>
</model>

<!--
    This example reads a previously set count value from a text file,
    increments the count by one and writes the result back into the text file.
-->

