<node>

    <node name="model_1" channel="file" format="element/part" model="counter_stack_deep/model_1.cybol"/>
    <node name="model_2" channel="file" format="element/part" model="counter_stack_deep/model_2.cybol"/>
    <node name="model_3" channel="file" format="element/part" model="counter_stack_deep/model_3.cybol"/>

    <node name="loop_1" channel="file" format="element/part" model="counter_stack_deep/loop_1.cybol">
        <node name="break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="index" channel="inline" format="number/integer" model="1"/>
        <node name="count" channel="inline" format="number/integer" model="4"/>
    </node>

    <node name="loop_2" channel="file" format="element/part" model="counter_stack_deep/loop_2.cybol">
        <node name="break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="index" channel="inline" format="number/integer" model="1"/>
        <node name="count" channel="inline" format="number/integer" model="3"/>
    </node>

    <node name="loop_3" channel="file" format="element/part" model="counter_stack_deep/loop_3.cybol">
        <node name="break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="index" channel="inline" format="number/integer" model="1"/>
        <node name="count" channel="inline" format="number/integer" model="2"/>
    </node>

</node>
