<model>
    <part name="simulate_first_case" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="true" channel="file" format="element/part" model="shell_output_branch/model_a.cybol"/>
        <property name="false" channel="file" format="element/part" model="shell_output_branch/model_b.cybol"/>
    </part>
    <part name="simulate_second_case" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="true" channel="file" format="element/part" model="shell_output_branch/model_a.cybol"/>
        <property name="false" channel="file" format="element/part" model="shell_output_branch/model_b.cybol"/>
    </part>
    <part name="shutdown" channel="inline" format="live/exit" model=""/>
</model>

<!--
    This example prints the famous "Hello, World!" string on the shell (standard output device).
    It calls one of two external models, depending on a condition, and executes its commands.
    Finally, an "exit" operation shuts down the application.
-->

