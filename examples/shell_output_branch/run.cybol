<model>
    <part name="simulate_first_case" channel="inline" encoding="utf-8" type="operation/plain" model="branch">
        <property name="criterion" channel="inline" encoding="utf-8" type="logicvalue/boolean" model="true"/>
        <property name="true" channel="file" encoding="utf-8" type="text/cybol" model="shell_output_branch/model_a.cybol"/>
        <property name="false" channel="file" encoding="utf-8" type="text/cybol" model="shell_output_branch/model_b.cybol"/>
    </part>
    <part name="simulate_second_case" channel="inline" encoding="utf-8" type="operation/plain" model="branch">
        <property name="criterion" channel="inline" encoding="utf-8" type="logicvalue/boolean" model="false"/>
        <property name="true" channel="file" encoding="utf-8" type="text/cybol" model="shell_output_branch/model_a.cybol"/>
        <property name="false" channel="file" encoding="utf-8" type="text/cybol" model="shell_output_branch/model_b.cybol"/>
    </part>
    <part name="shutdown" channel="inline" encoding="utf-8" type="operation/plain" model="exit"/>
</model>

<!--
    This example prints the famous "Hello, World!" string on the shell (standard output device).
    It calls one of two external models, depending on a condition, and executes its commands.
    Finally, an "exit" operation shuts down the application.
-->

