<!-- ### setze Aufrufe total ### -->
<node name="reset_row_content_total" channel="inline" format="modify/empty" model="">
    <node name="part" channel="inline" format="path/knowledge" model=".app.webstat.counter.body.table.row_2.column_1"/>
    <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
</node>

<node name="serialise_visits_total" channel="inline" format="represent/serialise" model="">
