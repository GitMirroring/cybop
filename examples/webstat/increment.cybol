<!-- ### lese Datum aus (heute, gestern) ### -->

<node name="get_date" channel="inline" format="run/run" model="">
    <node name="programme" channel="inline" format="text/plain" model="date +%F | tr -d '\n' > webstat/tmp/date_today.txt; date -d yesterday +%F | tr -d '\n' > webstat/tmp/date_yesterday.txt"/>
</node>

<node name="receive_file_date_today" channel="inline" format="communicate/receive" model="">
    <node name="channel" channel="inline" format="meta/channel" model="file"/>
    <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
    <node name="format" channel="inline" format="meta/format" model="text/plain"/>
    <node name="sender" channel="inline" format="path/knowledge" model=".app.var.file_path_date_today"/>
    <node name="message" channel="inline" format="path/knowledge" model=".app.var.today"/>
</node>  

<node name="receive_file_date_yesterday" channel="inline" format="communicate/receive" model="">
    <node name="channel" channel="inline" format="meta/channel" model="file"/>
    <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
    <node name="format" channel="inline" format="meta/format" model="text/plain"/>
    <node name="sender" channel="inline" format="path/knowledge" model=".app.var.file_path_date_yesterday"/>
    <node name="message" channel="inline" format="path/knowledge" model=".app.var.yesterday"/>
</node>  
  

<!-- ### lese Zugriffe aus Datei ### -->

<!-- lese Zugriffe für heute -->

<node name="reset_path_today" channel="inline" format="modify/empty" model="">
    <node name="part" channel="inline" format="path/knowledge" model=".app.var.file_path_today"/>
    <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
    <node name="meta" channel="inline" format="logicvalue/boolean" model="true"/>
</node>

<node name="append_root_path" channel="inline" format="modify/append" model="">
    <node name="destination" channel="inline" format="path/knowledge" model=".app.var.file_path_today"/>
    <node name="source" channel="inline" format="path/knowledge" model=".app.var.statistics_root_path"/>
    <node name="type" channel="inline" format="meta/type" model="text/plain"/>
</node>

<node name="build_path_today" channel="inline" format="modify/append" model="">
    <node name="destination" channel="inline" format="path/knowledge" model=".app.var.file_path_today"/>
    <node name="source" channel="inline" format="path/knowledge" model=".app.var.today"/>
    <node name="type" channel="inline" format="meta/type" model="text/plain"/>
</node>

<node name="append_suffix" channel="inline" format="modify/append" model="">
    <node name="destination" channel="inline" format="path/knowledge" model=".app.var.file_path_today"/>
    <node name="source" channel="inline" format="text/plain" model=".txt"/>
    <node name="type" channel="inline" format="meta/type" model="text/plain"/>
</node>

<node name="reset_visits_today" channel="inline" format="modify/empty" model="">
    <node name="part" channel="inline" format="path/knowledge" model=".app.var.visits_today"/>
    <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
</node>

<node name="receive_file_today" channel="inline" format="communicate/receive" model="">
    <node name="channel" channel="inline" format="meta/channel" model="file"/>
    <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
    <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    <node name="sender" channel="inline" format="path/knowledge" model=".app.var.file_path_today"/>
    <node name="message" channel="inline" format="path/knowledge" model=".app.var.visits_today"/>
</node>   


<!-- ### lese Zugriffe für gestern ### -->

<node name="reset_path_yesterday" channel="inline" format="modify/empty" model="">
