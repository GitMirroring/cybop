<node>

    <!-- Startup system -->
    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="internet/socket_client/app.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
    </node>

    <!-- Startup services -->
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="startup_socket" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="namespace" channel="inline" format="text/plain" model="ipv4"/>
        <node name="style" channel="inline" format="text/plain" model="stream"/>
        <node name="protocol" channel="inline" format="text/plain" model="tcp"/>
<!--
        <node name="address" channel="inline" format="text/plain" model="localhost"/>
-->
        <node name="address" channel="inline" format="text/plain" model="127.0.0.1"/>
        <!-- Specify either service name OR id (port) number, NOT both. If both are given, then the port has higher priority. -->
        <node name="service" channel="inline" format="text/plain" model="http"/>
        <node name="id" channel="inline" format="number/integer" model="1971"/>
        <node name="mode" channel="inline" format="text/plain" model="client"/>
        <!-- Making the client non-blocking ("false") results in error EWOULDBLOCK when reading/writing. -->
        <node name="blocking" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="socket" channel="inline" format="text/cybol-path" model=".server_socket"/>
    </node>

    <!-- Send hello request -->
    <node name="print_request" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Sending hello request ..."/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="send_request" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="say-hello"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".server_socket"/>
    </node>

    <!-- Receive hello response -->
    <node name="receive_response" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".server_socket"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".text-response"/>
    </node>
    <node name="print_response" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".text-response"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!-- Send image request -->
    <node name="print_request" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Sending image request ..."/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="send_request" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="show-image"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".server_socket"/>
    </node>

    <!-- Receive image response -->
    <node name="receive_response" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="language" channel="inline" format="meta/language" model="message/binary"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".server_socket"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".image-response"/>
    </node>
    <node name="write_response" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="language" channel="inline" format="meta/language" model="message/binary"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".image-response"/>
        <node name="receiver" channel="inline" format="text/plain" model="internet/socket_client/received_image.png"/>
    </node>

    <!-- Send exit request -->
    <node name="print_request_exit" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Sending exit request ..."/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="send_request_exit" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="exit"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".server_socket"/>
    </node>

    <!-- Exit programme -->
    <node name="exit_programme" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example demonstrates the client side of a socket communication.

    CAUTION! The reserved service ports 0..1023 can sometimes only be
    used when running the cybol application as "root" user (Administrator).

    The "nmap" tool may be used to find out about active service ports, e.g.:
    nmap localhost
-->
