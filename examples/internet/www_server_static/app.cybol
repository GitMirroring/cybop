<node>

    <node name="stdout" channel="inline" format="number/integer" model="-1"/>
    <node name="client_socket" channel="inline" format="number/integer" model="0"/>

    <node name="request" channel="inline" format="element/part" model=""/>

    <node name="path" channel="inline" format="text/plain" model=""/>
    <!--
        CAUTION! The format is "text/ascii" and NOT "text/plain",
        since some data, like images for instance, represent binary data.
    -->
    <node name="file" channel="inline" format="text/ascii" model=""/>

    <node name="handle_enable" channel="file" format="element/part" model="internet/www_server_static/handle_enable.cybol"/>
    <node name="handle_sense" channel="file" format="element/part" model="internet/www_server_static/handle_sense.cybol"/>

    <node name="handle_close" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="server" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="port" channel="inline" format="number/integer" model="1971"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".client_socket"/>
    </node>

</node>
