<node>

    <node name="heading" channel="inline" format="text/plain" model="CYBOL WWW Server Example">
        <node name="tag" channel="inline" format="text/plain" model="h1"/>
    </node>

    <node name="description" channel="inline" format="text/plain" model="This is an example web page created from cybol files.">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
    </node>
    <node name="note" channel="inline" format="text/plain" model="It is not formatted, since css files are not processed in this simple webserver example.">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
    </node>

    <node name="line_break_content" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="br"/>
    </node>
    <node name="content" channel="inline" format="text/plain" model="The content will appear right here.">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
        <node name="id" channel="inline" format="text/plain" model="content"/>
    </node>
    <node name="line_break_content" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="br"/>
    </node>

    <node name="content" channel="inline" format="text/plain" model="Click on the links below to change the content.">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
    </node>

    <node name="world_link" channel="inline" format="text/plain" model="Greet World">
        <node name="tag" channel="inline" format="text/plain" model="a"/>
        <node name="href" channel="inline" format="text/plain" model="http://localhost:1971/?action=greet-world"/>
        <node name="class" channel="inline" format="text/plain" model="button"/>
    </node>
    <node name="line_break_content" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="br"/>
    </node>

    <node name="cybop_link" channel="inline" format="text/plain" model="Greet CYBOP">
        <node name="tag" channel="inline" format="text/plain" model="a"/>
        <node name="href" channel="inline" format="text/plain" model="http://localhost:1971/?action=greet-cybop"/>
        <node name="class" channel="inline" format="text/plain" model="button"/>
    </node>
    <node name="line_break_content" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="br"/>
    </node>

    <node name="exit_link" channel="inline" format="text/plain" model="Exit Programme">
        <node name="tag" channel="inline" format="text/plain" model="a"/>
        <node name="href" channel="inline" format="text/plain" model="http://localhost:1971/?action=exit"/>
        <node name="class" channel="inline" format="text/plain" model="button"/>
    </node>
    <node name="line_break_content" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="br"/>
    </node>

</node>
