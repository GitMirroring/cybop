<node>

    <node name="handle_enable" channel="file" format="element/part" model="internet/www_server_dynamic/logic/handle_enable.cybol"/>
    <node name="handle_sense" channel="file" format="element/part" model="internet/www_server_dynamic/logic/handle_sense.cybol"/>

    <node name="handle_close" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="server" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="port" channel="inline" format="number/integer" model="1971"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".client_socket"/>
    </node>

    <node name="evaluate_query" channel="file" format="element/part" model="internet/www_server_dynamic/logic/evaluate_query.cybol"/>
    <node name="actions" channel="file" format="element/part" model="internet/www_server_dynamic/logic/actions.cybol"/>

    <node name="send_empty_message" channel="file" format="element/part" model="internet/www_server_dynamic/logic/send_empty_message.cybol"/>
    <node name="send_index" channel="file" format="element/part" model="internet/www_server_dynamic/logic/send_index.cybol"/>
    <node name="greet_world" channel="file" format="element/part" model="internet/www_server_dynamic/logic/greet_world.cybol"/>
    <node name="greet_cybop" channel="file" format="element/part" model="internet/www_server_dynamic/logic/greet_cybop.cybol"/>
    <node name="exit_programme" channel="file" format="element/part" model="internet/www_server_dynamic/logic/exit_programme.cybol"/>

</node>
