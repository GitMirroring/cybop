<node>

    <node name="wui" channel="file" format="element/part" model="internet/www_server_dynamic/wui.cybol"/>
    <node name="logic" channel="file" format="element/part" model="internet/www_server_dynamic/logic.cybol"/>

    <node name="request" channel="inline" format="element/part" model=""/>
    <node name="client_socket" channel="inline" format="number/integer" model="0"/>

    <!--
        CAUTION! Should the path format be "text/cybol-path" OR "text/plain"?
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handler.cybol" file.

        Alternative:
        <node name="path" channel="inline" format="text/cybol-path" model=""/>
        <node name="path" channel="inline" format="text/plain" model=""/>
    -->
    <node name="path" channel="inline" format="text/plain" model=""/>

    <node name="webpage" channel="inline" format="text/plain" model="">
        <!--
            CAUTION! The necessary "encoding" is added here DIRECTLY,
            since it does NOT work adding it as constraint at the operation "send".
            The reason is that the format "text/cybol-path" is used there,
            which points to another (this) part ".webpage" whose properties are used.
        -->
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    </node>
    <node name="css" channel="file" format="text/plain" model="internet/www_server_dynamic/wui/formatting.css">
        <!--
            CAUTION! The necessary "encoding" is added here DIRECTLY,
            since it does NOT work adding it as constraint at the operation "send".
            The reason is that the format "text/cybol-path" is used there,
            which points to another (this) part ".webpage" whose properties are used.
        -->
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    </node>

</node>
