<node>

    <node name="port" channel="inline" format="number/integer" model="8080"/>
    <node name="address" channel="inline" format="text/plain" model="127.0.0.1"/>
    <node name="client_socket" channel="inline" format="number/integer" model="0"/>

    <!-- loop Variablen -->
    <node name="csv_content" channel="inline" format="text/plain" model=""/>
    <node name="count" channel="inline" format="number/integer" model=""/>
    <node name="count_text" channel="inline" format="text/plain" model=""/>
    <node name="maximum" channel="inline" format="number/integer" model="29"/>
    <node name="break" channel="inline" format="number/integer" model="false"/>
    <node name="date_command" channel="inline" format="text/plain" model=""/>
    <node name="date_path" channel="inline" format="text/plain" model="webstat/tmp/loop_date.txt"/>
    <node name="loop_date" channel="inline" format="text/plain" model=""/>
    <node name="loop_date_path" channel="inline" format="text/plain" model=""/>
    <node name="loop_visits" channel="inline" format="text/plain" model=""/>
    <node name="linefeed" channel="inline" format="text/plain" model=""/>

    <node name="file_path_linefeed" channel="inline" format="text/plain" model="webstat/newline.txt"/>
    <node name="file_path_csv_data" channel="inline" format="text/plain" model="webstat/files/data.csv"/>
    <node name="file_path_today" channel="inline" format="text/plain" model=""/>
    <node name="file_path_yesterday" channel="inline" format="text/plain" model=""/>
    <node name="file_path_total" channel="inline" format="text/plain" model="webstat/saved_statistics/total.txt"/>
    <node name="statistics_root_path" channel="inline" format="text/plain" model="webstat/saved_statistics/"/>
    <node name="file_path_date_today" channel="inline" format="text/plain" model="webstat/tmp/date_today.txt"/>
    <node name="file_path_date_yesterday" channel="inline" format="text/plain" model="webstat/tmp/date_yesterday.txt"/>

    <node name="today" channel="inline" format="text/plain" model=""/>
    <node name="yesterday" channel="inline" format="text/plain" model=""/>

    <node name="visits_today" channel="inline" format="number/integer" model="0"/>
    <node name="visits_yesterday" channel="inline" format="number/integer" model="0"/>
    <node name="visits_total" channel="inline" format="number/integer" model="0"/>
    <node name="request" channel="inline" format="element/part" model=""/>
    <node name="path" channel="inline" format="text/cybol-path" model=""/>
    <node name="file" channel="inline" format="application/octet-stream" model=""/>
    <node name="increment" channel="inline" format="logicvalue/boolean" model="false"/>

</node>
