<node>

    <node name="logic" channel="file" format="element/part" model="internet/socket_server/logic.cybol"/>
    <node name="actions" channel="file" format="element/part" model="internet/socket_server/actions.cybol"/>

    <node name="request" channel="inline" format="text/plain" model=""/>
    <node name="client_socket" channel="inline" format="number/integer" model="0"/>

    <node name="path" channel="inline" format="text/plain" model=""/>

    <!--
        CAUTION! The format is "text/ascii" and NOT "text/plain",
        since an image contains binary data.
        These get loaded at application startup in file "run.cybol".
    -->
    <node name="image" channel="inline" format="text/ascii" model=""/>

</node>
