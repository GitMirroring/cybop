<node>
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="print" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Current time:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="create_application" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="counter"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="create_break" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="break"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="path/knowledge" model=".counter"/>
    </node>
    <node name="create_count" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="count"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="path/knowledge" model=".counter"/>
    </node>
    <node name="create_maximum" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="maximum"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="path/knowledge" model=".counter"/>
    </node>
    <node name="create_model" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="model"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="path/knowledge" model=".counter"/>
    </node>
    <node name="initialise_break" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".counter.break"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>
    <node name="initialise_count" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".counter.count"/>
        <node name="source" channel="inline" format="number/integer" model="1"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="initialise_maximum" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".counter.maximum"/>
        <node name="source" channel="inline" format="number/integer" model="10"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="initialise_model" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="time_output_3/model.cybol"/>
        <node name="message" channel="inline" format="path/knowledge" model=".counter.model"/>
    </node>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_loop_count" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".counter.break"/>
        <node name="left" channel="inline" format="path/knowledge" model=".counter.count"/>
        <node name="right" channel="inline" format="path/knowledge" model=".counter.maximum"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>
    <node name="call_loop" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="path/knowledge" model=".counter.break"/>
        <node name="model" channel="inline" format="path/knowledge" model=".counter.model"/>
    </node>
    <node name="exit_application" channel="inline" format="live/exit" model=""/>
</node>

<!--
    This example uses a loop to repeatedly print the current time.
    A shell command is applied to sleep for one second.
    Afterwards, the current time is printed on the shell.
-->

