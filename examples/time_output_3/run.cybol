<model>
    <part name="print_text" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="shell"/>
        <property name="language" channel="inline" type="text/plain" model="text/plain"/>
        <property name="message" channel="inline" type="text/plain" model="Current time:"/>
	<property name="new_line" channel="inline" type="logicvalue/boolean" model="true"/>
    </part>
    <part name="create_counter" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="counter"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
    </part>
    <part name="create_break" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="break"/>
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".counter"/>
    </part>
    <part name="create_count" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="count"/>
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".counter"/>
    </part>
    <part name="create_maximum" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="maximum"/>
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".counter"/>
    </part>
    <part name="create_model" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="model"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".counter"/>
    </part>
    <part name="initialise_break" channel="inline" type="operation/plain" model="copy">
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="source" channel="inline" type="number/integer" model="0"/>
        <property name="destination" channel="inline" type="path/knowledge" model=".counter.break"/>
    </part>
    <part name="initialise_count" channel="inline" type="operation/plain" model="copy">
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="source" channel="inline" type="number/integer" model="1"/>
        <property name="destination" channel="inline" type="path/knowledge" model=".counter.count"/>
    </part>
    <part name="initialise_maximum" channel="inline" type="operation/plain" model="copy">
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="source" channel="inline" type="number/integer" model="10"/>
        <property name="destination" channel="inline" type="path/knowledge" model=".counter.maximum"/>
    </part>
    <part name="initialise_model" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="time_output_3/model.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".counter.model"/>
    </part>
    <part name="call_loop" channel="inline" type="operation/plain" model="loop">
        <property name="break" channel="inline" type="path/knowledge" model=".counter.break"/>
        <property name="model" channel="inline" type="path/knowledge" model=".counter.model"/>
    </part>
    <part name="exit_application" channel="inline" type="operation/plain" model="exit"/>
</model>

<!--
    This example uses a loop to repeatedly print the current time.
    A shell command is applied to sleep for one second.
    Afterwards, the current time is printed on the shell.
/-->

