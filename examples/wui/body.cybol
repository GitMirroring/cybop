<node>
    <node name="heading" channel="inline" format="text/plain" model="CYBOL Web User Interface (WUI) Example">
        <node name="tag" channel="inline" format="text/plain" model="h1"/>
    </node>
    <node name="content" channel="inline" format="text/plain" model="This is an example web page created from cybol files.">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
    </node>
    <node name="content" channel="inline" format="text/plain" model="Following is a line break which IS allowed to be serialised as empty tag.">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
    </node>
    <node name="content" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="br"/>
    </node>
    <node name="content" channel="inline" format="text/plain" model="Following is an empty div block which is NOT allowed to be serialised as empty tag and hence should contain an opening AND closing tag.">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
    </node>
    <node name="content" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="div"/>
    </node>
    <node name="content" channel="inline" format="text/plain" model="Following is an external text read from a text file. It is preformatted which is indicated by the corresponding cybol property. Moreover, the formatting has to be taken care of in CSS!">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
    </node>
    <node name="content" channel="file" format="text/plain" model="wui/external_text.txt">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
        <node name="preformatted" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="class" channel="inline" format="text/plain" model="preformatted"/>
    </node>
    <node name="content" channel="inline" format="text/plain" model="This link contains a URL with unicode character codes greater 256 that should get encoded using percent encoding.">
        <node name="tag" channel="inline" format="text/plain" model="a"/>
        <node name="href" channel="inline" format="text/plain" model="http://www.The word China in Chinese: 中國 and that is it.cn"/>
    </node>
    <node name="heading" channel="inline" format="text/plain" model="Example Table">
        <node name="tag" channel="inline" format="text/plain" model="h4"/>
    </node>
    <node name="table" channel="file" format="element/part" model="wui/table.cybol">
        <node name="tag" channel="inline" format="text/plain" model="table"/>
    </node>
</node>
