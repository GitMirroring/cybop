<node>
    <node name="create_wui" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="wui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="initialise_wui" channel="inline" format="communicate/receive" model="">
        <node name="sender" channel="inline" format="text/plain" model="wui/wui.cybol"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".wui"/>
    </node>
    <node name="generate_html" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="wui.html"/>
        <node name="message" channel="inline" format="path/knowledge" model=".wui.index"/>
        <node name="language" channel="inline" format="meta/language" model="text/html">
            <node name="indentation" channel="inline" format="logicvalue/boolean" model="true"/>
        </node>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
    </node>
    <node name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".wui"/>
        <node name="receiver" channel="inline" format="text/plain" model="test_wui.txt"/>
    </node>
    <node name="exit_application" channel="inline" format="live/exit" model=""/>
</node>

<!--
    This example generates a web page.
    The resulting file "wui.html" can be found
    in the parent directory of this example.
-->

