<node>
    <node name="node1" channel="inline" format="text/plain" model="node1">
        <node name="a" channel="inline" format="text/plain" model="a"/>
        <node name="b" channel="inline" format="text/plain" model="b"/>
        <node name="c" channel="inline" format="text/plain" model="c"/>
    </node>
    <node name="node2" channel="inline" format="text/plain" model="node2"/>
    <node name="node3" channel="inline" format="text/plain" model="node3"/>
</node>

