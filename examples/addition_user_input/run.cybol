<node>

    <node name="create_app" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="app"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="addition_user_input/app.cybol"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app"/>
    </node>

    <!-- Write knowledge tree into file. -->
    <node name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_addition_user_input.txt"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app"/>
    </node>

    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <node name="receive_input" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <!-- CAUTION! Do NOT use an encoding here, since terminal input is already in wide characters. -->
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app.input"/>
    </node>

    <!-- Write knowledge tree into file. -->
    <node name="test_knowledge_tree_1" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_addition_user_input_1.txt"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app"/>
    </node>

    <!--
        CAUTION! Do NOT assign an initial value like zero, but empty array instead.
        Otherwise, many numbers will appear in the value, so that the calculation
        cannot happen due to different dimension of the two operand arrays.
    -->
    <node name="reset_operand" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="path/knowledge" model=".app.operand"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="deserialise_input" channel="inline" format="represent/deserialise" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.operand"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.input"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </node>

    <!-- Write knowledge tree into file. -->
    <node name="test_knowledge_tree_2" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_addition_user_input_2.txt"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app"/>
    </node>

    <!--
        CAUTION! The "result" integer vector has to be initialised BEFORE this operation.
        If result- and operand vectors had different sizes, they would NOT be added.
    -->
    <node name="add_operand" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".app.result"/>
        <node name="operand" channel="inline" format="path/knowledge" model=".app.operand"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>

    <!-- Write knowledge tree into file. -->
    <node name="test_knowledge_tree_3" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_addition_user_input_3.txt"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app"/>
    </node>

    <node name="print_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app.result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    TODO: CAUTION! This example does NOT WORK yet.
    The cyboi interpreter has to be adapted to being able
    to receive user input in different ways
    (canonical with buffer, blocking or not etc.).

    This example asks the user for input of an operand.
    It then adds that operand value to the result variable,
    which gets printed onto screen.
-->
