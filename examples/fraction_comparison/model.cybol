<model>
    <part name="result" channel="inline" format="logicvalue/boolean" model="false"/>
    <part name="left" channel="inline" format="number/fraction-vulgar" model="3,2"/>
    <part name="right" channel="inline" format="number/fraction-vulgar" model="6,4"/>
</model>

