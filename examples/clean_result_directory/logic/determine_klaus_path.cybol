<node>

    <node name="overwrite_with_home" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".klaus_path"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".home_path"/>
    </node>

    <node name="append_separator_and_klaus" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".klaus_path"/>
        <node name="source" channel="inline" format="text/plain" model="/klaus"/>
    </node>

    <node name="serialise_index" channel="inline" format="represent/serialise" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".klaus_path"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".index"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>

</node>
