<node>

    <node name="var" channel="file" format="element/part" model="password_generator/var.cybol"/>

    <node name="startpw" channel="file" format="element/part" model="password_generator/startpw.cybol"/>
    <node name="inputnewpw" channel="file" format="element/part" model="password_generator/inputnewpw.cybol"/>
    <node name="checknewpw" channel="file" format="element/part" model="password_generator/checknewpw.cybol"/>
    <node name="initialising" channel="file" format="element/part" model="password_generator/initialising.cybol"/>
    <node name="auswahl" channel="file" format="element/part" model="password_generator/auswahl.cybol"/>
    <node name="print_auswahl" channel="file" format="element/part" model="password_generator/print_auswahl.cybol"/>

    <node name="10_laenge" channel="file" format="element/part" model="password_generator/10_laenge.cybol"/>
    <node name="10_laenge_check" channel="file" format="element/part" model="password_generator/10_laenge_check.cybol"/>

    <node name="11_klein" channel="file" format="element/part" model="password_generator/11_klein.cybol"/>
    <node name="11_klein_check" channel="file" format="element/part" model="password_generator/11_klein_check.cybol"/>

    <node name="12_gross" channel="file" format="element/part" model="password_generator/12_gross.cybol"/>
    <node name="12_gross_check" channel="file" format="element/part" model="password_generator/12_gross_check.cybol"/>

    <node name="13_zahlen" channel="file" format="element/part" model="password_generator/13_zahlen.cybol"/>
    <node name="13_zahlen_check" channel="file" format="element/part" model="password_generator/13_zahlen_check.cybol"/>

    <node name="14_sonder" channel="file" format="element/part" model="password_generator/14_sonder.cybol"/>
    <node name="14_sonder_check" channel="file" format="element/part" model="password_generator/14_sonder_check.cybol"/>

    <node name="15_zufall" channel="file" format="element/part" model="password_generator/15_zufall.cybol"/>
    <node name="15_zufall_klein" channel="file" format="element/part" model="password_generator/15_zufall_klein.cybol"/>
    <node name="15_zufall_gross" channel="file" format="element/part" model="password_generator/15_zufall_gross.cybol"/>
    <node name="15_zufall_zahlen" channel="file" format="element/part" model="password_generator/15_zufall_zahlen.cybol"/>
    <node name="15_zufall_sonder" channel="file" format="element/part" model="password_generator/15_zufall_sonder.cybol"/>

    //loop1
    <node name="break" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="count" channel="inline" format="number/integer" model="1"/>
    <node name="maximum" channel="inline" format="number/integer" model="2"/>
    <node name="model" channel="file" format="element/part" model="password_generator/model.cybol"/>

    <node name="exit" channel="file" format="element/part" model="password_generator/exit.cybol"/>

