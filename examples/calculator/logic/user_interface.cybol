    <part name="select_right" channel="file" format="element/part" model="calculator/logic/user_interface/select_right.cybol"/>

    <part name="enter" channel="file" format="element/part" model="calculator/logic/user_interface/enter.cybol"/>

    <part name="show_about" channel="file" format="element/part" model="calculator/logic/user_interface/show_about.cybol"/>
