<node>

    <!--
        CAUTION! Do NOT assign an initial value like zero, but empty array instead.
        Otherwise, many numbers will appear in the value, so that the calculation
        cannot happen due to different dimension of the two operand arrays.
    -->
    <node name="reset_operand" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.tmp.operand"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="deserialise_operand" channel="inline" format="represent/deserialise" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tmp.operand"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.tui.main.menu.display.value"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </node>

    <node name="execute_stored_operation" channel="inline" format="flow/sequence" model="">
        <!-- CAUTION! The path is NOT a reference. -->
        <node name="model" channel="inline" format="text/cybol-path" model=".app.tmp.operation"/>
    </node>

    <node name="store_operation" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tmp.operation"/>
        <node name="source" channel="inline" format="text/plain" model=".app.logic.functionality.calculate.subtract"/>
    </node>

    <node name="update_display" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.user_interface.update_display"/>
    </node>

</node>
