<node>

    <!-- Write knowledge tree into file. -->
    <node name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app.tmp"/>
        <node name="receiver" channel="inline" format="text/plain" model="test_calculator_negate.txt"/>
    </node>

    <!--
        CAUTION! Do NOT assign an initial value like zero, but empty array instead.
        Otherwise, many numbers will appear in the value, so that the calculation
        cannot happen due to different dimension of the two operand arrays.
    -->
    <node name="reset_operand" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="path/knowledge" model=".app.tmp.operand"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="deserialise_operand" channel="inline" format="represent/deserialise" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.tmp.operand"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.tui.main.menu.display.value"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </node>

   <!--<node name="execute_stored_operation" channel="inline" format="flow/sequence" model="">
        <!-- CAUTION! The format is "path/knowledge" and NOT "path/reference". -->
        <node name="model" channel="inline" format="path/knowledge" model=".app.tmp.operation"/>
    </node>

    <node name="store_operation" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.tmp.operation"/>
        <node name="source" channel="inline" format="text/plain" model=".app.logic.functionality.calculate.negate"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    -->
    <node name="negate" channel="inline" format="calculate/negate" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".app.tmp.result"/>
        <node name="operand" channel="inline" format="path/knowledge" model=".app.tmp.operand"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="update_display" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/knowledge" model=".app.logic.user_interface.update_display_without_reset"/>
    </node>

</node>
