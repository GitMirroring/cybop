<model>

    <part name="copy_focused_part_name" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.tmp.action"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.tui.main.menu#focus"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="copy_action_property_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.tmp.action"/>
        <property name="source" channel="inline" format="text/plain" model="#action"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="get_action_reference" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.tmp.action"/>
        <property name="source" channel="inline" format="path/reference" model=".app.tmp.action"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.tmp"/>
        <property name="receiver" channel="inline" format="text/plain" model="test_calculator_action.txt"/>
    </part>

    <!--
        CAUTION! Do NOT use the "communicate/send" operation with "signal" channel here.
        Otherwise, another signal might be executed before, so that this signal could possibly
        not find all resources anymore, if they meanwhile have been manipulated by the other signal.
        The "flow/sequence" operation ensures that the given model is executed directly.
    -->
    <part name="execute_action" channel="inline" format="flow/sequence" model="">
        <!-- CAUTION! The format is "path/knowledge" and NOT "path/reference". -->
        <property name="model" channel="inline" format="path/reference" model=".app.tmp.action"/>
    </part>

</model>
