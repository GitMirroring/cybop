<model>
    <part name="translate" channel="inline" format="path/knowledge" model=".app.logic.translation.translate_appinfo_to_about"/>
    <part name="send" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/tui"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.tui.about"/>
        <property name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="sense" channel="inline" format="live/sense" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="handler" channel="inline" format="path/knowledge" model=".app.logic.handler.handle_about"/>
    </part>
</model>
