<model>
	<part name="is_operation" channel="inline" format="element/part" model="(	
		<part name="set_operation" channel="inline" format="modify/overwrite" model="">
			<property name="destination" channel="inline" format="path/knowledge" model=".safetmp.operation"/>
			<property name="source" channel="inline" format="path/knowledge" model=".safetmp.temp_line"/>
			<property name="type" channel="inline" format="meta/type" model="text/plain"/>
		</part>
		<part name="clear_temp_line" channel="inline" format="modify/empty" model="">
			<property name="part" channel="inline" format="path/knowledge" model=".safetmp.temp_line"/>
		</part>
		<part name="temp_pos_counter_erhöhen" channel="inline" format="calculate/add" model="">
			<property name="result" channel="inline" format="path/knowledge" model=".safetmp.temp_position_counter"/>
			<property name="operand" channel="inline" format="number/integer" model="1"/>
			<property name="type" channel="inline" format="meta/type" model="number/integer"/>
		</part>
	)"/>
	<part name="is_number" channel="inline" format="element/part" model="(
		<part name="set_number" channel="inline" format="modify/overwrite" model="">
			<property name="destination" channel="inline" format="path/knowledge" model=".safetmp.first_number_result"/>
			<property name="source" channel="inline" format="path/knowledge" model=".safetmp.temp_line"/>
			<property name="type" channel="inline" format="meta/type" model="number/integer"/>
		</part>
		<part name="clear_temp_line_2" channel="inline" format="modify/empty" model="">
			<property name="part" channel="inline" format="path/knowledge" model=".safetmp.temp_line"/>
		</part>
		<part name="temp_pos_counter_erhöhen" channel="inline" format="calculate/add" model="">
			<property name="result" channel="inline" format="path/knowledge" model=".safetmp.temp_position_counter"/>
			<property name="operand" channel="inline" format="number/integer" model="1"/>
			<property name="type" channel="inline" format="meta/type" model="number/integer"/>
		</part>
	)"/>
	
	<!-- after Enter -->
	<part name="last_number" channel="inline" format="element/part" model="(
		<part name="set_last_number" channel="inline" format="modify/overwrite" model="">
			<property name="destination" channel="inline" format="path/knowledge" model=".safetmp.second_number"/>
			<property name="source" channel="inline" format="path/knowledge" model=".safetmp.temp_line"/>
			<property name="type" channel="inline" format="meta/type" model="number/integer"/>
		</part>
		<part name="clear_temp_line_3" channel="inline" format="modify/empty" model="">
			<property name="part" channel="inline" format="path/knowledge" model=".safetmp.temp_line"/>
		</part>
		<part name="clear_active_operation" channel="inline" format="modify/empty" model="">
			<property name="part" channel="inline" format="path/knowledge" model=".safetmp.active_operation"/>
		</part>
		<part name="reset_temp_position_counter" channel="inline" format="modify/overwrite" model="">
			<property name="destination" channel="inline" format="path/knowledge" model=".safetmp.temp_position_counter"/>
			<property name="source" channel="inline" format="number/integer" model="0"/>
			<property name="type" channel="inline" format="meta/type" model="number/integer"/>
		</part>
	)"/>
	
	<!-- Set Condition_Flag -->
	<part name="set_condition_flag" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".safetmp.condition_flag"/>
        <property name="source" channel="inline" format="number/integer" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
	
	<!-- Fill Lines -->
	<part name="append_active_operation" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".safetmp.active_operation"/>
        <property name="source" channel="inline" format="path/knowledge" model=".safetmp.command"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
	<part name="append_temp_line" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".safetmp.temp_line"/>
        <property name="source" channel="inline" format="path/knowledge" model=".safetmp.command"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
</model>