<model>
    <part name="enter" channel="file" format="element/part" model="calculator/logic_enter.cybol"/>
    <part name="space" channel="file" format="element/part" model="calculator/logic_space.cybol"/>
    <part name="clear_calculation" channel="file" format="element/part" model="calculator/logic_clear.cybol"/>
    <part name="exit" channel="inline" format="live/exit" model=""/>
	
	<part name="is_operation" channel="file" format="element/part" model="calculator/logic_operation.cybol"/>	
	<part name="is_number" channel="file" format="element/part" model="calculator/logic_first_number.cybol"/>
	<part name="last_number" channel="file" format="element/part" model="calculator/logic_second_number.cybol"/>
	
	<!-- Set Condition_Flag -->
	<part name="set_condition_flag" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.condition_flag"/>
        <property name="source" channel="inline" format="number/integer" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
	
	<!-- Fill Lines -->
	<part name="append_active_operation" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.active_operation"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.safetmp.command"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
	<part name="append_temp_line" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_line"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.safetmp.command"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
</model>