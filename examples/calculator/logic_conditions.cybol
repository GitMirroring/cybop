	<part name="comparison_c" channel="inline" format="compare/equal" model="">
		<property name="operand_1" channel="inline" format="path/knowledge" model=".safetmp.command"/>
		<property name="operand_2" channel="inline" format="number/integer" model="c"/>
		<property name="result" channel="inline" format="path/knowledge" model=".safetmp.flag"/>
	</part>
	<part name="if_is_c" channel="inline" format="flow/branch" model="">
		<property name="criterion" channel="inline" format="path/knowledge" model=".safetmp.flag"/>
		<property name="true" channel="inline" format="path/knowledge" model=".logic_calculation.set_condition_flag"/>
	</part>
	
	<part name="comparison_esc" channel="inline" format="compare/equal" model="">
		<property name="operand_1" channel="inline" format="path/knowledge" model=".safetmp.command"/>
		<property name="operand_2" channel="inline" format="number/integer" model="esc"/>
		<property name="result" channel="inline" format="path/knowledge" model=".safetmp.flag"/>
	</part>
	<part name="if_is_esc" channel="inline" format="flow/branch" model="">
		<property name="criterion" channel="inline" format="path/knowledge" model=".safetmp.flag"/>
