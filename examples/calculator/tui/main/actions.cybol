<model>

    <part name="arrow-up" channel="inline" format="path/knowledge" model=".app.logic.user_interface.select_up"/>
    <part name="arrow-down" channel="inline" format="path/knowledge" model=".app.logic.user_interface.select_down"/>
    <part name="arrow-left" channel="inline" format="path/knowledge" model=".app.logic.user_interface.select_left"/>
    <part name="arrow-right" channel="inline" format="path/knowledge" model=".app.logic.user_interface.select_right"/>

    <part name="enter" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_focus"/>
    <part name="escape" channel="inline" format="path/knowledge" model=".app.logic.functionality.reset"/>

    <part name="a" channel="inline" format="path/knowledge" model=".app.logic.user_interface.show_about"/>
    <part name="e" channel="inline" format="path/knowledge" model=".app.logic.lifecycle.shutdown"/>

    <part name="0" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <part name="1" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <part name="2" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <part name="3" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <part name="4" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <part name="5" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <part name="6" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <part name="7" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <part name="8" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <part name="9" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>

    <part name="=" channel="inline" format="path/knowledge" model=".app.logic.functionality.equals"/>
    <part name="+" channel="inline" format="path/knowledge" model=".app.logic.functionality.add"/>
    <part name="-" channel="inline" format="path/knowledge" model=".app.logic.functionality.subtract"/>
    <part name="*" channel="inline" format="path/knowledge" model=".app.logic.functionality.multiply"/>
    <part name="/" channel="inline" format="path/knowledge" model=".app.logic.functionality.divide"/>
    <part name="s" channel="inline" format="path/knowledge" model=".app.logic.functionality.square"/>
    <part name="r" channel="inline" format="path/knowledge" model=".app.logic.functionality.squareroot"/>

</model>
