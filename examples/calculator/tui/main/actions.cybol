<node>

    <node name="arrow-up" channel="inline" format="path/knowledge" model=".app.logic.user_interface.select_up"/>
    <node name="arrow-down" channel="inline" format="path/knowledge" model=".app.logic.user_interface.select_down"/>
    <node name="arrow-left" channel="inline" format="path/knowledge" model=".app.logic.user_interface.select_left"/>
    <node name="arrow-right" channel="inline" format="path/knowledge" model=".app.logic.user_interface.select_right"/>

    <node name="enter" channel="inline" format="path/knowledge" model=".app.logic.handler.handle_action"/>
    <node name="escape" channel="inline" format="path/knowledge" model=".app.logic.functionality.reset"/>

    <node name="a" channel="inline" format="path/knowledge" model=".app.logic.user_interface.show_about"/>
    <node name="e" channel="inline" format="path/knowledge" model=".app.logic.lifecycle.shutdown"/>

    <node name="0" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <node name="1" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <node name="2" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <node name="3" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <node name="4" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <node name="5" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <node name="6" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <node name="7" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <node name="8" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>
    <node name="9" channel="inline" format="path/knowledge" model=".app.logic.user_interface.display_command"/>

    <node name="=" channel="inline" format="path/knowledge" model=".app.logic.functionality.equals"/>
    <node name="+" channel="inline" format="path/knowledge" model=".app.logic.functionality.add"/>
    <node name="-" channel="inline" format="path/knowledge" model=".app.logic.functionality.subtract"/>
    <node name="*" channel="inline" format="path/knowledge" model=".app.logic.functionality.multiply"/>
    <node name="/" channel="inline" format="path/knowledge" model=".app.logic.functionality.divide"/>
    <node name="s" channel="inline" format="path/knowledge" model=".app.logic.functionality.square"/>
    <node name="r" channel="inline" format="path/knowledge" model=".app.logic.functionality.squareroot"/>
    <node name="m" channel="inline" format="path/knowledge" model=".app.logic.functionality.modulo"/>
    <node name="n" channel="inline" format="path/knowledge" model=".app.logic.functionality.negate"/>

</node>
