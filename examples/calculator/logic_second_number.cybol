<model>
	<part name="set_last_number" channel="inline" format="modify/overwrite" model="">
		<property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.second_number"/>
		<property name="source" channel="inline" format="path/knowledge" model=".app.safetmp.temp_line"/>
		<property name="type" channel="inline" format="meta/type" model="number/integer"/>
	</part>
	<part name="clear_temp_line_4" channel="inline" format="modify/empty" model="">
		<property name="part" channel="inline" format="path/knowledge" model=".app.safetmp.temp_line"/>
	</part>
	<part name="clear_active_operation" channel="inline" format="modify/empty" model="">
		<property name="part" channel="inline" format="path/knowledge" model=".app.safetmp.active_operation"/>
	</part>
	<part name="reset_temp_position_counter" channel="inline" format="modify/overwrite" model="">
		<property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_position_counter"/>
		<property name="source" channel="inline" format="number/integer" model="0"/>
		<property name="type" channel="inline" format="meta/type" model="number/integer"/>
	</part>
</model>
