<model>	
	<part name="reset_first_number" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".app.safetmp.first_number_result"/>
    </part>
    <part name="set_first_number" channel="inline" format="represent/deserialise" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.first_number_result"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.safetmp.temp_line"/>
        <property name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </part>
</model>
