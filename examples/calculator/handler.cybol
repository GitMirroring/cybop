<model>
    <part name="reset_command" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".safetmp.command"/>
    </part>
    <part name="receive_command" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/tui"/>
        <property name="model" channel="inline" format="path/knowledge" model=".safetmp.command"/>
    </part>
    <part name="append_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".safetmp.path"/>
        <property name="source" channel="inline" format="text/plain" model=".actions."/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_command" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".safetmp.path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".safetmp.command"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="send_command" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".safetmp.path"/>
    </part>
    <part name="sleep_for_some_time_so_that_the_output_can_be_read_by_the_user" channel="inline" format="run/run" model="">
        <property name="programme" channel="inline" format="text/plain" model="sleep 0.8"/>
    </part>
	
	<!-- Overwrite TUI/Cursor -->
	<part name="set_tui_menu" channel="inline" format="communicate/send" model="">
		<property name="channel" channel="inline" format="meta/channel" model="terminal"/>
		<property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
		<property name="language" channel="inline" format="meta/language" model="message/tui"/>
		<property name="format" channel="inline" format="meta/format" model="element/part"/>
		<property name="message" channel="inline" format="path/knowledge" model=".tui.menu_window"/>
		<property name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
	</part>
	<part name="set_tui_input" channel="inline" format="communicate/send" model="">
		<property name="channel" channel="inline" format="meta/channel" model="terminal"/>
		<property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
		<property name="language" channel="inline" format="meta/language" model="message/tui"/>
		<property name="format" channel="inline" format="meta/format" model="element/part"/>
		<property name="message" channel="inline" format="path/knowledge" model=".tui.input_window"/>
		<property name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
	</part>
	<part name="set_cursor" channel="inline" format="communicate/send" model="">
		<property name="channel" channel="inline" format="meta/channel" model="terminal"/>
		<property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
		<property name="language" channel="inline" format="meta/language" model="message/tui"/>
		<property name="format" channel="inline" format="meta/format" model="text/plain"/>
		<property name="message" channel="inline" format="path/knowledge" model=".tui.input_window.imput.cursor"/>
	</part>
</model>