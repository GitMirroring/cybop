<model>
	<model>
    <part name="title" channel="inline" format="text/plain" model="Menu">
        <property name="position" channel="inline" format="number/integer" model="2,1"/>
        <property name="size" channel="inline" format="number/integer" model="4,1"/>
        <property name="background" channel="inline" format="colour/terminal" model="red"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="black"/>
        <property name="bold" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="info_enter_oparetion" channel="inline" format="text/plain" model="Enter: <Number><1.Space><Operation><2.Space><Number><Enter>">
        <property name="position" channel="inline" format="number/integer" model="2,3"/>
        <property name="size" channel="inline" format="number/integer" model="90,1"/>
        <property name="background" channel="inline" format="colour/terminal" model="red"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </part>
    <part name="info_count_operation" channel="inline" format="text/plain" model="1. only 1 Operation each Calculation (+, -, *, /)">
        <property name="position" channel="inline" format="number/integer" model="2,5"/>
        <property name="size" channel="inline" format="number/integer" model="90,1"/>
        <property name="background" channel="inline" format="colour/terminal" model="red"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </part>
	<part name="info_numbers" channel="inline" format="text/plain" model="2. Number-Datatypes are Integer">
        <property name="position" channel="inline" format="number/integer" model="2,6"/>
        <property name="size" channel="inline" format="number/integer" model="90,1"/>
        <property name="background" channel="inline" format="colour/terminal" model="red"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </part>
		<part name="exit" channel="inline" format="text/plain" model="3. C - delete content of active line (clear operation)">
        <property name="position" channel="inline" format="number/integer" model="2,7"/>
        <property name="size" channel="inline" format="number/integer" model="90,1"/>
        <property name="background" channel="inline" format="colour/terminal" model="red"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </part>
	<part name="exit" channel="inline" format="text/plain" model="4. Esc - Exit Calculator">
        <property name="position" channel="inline" format="number/integer" model="2,7"/>
        <property name="size" channel="inline" format="number/integer" model="90,1"/>
        <property name="background" channel="inline" format="colour/terminal" model="red"/>
        <property name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </part>
</model>