<node>

    <!-- basic operations -->

    <node name="add" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_add"/>
        <node name="operand" channel="inline" format="number/integer" model="5"/>
    </node>

    <!-- minimum and maximum -->

    <node name="minimum" channel="inline" format="calculate/minimum" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result_minimum"/>
        <node name="operand" channel="inline" format="number/integer" model="5"/>
    </node>

</node>
