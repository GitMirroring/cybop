<model>
    <!-- Create and Initialise Components -->
    <part name="create_app" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="app"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="init_app" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="calculator/app.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".app"/>
    </part>

    <!-- Write knowledge tree into file. -->
    <part name="TEST_knowledge_tree" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app"/>
        <property name="receiver" channel="inline" format="text/plain" model="test_calculator.txt"/>
    </part>

    <!-- Startup Application -->

    <!-- Startup Terminal -->
    <part name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </part>

    <!-- Send Window on Terminal -->
    <part name="set_window" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/tui"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.tui.menu_window"/>
        <property name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

    <!-- Set Cursor -->
    <part name="set_cursor_start" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/tui"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.tui.cursor"/>
    </part>

    <!-- Set Handler for Terminal -->
    <part name="set_handler_commands_reading" channel="inline" format="live/sense" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="handler" channel="inline" format="path/knowledge" model=".app.handler"/>
    </part>
</model>
