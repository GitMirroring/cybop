<model>
	<!-- Enter -->
	<part name="preperation_calculation" channel="inline" format="element/part" model=".app.logic.last_number">
	
	<!-- Start Calculation -->
	<part name="compare_add" channel="inline" format="compare/equal" model="">
		<property name="operand_1" channel="inline" format="path/knowledge" model=".app.safetmp.operation"/>
		<property name="operand_2" channel="inline" format="text/plain" model="+"/>
		<property name="result" channel="inline" format="path/knowledge" model=".app.safetmp.flag"/>
	</part>
	<part name="addition" channel="inline" format="flow/branch" model="">
		<property name="criterion" channel="inline" format="path/knowledge" model=".app.safetmp.flag"/>
		<property name="true" channel="inline" format="path/knowledge" model=".app.calculation.add_second_number"/>
	</part>

	<part name="compare_sub" channel="inline" format="compare/equal" model="">
		<property name="operand_1" channel="inline" format="path/knowledge" model=".app.safetmp.operation"/>
		<property name="operand_2" channel="inline" format="text/plain" model="-"/>
		<property name="result" channel="inline" format="path/knowledge" model=".app.safetmp.flag"/>
	</part>		
	<part name="subtraction" channel="inline" format="flow/branch" model="">
		<property name="criterion" channel="inline" format="path/knowledge" model=".app.safetmp.flag"/>
		<property name="true" channel="inline" format="path/knowledge" model=".app.calculation.subtract_second_number"/>
	</part>

	<part name="compare_mul" channel="inline" format="compare/equal" model="">
		<property name="operand_1" channel="inline" format="path/knowledge" model=".app.safetmp.operation"/>
		<property name="operand_2" channel="inline" format="text/plain" model="*"/>
		<property name="result" channel="inline" format="path/knowledge" model=".app.safetmp.flag"/>
	</part>		
	<part name="multiplication" channel="inline" format="flow/branch" model="">
		<property name="criterion" channel="inline" format="path/knowledge" model=".app.safetmp.flag"/>
		<property name="true" channel="inline" format="path/knowledge" model=".app.calculation.multiply_second_number"/>
	</part>

	<part name="compare_div" channel="inline" format="compare/equal" model="">
		<property name="operand_1" channel="inline" format="path/knowledge" model=".app.safetmp.operation"/>
		<property name="operand_2" channel="inline" format="text/plain" model="/"/>
		<property name="result" channel="inline" format="path/knowledge" model=".app.safetmp.flag"/>
	</part>		
	<part name="division" channel="inline" format="flow/branch" model="">
		<property name="criterion" channel="inline" format="path/knowledge" model=".app.safetmp.flag"/>
		<property name="true" channel="inline" format="path/knowledge" model=".app.calculation.divide_second_number"/>
	</part>
	
	<!-- Output Result -->
	<part name="give_result" channel="inline" format="modify/overwrite" model="">
		<property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.result_to_show"/>
		<property name="source" channel="inline" format="path/knowledge" model=".app.safetmp.first_number_result"/>
		<property name="type" channel="inline" format="meta/type" model="number/integer"/>
	</part>
</model>