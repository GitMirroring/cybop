<model>
    <part name="handler" channel="file" format="text/cybol" model="http_communication/logic/handler.cybol"/>
    <part name="send_wui_index" channel="file" format="text/cybol" model="http_communication/logic/send_wui_index.cybol"/>
    <part name="exit_programme" channel="file" format="text/cybol" model="http_communication/logic/shutdown.cybol"/>
</model>

