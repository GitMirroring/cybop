<model>
    <!-- The html data transfer object (dto) used as temporary buffer for translation. -->
    <part name="message" channel="inline" encoding="utf-8" format="text/plain" model=""/>
    <part name="index" channel="file" encoding="utf-8" format="text/cybol" model="http_communication/wui/index.cybol">
        <property name="tag" channel="inline" encoding="utf-8" format="text/plain" model="html"/>
        <property name="xmlns" channel="inline" encoding="utf-8" format="text/plain" model="http://www.w3.org/1999/xhtml"/>
    </part>
</model>

