<model>
    <part name="heading" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="HTTP Example Application">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="h1"/>
        <property name="align" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="center"/>
    </part>
    <part name="heading_break" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="br"/>
    </part>
    <part name="patient_list_link" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="Do Something">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="a"/>
        <property name="href" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="http://localhost:1971/?action=do_something"/>
    </part>
    <part name="patient_list_link_line_break" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="br"/>
    </part>
    <part name="shutdown_link" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="Shutdown System">
        <property name="tag" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="a"/>
        <property name="href" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="http://localhost:1971/?action=shutdown"/>
    </part>
</model>

