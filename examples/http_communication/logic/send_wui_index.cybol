<model>
    <part name="test_conversion" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="send">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="file"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/html"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".http_communication.wui.index"/>
        <property name="receiver" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="conversion.html"/>
    </part>
    <part name="translate_into_html" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="send">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="inline"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/html"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".http_communication.wui.index"/>
        <property name="receiver" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".http_communication.wui.message"/>
    </part>
    <part name="test_html" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="send">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="file"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text/plain"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".http_communication.wui.message"/>
        <property name="receiver" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="test.html"/>
    </part>
    <part name="translate_into_http_response" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="send">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="inline"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="message/http-response"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".http_communication.wui.message"/>
        <property name="metadata" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".http_communication.wui.metadata"/>
        <property name="receiver" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".http_communication.wui.response"/>
    </part>
    <part name="send" channel="inline" encoding="utf-8" language="text/cybol" format="operation/plain" model="send">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="cyboi"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".http_communication.wui.response"/>
        <property name="namespace" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="ipv4"/>
        <property name="style" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="stream"/>
        <property name="mode" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="server"/>
    </part>
</model>

