<model>
    <part name="startup" channel="inline" format="operation/plain" model="send">
        <property name="channel" channel="inline" format="text/plain" model="signal"/>
        <property name="message" channel="file" format="text/cybol" model="http_communication/logic/startup.cybol"/>
    </part>
</model>

