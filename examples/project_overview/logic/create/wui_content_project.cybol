<node>

    <node name="create_wui_content_project" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/cybol-path" model="#project_name"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content"/>
    </node>

    <node name="initialise_wui_content_project_part" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="project_overview/wui/content/project.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name)"/>
    </node>
    <node name="initialise_wui_content_project_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="sender" channel="inline" format="text/plain" model="project_overview/wui/content/project_properties.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name)"/>
    </node>

    <node name="overwrite_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name).anchor.heading"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#project_name"/>
    </node>
    <node name="overwrite_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name).anchor:name"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#project_name"/>
    </node>
    <node name="overwrite_description" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name).table.description.content"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".list.(#category_name).(#project_name).description"/>
    </node>
    <node name="overwrite_technology" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name).table.technology.content"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".list.(#category_name).(#project_name).technology"/>
    </node>
    <node name="overwrite_licence" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name).table.licence.content"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".list.(#category_name).(#project_name).licence"/>
    </node>
    <node name="overwrite_portal" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name).table.portal.content"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".list.(#category_name).(#project_name).portal"/>
    </node>
    <node name="overwrite_contact" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name).table.contact.content"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".list.(#category_name).(#project_name).contact"/>
    </node>
    <node name="overwrite_remark" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.content.(#project_name).table.remark.content"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".list.(#category_name).(#project_name).remark"/>
    </node>

</node>
