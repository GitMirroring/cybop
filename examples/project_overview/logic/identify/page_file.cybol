<node>

    <node name="overwrite_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#list_file"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#list_name"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_suffix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#list_file"/>
        <node name="source" channel="inline" format="text/plain" model=".html"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

</node>
