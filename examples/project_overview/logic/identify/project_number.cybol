<node>

    <!--
        CAUTION! Do NOT delete this "empty" operation!
        The "serialise" operation below appends its result,
        so that previous results are not overwritten.
        Therefore, the result variable HAS TO BE emptied beforehand.
    -->
    <node name="empty" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model="project_number"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="serialise_index" channel="inline" format="represent/serialise" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="project_number"/>
        <node name="source" channel="inline" format="text/cybol-path" model="project_index"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>

</node>
