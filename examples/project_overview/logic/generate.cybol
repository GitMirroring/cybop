<node>

    <!-- This entry uses stack variables, given as properties. -->
    <node name="wui" channel="file" format="element/part" model="project_overview/logic/generate/wui.cybol">

        <!-- The loop parametres. -->
        <node name="page_break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="page_count" channel="inline" format="number/integer" model="0"/>
        <node name="page_index" channel="inline" format="number/integer" model="0"/>
        <!-- The element. -->
        <!-- CAUTION! Do NOT use "text/plain" as format here, but "text/cybol-path" instead. -->
        <node name="page_name" channel="inline" format="text/plain" model=""/>
        <!-- Only needed for html page generation. -->
        <node name="page_file" channel="inline" format="text/plain" model=""/>

    </node>

    <node name="page" channel="file" format="element/part" model="project_overview/logic/generate/page.cybol"/>

</node>
