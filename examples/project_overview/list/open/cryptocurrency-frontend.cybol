    <node name="description" channel="inline" format="text/plain" model="Kryptowährung: Application Client"/>
    <node name="technology" channel="inline" format="text/plain" model="Android, Ruboto, Ruby oder Windows+Mac+Linux, JRuby; Quellcodeverwaltung mit Mercurial; Projektverwaltung mit Redmine"/>
