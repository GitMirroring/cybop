<model>
    <part name="usepackage_$0" channel="inline" abstraction="string" model="">
        <property name="paper_format" channel="inline" abstraction="string" model="a4"/>
        <property name="font" channel="inline" abstraction="string" model="times"/>
    </part>
    <part name="usepackage_$1" channel="inline" abstraction="string" model="tocbibind">
        <property name="section" channel="inline" abstraction="string" model="section"/>
        <property name="font" channel="inline" abstraction="string" model="nottoc"/>
        <property name="font" channel="inline" abstraction="string" model="numbib"/>
        <property name="font" channel="inline" abstraction="string" model="numindex"/>
    </part>
    <part name="usepackage_$2" channel="inline" abstraction="string" model="makeidx"/>
    <part name="usepackage_$3" channel="inline" abstraction="string" model="wrapfig"/>
</model>
