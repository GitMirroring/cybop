<model>
    <part name="hoffset" channel="inline" abstraction="integer" model="-30">
        <property name="unit" channel="inline" abstraction="string" model="mm"/>
    </part>
    <part name="voffset" channel="inline" abstraction="integer" model="-27">
        <property name="unit" channel="inline" abstraction="string" model="mm"/>
    </part>
    <part name="oddsidemargin" channel="inline" abstraction="integer" model="30">
        <property name="unit" channel="inline" abstraction="string" model="mm"/>
    </part>
    <part name="evensidemargin" channel="inline" abstraction="integer" model="30">
        <property name="unit" channel="inline" abstraction="string" model="mm"/>
    </part>
    <part name="topmargin" channel="inline" abstraction="integer" model="20">
        <property name="unit" channel="inline" abstraction="string" model="mm"/>
    </part>
    <part name="textwidth" channel="inline" abstraction="integer" model="157">
        <property name="unit" channel="inline" abstraction="string" model="mm"/>
    </part>
    <part name="textheight" channel="inline" abstraction="integer" model="230">
        <property name="unit" channel="inline" abstraction="string" model="mm"/>
    </part>
</model>
