<model>
    <part name="create_domain" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="domain"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
    </part>
    <part name="initialise_domain" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="addition_static_model/domain.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".domain"/>
    </part>
    <part name="add" channel="inline" type="operation/plain" model="add">
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="summand_1" channel="inline" type="path/knowledge" model=".domain.summand_1"/>
        <property name="summand_2" channel="inline" type="path/knowledge" model=".domain.summand_2"/>
        <property name="sum" channel="inline" type="path/knowledge" model=".domain.sum"/>
    </part>
    <part name="print_result" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="shell"/>
        <property name="language" channel="inline" type="text/plain" model="integer"/>
        <property name="message" channel="inline" type="path/knowledge" model=".domain.sum"/>
        <property name="new_line" channel="inline" type="logicvalue/boolean" model="true"/>
    </part>
    <part name="exit_application" channel="inline" type="operation/plain" model="exit"/>
</model>

<!--
    This example uses a small domain model that contains three integer values,
    which are needed for the addition operation.
    The domain model resides externally, in an own cybol file.
    It gets created and added to the runtime knowledge tree automatically,
    when using the "receive" operation and specifying "text/cybol" as data format.
    Then follows the addition and result printing on screen.
/-->

