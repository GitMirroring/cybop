<model>
    <part name="summand_1" channel="inline" type="number/integer" model="4"/>
    <part name="summand_2" channel="inline" type="number/integer" model="5"/>
    <part name="sum" channel="inline" type="number/integer" model="0"/>
</model>

<!--
    This example uses a loop to print the numbers 1 to 10 to screen.
-->

