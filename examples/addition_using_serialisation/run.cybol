<node>

    <node name="create_sum" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="sum"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="create_summand" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="summand"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="create_text" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="text"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="initialise_sum" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".sum"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <!--
        CAUTION! Do NOT initialise the summand here.
        This would lead to a resulting sum integer vector "0,7" instead of just "7".
        The reason is that the deserialise operation appends its result to the destination.
        Therefore, the destination should be EMPTY.
    -->
    <node name="initialise_text" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".text"/>
        <node name="source" channel="inline" format="text/plain" model="7"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <!-- Write knowledge tree into file. -->
    <node name="test_knowledge_tree_summand_pre" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".summand"/>
        <node name="receiver" channel="inline" format="text/plain" model="TEST_ADDITION_SERIALISATION_SUMMAND_PRE.txt"/>
    </node>
    <node name="deserialise_operand" channel="inline" format="represent/deserialise" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".summand"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".text"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </node>
    <node name="add_operand" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".sum"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".summand"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <!-- Write knowledge tree into file. -->
    <node name="test_knowledge_tree_summand_post" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".summand"/>
        <node name="receiver" channel="inline" format="text/plain" model="TEST_ADDITION_SERIALISATION_SUMMAND_POST.txt"/>
    </node>
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="print_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".sum"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <!--
        This is just an example for how to remove all numbers from the ".summand" integer array.
        If repeated deserialisation with overwriting old values is necessary,
        then the destination value has to be REMOVED before calling the deserialise operation.
        This can be achieved using the "modify/empty" or "modify/remove" cybol operation.
    -->
    <node name="remove" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".summand"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="exit_application" channel="inline" format="live/exit" model=""/>
</node>

<!--
    This example creates and initialises two integer values dynamically.
    Also, a text node gets created and initialised.
    Afterwards, the text is deserialised into an integer number
    and the latter added as summand to the sum,
    which finally gets printed on screen.
-->
