<model>
    <part name="create_sum" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="sum"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
    </part>
    <part name="create_summand" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="summand"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
    </part>
    <part name="create_text" channel="inline" encoding="utf-8" language="text/cybol" format="memorise/create" model="">
        <property name="name" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="text"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="part"/>
    </part>
    <part name="initialise_sum" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".sum"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="number/integer" model="0"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
    </part>
    <!--
        CAUTION! Do NOT initialise the summand here.
        This would lead to a resulting sum integer vector "0,7" instead of just "7".
        The reason is that the deserialise operation appends its result to the destination.
        Therefore, the destination should be EMPTY.
    -->
    <part name="initialise_text" channel="inline" encoding="utf-8" language="text/cybol" format="modify/overwrite" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".text"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="7"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="text/plain"/>
    </part>
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree_summand_pre" channel="inline" encoding="utf-8" language="text/cybol" format="communicate/send" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" encoding="utf-8" language="text/cybol" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".summand"/>
        <property name="receiver" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="TEST_ADDITION_SERIALISATION_SUMMAND_PRE.txt"/>
    </part>
    <part name="deserialise_operand" channel="inline" encoding="utf-8" language="text/cybol" format="represent/deserialise" model="">
        <property name="destination" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".summand"/>
        <property name="source" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".text"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/cybol"/>
    </part>
    <part name="add_operand" channel="inline" encoding="utf-8" language="text/cybol" format="calculate/add" model="">
        <property name="result" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".sum"/>
        <property name="operand" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".summand"/>
        <property name="type" channel="inline" encoding="utf-8" language="text/cybol" format="meta/type" model="number/integer"/>
    </part>
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree_summand_post" channel="inline" encoding="utf-8" language="text/cybol" format="communicate/send" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" encoding="utf-8" language="text/cybol" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".summand"/>
        <property name="receiver" channel="inline" encoding="utf-8" language="text/cybol" format="text/plain" model="TEST_ADDITION_SERIALISATION_SUMMAND_POST.txt"/>
    </part>
    <part name="print_result" channel="inline" encoding="utf-8" language="text/cybol" format="communicate/send" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" encoding="utf-8" language="text/cybol" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" encoding="utf-8" language="text/cybol" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" encoding="utf-8" language="text/cybol" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".sum"/>
        <property name="new_line" channel="inline" encoding="utf-8" language="text/cybol" format="logicvalue/boolean" model="true"/>
    </part>
    <!--
        This is just an example for how to remove all numbers from the ".summand" integer array.
        If repeated deserialisation with overwriting old values is necessary,
        then the destination value has to be REMOVED before calling the deserialise operation.
        This can be achieved using the "modify/empty" or "modify/remove" cybol operation.
    -->
    <part name="remove" channel="inline" encoding="utf-8" language="text/cybol" format="modify/empty" model="">
        <property name="part" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".summand"/>
    </part>
    <part name="exit_application" channel="inline" encoding="utf-8" language="text/cybol" format="live/exit" model=""/>
</model>

<!--
    This example creates and initialises two integer values dynamically.
    Also, a text node gets created and initialised.
    Afterwards, the text is deserialised into an integer number
    and the latter added as summand to the sum,
    which finally gets printed on screen.
-->

