<node>

    <node name="create_id" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="id"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>

    <!-- Initialise application -->

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="container_modification/stripper/app.cybol"/>
    </node>
    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <!-- Call stripping operations -->

    <node name="strip_leading" channel="inline" format="modify/strip-leading" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".leading"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".test"/>
    </node>
    <node name="strip_trailing" channel="inline" format="modify/strip-trailing" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".trailing"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".test"/>
    </node>
    <node name="strip_leading_and_trailing" channel="inline" format="modify/strip" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".leading-and-trailing"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".test"/>
    </node>
    <node name="normalise" channel="inline" format="modify/normalise" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".normalised"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".test"/>
    </node>

    <!-- Write results to terminal -->

    <node name="write_string" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".TODO-STRING"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!-- Exit application -->

    <node name="exit_app" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example tests various stripping functions on string data
    and writes the results out to the terminal.
-->
