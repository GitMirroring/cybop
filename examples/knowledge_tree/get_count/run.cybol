<node>

    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="knowledge_tree/get_count/app.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
    </node>

    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <!--
        Vary the "selection" and "filter" properties as needed, e.g.:
        - selection: all, prefix, suffix, subsequence
        - filter: (an arbitrary string)
    -->
    <node name="count" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model=".count"/>
        <node name="part" channel="inline" format="text/cybol-path" model="."/>
        <node name="filter" channel="inline" format="text/plain" model="blubla"/>
        <node name="selection" channel="inline" format="text/plain" model="subsequence"/>
    </node>

    <node name="print_count" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".count"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example tests the "access/count" operation with filter string and selection.
-->
