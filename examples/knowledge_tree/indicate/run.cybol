<node>

    <!-- This is needed for printing messages on terminal. -->
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <node name="create_app" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="app"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>

    </node>
    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="indicate/app.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app"/>
    </node>

    <!-- Empty number. -->

    <node name="reset_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="test_empty_number_empty" channel="inline" format="access/indicate-empty" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.empty_number"/>
    </node>
    <node name="print_flag" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.flag"/>
    </node>

    <node name="reset_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="test_empty_number_exists" channel="inline" format="access/indicate-exists" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.empty_number"/>
    </node>
    <node name="print_flag" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.flag"/>
    </node>

    <!-- Exists number. -->

    <node name="reset_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="test_exists_number_exists" channel="inline" format="access/indicate-exists" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.exists_number"/>
    </node>
    <node name="print_flag" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.flag"/>
    </node>

    <node name="reset_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="test_exists_number_empty" channel="inline" format="access/indicate-empty" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.exists_number"/>
    </node>
    <node name="print_flag" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.flag"/>
    </node>

    <!-- Empty string. -->

    <node name="reset_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="test_empty_string_empty" channel="inline" format="access/indicate-empty" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.empty_string"/>
    </node>
    <node name="print_flag" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.flag"/>
    </node>

    <node name="reset_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="test_empty_string_exists" channel="inline" format="access/indicate-exists" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.empty_string"/>
    </node>
    <node name="print_flag" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.flag"/>
    </node>

    <!-- Exists string. -->

    <node name="reset_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="test_exists_string_exists" channel="inline" format="access/indicate-exists" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.exists_string"/>
    </node>
    <node name="print_flag" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.flag"/>
    </node>

    <node name="reset_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="test_exists_string_empty" channel="inline" format="access/indicate-empty" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.flag"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.exists_string"/>
    </node>
    <node name="print_flag" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.flag"/>
    </node>

    <node name="message" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example demonstrates the cybol operations "access/indicate-empty" and "access/indicate-exists".

    The two operations are ONLY usable with values of format "text/plain".
    They FAIL when being used with values of format "number/integer" and the like,
    since those are created inside cyboi, even if no value was given in cybol.
-->
