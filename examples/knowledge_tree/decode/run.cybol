<node>

    <node name="create_text" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="text"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
    </node>
    <node name="create_result" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="result"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
    </node>

    <node name="initialise_text" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".text"/>
        <node name="source" channel="inline" format="text/plain" model="Ich bin ein Text!"/>
    </node>

    <node name="decode" channel="inline" format="convert/decode" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".text"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    </node>

    <node name="print_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Result:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example tests the copier functionality,
    i.e. shallow as well as deep cloning.
-->
