<node>
    <!-- The command HAS TO BE EMPTIED since otherwise, the new is appended to the old command in the receive operation below. -->
    <node name="reset_command" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".temporary.command"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="receive_command" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <!-- CAUTION! Do NOT use an encoding here, since terminal input is already in wide characters. -->
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".temporary.command"/>
    </node>
    <!-- CAUTION! Use "overwrite" here for initialisation and "append" only afterwards. -->
    <node name="append_path" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".temporary.path"/>
        <node name="source" channel="inline" format="text/plain" model=".actions."/>
    </node>
    <node name="append_command" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".temporary.path"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".temporary.command"/>
    </node>
    <!--
        CAUTION! Do NOT use the "communicate/send" operation with "signal" channel here.
        Otherwise, another signal might be executed before, so that this signal could possibly
        not find all resources anymore, if they meanwhile have been manipulated by the other signal.
        The "flow/sequence" operation ensures that the given model is executed directly.
    -->
    <node name="send_command" channel="inline" format="flow/sequence" model="">
        <!-- CAUTION! The path is NOT a reference. -->
        <node name="model" channel="inline" format="text/cybol-path" model=".temporary.path"/>
    </node>
    <node name="sleep_for_some_time_so_that_the_output_can_be_read_by_the_user" channel="inline" format="run/run" model="">
        <node name="programme" channel="inline" format="text/plain" model="sleep 0.8"/>
    </node>
    <node name="send_tui" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".tui.window"/>
        <node name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="set_cursor" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".tui.cursor"/>
    </node>
</node>

