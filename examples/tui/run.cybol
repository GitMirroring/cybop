    <part name="startup_tui" channel="inline" encoding="utf-8" language="text/cybol" format="maintain/startup" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="terminal"/>
    </part>
    <part name="sense_tui_commands" channel="inline" encoding="utf-8" language="text/cybol" format="live/sense" model="">
        <property name="channel" channel="inline" encoding="utf-8" language="text/cybol" format="meta/channel" model="terminal"/>
        <property name="handler" channel="inline" encoding="utf-8" language="text/cybol" format="path/knowledge" model=".handler"/>
    </part>
</model>

