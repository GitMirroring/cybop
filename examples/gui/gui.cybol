<?xml version="1.0" encoding="ISO-8859-1"?>

<model>
    <part name="main_window" channel="file" abstraction="compound" model="hedam/gui/main_window.cybol">
        <property name="shape" channel="inline" abstraction="character" model="rectangle"/>
        <property name="layout" channel="inline" abstraction="character" model="root"/>
        <property name="cell" channel="inline" abstraction="character" model=""/>
        <property name="position" channel="inline" abstraction="integer" model="200,200,0"/>
        <property name="size" channel="inline" abstraction="integer" model="800,600,1"/>
        <property name="background" channel="inline" abstraction="character" model="white"/>
        <property name="foreground" channel="inline" abstraction="character" model="white"/>
        <property name="title" channel="inline" abstraction="character" model="HEDAM"/>
        <property name="icon" channel="file" abstraction="png" model="hedam/gui/main_window/icon.png"/>
    </part>
</model>

