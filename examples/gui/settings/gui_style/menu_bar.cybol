<?xml version="1.0" encoding="ISO-8859-1"?>

<model>
    <part name="left_border" channel="inline" abstraction="" model="">
        <property name="colour" channel="inline" abstraction="integer" model="0,0,0"/>
        <property name="colour_style" channel="inline" abstraction="character" model="rgb"/>
    </part>
</model>

