<model>
    <part name="create_gui" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="gui"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_logic" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="logic"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_gui" channel="inline" format="communicate/receive" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".gui"/>
        <property name="message" channel="inline" format="text/plain" model="gui/gui.cybol"/>
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
    </part>
    <part name="initialise_logic" channel="inline" format="communicate/receive" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic"/>
        <property name="message" channel="inline" format="text/plain" model="gui/logic.cybol"/>
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
    </part>
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree_gui" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".gui"/>
        <property name="receiver" channel="inline" format="text/plain" model="test_gui_gui.txt"/>
    </part>
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree_logic" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".logic"/>
        <property name="receiver" channel="inline" format="text/plain" model="test_gui_logic.txt"/>
    </part>
    <!-- TEST only. Necessary for displaying test messages on console. Delete later. -->
    <part name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </part>
    <part name="startup_display" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="display"/>
    </part>
    <part name="send_display" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".logic.refresh_display"/>
    </part>
    <part name="sense_display" channel="inline" format="live/sense" model="">
        <property name="channel" channel="inline" format="meta/channel" model="display"/>
        <property name="handler" channel="inline" format="path/knowledge" model=".logic.handler"/>
        <property name="root" channel="inline" format="path/knowledge" model=".gui.window"/>
    </part>
</model>

