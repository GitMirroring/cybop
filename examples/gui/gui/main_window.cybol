<?xml version="1.0" encoding="ISO-8859-1"?>

<model>
    <part name="menu_bar" channel="file" abstraction="compound" model="hedam/gui/main_window/menu_bar.cybol">
        <property name="layout" channel="inline" abstraction="character" model="compass"/>
        <property name="cell" channel="inline" abstraction="character" model="north"/>
        <property name="position" channel="inline" abstraction="integer" model="0,0,0"/>
        <property name="size" channel="inline" abstraction="integer" model="780,20,1"/>
        <property name="left_release" channel="inline" abstraction="knowledge" model=".hedam.logic.exit_program"/>
    </part>
    <part name="status_bar" channel="file" abstraction="compound" model="hedam/gui/main_window/status_bar.cybol">
        <property name="layout" channel="inline" abstraction="character" model="compass"/>
        <property name="cell" channel="inline" abstraction="character" model="south"/>
        <property name="position" channel="inline" abstraction="integer" model="0,20,0"/>
        <property name="size" channel="inline" abstraction="integer" model="780,20,1"/>
    </part>
<!--
    <part name="contents_panel" channel="file" abstraction="compound" model="hedam/gui/main_window/contents_panel.cybol">
        <property name="layout" channel="inline" abstraction="character" model="compass"/>
        <property name="cell" channel="inline" abstraction="character" model="centre"/>
        <property name="position" channel="inline" abstraction="integer" model="0,0,0"/>
        <property name="size" channel="inline" abstraction="integer" model="780,500,1"/>
    </part>
-->
<!--
    <part name="resizable_flag" channel="inline" abstraction="boolean" model="false"/>
-->
</model>

