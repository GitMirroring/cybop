<?xml version="1.0" encoding="ISO-8859-1"?>

<model>
    <part name="exit_program" channel="file" abstraction="png" model="hedam/gui/main_frame/exit_button.png">
        <property name="layout" channel="inline" abstraction="character" model="compass"/>
        <property name="cell" channel="inline" abstraction="character" model="west"/>
        <property name="position" channel="inline" abstraction="integer" model="0,0,0"/>
        <property name="size" channel="inline" abstraction="integer" model="0,0,0"/>
        <property name="mouse_click_action" channel="inline" abstraction="character" model="hedam.logic.exit_program"/>
    </part>
    <part name="show_about_dialogue" channel="file" abstraction="png" model="hedam/gui/main_frame/about_button.png">
        <property name="layout" channel="inline" abstraction="character" model="compass"/>
        <property name="cell" channel="inline" abstraction="character" model="west"/>
        <property name="position" channel="inline" abstraction="integer" model="0,0,0"/>
        <property name="size" channel="inline" abstraction="integer" model="0,0,0"/>
        <property name="mouse_click_action" channel="inline" abstraction="character" model="hedam.logic.show_about_dialogue"/>
    </part>
</model>

