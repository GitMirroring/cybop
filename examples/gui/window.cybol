<model>
    <!-- CAUTION! Colour values for the x window system have to be given as 16 bit values ranging from 0 to 255. -->
    <part name="rectangle_0" channel="inline" format="text/plain" model="Hello, World!">
        <property name="position" channel="inline" format="number/integer" model="20,50"/>
        <property name="size" channel="inline" format="number/integer" model="200,50"/>
        <property name="foreground" channel="inline" format="colour/rgb" model="0,0,0"/>
        <property name="background" channel="inline" format="colour/rgb" model="255,255,0"/>
        <property name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <property name="font" channel="inline" format="text/plain" model="7x13"/>
        <property name="button-release" channel="inline" format="text/plain" model=".app.logic.print_message"/>
        <!--
            CAUTION! The following line may possibly be deleted, since the refresh is done by .app.gui already.
            However, deletion was leading to nothing to be drawn anymore.
            Check this out later!
        -->
        <property name="expose" channel="inline" format="text/plain" model=".app.logic.refresh_display"/>
    </part>
    <part name="rectangle_1" channel="inline" format="text/plain" model="CYBOP Demo">
        <property name="position" channel="inline" format="number/integer" model="150,150"/>
        <property name="size" channel="inline" format="number/integer" model="200,100"/>
        <property name="foreground" channel="inline" format="colour/rgb" model="255,255,255"/>
        <property name="background" channel="inline" format="colour/rgb" model="0,0,255"/>
        <property name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <!-- unit: pixel -->
        <property name="line-width" channel="inline" format="number/integer" model="5"/>
        <!-- butt, not-last, projecting, round -->
        <property name="cap-style" channel="inline" format="text/plain" model="round"/>
        <!-- opaque-stippled, solid, stippled, tiled -->
        <property name="fill-style" channel="inline" format="text/plain" model="solid"/>
        <!-- even-odd, winding -->
        <property name="fill-rule" channel="inline" format="text/plain" model="even-odd"/>
        <!-- bevel, miter, round -->
        <property name="join-style" channel="inline" format="text/plain" model="round"/>
        <!-- double-dash, on-off-dash, solid -->
        <property name="line-style" channel="inline" format="text/plain" model="double-dash"/>
        <property name="font" channel="inline" format="text/plain" model="7x13"/>
        <!--
            CAUTION! The following line may possibly be deleted, since the refresh is done by .app.gui already.
            However, deletion was leading to nothing to be drawn anymore.
            Check this out later!
        -->
        <property name="expose" channel="inline" format="text/plain" model=".app.logic.refresh_display"/>
    </part>
</model>
