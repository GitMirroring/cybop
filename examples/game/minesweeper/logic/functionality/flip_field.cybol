<node>

    <node name="copy_focused_part_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.focused_field_text"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.tui.window.menu:focus"/>
    </node>
    <node name="get_field2" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.focused_field_text"/>
        <node name="source" channel="inline" format="text/plain" model=".value"/>
    </node>

    <node name="copy_focused_part_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.field"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.tui.window.menu:focus"/>
    </node>
    <node name="get_random_field5" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.field"/>
        <node name="source" channel="inline" format="text/plain" model=":mine"/>
    </node>

    <node name="determine_flipped_value" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model="{.app.field}"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.logic.functionality.flip_mine"/>
        <node name="false" channel="inline" format="text/cybol-path" model=".app.logic.functionality.flip_empty"/>
    </node>

</node>
