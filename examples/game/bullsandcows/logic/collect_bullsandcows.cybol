<node>

    <node name="count_bull" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.count_bull"/>
    </node>

    <node name="print_bull_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Bulls: "/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="print_bull" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.bull"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="count_cows" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.count_cow"/>
    </node>

    <node name="print_cow_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model=" Cows: "/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="print_cow" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.cow"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="reset_loose_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.loose_flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="compare_equal" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.loose_flag"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.round_counter"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".app.var.max_round"/>
    </node>

    <node name="reset_win_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.win_flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="compare_equal" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.win_flag"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.bull"/>
        <node name="right" channel="inline" format="number/integer" model="4"/>
    </node>

    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.win_flag"/>
        <node name="true" channel="inline" format="text/cybol-path" model=""/>
        <node name="false" channel="inline" format="text/cybol-path" model=".app.inkrement_round_counter"/>
    </node>

    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.loose_flag"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.loose_dialog"/>
        <node name="false" channel="inline" format="text/cybol-path" model=""/>
    </node>

    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.win_flag"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.win_dialog"/>
        <node name="false" channel="inline" format="text/cybol-path" model=".app.prompt_guess"/>
    </node>



</node>