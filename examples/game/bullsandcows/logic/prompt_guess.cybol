<node>

    <node name="reset" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.choice1_s"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="reset_command" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.choice2_s"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="reset_command" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.choice3_s"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="reset_command" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.choice4_s"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="round" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui">
            <node name="newline" channel="inline" format="logicvalue/boolean" model="false"/>
        </node>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.round_counter"/>
    </node>

     <node name="Round" channel="inline" format="communicate/send" model="">
         <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
         <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
         <node name="language" channel="inline" format="meta/language" model="message/tui"/>
         <node name="format" channel="inline" format="meta/format" model="text/plain"/>
         <node name="message" channel="inline" format="text/plain" model=". Round"/>
      </node>

     <node name="print_question" channel="inline" format="communicate/send" model="">
         <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
         <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
         <node name="language" channel="inline" format="meta/language" model="message/tui"/>
         <node name="format" channel="inline" format="meta/format" model="text/plain"/>
         <node name="message" channel="inline" format="text/plain" model="Make your guess!"/>
      </node>
     <node name="print_question" channel="inline" format="communicate/send" model="">
         <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
         <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui">
            <node name="newline" channel="inline" format="logicvalue/boolean" model="false"/>
        </node>
         <node name="format" channel="inline" format="meta/format" model="text/plain"/>
         <node name="message" channel="inline" format="text/plain" model=">>> "/>
     </node>

     <!--<node name="sense_commands" channel="inline" format="activate/enable" model="">-->
         <!--<node name="channel" channel="inline" format="meta/channel" model="terminal"/>-->
         <!--<node name="handler" channel="inline" format="text/cybol-path" model=".app.choice1"/>-->
     <!--</node>-->

     <node name="get_guess" channel="inline" format="flow/sequence" model="">
         <node name="model" channel="inline" format="text/cybol-path" model=".app.get_guess"/>
     </node>

     <node name="start_comparism" channel="inline" format="flow/sequence" model="">
         <node name="model" channel="inline" format="text/cybol-path" model=".app.tointeger"/>
     </node>

</node>
