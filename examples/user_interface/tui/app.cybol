<node>

    <node name="stdin" channel="inline" format="number/integer" model="-1"/>
    <node name="stdout" channel="inline" format="number/integer" model="-1"/>

    <node name="logic" channel="file" format="element/part" model="user_interface/tui/logic.cybol"/>
    <node name="tui" channel="file" format="element/part" model="user_interface/tui/tui.cybol"/>
    <node name="actions" channel="file" format="element/part" model="user_interface/tui/actions.cybol"/>
    <node name="handle" channel="file" format="element/part" model="user_interface/tui/handle.cybol"/>

    <node name="command" channel="inline" format="text/plain" model=""/>
    <!--
        CAUTION! The path format is "text/cybol-path" and NOT "text/plain".
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handle.cybol" file.
    -->
    <node name="path" channel="inline" format="text/cybol-path" model=""/>

</node>
