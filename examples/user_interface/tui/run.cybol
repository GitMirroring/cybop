<node>

    <node name="create_temporary" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="temporary"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
    </node>
    <node name="create_logic" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="logic"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
    </node>
    <node name="create_tui" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="tui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
    </node>
    <node name="create_actions" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="actions"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
    </node>
    <node name="create_handler" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="handler"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
    </node>

    <node name="initialise_temporary" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="tui/temporary.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".temporary"/>
    </node>
    <node name="initialise_logic" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="tui/logic.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".logic"/>
    </node>
    <node name="initialise_tui" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="tui/tui.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".tui"/>
    </node>
    <node name="initialise_actions" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="tui/actions.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".actions"/>
    </node>
    <node name="initialise_handler" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="tui/handler.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".handler"/>
    </node>

    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="id" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="send_terminal" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".tui.window"/>
        <node name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="set_cursor" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".tui.cursor"/>
    </node>

    <node name="sense_commands" channel="inline" format="activate/enable" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="id" channel="inline" format="number/integer" model="0"/>
        <node name="handler" channel="inline" format="text/cybol-path" model=".handler"/>
    </node>

</node>
