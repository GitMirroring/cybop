<node>

    <node name="command" channel="inline" format="text/plain" model=""/>

    <!--
        CAUTION! The path format is "text/cybol-path" and NOT "text/plain".
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handler.cybol" file.
    -->
    <node name="path" channel="inline" format="text/cybol-path" model=""/>

</node>
