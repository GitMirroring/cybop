<node>

    <node name="receive_command" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#command"/>
        <node name="sender" channel="inline" format="number/integer" model="0"/>
        <node name="port" channel="inline" format="number/integer" model="0"/>
    </node>

    <!-- CAUTION! Use "overwrite" here for initialisation and "append" only afterwards. -->
    <node name="overwrite_path" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.path"/>
        <node name="source" channel="inline" format="text/plain" model=".tui.about_actions."/>
    </node>
    <node name="append_command" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.path"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#command"/>
    </node>

    <!-- CAUTION! The path is NOT a reference. -->
    <node name="send_command" channel="inline" format="text/cybol-path" model=".var.path"/>

</node>
