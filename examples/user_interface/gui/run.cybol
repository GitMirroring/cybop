<node>

    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
        <node name="sender" channel="inline" format="text/plain" model="user_interface/gui/app.cybol"/>
    </node>

    <!-- TEST only. Necessary for displaying test messages on console. Delete later. -->
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="startup_display" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <node name="mode" channel="inline" format="text/plain" model="server"/>
<!--
        <node name="connexions" channel="inline" format="number/integer" model="1"/>
-->
    </node>
    <node name="startup_window" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <node name="mode" channel="inline" format="text/plain" model="client"/>
        <node name="client" channel="inline" format="text/cybol-path" model=".gui.window_id"/>
    </node>

    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".gui.window_id"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="model" channel="inline" format="text/cybol-path" model=".logic.refresh_display"/>

    <node name="sense_display" channel="inline" format="activate/enable" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <node name="handler" channel="inline" format="text/cybol-path" model=".logic.handler"/>
        <node name="root" channel="inline" format="text/cybol-path" model=".gui.window"/>
    </node>

</node>

<!--
    This example prints geometrical figures in a graphical window.
    It also contains buttons, one to print text on console
    and the other to exit the application.
-->
