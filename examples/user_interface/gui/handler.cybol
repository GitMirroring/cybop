<node>

    <!--
        CAUTION! If these variables were not reset here,
        then the last valid previous action would be executed
        again and again, neverendingly.
    -->
    <node name="reset_action" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="receive_event" channel="inline" format="communicate/receive" model="">
        <node name="sender" channel="inline" format="text/cybol-path" model=".gui.window"/>
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <node name="language" channel="inline" format="meta/language" model="event/gui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".gui.action"/>
    </node>

    <!-- Write knowledge tree into file. -->
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_gui_received.txt"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
    </node>

    <!--
        CAUTION! Do NOT use the "communicate/send" operation with "signal" channel here.
        Otherwise, another signal might be executed before, so that this signal could possibly
        not find all resources anymore, if they meanwhile have been manipulated by the other signal.
        The "flow/sequence" operation ensures that the given model is executed directly.

        CAUTION! Use path REFERENCE here, since the action is just
        a string pointing to the actual model to be executed.
    -->
    <node name="execute_action" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model="*.gui.action"/>
    </node>

</node>
