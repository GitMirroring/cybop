<node>

    <!-- CAUTION! Colour values for the x window system have to be given as 16 bit values ranging from 0 to 255. -->
    <node name="rectangle_0" channel="inline" format="text/plain" model="Hello, World!">
        <node name="position" channel="inline" format="number/integer" model="20,50"/>
        <node name="size" channel="inline" format="number/integer" model="200,50"/>
        <!-- yellow -->
        <node name="background" channel="inline" format="colour/rgb" model="255,255,0"/>
        <!-- black -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,0,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="font" channel="inline" format="text/plain" model="7x13"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.print_message"/>
        <!--
            CAUTION! The following line may possibly be deleted, since the refresh is done by .gui already.
            However, deletion was leading to nothing to be drawn anymore.
            Check this out later!
        -->
        <node name="expose" channel="inline" format="text/plain" model=".logic.refresh_display"/>
    </node>

    <node name="rectangle_1" channel="inline" format="text/plain" model="CYBOP Demo">
        <node name="position" channel="inline" format="number/integer" model="150,150"/>
        <node name="size" channel="inline" format="number/integer" model="200,100"/>
        <!-- blue -->
        <node name="background" channel="inline" format="colour/rgb" model="0,0,255"/>
        <!-- white -->
        <node name="foreground" channel="inline" format="colour/rgb" model="255,255,255"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <!-- unit: pixel -->
        <node name="line-width" channel="inline" format="number/integer" model="5"/>
        <!-- butt, not-last, projecting, round -->
        <node name="cap-style" channel="inline" format="text/plain" model="round"/>
        <!-- opaque-stippled, solid, stippled, tiled -->
        <node name="fill-style" channel="inline" format="text/plain" model="solid"/>
        <!-- even-odd, winding -->
        <node name="fill-rule" channel="inline" format="text/plain" model="even-odd"/>
        <!-- bevel, miter, round -->
        <node name="join-style" channel="inline" format="text/plain" model="round"/>
        <!-- double-dash, on-off-dash, solid -->
        <node name="line-style" channel="inline" format="text/plain" model="double-dash"/>
        <node name="font" channel="inline" format="text/plain" model="7x13"/>
        <!--
            CAUTION! The following line may possibly be deleted, since the refresh is done by .gui already.
            However, deletion was leading to nothing to be drawn anymore.
            Check this out later!
        -->
        <node name="expose" channel="inline" format="text/plain" model=".logic.refresh_display"/>
    </node>

</node>
