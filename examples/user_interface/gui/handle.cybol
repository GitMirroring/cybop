<node>

    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="TEST handle"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!--
        CAUTION! If these variables were not reset here, then the last valid
        previous action would be executed again and again, neverendingly.
    -->
    <node name="reset_action" channel="inline" format="text/cybol-path" model=".logic.reset_action"/>

    <node name="receive_event" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <node name="language" channel="inline" format="meta/language" model="event/gui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".gui.action"/>
        <!--
            CAUTION! Do NOT use ".gui.window_id" here, but rather ".gui.window".
            The correct action needs to be read from the window element hierarchy.
            So, the window id related to a windowing system (xcb) does not help here.
        -->
        <node name="sender" channel="inline" format="text/cybol-path" model=".gui.window"/>
    </node>

    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="TEST handle .gui.action"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".gui.action"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!--
        CAUTION! Use path REFERENCE (asterisk) here, since the action is just
        a string pointing to the actual model to be executed.
    -->
    <node name="execute_action" channel="inline" format="text/cybol-path" model="*.gui.action"/>

</node>
