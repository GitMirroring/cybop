<node>

    <node name="button" channel="inline" format="text/plain" model="Click Me!">
        <node name="position" channel="inline" format="number/integer" model="30,30"/>
        <node name="size" channel="inline" format="number/integer" model="100,50"/>
        <!-- blue on purple -->
        <node name="background" channel="inline" format="colour/rgb" model="255,0,255"/>
        <node name="foreground" channel="inline" format="colour/rgb" model="0,0,255"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="font" channel="inline" format="text/plain" model="7x13"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.print_message"/>
    </node>

</node>
