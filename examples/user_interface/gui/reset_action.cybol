<node>

    <!--
        CAUTION! Assigning an empty string with "modify/overwrite" does NOT work.
        Instead, the operation "modify/empty" has to be used here.
    -->
    <node name="reset_action_model" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="reset_event_model" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:event"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <!--
        CAUTION! Do NOT empty (remove) but rather RESET action properties since otherwise,
        they would not exist anymore and values would not be assignable to them anymore.
    -->

    <node name="reset_window" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:window"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_exposed_x" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:exposed_x"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_exposed_y" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:exposed_y"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_exposed_width" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:exposed_width"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_exposed_height" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:exposed_height"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_x" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:x"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_y" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:y"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_button" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:button"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_keycode" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:keycode"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_mask" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:mask"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_mode" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.action:mode"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

</node>
