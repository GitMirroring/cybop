<node>

    <node name="charset" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="meta"/>
        <node name="charset" channel="inline" format="text/plain" model="utf-8"/>
    </node>

    <node name="viewport" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="meta"/>
        <node name="name" channel="inline" format="text/plain" model="viewport"/>
        <node name="content" channel="inline" format="text/plain" model="width=device-width, initial-scale=1, maximum-scale=1"/>
    </node>

    <node name="author" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="meta"/>
        <node name="name" channel="inline" format="text/plain" model="author"/>
        <node name="content" channel="inline" format="text/plain" model="Generated by CYBOI; See http://www.cybop.org/"/>
    </node>

    <node name="css" channel="file" format="text/plain" model="user_interface/ui/wui/format.css">
        <node name="tag" channel="inline" format="text/plain" model="style"/>
    </node>

<!-- OLD solution:
    <node name="css" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="link"/>
        <node name="rel" channel="inline" format="text/plain" model="stylesheet"/>
        <node name="type" channel="inline" format="text/plain" model="text/css"/>
        <node name="href" channel="inline" format="text/plain" model="user_interface/ui/wui/file/format.css"/>
    </node>
-->

    <node name="title" channel="inline" format="text/plain" model="CYBOL User Interface (UI) Example">
        <node name="tag" channel="inline" format="text/plain" model="title"/>
    </node>

</node>
