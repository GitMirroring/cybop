<node>
    <node name="heading" channel="inline" format="text/plain" model="CYBOL User Interface (UI) Example">
        <node name="tag" channel="inline" format="text/plain" model="h1"/>
    </node>
    <node name="box1" channel="inline" format="text/plain" model="empty">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
        <node name="class" channel="inline" format="text/plain" model="box1"/>
    </node>
    <node name="box2" channel="inline" format="text/plain" model="empty">
        <node name="tag" channel="inline" format="text/plain" model="div"/>
        <node name="id" channel="inline" format="text/plain" model="box2"/>
    </node>
    <node name="control" channel="file" format="element/part" model="user_interface/ui/wui/control.cybol">
        <node name="tag" channel="inline" format="text/plain" model="div"/>
        <node name="id" channel="inline" format="text/plain" model="control"/>
    </node>
</node>
