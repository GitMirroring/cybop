<node>

    <node name="label" channel="inline" format="text/plain" model="Press w|arrow-left|up|enter OR c|arrow-right|down for buttons">
        <node name="position" channel="inline" format="number/integer" model="5,17"/>
        <node name="size" channel="inline" format="number/integer" model="70,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="green"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="white"/>
    </node>

</node>
