<node>

    <!--
        CAUTION! Colour values for the x window system
        have to be given as 16 bit values ranging from 0 to 255.
    -->

    <node name="world_button" channel="file" format="element/part" model="user_interface/ui/gui/world_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="20,20"/>
        <node name="size" channel="inline" format="number/integer" model="200,50"/>
        <!-- yellow -->
        <node name="background" channel="inline" format="colour/rgb" model="0,255,255"/>
        <!-- black -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,0,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <!-- unit: pixel -->
        <node name="line-width" channel="inline" format="number/integer" model="1"/>
        <!-- butt, not-last, projecting, round -->
        <node name="cap-style" channel="inline" format="text/plain" model="round"/>
        <!-- opaque-stippled, solid, stippled, tiled -->
        <node name="fill-style" channel="inline" format="text/plain" model="solid"/>
        <!-- even-odd, winding -->
        <node name="fill-rule" channel="inline" format="text/plain" model="even-odd"/>
        <!-- bevel, miter, round -->
        <node name="join-style" channel="inline" format="text/plain" model="round"/>
        <!-- double-dash, on-off-dash, solid -->
        <node name="line-style" channel="inline" format="text/plain" model="solid"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.greet_cybop"/>
    </node>

    <node name="cybop_button" channel="file" format="element/part" model="user_interface/ui/gui/cybop_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="300,20"/>
        <node name="size" channel="inline" format="number/integer" model="200,50"/>
        <!-- yellow -->
        <node name="background" channel="inline" format="colour/rgb" model="0,255,255"/>
        <!-- black -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,0,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <!-- unit: pixel -->
        <node name="line-width" channel="inline" format="number/integer" model="1"/>
        <!-- butt, not-last, projecting, round -->
        <node name="cap-style" channel="inline" format="text/plain" model="round"/>
        <!-- opaque-stippled, solid, stippled, tiled -->
        <node name="fill-style" channel="inline" format="text/plain" model="solid"/>
        <!-- even-odd, winding -->
        <node name="fill-rule" channel="inline" format="text/plain" model="even-odd"/>
        <!-- bevel, miter, round -->
        <node name="join-style" channel="inline" format="text/plain" model="round"/>
        <!-- double-dash, on-off-dash, solid -->
        <node name="line-style" channel="inline" format="text/plain" model="solid"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.greet_cybop"/>
    </node>

</node>
