<node>

    <!--
        CAUTION! Colour values for the x window system
        have to be given as 16 bit values ranging from 0 to 255.
    -->

    <node name="world_button" channel="file" format="element/part" model="user_interface/ui/gui/world_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="20,0"/>
        <node name="size" channel="inline" format="number/integer" model="100,40"/>
        <!-- yellow -->
        <node name="background" channel="inline" format="colour/rgb" model="0,255,255"/>
        <!-- black -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,0,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.greet_world"/>
    </node>

    <node name="cybop_button" channel="file" format="element/part" model="user_interface/ui/gui/cybop_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="280,0"/>
        <node name="size" channel="inline" format="number/integer" model="100,40"/>
        <!-- yellow -->
        <node name="background" channel="inline" format="colour/rgb" model="0,255,255"/>
        <!-- black -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,0,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.greet_cybop"/>
    </node>

</node>
