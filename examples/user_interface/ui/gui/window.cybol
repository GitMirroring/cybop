<node>

    <!-- CAUTION! Colour values for the x window system have to be given as 16 bit values ranging from 0 to 255. -->
    <node name="box1" channel="inline" format="text/plain" model="Label">
        <node name="position" channel="inline" format="number/integer" model="20,50"/>
        <node name="size" channel="inline" format="number/integer" model="200,50"/>
        <!-- yellow -->
        <node name="background" channel="inline" format="colour/rgb" model="255,255,0"/>
        <!-- black -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,0,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="font" channel="inline" format="text/plain" model="7x13"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.greet_cybop"/>
    </node>
    <!-- CAUTION! Colour values for the x window system have to be given as 16 bit values ranging from 0 to 255. -->
    <node name="box2" channel="inline" format="text/plain" model="Label">
        <node name="position" channel="inline" format="number/integer" model="200,150"/>
        <node name="size" channel="inline" format="number/integer" model="200,50"/>
        <!-- blue -->
        <node name="background" channel="inline" format="colour/rgb" model="0,0,255"/>
        <!-- white -->
        <node name="foreground" channel="inline" format="colour/rgb" model="255,255,255"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="font" channel="inline" format="text/plain" model="7x13"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.greet_cybop"/>
    </node>

</node>
