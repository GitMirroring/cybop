<node>

    <!--
        CAUTION! Colour values for the x window system
        have to be given as 16 bit values ranging from 0 to 255.
    -->

    <node name="heading" channel="inline" format="text/plain" model="CYBOL User Interface (UI) Example">
        <node name="position" channel="inline" format="number/integer" model="50,50"/>
        <node name="size" channel="inline" format="number/integer" model="400,40"/>
        <!-- green -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,255,0"/>
        <node name="font" channel="inline" format="text/plain" model="7x13"/>
    </node>

    <node name="box" channel="file" format="element/part" model="user_interface/ui/gui/box.cybol">
        <node name="position" channel="inline" format="number/integer" model="50,100"/>
        <node name="size" channel="inline" format="number/integer" model="400,150"/>
        <!-- blue -->
        <node name="background" channel="inline" format="colour/rgb" model="0,0,255"/>
        <!-- yellow (for border) -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,255,255"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <!-- unit: pixel -->
        <node name="line-width" channel="inline" format="number/integer" model="5"/>
        <!-- butt, not-last, projecting, round -->
        <node name="cap-style" channel="inline" format="text/plain" model="round"/>
        <!-- opaque-stippled, solid, stippled, tiled -->
        <node name="fill-style" channel="inline" format="text/plain" model="solid"/>
        <!-- even-odd, winding -->
        <node name="fill-rule" channel="inline" format="text/plain" model="even-odd"/>
        <!-- bevel, miter, round -->
        <node name="join-style" channel="inline" format="text/plain" model="round"/>
        <!-- double-dash, on-off-dash, solid -->
        <node name="line-style" channel="inline" format="text/plain" model="double-dash"/>
    </node>

    <node name="control" channel="file" format="element/part" model="user_interface/ui/gui/control.cybol">
        <node name="position" channel="inline" format="number/integer" model="50,300"/>
        <node name="size" channel="inline" format="number/integer" model="400,50"/>
    </node>

</node>
