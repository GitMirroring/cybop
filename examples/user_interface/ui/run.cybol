<node>

    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="user_interface/ui/app.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
    </node>

    <node name="startup" channel="inline" format="text/cybol-path" model=".logic.startup"/>
    <node name="greet" channel="inline" format="text/cybol-path" model=".logic.greet-world"/>
    <node name="sense" channel="inline" format="text/cybol-path" model=".logic.sense"/>

</node>

<!--
    This example shows interaction between different user interfaces: tui, gui, wui via socket.
    A click on one of the two buttons leads to updated views on all user interfaces.
-->
