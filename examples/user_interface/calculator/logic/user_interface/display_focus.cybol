<node>

    <node name="determine_button" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tmp.character"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.tui.main.menu:focus"/>
    </node>
    <node name="determine_button_value" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tmp.character"/>
        <node name="source" channel="inline" format="text/plain" model=".value"/>
    </node>

    <node name="append" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tui.main.menu.display.value"/>
        <node name="source" channel="inline" format="text/cybol-path" model="{.app.tmp.character}"/>
    </node>

    <node name="send_tui" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.tui.main"/>
    </node>

</node>
