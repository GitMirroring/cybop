<node>

    <!-- The display HAS TO BE EMPTIED since otherwise, the result is appended to the old operand. -->
    <node name="reset_display" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tui.main.menu.display.value"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="reset_display" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tui.main.menu.display.value"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="serialise_result" channel="inline" format="represent/serialise" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tui.main.menu.display.value"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.tmp.result"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </node>

    <node name="send_tui" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.tui.main"/>
<!--
        <node name="area" channel="inline" format="text/cybol-path" model=".app.tui.main.menu"/>
-->
        <node name="clear" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!--
        CAUTION! The display HAS TO BE EMPTIED here again after refreshing the ui
        since otherwise, new input numbers will be appended to the existing display content,
        which would lead to a not-wanted prefix and false results.
    -->
    <node name="reset_display_again" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tui.main.menu.display.value"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="reset_display_again" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.tui.main.menu.display.value"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

</node>
