<node>

    <node name="name" channel="inline" format="text/plain" model="Calculator 2.0">
        <node name="position" channel="inline" format="number/integer" model="14,2"/>
        <node name="size" channel="inline" format="number/integer" model="20,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="red"/>
    </node>
    <node name="direct" channel="inline" format="text/plain" model="direct number   - input">
        <node name="position" channel="inline" format="number/integer" model="2,5"/>
        <node name="size" channel="inline" format="number/integer" model="20,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </node>
    <node name="direct" channel="inline" format="text/plain" model="direct operator - calculate">
        <node name="position" channel="inline" format="number/integer" model="2,7"/>
        <node name="size" channel="inline" format="number/integer" model="20,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </node>
    <node name="arrow" channel="inline" format="text/plain" model="arrow keys      - move focus">
        <node name="position" channel="inline" format="number/integer" model="2,9"/>
        <node name="size" channel="inline" format="number/integer" model="20,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </node>
    <node name="enter" channel="inline" format="text/plain" model="<enter>         - input">
        <node name="position" channel="inline" format="number/integer" model="2,11"/>
        <node name="size" channel="inline" format="number/integer" model="20,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </node>
    <node name="about" channel="inline" format="text/plain" model="<a>             - show about info">
        <node name="position" channel="inline" format="number/integer" model="2,13"/>
        <node name="size" channel="inline" format="number/integer" model="20,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </node>
    <node name="exit" channel="inline" format="text/plain" model="<e>             - exit">
        <node name="position" channel="inline" format="number/integer" model="2,15"/>
        <node name="size" channel="inline" format="number/integer" model="20,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </node>
    <node name="reset" channel="inline" format="text/plain" model="<esc>           - reset number">
        <node name="position" channel="inline" format="number/integer" model="2,17"/>
        <node name="size" channel="inline" format="number/integer" model="20,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </node>
    <node name="negate" channel="inline" format="text/plain" model="<n>             - negate (+/-)">
        <node name="position" channel="inline" format="number/integer" model="2,19"/>
        <node name="size" channel="inline" format="number/integer" model="20,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </node>

</node>
