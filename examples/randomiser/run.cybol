<model>

    <part name="create_seed" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="seed"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_number" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="number"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>

    <part name="initialise_seed" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".seed"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="initialise_number" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".number"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>

    <part name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </part>

    <!--
        Operation calls using the same seed deliver identical pseudo random numbers.
        Ideally, the seed should change with every call, in C syntax e.g.: srand(time(0)).
        Therefore, the current time is determined as seed here.
    -->
    <part name="get_time" channel="inline" format="time/current" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".seed"/>
    </part>
    <!--
        By default, the current time is used as seed below:
        <property name="seed" channel="inline" format="path/knowledge" model=".seed"/>
        Alternatively, a fixed integer number may be used as seed, e.g.:
        <property name="seed" channel="inline" format="number/integer" model="5"/>
    -->
    <part name="set_seed" channel="inline" format="randomise/sow" model="">
        <property name="seed" channel="inline" format="path/knowledge" model=".seed"/>
    </part>

    <part name="get_random_number_1" channel="inline" format="randomise/retrieve" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".number"/>
        <property name="minimum" channel="inline" format="number/integer" model="20"/>
        <property name="maximum" channel="inline" format="number/integer" model="30"/>
    </part>
    <part name="print_random_number_1" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" format="path/knowledge" model=".number"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

    <part name="get_random_number_2" channel="inline" format="randomise/retrieve" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".number"/>
        <property name="minimum" channel="inline" format="number/integer" model="20"/>
        <property name="maximum" channel="inline" format="number/integer" model="30"/>
    </part>
    <part name="print_random_number_2" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" format="path/knowledge" model=".number"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

    <part name="exit_application" channel="inline" format="live/exit" model=""/>

</model>

<!--
    This example generates a random number and displays it on terminal.
-->

