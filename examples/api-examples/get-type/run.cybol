<node>

    <node name="create_part_1" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="part_1"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
         
    </node>
    <node name="create_part_2" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="part_2"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
         
    </node>

    <node name="initialise_part_1" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".part_1"/>
        <node name="source" channel="inline" format="number/integer" model="2"/>
    </node>
    <node name="initialise_part_2" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".part_2"/>
        <node name="source" channel="inline" format="text/plain" model="blubla"/>
    </node>

    <node name="copy_type_of_part_1_into_model_of_part_2" channel="inline" format="access/get-type" model="">
        <node name="element" channel="inline" format="text/cybol-path" model=".part_2"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".part_1"/>
    </node>

    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="print_model_of_part_2" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="meta/type"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".part_2"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>
