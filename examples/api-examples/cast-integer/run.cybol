<node>

    <node name="create_part_2" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="part_2"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>
    <node name="initialise_part_2" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".part_2"/>
        <node name="source" channel="inline" format="number/integer" model="1"/>
    </node>

    <node name="cast_double" channel="inline" format="cast/integer" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".part_2"/>
        <node name="source" channel="inline" format="number/byte" model="12"/>
    </node>

    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="print_model_of_part_2" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".part_2"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>
