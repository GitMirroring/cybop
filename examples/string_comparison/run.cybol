<node>
    <node name="create_result" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="result"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>

    </node>
    <node name="initialise_result" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="compare" channel="inline" format="compare/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="left" channel="inline" format="text/plain" model="Halli"/>
<!--
        <node name="right" channel="inline" format="text/plain" model="Halli"/>
-->
        <node name="right" channel="inline" format="text/plain" model="Hallo"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>
    <node name="print" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".result"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="exit_application" channel="inline" format="live/exit" model=""/>
</node>

<!--
    This example compares two text strings.
-->
