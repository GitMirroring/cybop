<model>
    <part name="create_result" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="result"/>
        <property name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_result" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".result"/>
        <property name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </part>
    <part name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </part>
    <part name="compare" channel="inline" format="compare/equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".result"/>
        <property name="left" channel="inline" format="text/plain" model="Halli"/>
<!--
        <property name="right" channel="inline" format="text/plain" model="Halli"/>
-->
        <property name="right" channel="inline" format="text/plain" model="Hallo"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="print" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <property name="message" channel="inline" format="path/knowledge" model=".result"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="exit_application" channel="inline" format="live/exit" model=""/>
</model>

<!--
    This example compares two text strings.
-->

