<node>

    <node name="create_app" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="app"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="counter_stack/app.cybol"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app"/>
    </node>

    <!-- Write knowledge tree into file. -->
    <node name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_counter_stack.txt"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app"/>
    </node>

    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <!--
        The classic implementation WITHOUT stack
    -->

    <!-- The break condition has to be GREATER-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_loop_count" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".app.break"/>
        <node name="left" channel="inline" format="path/knowledge" model=".app.index"/>
        <node name="right" channel="inline" format="path/knowledge" model=".app.count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>
    <node name="print_numbers" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="path/knowledge" model=".app.break"/>
        <node name="model" channel="inline" format="path/knowledge" model=".app.model"/>
    </node>

    <!--
        The new implementation WITH stack
    -->

<!--
    <node name="compare_loop_count" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="path/stack" model="break"/>
        <node name="left" channel="inline" format="path/stack" model="index"/>
        <node name="right" channel="inline" format="path/stack" model="count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>
    <node name="print_numbers" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="path/knowledge" model=".app.break"/>
        <node name="model" channel="inline" format="path/knowledge" model=".app.model"/>
-->
        <!-- Define stack variables. -->
<!--
        <node name="count" channel="inline" format="number/integer" model="10"/>
        <node name="index" channel="inline" format="number/integer" model="1"/>
        <node name="break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="model" channel="file" format="element/part" model="counter_stack/model.cybol"/>
    </node>
-->

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example uses a loop to print the numbers 1 to 10 to screen.
    It uses stack variables instead of global heap variables.
-->
