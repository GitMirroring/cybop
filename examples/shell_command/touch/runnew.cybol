<node>

    <node name="touch" channel="inline" format="command/touch" model="">
        <node name="path" channel="inline" format="text/plain" model="./shell_command/touch/leostest.txt"/>
        <!-- <node name="reference" channel="inline" format="text/plain" model=""/> -->
        <node name="timestamp" channel="inline" format="text/plain" model="0912311627"/>
    </node>

    <node name="exit" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example executes a shell command.
