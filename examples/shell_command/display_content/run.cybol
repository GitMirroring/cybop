<node>

    <node name="display-content" channel="inline" format="command/display-content" model="">
        <node name="path" channel="inline" format="text/plain" model="file1"/>
        <node name="squeeze" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="number-lines" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="exit" channel="inline" format="live/exit" model=""/>

</node>

