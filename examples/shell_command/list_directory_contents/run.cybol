<node>

    <node name="list_parent_directory_recursively" channel="inline" format="command/list-directory-contents" model="">
        <node name="path" channel="inline" format="text/plain" model="./.."/>
        <node name="all" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="long" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="one_row_per_entry" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="recursive" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="short" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="sort_by_file_size" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="sort_by_modification" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="sort_by_extension" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="list_files_in_current_directory" channel="inline" format="command/list-directory-contents" model="">
        <node name="all" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="long" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="export" channel="inline" format="text/plain" model="test.txt"/>
    </node>

    <node name="exit" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example executes a shell command.
-->

