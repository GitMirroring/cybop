<model>
    <part name="create_addition_application" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="addition_application"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_summand_1" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="summand_1"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/knowledge" model=".addition_application"/>
    </part>
    <part name="create_summand_2" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="summand_2"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/knowledge" model=".addition_application"/>
    </part>
    <part name="create_sum" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="sum"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/knowledge" model=".addition_application"/>
    </part>
    <part name="initialise_summand_1" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".addition_application.summand_1"/>
        <property name="source" channel="inline" format="number/integer" model="3"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="initialise_summand_2" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".addition_application.summand_2"/>
        <property name="source" channel="inline" format="number/integer" model="4"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="initialise_sum" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".addition_application.sum"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="add_operand_1" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".addition_application.sum"/>
        <property name="operand" channel="inline" format="path/knowledge" model=".addition_application.summand_1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="add_operand_2" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".addition_application.sum"/>
        <property name="operand" channel="inline" format="path/knowledge" model=".addition_application.summand_2"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".addition_application"/>
        <property name="receiver" channel="inline" format="text/plain" model="TEST_ADDITION_DYNAMIC_WITH_ROOT.txt"/>
    </part>
    <part name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </part>
    <part name="print_result" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" format="path/knowledge" model=".addition_application.sum"/>
        <property name="new_line" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="exit_application" channel="inline" format="live/exit" model=""/>
</model>

<!--
    This example is identical to the "addition_dynamic_model" example,
    only that a root node named "addition_application" is created first,
    to which all other values are added (by using the "whole" property).
-->

