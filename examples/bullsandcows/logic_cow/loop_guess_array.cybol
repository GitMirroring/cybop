    <!--<node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>-->
    <!--</node>-->

    <!--<node name="print_adress_help" channel="inline" format="communicate/send" model="">-->
    <!--<node name="channel" channel="inline" format="meta/channel" model="terminal"/>-->
    <!--<node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>-->
    <!--<node name="language" channel="inline" format="meta/language" model="message/cli"/>-->
    <!--<node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>-->
    <!--<node name="message" channel="inline" format="text/cybol-path" model="*.app.var.help_adress"/>-->
    <!--<node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>-->
    <!--</node>-->

    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model="*.app.var.help_adress"/>
        <node name="false" channel="inline" format="text/cybol-path" model=".app.compare_comp_guess"/>
    </node>

    <node name="increment_loop_count" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.counter_y"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

    <node name="compare_loop_count" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.counter_y_b"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.counter_y"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".app.var.counter_y_max"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

</node>
