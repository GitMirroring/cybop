<node>
    <node name="reset_counter" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.counter_x"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>

    <node name="reset_counter_b" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.counter_x_b"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>

    <node name="compare_loop_count" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.counter_x_b"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.counter_x"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".app.var.counter_x_max"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

    <node name="count_cows" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".app.var.counter_x_b"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".app.loop_comp_array"/>
    </node>
</node>