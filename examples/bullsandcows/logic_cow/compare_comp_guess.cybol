    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.x_equal_y_flag"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.inkrement_cow"/>
        <node name="false" channel="inline" format="text/cybol-path" model=""/>
    </node>
    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.x_equal_y_flag"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.set_visited"/>
        <node name="false" channel="inline" format="text/cybol-path" model=""/>
    </node>
