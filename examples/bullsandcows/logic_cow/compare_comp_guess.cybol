    <node name="reset_comparexy" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.x_equal_y_flag"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>

    <node name="compare_equal" channel="inline" format="compare/equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.x_equal_y_flag"/>
        <node name="left" channel="inline" format="text/cybol-path" model="*.app.var.comp_adress"/>
        <node name="right" channel="inline" format="text/cybol-path" model="*.app.var.guess_adress"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

