<node>
    <node name="reset_counter_y" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.counter_y"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <node name="reset_counter_y_b" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.counter_y_b"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="compare_loop_count2" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.counter_y_b"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.counter_y"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".app.var.counter_y_max"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

    <node name="count_cows2" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".app.var.counter_y_b"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".app.loop_guess_array"/>
    </node>
</node>