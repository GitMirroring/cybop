//Auf Eingabe warten und an checknewgame übergeben
<node>
    <node name="neues_spiel" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Neues Spiel starten? [y/n]"/>
        <node name="clear" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="reset_round_counter" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.round_counter"/>
        <node name="source" channel="inline" format="number/integer" model="1"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <node name="sense_commands" channel="inline" format="live/sense" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="handler" channel="inline" format="path/knowledge" model=".app.checknewgame"/>
    </node>

</node>