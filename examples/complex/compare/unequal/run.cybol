<model>
    <part name="create_model" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="model"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_model" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="sender" channel="inline" format="text/plain" model="complex/compare/unequal/model.cybol"/>
        <property name="message" channel="inline" format="path/knowledge" model=".model"/>
    </part>
    <part name="startup_terminal_service" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </part>
    <part name="compare_unequal" channel="inline" format="compare/unequal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".model.result"/>
    <property name="left" channel="inline" format="path/knowledge" model=".model.left"/>
        <property name="right" channel="inline" format="path/knowledge" model=".model.right"/>
    <property name="type" channel="inline" format="meta/type" model="number/complex-cartesian"/>
    <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="print_unequal" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="text/plain" model="Compare (unequal): (1.0 + i 2) != (3 + i 4.12345) = true:"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="print_unequal_result" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <property name="message" channel="inline" format="path/knowledge" model=".model.result"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

    <part name="exit_application" channel="inline" format="live/exit" model=""/>
</model>

