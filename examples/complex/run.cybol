<model>
    <!-- Creation -->
    <part name="create_result" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="result"/>
        <property name="format" channel="inline" format="meta/format" model="number/complex-cartesian"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_operand" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="operand"/>
        <property name="format" channel="inline" format="meta/format" model="number/complex-cartesian"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>

    <!-- Initialisation -->
    <part name="initialise_result" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".result"/>
        <property name="source" channel="inline" format="number/complex-cartesian" model="5,25.5"/>
        <property name="type" channel="inline" format="meta/type" model="number/complex-cartesian"/>
    </part>
    <part name="initialise_operand" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".operand"/>
        <property name="source" channel="inline" format="number/complex-cartesian" model="10.5,11.11"/>
        <property name="type" channel="inline" format="meta/type" model="number/complex-cartesian"/>
    </part>

    <!-- Service startup. -->
    <part name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </part>


    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="number/complex-cartesian"/>
        <property name="message" channel="inline" format="path/knowledge" model=".operand"/>
        <property name="receiver" channel="inline" format="text/plain" model="test_complex_operand.txt"/>
    </part>

    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="number/complex-cartesian"/>
        <property name="message" channel="inline" format="path/knowledge" model=".result"/>
        <property name="receiver" channel="inline" format="text/plain" model="test_complex_result.txt"/>
    </part>

    <!-- Addition -->
    <part name="add_operand" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".result"/>
        <property name="operand" channel="inline" format="path/knowledge" model=".operand"/>
        <property name="type" channel="inline" format="meta/type" model="number/complex-cartesian"/>
    </part>
    <part name="print_addition" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="text/plain" model="Addition: 2.25 + 10.5 = 12.75, 25.5 + 11.11 = 36.61:"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="print_addition_result" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="number/complex-cartesian"/>
        <property name="message" channel="inline" format="path/knowledge" model=".result"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

    

    <!-- Shutdown -->
    <part name="exit_application" channel="inline" format="live/exit" model=""/>
</model>

<!--
    This example calculates values of type "double".
-->

