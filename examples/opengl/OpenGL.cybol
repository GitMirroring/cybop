<node>

  // ...Initialisierung
  <node name="init_opengl" channel="inline" format="graphic/opengl_init" model=""/>

  // Aufbau der 3D Szene

  <node name="open_window" channel="inline" format="graphic/opengl_open_window" model="">
    <node name="title" channel="inline" format="text/plain" model="OpenGL Demo"/>
    <node name="size" channel="inline" format="number/integer" model="1920,1080"/>
    <node name="color_depth" channel="inline" format="number/integer" model="32"/>
    <node name="antialiasing" channel="inline" format="number/integer" model="0"/>
    <node name="fullscreen" channel="inline" format="logicvalue/boolean" model="false"/>
    optional: <node name="monitor" channel="inline" format="number/integer" model="0"/>
  </node>
  <node name="model_house" channel="inline" format="graphic/opengl_create_model" model="">
    <node name="mesh" channel="inline" format="element/part" model="opengl/house.cybol"/>
  </node>
  <node name="camera" channel="inline" format="transform/move" model="">
    <node name="camera" chanel="inline" format="text/cybol-path" model="model_house" />
    <node name="position" chanel="inline" format="number/float" model="3.0f,0.5f,3.0f" />
    <node name="viewpoint" chanel="inline" format="number/float" model="0.0f,0.5f,0.0f" />
    <node name="fov" chanel="inline" format="number/float" model="45.0f" />
  </node>
  <node name="model_move" channel="inline" format="graphic/opengl_move_model" model="">
    <node name="model" chanel="inline" format="text/cybol-path" model="model_house" />
    <node name="scale" chanel="inline" format="number/float" model="1.0f,1.0f,1.0f" />
    <node name="rotation" chanel="inline" format="number/float" model="0.0f,0.0f,0.0f" />
    <node name="translation" chanel="inline" format="number/float" model="0.0f,0.0f,0.0f" />
  </node>

  // Starten einer endlosschleife bis die Anwendung geschlossen wird
  // oder Reaktion auf Eingaben und dann neu Zeichnen
  
  <node name="draw" chanel="inline" format="graphic/opengl_draw" model="Draw_OpenGL" />
  
</node>
