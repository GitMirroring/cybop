<model>

  <part name="first" channel="inline" format="element/part" model="opengl/triangle.cybol">
    <property name="position" chanel="inline" format="number/double" model="-0,5f,0.0f,-0.5f" />
    <property name="scale" chanel="inline" format="number/double" model="1.0f,1.0f,1.0f" />
    <property name="rotation" chanel="inline" format="number/double" model="90.0f,0.0f,0.0f" />
    <property name="color" chanel="inline" format="number/double" model="r,g,b" />
  </part>

  <part name="second" channel="inline" format="element/part" model="opengl/triangle.cybol">
    <property name="position" chanel="inline" format="number/double" model="0,5f,0.0f,0.5f" />
    <property name="scale" chanel="inline" format="number/double" model="1.0f,1.0f,1.0f" />
    <property name="rotation" chanel="inline" format="number/double" model="90.0f,0.0f,180.0f" />
    <property name="color" chanel="inline" format="number/double" model="r,g,b" />
  </part>


</model>