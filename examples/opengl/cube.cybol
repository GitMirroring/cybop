<node>

  <node name="left_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/fraction-decimal" model="-0.5,0.0,0.0"/>
    <node name="scale" chanel="inline" format="number/fraction-decimal" model="1.0,1.0,1.0"/>
    <node name="rotation" chanel="inline" format="number/fraction-decimal" model="0.0,0.0,270.0"/>
    <node name="color" chanel="inline" format="number/fraction-decimal" model="r,g,b"/>
  </node>

  <node name="right_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/fraction-decimal" model="0.5,0.0,0.0"/>
    <node name="scale" chanel="inline" format="number/fraction-decimal" model="1.0,1.0,1.0"/>
    <node name="rotation" chanel="inline" format="number/fraction-decimal" model="0.0,0.0,90.0"/>
    <node name="color" chanel="inline" format="number/fraction-decimal" model="r,g,b"/>
  </node>

  <node name="front_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/fraction-decimal" model="0.0,0.0,0.5"/>
    <node name="scale" chanel="inline" format="number/fraction-decimal" model="1.0,1.0,1.0"/>
    <node name="rotation" chanel="inline" format="number/fraction-decimal" model="270.0,0.0,0.0"/>
    <node name="color" chanel="inline" format="number/fraction-decimal" model="r,g,b"/>
  </node>

  <node name="back_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/fraction-decimal" model="0.0,0.0,-0.5"/>
    <node name="scale" chanel="inline" format="number/fraction-decimal" model="1.0,1.0,1.0"/>
    <node name="rotation" chanel="inline" format="number/fraction-decimal" model="90.0,0.0,0.0"/>
    <node name="color" chanel="inline" format="number/fraction-decimal" model="r,g,b"/>
  </node>

  <node name="top_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/fraction-decimal" model="0.0,0.5,0.0"/>
    <node name="scale" chanel="inline" format="number/fraction-decimal" model="1.0,1.0,1.0"/>
    <node name="rotation" chanel="inline" format="number/fraction-decimal" model="0.0,0.0,0.0"/>
    <node name="color" chanel="inline" format="number/fraction-decimal" model="r,g,b"/>
  </node>

  <node name="bottom_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/fraction-decimal" model="0.0,-0.5,0.0"/>
    <node name="scale" chanel="inline" format="number/fraction-decimal" model="1.0,1.0,1.0"/>
    <node name="rotation" chanel="inline" format="number/fraction-decimal" model="0.0,0.0,180.0"/>
    <node name="color" chanel="inline" format="number/fraction-decimal" model="r,g,b"/>
  </node>

</node>
