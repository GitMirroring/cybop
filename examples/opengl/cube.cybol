 <node>

  <node name="left_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/double" model="-0.5f,0.0f,0.0f" />
    <node name="scale" chanel="inline" format="number/double" model="1.0f,1.0f,1.0f" />
    <node name="rotation" chanel="inline" format="number/double" model="0.0f,0.0f,270.0f" />
    <node name="color" chanel="inline" format="number/double" model="r,g,b" />
  </node>

  <node name="right_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/double" model="0.5f,0.0f,0.0f" />
    <node name="scale" chanel="inline" format="number/double" model="1.0f,1.0f,1.0f" />
    <node name="rotation" chanel="inline" format="number/double" model="0.0f,0.0f,90.0f" />
    <node name="color" chanel="inline" format="number/double" model="r,g,b" />
  </node>

  <node name="front_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/double" model="0.0f,0.0f,0.5f" />
    <node name="scale" chanel="inline" format="number/double" model="1.0f,1.0f,1.0f" />
    <node name="rotation" chanel="inline" format="number/double" model="270.0f,0.0f,0.0f" />
    <node name="color" chanel="inline" format="number/double" model="r,g,b" />
  </node>

  <node name="back_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/double" model="0.0f,0.0f,-0.5f" />
    <node name="scale" chanel="inline" format="number/double" model="1.0f,1.0f,1.0f" />
    <node name="rotation" chanel="inline" format="number/double" model="90.0f,0.0f,0.0f" />
    <node name="color" chanel="inline" format="number/double" model="r,g,b" />
  </node>

  <node name="top_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/double" model="0.0f,0.5f,0.0f" />
    <node name="scale" chanel="inline" format="number/double" model="1.0f,1.0f,1.0f" />
    <node name="rotation" chanel="inline" format="number/double" model="0.0f,0.0f,0.0f" />
    <node name="color" chanel="inline" format="number/double" model="r,g,b" />
  </node>

  <node name="bottom_plane" channel="file" format="element/part" model="opengl/plane.cybol">
    <node name="position" chanel="inline" format="number/double" model="0.0f,-0.5f,0.0f" />
    <node name="scale" chanel="inline" format="number/double" model="1.0f,1.0f,1.0f" />
    <node name="rotation" chanel="inline" format="number/double" model="0.0f,0.0f,180.0f" />
    <node name="color" chanel="inline" format="number/double" model="r,g,b" />
  </node>

</node>
