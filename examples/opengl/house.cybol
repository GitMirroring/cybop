<model>

  <part name="cube" channel="file" format="element/part" model="opengl/cube.cybol">
    <property name="position" chanel="inline" format="number/double" model="0.0f,0.5f,0.0f" />
    <property name="scale" chanel="inline" format="number/double" model="1.0f,1.0f,1.0f" />
    <property name="rotation" chanel="inline" format="number/double" model="0.0f,0.0f,0.0f" />
    <property name="color" chanel="inline" format="colour/rgb" model="255,255,255" />
  </part>

  <part name="roof" channel="file" format="element/part" model="opengl/roof.cybol">
    <property name="position" chanel="inline" format="number/double" model="0.0f,1.0f,0.0f" />
    <property name="scale" chanel="inline" format="number/double" model="1.0f,0.7f,1.0f" />
    <property name="rotation" chanel="inline" format="number/double" model="0.0f,0.0f,0.0f" />
    <property name="color" chanel="inline" format="number/double" model="r,g,b" />
  </part>

  <part name="chimnay" channel="file" format="element/part" model="opengl/cube.cybol">
    <property name="position" chanel="inline" format="number/double" model="-0.25f,1.0f,0.0f" />
    <property name="scale" chanel="inline" format="number/double" model="0.2f,0.5f,0.2f" />
    <property name="rotation" chanel="inline" format="number/double" model="0.0f,0.0f,0.0f" />
    <property name="color" chanel="inline" format="number/double" model="r,g,b" />
  </part>

</model>

