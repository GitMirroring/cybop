<node>

  <node name="cube" channel="file" format="element/part" model="opengl/cube.cybol">
    <node name="position" chanel="inline" format="number/fraction-decimal" model="0.0,0.5,0.0"/>
    <node name="scale" chanel="inline" format="number/fraction-decimal" model="1.0,1.0,1.0"/>
    <node name="rotation" chanel="inline" format="number/fraction-decimal" model="0.0,0.0,0.0"/>
    <node name="color" chanel="inline" format="colour/rgb" model="255,255,255"/>
  </node>

  <node name="roof" channel="file" format="element/part" model="opengl/roof.cybol">
    <node name="position" chanel="inline" format="number/fraction-decimal" model="0.0,1.0,0.0"/>
    <node name="scale" chanel="inline" format="number/fraction-decimal" model="1.0,0.7,1.0"/>
    <node name="rotation" chanel="inline" format="number/fraction-decimal" model="0.0,0.0,0.0"/>
    <node name="color" chanel="inline" format="number/fraction-decimal" model="r,g,b"/>
  </node>

  <node name="chimnay" channel="file" format="element/part" model="opengl/cube.cybol">
    <node name="position" chanel="inline" format="number/fraction-decimal" model="-0.25,1.0,0.0"/>
    <node name="scale" chanel="inline" format="number/fraction-decimal" model="0.2,0.5,0.2"/>
    <node name="rotation" chanel="inline" format="number/fraction-decimal" model="0.0,0.0,0.0"/>
    <node name="color" chanel="inline" format="number/fraction-decimal" model="r,g,b"/>
  </node>

</node>

