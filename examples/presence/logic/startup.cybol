<model>
    <part name="create_presence" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="presence"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
    </part>
    <part name="create_record" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="record"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".presence"/>
    </part>
    <part name="create_temporary_variables" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="temporary"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".presence"/>
    </part>
    <part name="receive_temporary_variables" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="presence/temporary.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".presence.temporary"/>
    </part>
    <part name="create_wui" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="wui"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".presence"/>
    </part>
    <part name="receive_wui" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="presence/wui.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".presence.wui"/>
    </part>
    <!-- TEST http encoding; delete later! -->
    <part name="create_wui_response" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="response"/>
        <property name="abstraction" channel="inline" type="text/plain" model="character"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".presence.wui"/>
    </part>
    <part name="create_logic" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="logic"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".presence"/>
    </part>
    <part name="receive_logic" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="presence/logic.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".presence.logic"/>
    </part>
    <part name="create_logic_www_index_input" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="www_index_input"/>
        <!--
            CAUTION! Do use character and NOT wide_character here!
            The http message body may be encoded and has to be read as plain characters.
        -->
        <property name="abstraction" channel="inline" type="text/plain" model="character"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".presence.logic.handler"/>
    </part>
    <part name="create_wui_index_actions" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="wui_index_actions"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
        <property name="whole" channel="inline" type="path/knowledge" model=".presence.logic.user_interface"/>
    </part>
    <part name="receive_wui_index_actions" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="presence/wui/index/actions.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".presence.logic.user_interface.wui_index_actions"/>
    </part>
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/model-diagram"/>
        <property name="message" channel="inline" type="path/knowledge" model=".presence"/>
        <property name="receiver" channel="inline" type="text/plain" model="TEST_RESIDENZ.txt"/>
    </part>
    <part name="startup_www_service" channel="inline" type="operation/plain" model="startup">
        <property name="service" channel="inline" type="text/plain" model="cyboi"/>
        <property name="namespace" channel="inline" type="text/plain" model="ipv4"/>
        <property name="style" channel="inline" type="text/plain" model="stream"/>
        <property name="address" channel="inline" type="text/plain" model="any"/>
    </part>
    <part name="sense_http_client_requests" channel="inline" type="operation/plain" model="sense">
        <property name="channel" channel="inline" type="text/plain" model="cyboi"/>
        <property name="handler" channel="inline" type="path/knowledge" model=".presence.logic.handler.handle_www_service"/>
    </part>
<!--
    <part name="import_xdt" channel="inline" type="path/knowledge" model=".presence.logic.import.xdt"/>
-->
</model>

