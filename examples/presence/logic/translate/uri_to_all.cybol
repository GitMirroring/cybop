<model>

    <part name="translate_uri_to_wui" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.translate.uri_to_wui.column"/>
    </part>

    <!-- CAUTION! The translation to wui has to be done FIRST, since the translation to db is reading current values from wui. -->
    <part name="translate_uri_to_db" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.translate.uri_to_db.row"/>
    </part>

</model>
