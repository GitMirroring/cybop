<node>

    <node name="translate_uri_to_wui" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.translate.uri_to_wui.column"/>
    </node>

    <node name="send_index" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.send.index"/>
    </node>

    <!-- CAUTION! The translation to wui has to be done FIRST, since the translation to db is reading current values from wui. -->
    <node name="translate_uri_to_db" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.translate.uri_to_db.row"/>
    </node>

</node>
