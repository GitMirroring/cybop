<model>

    <part name="overwrite_reset" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.reset"/>
        <property name="source" channel="inline" format="text/plain" model="db_to_wui_column"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="reset_loop" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.reset.stack.loop"/>
    </part>

    <part name="count_weekdays" channel="inline" format="access/count" model="">
        <property name="count" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.loop.count"/>
        <property name="part" channel="inline" format="path/knowledge" model=".app.weekdays"/>
    </part>

    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.loop.break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.loop.index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.loop.count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>

    <part name="loop_lecturers" channel="inline" format="flow/loop" model="">
        <property name="break" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.loop.break"/>
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.translate.db_to_wui.column"/>
    </part>

</model>
