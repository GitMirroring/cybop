<node>

    <node name="initialise_reset" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.reset"/>
        <node name="source" channel="inline" format="text/plain" model="db_to_wui_column"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="reset_loop" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.reset.stack.loop"/>
    </node>

    <node name="count_weekdays" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.loop.count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.domain.weekdays"/>
    </node>

    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.loop.break"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.loop.index"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.loop.count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

    <node name="loop_lecturers" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.loop.break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.translate.db_to_wui.column"/>
    </node>

</node>
