<model>

    <!--
        Example path:
        presence/db/2015/11/heller.cybol
    -->

    <part name="overwrite_application" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.path.application"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="append_database_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.path.separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_database" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.path.db"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="append_year_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.path.separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_year" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
<!--
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.year"/>
-->
        <property name="source" channel="inline" format="text/plain" model="2015"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="append_week_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.path.separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_week" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
<!--
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.week"/>
-->
        <property name="source" channel="inline" format="text/plain" model="11"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="append_lecturer_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.path.separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_lecturer" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_lecturer.element.name"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="append_suffix_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.path.suffix_separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_file_suffix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.file"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.path.file_suffix"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

</model>
