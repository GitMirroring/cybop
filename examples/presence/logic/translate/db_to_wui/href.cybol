<model>

    <!--
        Example uri:
        http://presence.ba-leipzig.de/?year=2015&week=10&lecturer=heller&day=monday&choice=holiday&action=update
    -->

    <!-- The standard parts. -->
    <part name="overwrite_scheme" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.scheme"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_scheme_suffix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.scheme_suffix"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_hostname_prefix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.hostname_prefix"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_hostname" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.hostname"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_port_prefix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.port_prefix"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_port" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.port"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_directory" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.directory"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_prefix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_prefix"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- The year parametre. -->
    <part name="append_parametre_year_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_year"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_year_assignment" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_assignment"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_year_value" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
<!--
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.year"/>
-->
        <property name="source" channel="inline" format="text/plain" model="2015"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- The week parametre. -->
    <part name="append_parametre_week_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_week_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_week"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_week_assignment" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_assignment"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_week_value" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
<!--
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.week"/>
-->
        <property name="source" channel="inline" format="text/plain" model="10"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- The lecturer parametre. -->
    <part name="append_parametre_lecturer_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_lecturer_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_lecturer"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_lecturer_assignment" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_assignment"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_lecturer_value" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_lecturer.element.name"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- The day parametre. -->
    <part name="append_parametre_day_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_day_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_day"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_day_assignment" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_assignment"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_day_value" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.day"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- The choice parametre. -->
    <part name="append_parametre_choice_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_choice_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_choice"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_choice_assignment" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_assignment"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_choice_value" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.choices.(.app.var.unref)#next"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- The action parametre. -->
    <part name="append_parametre_action_separator" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_separator"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_action_name" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_action"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_action_assignment" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.parametre_assignment"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_action_value" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_column.element.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.uri.action_update"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

</model>
