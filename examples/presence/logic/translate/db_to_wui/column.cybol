<node>

    <!-- Reset. -->
    <!-- Initialisation IS necessary, since data might have got changed within another logic called below. -->
    <node name="initialise_reset" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.reset"/>
        <node name="source" channel="inline" format="text/plain" model="db_to_wui_column"/>
    </node>
    <node name="reset_element" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.reset.stack.element"/>
    </node>

    <!-- Identification. -->
    <node name="overwrite_identify_prefix" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.identify_prefix"/>
        <node name="source" channel="inline" format="text/plain" model=".app.domain."/>
    </node>
    <node name="overwrite_identify_source" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.identify_source"/>
        <node name="source" channel="inline" format="text/plain" model="weekdays"/>
    </node>
    <node name="overwrite_identify" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.identify"/>
        <node name="source" channel="inline" format="text/plain" model="db_to_wui_column"/>
    </node>
    <node name="identify_weekday_number" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.identify.number"/>
    </node>
    <node name="identify_weekday_root" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.identify.root"/>
    </node>
    <node name="get_weekday_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.day"/>
        <node name="part" channel="inline" format="text/cybol-path" model="*.app.var.db_to_wui_column.element.root"/>
    </node>

    <!-- BEGIN: Optimise this in the future using: ((.path.with.reference)) -->

    <node name="overwrite_dbday_path" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.dbday"/>
        <node name="source" channel="inline" format="text/plain" model=".app.var.db."/>
    </node>
    <node name="append_dbday_day" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.dbday"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.day"/>
    </node>
    <node name="overwrite_dbday_reference_with_actual_model" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.unref"/>
        <node name="source" channel="inline" format="text/cybol-path" model="*.app.var.dbday"/>
    </node>

    <!-- END: Optimise this in the future! -->

    <node name="test_for_emptyness" channel="inline" format="access/indicate-empty" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.empty"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.unref"/>
    </node>
    <!-- Fill cell with database values. If those are empty, then use default values. -->
    <node name="translate_cell" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.empty"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.logic.translate.db_to_wui.cell_default"/>
        <node name="false" channel="inline" format="text/cybol-path" model=".app.logic.translate.db_to_wui.cell"/>
    </node>

    <!-- Loop test. -->
    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.loop.index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.loop.break"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.loop.index"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.loop.count"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

</node>
