<node>

    <node name="initialise_reset" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.reset"/>
        <node name="source" channel="inline" format="text/plain" model="uri_to_db"/>
    </node>
    <node name="reset_loop" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.reset.stack.loop"/>
    </node>
    <node name="reset_db" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.reset.db"/>
    </node>

    <node name="count_weekdays" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model=".app.var.uri_to_db.loop.count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.domain.weekdays"/>
    </node>

    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.uri_to_db.loop.break"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.uri_to_db.loop.index"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".app.var.uri_to_db.loop.count"/>
    </node>

    <!-- Fill database element. -->
    <node name="loop_columns" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".app.var.uri_to_db.loop.break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.translate.uri_to_db.column"/>
    </node>

    <node name="save_db_to_file" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.translate.uri_to_db.file"/>
    </node>

</node>
