<node>

    <!--
        Example path:
        presence/db/2015/11/heller.cybol
    -->

    <node name="overwrite_application" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.directory"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.domain.path.application"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <node name="append_database_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.directory"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.domain.path.separator"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_database" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.directory"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.domain.path.db"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <node name="append_year_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.directory"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.domain.path.separator"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_year" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.directory"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.request#uri#query.year"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <node name="append_week_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.directory"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.domain.path.separator"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="append_week" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.directory"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.request#uri#query.week"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

</node>
