<model>

    <!--
        Example uri:
        http://presence.ba-leipzig.de/?lecturer=heller&year=2015&week=10&day=monday&action=choose_holiday
    -->

    <part name="overwrite_scheme" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.communication.scheme"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_scheme_suffix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.communication.scheme_suffix"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_hostname_prefix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.communication.hostname_prefix"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_hostname" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.communication.hostname"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_port_prefix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.communication.port_prefix"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_port" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.communication.port"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_directory" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.communication.directory"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="append_parametre_prefix" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.href"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.communication.parametre_prefix"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

</model>
