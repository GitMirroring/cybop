<model>

    <part name="assign_monday" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.day"/>
        <property name="source" channel="inline" format="text/plain" model="monday"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="translate_monday" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.translate.database_to_wui.column"/>
    </part>

