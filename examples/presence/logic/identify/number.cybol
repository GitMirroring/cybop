<node>

    <node name="serialise_index" channel="inline" format="represent/serialise" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.(.app.var.identify).element.number"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.var.(.app.var.identify).loop.index"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>

</node>
