<node>

    <!-- Web user interface. -->
    <node name="send_index" channel="inline" format="path/knowledge" model=".app.logic.send.index"/>
    <node name="send_css" channel="inline" format="path/knowledge" model=".app.logic.send.css"/>
    <node name="send_header_image" channel="inline" format="path/knowledge" model=".app.logic.send.header_image"/>
    <node name="send_heraldic_symbol" channel="inline" format="path/knowledge" model=".app.logic.send.heraldic_symbol"/>
    <node name="send_icon" channel="inline" format="path/knowledge" model=".app.logic.send.icon"/>

    <!-- Date navigation. -->
    <node name="go_backward" channel="inline" format="path/knowledge" model=".app.logic.go_backward"/>
    <node name="go_forward" channel="inline" format="path/knowledge" model=".app.logic.go_forward"/>

    <!-- Overview entry choice. -->
    <node name="update" channel="inline" format="path/knowledge" model=".app.logic.translate.uri_to_all"/>

</node>
