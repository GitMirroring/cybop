<node>

    <!-- Web page. -->
    <node name="send_index" channel="inline" format="text/cybol-path" model=".app.logic.send.index"/>
    <node name="send_css" channel="inline" format="text/cybol-path" model=".app.logic.send.css"/>
    <node name="send_header_image" channel="inline" format="text/cybol-path" model=".app.logic.send.header_image"/>
    <node name="send_heraldic_symbol" channel="inline" format="text/cybol-path" model=".app.logic.send.heraldic_symbol"/>
    <node name="send_icon" channel="inline" format="text/cybol-path" model=".app.logic.send.icon"/>

    <!-- Date navigation. -->
    <node name="navigate_backward" channel="inline" format="text/cybol-path" model=".app.logic.navigate.backward"/>
    <node name="navigate_forward" channel="inline" format="text/cybol-path" model=".app.logic.navigate.forward"/>

    <!-- Overview entry choice. -->
    <node name="update" channel="inline" format="text/cybol-path" model=".app.logic.translate.uri_to_all"/>

    <!-- Overview entry choice. -->
    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>
