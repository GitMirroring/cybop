<node>

    <node name="decrement_week" channel="inline" format="calculate/subtract" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.week"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>

    <node name="navigate_to_week" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.navigate.week"/>
    </node>

    <!--
        CAUTION! Do NOT send index page in file "logic/navigate/week.cybol".
        It gets called on system startup before a socket was created,
        so that it MUST NOT try to send data yet.
        Therefore, the page is sent only here, reacting to an action request.
    -->
    <node name="send_index" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.send.index"/>
    </node>

</node>
