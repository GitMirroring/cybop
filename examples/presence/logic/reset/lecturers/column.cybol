<model>

    <!-- Reset. -->
    <!-- Initialisation IS necessary, since data might have got changed within another logic called below. -->
    <part name="initialise_reset" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.reset"/>
        <property name="source" channel="inline" format="text/plain" model="db_to_wui_reset"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="reset_element" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.reset.stack.element"/>
    </part>

    <!-- Identification. -->
    <part name="overwrite_identify_prefix" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.identify_prefix"/>
        <property name="source" channel="inline" format="text/plain" model=".app.domain."/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="overwrite_identify_source" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.identify_source"/>
        <property name="source" channel="inline" format="text/plain" model="weekdays"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="overwrite_identify" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.identify"/>
        <property name="source" channel="inline" format="text/plain" model="db_to_wui_reset"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="identify_weekday_number" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.number"/>
    </part>
    <part name="identify_weekday_root" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.root"/>
    </part>
    <part name="get_weekday_name" channel="inline" format="access/get-name" model="">
        <property name="element" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.element.day"/>
        <property name="part" channel="inline" format="path/reference" model=".app.var.db_to_wui_reset.element.root"/>
    </part>

    <part name="overwrite_link" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table.(.app.var.db_to_wui_lecturer.element.name).(.app.var.db_to_wui_reset.element.day).link"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.domain.choices.teaching"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="empty_href" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table.(.app.var.db_to_wui_lecturer.element.name).(.app.var.db_to_wui_reset.element.day).link#href"/>
        <property name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="overwrite_class" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table.(.app.var.db_to_wui_lecturer.element.name).(.app.var.db_to_wui_reset.element.day)#class"/>
        <property name="source" channel="inline" format="text/plain" model="teaching"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- Loop test. -->
    <part name="increment_index" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.loop.index"/>
        <property name="operand" channel="inline" format="number/integer" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.loop.break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.loop.index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.loop.count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>

</model>
