<node>

    <!-- Reset. -->
    <!-- Initialisation IS necessary, since data might have got changed within another logic called below. -->
    <node name="initialise_reset" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.reset"/>
        <node name="source" channel="inline" format="text/plain" model="db_to_wui_reset"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="reset_element" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/knowledge" model=".app.logic.reset.stack.element"/>
    </node>

    <!-- Identification. -->
    <node name="overwrite_identify_prefix" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.identify_prefix"/>
        <node name="source" channel="inline" format="text/plain" model=".app.domain."/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="overwrite_identify_source" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.identify_source"/>
        <node name="source" channel="inline" format="text/plain" model="weekdays"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="overwrite_identify" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.identify"/>
        <node name="source" channel="inline" format="text/plain" model="db_to_wui_reset"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="identify_weekday_number" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.number"/>
    </node>
    <node name="identify_weekday_root" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.root"/>
    </node>
    <node name="get_weekday_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.element.day"/>
        <node name="part" channel="inline" format="path/reference" model=".app.var.db_to_wui_reset.element.root"/>
    </node>

    <node name="overwrite_link" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table.(.app.var.db_to_wui_lecturer.element.name).(.app.var.db_to_wui_reset.element.day).link"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.domain.choices.teaching"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="empty_href" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table.(.app.var.db_to_wui_lecturer.element.name).(.app.var.db_to_wui_reset.element.day).link#href"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="overwrite_class" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table.(.app.var.db_to_wui_lecturer.element.name).(.app.var.db_to_wui_reset.element.day)#class"/>
        <node name="source" channel="inline" format="text/plain" model="teaching"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <!-- Loop test. -->
    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.loop.index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.loop.break"/>
        <node name="left" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.loop.index"/>
        <node name="right" channel="inline" format="path/knowledge" model=".app.var.db_to_wui_reset.loop.count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

</node>
