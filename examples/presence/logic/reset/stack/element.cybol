<node>

    <!--
        CAUTION! Do NOT delete this "empty" operation!
        Some operations below append their result,
        so that previous results are NOT overwritten.
        Therefore, the result variable HAS TO BE emptied beforehand.

        CAUTION! The "overwrite" operation may NOT be used to reset a value,
        since it does NOT copy anything, if the source property value is empty.
    -->

    <node name="empty_number" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.(.app.var.reset).element.number"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="empty_root" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.(.app.var.reset).element.root"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="empty_name" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.(.app.var.reset).element.name"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="empty_day" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.(.app.var.reset).element.day"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="empty_href" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.(.app.var.reset).element.href"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

</node>
