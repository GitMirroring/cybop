<node>

    <node name="empty_file" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.file"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="empty_dbday" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.dbday"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="empty_unref" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.unref"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="empty_db" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.db"/>
        <node name="model" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="reset_flag" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.empty"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </node>

</node>
