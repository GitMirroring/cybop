<model>

    <!-- Reset loop variables. -->

    <!--
        CAUTION! The count has to be reset even though it gets calculated below.
        The reason is that calculation might fail for non-existing parts,
        and using an invalid count of a previous part would lead to wrong results.
    -->
    <part name="reset_count" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.count2"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>

    <part name="reset_index" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.index2"/>
        <property name="source" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>

    <part name="reset_break" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.var.break2"/>
        <property name="source" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </part>

</model>
