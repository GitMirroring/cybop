<node>

    <!-- Reset is NOT necessary, since this is executed only ONCE at application startup. -->

    <node name="count_choices" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model=".app.var.choices.loop.count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".app.domain.choices"/>
    </node>

    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.choices.loop.break"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.choices.loop.index"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".app.var.choices.loop.count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

    <node name="loop_choices" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".app.var.choices.loop.break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.create.choices.row"/>
    </node>

</node>
