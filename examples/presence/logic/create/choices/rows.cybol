<model>

    <part name="count_choices" channel="inline" format="access/count" model="">
        <property name="count" channel="inline" format="path/knowledge" model=".app.var.choice.count"/>
        <property name="part" channel="inline" format="path/knowledge" model=".app.choices"/>
    </part>

    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.choice.break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".app.var.choice.index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".app.var.choice.count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>

    <part name="loop_choices" channel="inline" format="flow/loop" model="">
        <property name="break" channel="inline" format="path/knowledge" model=".app.var.choice.break"/>
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.create.choices.row"/>
    </part>

</model>
