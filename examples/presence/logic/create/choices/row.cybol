<model>

    <part name="reset_element" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.reset.element"/>
    </part>

    <part name="identify_choice_number" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.choice.number"/>
    </part>
    <part name="identify_choice_root" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.choice.root"/>
    </part>
    <part name="get_choice_name" channel="inline" format="access/get-name" model="">
        <property name="element" channel="inline" format="path/knowledge" model=".app.var.name"/>
        <property name="part" channel="inline" format="path/reference" model=".app.var.root"/>
    </part>

    <part name="create_choice" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="path/knowledge" model=".app.var.name"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
        <property name="whole" channel="inline" format="path/knowledge" model=".app.wui.index.body.choices.table"/>
    </part>

    <part name="initialise_choice_part" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="sender" channel="inline" format="text/plain" model="presence/wui/choices/row.cybol"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.wui.index.body.choices.table.(.app.var.name)"/>
    </part>
    <part name="initialise_choice_properties" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/property"/>
        <property name="sender" channel="inline" format="text/plain" model="presence/wui/choices/row_properties.cybol"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.wui.index.body.choices.table.(.app.var.name)"/>
    </part>

    <part name="overwrite_data" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.wui.index.body.choices.table.(.app.var.name).data"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.choices.(.app.var.name)"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="overwrite_class" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.wui.index.body.choices.table.(.app.var.name).data#class"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.var.name"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <!-- Loop test. -->
    <part name="increment_index" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.index"/>
        <property name="operand" channel="inline" format="number/integer" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <part name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.var.break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".app.var.index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".app.var.count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>

</model>
