<node>

    <!-- Reset. -->
    <!-- Initialisation IS necessary, since data might have got changed within another logic called below. -->
    <node name="initialise_reset" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.reset"/>
        <node name="source" channel="inline" format="text/plain" model="lecturers"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="reset_element" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/knowledge" model=".app.logic.reset.stack.element"/>
    </node>

    <!-- Identification. -->
    <node name="overwrite_identify_prefix" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.identify_prefix"/>
        <node name="source" channel="inline" format="text/plain" model=".app.domain."/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="overwrite_identify_source" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.identify_source"/>
        <node name="source" channel="inline" format="text/plain" model="lecturers"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="overwrite_identify" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.var.identify"/>
        <node name="source" channel="inline" format="text/plain" model="lecturers"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>
    <node name="identify_lecturer_number" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.number"/>
    </node>
    <node name="identify_lecturer_root" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="path/knowledge" model=".app.logic.identify.root"/>
    </node>
    <node name="get_lecturer_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="path/knowledge" model=".app.var.lecturers.element.name"/>
        <node name="part" channel="inline" format="path/knowledge" model="*.app.var.lecturers.element.root"/>
    </node>

    <node name="create_lecturer" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="path/knowledge" model=".app.var.lecturers.element.name"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table"/>
    </node>

    <node name="initialise_lecturer_part" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="presence/wui/lecturers/row.cybol"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table.(.app.var.lecturers.element.name)"/>
    </node>
    <node name="initialise_lecturer_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="sender" channel="inline" format="text/plain" model="presence/wui/lecturers/row_properties.cybol"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table.(.app.var.lecturers.element.name)"/>
    </node>

    <node name="overwrite_heading" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".app.wui.index.body.lecturers.table.(.app.var.lecturers.element.name).heading"/>
        <node name="source" channel="inline" format="path/knowledge" model=".app.domain.lecturers.(.app.var.lecturers.element.name)"/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <!-- Loop test. -->
    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".app.var.lecturers.loop.index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".app.var.lecturers.loop.break"/>
        <node name="left" channel="inline" format="path/knowledge" model=".app.var.lecturers.loop.index"/>
        <node name="right" channel="inline" format="path/knowledge" model=".app.var.lecturers.loop.count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

</node>
