<model>

    <part name="teaching" channel="inline" format="text/plain" model="Lehre/Büro">
        <property name="next" channel="inline" format="text/plain" model="homeoffice"/>
    </part>
    <part name="homeoffice" channel="inline" format="text/plain" model="Heimarbeit">
        <property name="next" channel="inline" format="text/plain" model="businesstrip"/>
    </part>
    <part name="businesstrip" channel="inline" format="text/plain" model="Dienstreise">
        <property name="next" channel="inline" format="text/plain" model="holiday"/>
    </part>
    <part name="holiday" channel="inline" format="text/plain" model="Urlaub">
        <property name="next" channel="inline" format="text/plain" model="illness"/>
    </part>
    <part name="illness" channel="inline" format="text/plain" model="Erkrankung">
        <property name="next" channel="inline" format="text/plain" model="bankholiday"/>
    </part>
    <part name="bankholiday" channel="inline" format="text/plain" model="Feiertag">
        <property name="next" channel="inline" format="text/plain" model="teaching"/>
    </part>

</model>
