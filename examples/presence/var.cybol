<node>

    <!-- The logic working universally for the term specified here. -->
    <node name="reset" channel="inline" format="text/plain" model=""/>
    <node name="identify_prefix" channel="inline" format="text/plain" model=""/>
    <node name="identify_source" channel="inline" format="text/plain" model=""/>
    <node name="identify" channel="inline" format="text/plain" model=""/>

    <!-- The creation. -->
    <node name="lecturers" channel="file" format="element/part" model="presence/var/stack.cybol"/>
    <node name="choices" channel="file" format="element/part" model="presence/var/stack.cybol"/>

    <!-- The translation. -->
    <node name="db_to_wui_lecturer" channel="file" format="element/part" model="presence/var/stack.cybol"/>
    <node name="db_to_wui_column" channel="file" format="element/part" model="presence/var/stack.cybol"/>
    <node name="db_to_wui_reset" channel="file" format="element/part" model="presence/var/stack.cybol"/>
    <node name="uri_to_db" channel="file" format="element/part" model="presence/var/stack.cybol"/>

    <!-- The db model. -->
    <node name="file" channel="inline" format="text/plain" model=""/>
    <node name="dbday" channel="inline" format="text/plain" model=""/>
    <node name="unref" channel="inline" format="text/plain" model=""/>
    <node name="db" channel="inline" format="element/part" model=""/>

    <!-- The calendar. -->
    <node name="year" channel="inline" format="number/integer" model="2015"/>
    <node name="week" channel="inline" format="number/integer" model="1"/>
    <node name="year_string" channel="inline" format="text/plain" model="2015"/>
    <node name="week_string" channel="inline" format="text/plain" model="1"/>
<!--
    <node name="day" channel="inline" format="datetime/utc" model="2015-01-01T00:00:00"/>
-->

    <!-- Request-response-cycle. -->
    <node name="request" channel="inline" format="element/part" model=""/>
    <!--
        CAUTION! The path format is "path/knowledge" and NOT "text/plain".
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handler.cybol" file.
    -->
    <node name="path" channel="inline" format="path/knowledge" model=""/>
    <node name="client_socket" channel="inline" format="number/integer" model="0"/>

    <!-- The serialised webpage. -->
    <node name="webpage" channel="inline" format="text/plain" model="">
        <!--
            CAUTION! The necessary "encoding" is added here DIRECTLY,
            since it does NOT work adding it as constraint at the operation "send".
            The reason is that the format "path/knowledge" is used there,
            which points to another (this) part ".app.var.webpage" whose properties are used.
        -->
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    </node>

</node>
