<model>

    <!-- The loop parametres. -->
    <part name="count" channel="inline" format="number/integer" model="0"/>
    <part name="index" channel="inline" format="number/integer" model="0"/>
    <part name="break" channel="inline" format="logicvalue/boolean" model="false"/>

    <!-- The element. -->
    <part name="number" channel="inline" format="text/plain" model=""/>
    <part name="root" channel="inline" format="text/plain" model=""/>
    <part name="name" channel="inline" format="text/plain" model=""/>
    <part name="day" channel="inline" format="text/plain" model=""/>
    <part name="href" channel="inline" format="text/plain" model=""/>

    <!-- The database model. -->
    <part name="file" channel="inline" format="text/plain" model=""/>
    <part name="db" channel="inline" format="element/part" model=""/>

    <!-- The calendar. -->
    <part name="year" channel="inline" format="text/plain" model=""/>
    <part name="week" channel="inline" format="text/plain" model=""/>

    <!-- Request-response-cycle. -->
    <part name="request" channel="inline" format="element/part" model=""/>
    <!--
        CAUTION! The path format is "path/knowledge" and NOT "text/plain".
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handler.cybol" file.
    -->
    <part name="path" channel="inline" format="path/knowledge" model=""/>
    <part name="client_socket" channel="inline" format="number/integer" model="0"/>

    <!-- The serialised webpage. -->
    <part name="webpage" channel="inline" format="text/plain" model="">
        <!--
            CAUTION! The necessary "encoding" is added here DIRECTLY,
            since it does NOT work adding it as constraint at the operation "send".
            The reason is that the format "path/knowledge" is used there,
            which points to another (this) part ".app.var.webpage" whose properties are used.
        -->
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    </part>

</model>
