<model>

    <part name="heading" channel="inline" format="text/plain" model="--">
        <property name="tag" channel="inline" format="text/plain" model="th"/>
        <property name="class" channel="inline" format="text/plain" model="left"/>
    </part>

    <part name="monday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <property name="tag" channel="inline" format="text/plain" model="td"/>
        <property name="class" channel="inline" format="text/plain" model="empty"/>
    </part>
    <part name="tuesday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <property name="tag" channel="inline" format="text/plain" model="td"/>
        <property name="class" channel="inline" format="text/plain" model="empty"/>
    </part>
    <part name="wednesday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <property name="tag" channel="inline" format="text/plain" model="td"/>
        <property name="class" channel="inline" format="text/plain" model="empty"/>
    </part>
    <part name="thursday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <property name="tag" channel="inline" format="text/plain" model="td"/>
        <property name="class" channel="inline" format="text/plain" model="empty"/>
    </part>
    <part name="friday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <property name="tag" channel="inline" format="text/plain" model="td"/>
        <property name="class" channel="inline" format="text/plain" model="empty"/>
    </part>
    <part name="saturday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <property name="tag" channel="inline" format="text/plain" model="td"/>
        <property name="class" channel="inline" format="text/plain" model="empty"/>
    </part>

</model>
