<model>

    <part name="lecturer" channel="inline" format="text/plain" model="Dozent">
        <property name="tag" channel="inline" format="text/plain" model="th"/>
    </part>
    <part name="monday" channel="inline" format="text/plain" model="Montag">
        <property name="tag" channel="inline" format="text/plain" model="th"/>
    </part>
    <part name="tuesday" channel="inline" format="text/plain" model="Dienstag">
        <property name="tag" channel="inline" format="text/plain" model="th"/>
    </part>
    <part name="wednesday" channel="inline" format="text/plain" model="Mittwoch">
        <property name="tag" channel="inline" format="text/plain" model="th"/>
    </part>
    <part name="thursday" channel="inline" format="text/plain" model="Donnerstag">
        <property name="tag" channel="inline" format="text/plain" model="th"/>
    </part>
    <part name="friday" channel="inline" format="text/plain" model="Freitag">
        <property name="tag" channel="inline" format="text/plain" model="th"/>
    </part>
    <part name="saturday" channel="inline" format="text/plain" model="Samstag">
        <property name="tag" channel="inline" format="text/plain" model="th"/>
    </part>

</model>
