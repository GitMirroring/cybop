<model>

    <part name="http-equiv" channel="inline" format="text/plain" model="">
        <property name="tag" channel="inline" format="text/plain" model="meta"/>
        <property name="http-equiv" channel="inline" format="text/plain" model="content-type"/>
        <property name="content" channel="inline" format="text/plain" model="text/html; charset=utf-8"/>
    </part>
    <part name="author" channel="inline" format="text/plain" model="">
        <property name="tag" channel="inline" format="text/plain" model="meta"/>
        <property name="name" channel="inline" format="text/plain" model="author"/>
        <property name="content" channel="inline" format="text/plain" model="Christian Heller &lt;christian.heller@tuxtax.de&gt;. Generated by CYBOI. See http://www.cybop.org/"/>
    </part>
    <part name="robots" channel="inline" format="text/plain" model="">
        <property name="tag" channel="inline" format="text/plain" model="meta"/>
        <property name="name" channel="inline" format="text/plain" model="robots"/>
        <property name="content" channel="inline" format="text/plain" model="noindex"/>
    </part>
    <part name="css" channel="inline" format="text/plain" model="">
        <property name="tag" channel="inline" format="text/plain" model="link"/>
        <property name="rel" channel="inline" format="text/plain" model="stylesheet"/>
        <property name="media" channel="inline" format="text/plain" model="all"/>
        <property name="type" channel="inline" format="text/plain" model="text/css"/>
        <property name="href" channel="inline" format="text/plain" model="http://localhost/?action=send_css"/>
    </part>
    <part name="icon" channel="inline" format="text/plain" model="">
        <property name="tag" channel="inline" format="text/plain" model="link"/>
        <property name="rel" channel="inline" format="text/plain" model="icon"/>
        <property name="type" channel="inline" format="text/plain" model="image/png"/>
        <property name="href" channel="inline" format="text/plain" model="http://localhost/?action=send_icon"/>
    </part>
    <part name="title" channel="inline" format="text/plain" model="Anwesenheit Hauptberufliche Dozenten">
        <property name="tag" channel="inline" format="text/plain" model="title"/>
    </part>

</model>
