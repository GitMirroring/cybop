<node>

    <node name="http-equiv" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="meta"/>
        <node name="http-equiv" channel="inline" format="text/plain" model="content-type"/>
        <node name="content" channel="inline" format="text/plain" model="text/html; charset=utf-8"/>
    </node>
    <node name="author" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="meta"/>
        <node name="name" channel="inline" format="text/plain" model="author"/>
        <node name="content" channel="inline" format="text/plain" model="Christian Heller &lt;christian.heller@tuxtax.de&gt;. Generated by CYBOI. See http://www.cybop.org/"/>
    </node>
    <node name="robots" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="meta"/>
        <node name="name" channel="inline" format="text/plain" model="robots"/>
        <node name="content" channel="inline" format="text/plain" model="noindex"/>
    </node>
    <node name="css" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="link"/>
        <node name="rel" channel="inline" format="text/plain" model="stylesheet"/>
        <node name="media" channel="inline" format="text/plain" model="all"/>
        <node name="type" channel="inline" format="text/plain" model="text/css"/>
        <node name="href" channel="inline" format="text/plain" model="http://localhost/?action=send_css"/>
    </node>
    <node name="icon" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="link"/>
        <node name="rel" channel="inline" format="text/plain" model="icon"/>
        <node name="type" channel="inline" format="text/plain" model="image/png"/>
<!--
        <node name="type" channel="inline" format="text/plain" model="image/vnd.microsoft.icon"/>
-->
        <node name="href" channel="inline" format="text/plain" model="http://localhost/?action=send_icon"/>
    </node>
    <node name="title" channel="inline" format="text/plain" model="Anwesenheit Hauptberufliche Dozenten">
        <node name="tag" channel="inline" format="text/plain" model="title"/>
    </node>

</node>
