<node>

    <node name="backward" channel="file" format="element/part" model="presence/wui/navigation/backward.cybol">
        <node name="tag" channel="inline" format="text/plain" model="td"/>
        <node name="width" channel="inline" format="text/plain" model="100px"/>
        <node name="class" channel="inline" format="text/plain" model="left"/>
    </node>

    <node name="week" channel="inline" format="text/plain" model="02.03.2015 - 07.03.2015 (Kalenderwoche 10)">
        <node name="tag" channel="inline" format="text/plain" model="td"/>
        <node name="class" channel="inline" format="text/plain" model="center"/>
    </node>

    <node name="forward" channel="file" format="element/part" model="presence/wui/navigation/forward.cybol">
        <node name="tag" channel="inline" format="text/plain" model="td"/>
        <node name="width" channel="inline" format="text/plain" model="100px"/>
        <node name="class" channel="inline" format="text/plain" model="right"/>
    </node>

</node>
