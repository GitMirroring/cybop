<model>

    <part name="overwrite_with_home" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.klaus_path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.home_path"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="append_separator_and_klaus" channel="inline" format="modify/append" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.klaus_path"/>
        <property name="source" channel="inline" format="text/plain" model="/klaus"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="serialise_index" channel="inline" format="represent/serialise" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.klaus_path"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.index"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
    </part>

</model>
