<node>

    <!-- The directory and file names. -->
    <node name="archive" channel="inline" format="text/plain" model="./archiv.tar.gz"/>
    <node name="extraction_path" channel="inline" format="text/plain" model="."/>
    <node name="export_path" channel="inline" format="text/plain" model="./export"/>
    <node name="klausur_path" channel="inline" format="text/plain" model="./export/home/klausur"/>
    <node name="home_path" channel="inline" format="text/plain" model="./home"/>
    <node name="klausuruser_files" channel="inline" format="text/plain" model="./home/klausuruser-login*"/>
    <node name="klaus_path" channel="inline" format="text/plain" model=""/>

    <!-- The loop parametres. There are 50 sub directories for users klaus1 to klaus50. -->
    <node name="count" channel="inline" format="number/integer" model="50"/>
    <node name="index" channel="inline" format="number/integer" model="1"/>
    <node name="break" channel="inline" format="logicvalue/boolean" model="false"/>

    <!--
        The variable is compared with number 2 because listing all files using
        "ls -a" also lists the current directory "." and parent directory "..".
        Therefore, otherwise empty directories still have these two entries.
    -->
    <node name="standard_files" channel="inline" format="number/integer" model="2"/>
    <!-- The number of directories and files contained within the given sub directory. -->
    <node name="counted_files" channel="inline" format="number/integer" model="0"/>
    <!-- The branch parametres. -->
    <node name="criterion" channel="inline" format="logicvalue/boolean" model="false"/>

    <!-- The remove logic. -->
    <node name="remove_hidden_directories" channel="file" format="element/part" model="shell_script_clean_result_directory/remove_hidden_directories.cybol"/>
    <node name="remove_directories" channel="file" format="element/part" model="shell_script_clean_result_directory/remove_directories.cybol"/>
    <node name="remove_hidden_files" channel="file" format="element/part" model="shell_script_clean_result_directory/remove_hidden_files.cybol"/>
    <node name="remove_files" channel="file" format="element/part" model="shell_script_clean_result_directory/remove_files.cybol"/>
    <node name="remove_empty_home_directories" channel="file" format="element/part" model="shell_script_clean_result_directory/remove_empty_home_directories.cybol"/>
    <node name="determine_klaus_path" channel="file" format="element/part" model="shell_script_clean_result_directory/determine_klaus_path.cybol"/>
    <node name="check_empty_home_directory" channel="file" format="element/part" model="shell_script_clean_result_directory/check_empty_home_directory.cybol"/>
    <node name="remove_empty_home_directory" channel="file" format="element/part" model="shell_script_clean_result_directory/remove_empty_home_directory.cybol"/>

</node>
