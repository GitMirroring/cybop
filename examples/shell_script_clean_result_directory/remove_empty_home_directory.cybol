<model>

    <part name="remove" channel="inline" format="command/remove" model="">
        <property name="path" channel="inline" format="text/plain" model=".app.klaus_path"/>
        <property name="force" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="interactive" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="recursive" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="verbal" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

</model>
