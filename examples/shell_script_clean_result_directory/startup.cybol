<model>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model=" "/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="\*"/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="\* Shell Script zum Löschen nicht benötigter Verzeichnisse"/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="\* und Dateien aus dem Ergebnisverzeichnis einer Klausur,"/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="\* welches in Form eines komprimierten Archives vorliegt."/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="\*"/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="\* Autor: Christian Heller \<christian.heller@ba-leipzig.de\>"/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="\* Contributor: Alexander Mueller \<alexander.mueller@it2011.ba-leipzig.de\>"/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="\* Version: 2013-02-21""/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="\*"/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model=" "/>
    </part>
    
    
    <!-- define variables -->
    <part name="create_archive" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="archive"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_archive" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".archive"/>
        <property name="source" channel="inline" format="text/plain" model="./shell_script_clean_result_directory/test.tar.gz"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="create_archive_path" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="archive_path"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_archive_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".archive_path"/>
        <property name="source" channel="inline" format="text/plain" model="./shell_script_clean_result_directory"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="create_export_path" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="export_path"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_export_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".export_path"/>
        <property name="source" channel="inline" format="text/plain" model="./shell_script_clean_result_directory/test/export"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="create_klausur_path" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="klausur_path"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_klausur_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".klausur_path"/>
        <property name="source" channel="inline" format="text/plain" model="./shell_script_clean_result_directory/test/export/home/klausur/"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="create_new_klausur_path" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="new_klausur_path"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_new_klausur_path" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".new_klausur_path"/>
        <property name="source" channel="inline" format="text/plain" model="./shell_script_clean_result_directory/home"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="create_klausuruser_files" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="klausuruser_files"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_klausuruser_files" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".klausuruser_files"/>
        <property name="source" channel="inline" format="text/plain" model="./shell_script_clean_result_directory/home/klausuruser-login*"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    
    <!--  -->
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model=" "/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="Setze Lese- und Schreibrechte, damit Datei ohne interaktive Rückfrage gelesen und später gelöscht werden kann."/>
    </part>    
    <part name="chmod_tar_file" channel="inline" format="command/change-permission" model="">
        <property name="path" channel="inline" format="path/knowledge" model=".archive"/>         
        <property name="user" channel="inline" format="text/plain" model="rwx"/>
        <property name="group" channel="inline" format="text/plain" model="rwx"/>
        <property name="other" channel="inline" format="text/plain" model="rwx"/>        
        <property name="recursive" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="verbose" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="silent" channel="inline" format="logicvalue/boolean" model="false"/>
    </part>
    
    <!--  -->
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model=" "/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="Entpacke Inhalt des komprimierten Ergebnisverzeichnisses."/>
    </part>
    <part name="unpack_tar_gz_file" channel="inline" format="command/tape-archiver" model="">
        <property name="source" channel="inline" format="path/knowledge" model=".archive"/>
        <property name="destination" channel="inline" format="path/knowledge" model=".archive_path"/>
        <property name="force" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="gzip" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="unpack" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="recursive" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="verbal" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    
    <!--  -->
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model=" "/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="Setze Lese- und Schreibrechte, damit Unterverzeichnisse und Dateien ohne interaktive Rückfrage bearbeitet werden können."/>
    </part>
    <part name="chmod_export_directory" channel="inline" format="command/change-permission" model="">
        <property name="path" channel="inline" format="path/knowledge" model=".export_path"/>         
        <property name="user" channel="inline" format="text/plain" model="rwx"/>
        <property name="group" channel="inline" format="text/plain" model="rwx"/>
        <property name="other" channel="inline" format="text/plain" model="rwx"/>        
        <property name="recursive" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="verbose" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="silent" channel="inline" format="logicvalue/boolean" model="false"/>
    </part>
    
    <!--  -->
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model=" "/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="Verschiebe Unterverzeichnis auf die aktuelle Ebene und benenne Verzeichnis um in 'home'."/>
    </part>
    <part name="move_file" channel="inline" format="command/move" model="">
        <property name="source" channel="inline" format="path/knowledge" model=".klausur_path"/>
        <property name="destination" channel="inline" format="path/knowledge" model=".new_klausur_path"/>
        <property name="force" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="interactive" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="verbal" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    
    <!--  -->
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model=" "/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="Lösche verbliebenen, nicht benötigten Inhalt rekursiv."/>
    </part>
    <part name="remove_file" channel="inline" format="command/remove" model="">
        <property name="path" channel="inline" format="path/knowledge" model=".export_path"/>
        <property name="force" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="interactive" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="recursive" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="verbal" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    
    <!--   -->
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model=" "/>
    </part>
    <part name="echo_message" channel="inline" format="command/echo" model="">
        <property name="message" channel="inline" format="text/plain" model="Lösche nicht benötigte Klausur user login Dateien."/>
    </part>    
    <part name="remove_file" channel="inline" format="command/remove" model="">
        <property name="path" channel="inline" format="path/knowledge" model=".klausuruser_files"/>
        <property name="force" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="interactive" channel="inline" format="logicvalue/boolean" model="false"/>
        <property name="recursive" channel="inline" format="logicvalue/boolean" model="true"/>
        <property name="verbal" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>   
   
    
    <part name="execute_removes" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="file" format="element/part" model="./shell_script_clean_result_directory/removes.cybol"/>
    </part>
    
    

    <part name="exit" channel="inline" format="live/exit" model=""/>
</model>

