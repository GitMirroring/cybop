<model>

    <!-- The break condition has to be GREATER-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <part name="compare_loop_index" channel="inline" format="compare/greater" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".app.break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".app.index"/>
        <property name="right" channel="inline" format="path/knowledge" model=".app.count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>

    <part name="check_empty_home_directory" channel="inline" format="flow/loop" model="">
        <property name="break" channel="inline" format="path/knowledge" model=".app.break"/>
        <property name="model" channel="inline" format="path/knowledge" model=".app.remove_empty_home_directory"/>
    </part>

</model>
