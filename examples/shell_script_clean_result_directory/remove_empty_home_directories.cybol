<node>

    <!-- The break condition has to be GREATER-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_loop_index" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.break"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".app.index"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".app.count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>

    <node name="check_empty_home_directory" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".app.break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".app.remove_empty_home_directory"/>
    </node>

</node>
