<node>

    <node name="initialise_application" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="checker/app.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
    </node>

    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <node name="print_values_pre" channel="inline" format="text/cybol-path" model=".print"/>
    <node name="manipulate_values" channel="inline" format="text/cybol-path" model=".manipulate"/>

    <!-- Write knowledge into file. -->
<!--
    <node name="test_knowledge" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_checker.txt"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
    </node>
-->

    <node name="check_values" channel="inline" format="text/cybol-path" model=".check"/>
    <node name="print_values_post" channel="inline" format="text/cybol-path" model=".print"/>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example checks primitive values as well as compound parts.
    Checking is just comparison that returns ONE boolean result value.
    Standard comparison, on the other hand, returns a vector with MANY boolean result values.
    For compound parts, DEEP comparison is used.
-->
