<node>

    <node name="print_accept" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Accepted client request at socket:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_socket" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.client_socket"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!-- CAUTION! If the request was not reset here, then the last valid previous request would be used again and again, neverendingly. -->
    <node name="reset_request_model" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.request"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="reset_request_properties" channel="inline" format="modify/empty" model="">
        <node name="part" channel="inline" format="text/cybol-path" model=".app.var.request"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="receive_request" channel="inline" format="communicate/receive" model="">
        <node name="sender" channel="inline" format="text/cybol-path" model=".app.var.client_socket"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.request"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
    </node>

    <!-- CAUTION! Use "overwrite" here for initialisation and "append" only afterwards. -->
    <node name="overwrite_path" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.path"/>
        <node name="source" channel="inline" format="text/plain" model=".app.actions."/>
    </node>
    <node name="append_action" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.path"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.var.request"/>
    </node>

    <node name="print_path_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Action path:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_path" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.path"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_action_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Action:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_action" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model="*.app.var.path"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!--
        CAUTION! Do NOT use the "communicate/send" operation with "signal" channel here.
        Otherwise, another signal might be executed before, so that this signal could possibly
        not find all resources anymore, if they meanwhile have been manipulated by the other signal.
        The "flow/sequence" operation ensures that the given model is executed directly.

        CAUTION! Use path REFERENCE here, since the action is just
        a string pointing to the actual model to be executed.
    -->
    <node name="execute_action" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model="*.app.var.path"/>
    </node>

</node>
