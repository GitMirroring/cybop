<node>

    <node name="create_app" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="app"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>

    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="socket_server/app.cybol"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app"/>
    </node>

    <!-- Write knowledge tree into file. -->
    <node name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".app"/>
        <node name="receiver" channel="inline" format="text/plain" model="test_socket_server.txt"/>
    </node>

    <!-- This is needed for printing test messages on terminal. -->
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="startup_socket" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="namespace" channel="inline" format="text/plain" model="ipv4"/>
        <node name="style" channel="inline" format="text/plain" model="stream"/>
        <node name="protocol" channel="inline" format="text/plain" model="tcp"/>
<!--
        <node name="address" channel="inline" format="text/plain" model="any"/>
        <node name="address" channel="inline" format="text/plain" model="localhost"/>
-->
        <node name="address" channel="inline" format="text/plain" model="127.0.0.1"/>
        <!-- Specify either service name OR id (port) number, NOT both. If both are given, then the port has higher priority. -->
        <node name="id" channel="inline" format="number/integer" model="1971"/>
        <node name="service" channel="inline" format="text/plain" model="http"/>
        <node name="mode" channel="inline" format="text/plain" model="server"/>
        <!--
            If setting the server socket non-blocking,
            cyboi will run a "busy waiting" endless loop,
            and be able to process other signals/events.
            Otherwise, if blocking, the operating system will care
            about waiting for new client requests in socket "accept"
            and meanwhile block any other message processing in cyboi.
            You may try out either here: "true" for blocking; "false" for non-blocking.
        -->
        <node name="blocking" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="connexions" channel="inline" format="number/integer" model="1"/>
    </node>

    <node name="print_message" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Waiting for client requests ..."/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="sense_requests" channel="inline" format="live/sense" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <!-- Specify either service name OR id (port) number, NOT both. If both are given, then the port has higher priority. -->
        <node name="id" channel="inline" format="number/integer" model="1971"/>
        <node name="service" channel="inline" format="text/plain" model="http"/>
        <node name="handler" channel="inline" format="path/knowledge" model=".app.logic.handler"/>
        <node name="sender" channel="inline" format="path/knowledge" model=".app.var.client_socket"/>
    </node>

</node>

<!--
    This example demonstrates the server side of a socket communication.

    CAUTION! The reserved service ports 0..1023 can sometimes only be
    used when running the cybol application as "root" user (Administrator).

    The "nmap" tool may be used to find out about active service ports, e.g.:
    nmap localhost
-->

