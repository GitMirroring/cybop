<node>

    <node name="overwrite_content" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.wui.index.body.content"/>
        <node name="source" channel="inline" format="text/plain" model="The application was shut down successfully. Further requests will fail."/>
        <node name="type" channel="inline" format="meta/type" model="text/plain"/>
    </node>

    <node name="send_index" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".app.logic.send_index"/>
    </node>

    <node name="exit_programme" channel="inline" format="live/exit" model=""/>

</node>
