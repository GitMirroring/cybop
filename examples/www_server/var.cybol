<model>

    <!--
        The client request as received on the server.
        CAUTION! Use "text/ascii" and NOT "text/plain" (wide_character) here.
    -->
    <part name="request" channel="inline" format="text/ascii" model=""/>
    <!--
        The server response as received on the client.
        CAUTION! Use "text/ascii" and NOT "text/plain" (wide_character) here.
    -->
    <part name="response" channel="inline" format="text/ascii" model=""/>

    <!--
        CAUTION! The path format is "path/knowledge" and NOT "text/plain".
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handler.cybol" file.
    -->
    <part name="path" channel="inline" format="path/knowledge" model=""/>

    <part name="server_connexion_socket" channel="inline" format="number/integer" model="0"/>
    <part name="client_connexion_socket" channel="inline" format="number/integer" model="0"/>

</model>
