<model>

    <part name="send" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="socket"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
<!--
        <property name="language" channel="inline" format="meta/language" model="text/html"/>
        <property name="language" channel="inline" format="meta/language" model="message/http-response"/>
-->
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
<!--
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
-->
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
<!--
        <property name="message" channel="inline" format="knowledge/path" model=".app.wui.index"/>
-->
        <property name="message" channel="inline" format="text/plain" model="Hello, World!"/>
<!--
        <property name="meta" channel="inline" format="path/knowledge" model=".app.wui.meta"/>
-->
        <property name="receiver" channel="inline" format="path/knowledge" model=".app.var.client_socket"/>
    </part>

</model>
