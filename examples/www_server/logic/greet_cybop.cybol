<model>

    <part name="overwrite_content" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.wui.index.body.content"/>
        <property name="source" channel="inline" format="text/plain" model="Hello, CYBOP!"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>

    <part name="send_index" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="inline" format="path/knowledge" model=".app.logic.send_index"/>
    </part>

</model>
