<node>

    <!-- .value -->
    <node name="create_value" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="value"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
    </node>

    <node name="init_value" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="inline"/>
        <node name="encoding" chanenl="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="sender" channel="inline" format="text/plain" model="Text"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".value"/>
    </node>

    <!-- .bool -->
    <node name="create_bool" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="bool"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
    </node>

    <node name="init_bool" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="inline"/>
        <node name="encoding" chanenl="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="sender" channel="inline" format="text/plain" model="false"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".bool"/>
    </node>

    <!-- compare -->
    <node name="compare" channel="inline" format="check/equal" model="">
        <node name="left" channel="inline" format="text/cybol-path" model=".value"/>
        <node name="right" channel="inline" format="text/plain" model="Text"/>
        <node name="result" channel="inline" format="text/cybol-path" model=".bool"/>
    </node>

    <node name="startup" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <node name="print" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".bool"/>
    </node>

    <node name="shutdown" channel="inline" format="live/exit" model=""/>

</node>
