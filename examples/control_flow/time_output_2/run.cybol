<!--
    This example uses a loop to repeatedly print the current time.
    A shell command is applied to store the current time in a file.
    Afterwards, the file content is printed on the shell.
-->

<node>

    <node name="create_application" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="counter"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>

    </node>
    <node name="create_break" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="break"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>

        <node name="whole" channel="inline" format="text/cybol-path" model=".counter"/>
    </node>
    <node name="create_count" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="count"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>

        <node name="whole" channel="inline" format="text/cybol-path" model=".counter"/>
    </node>
    <node name="create_maximum" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="maximum"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>

        <node name="whole" channel="inline" format="text/cybol-path" model=".counter"/>
    </node>
    <node name="create_model" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="model"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>

        <node name="whole" channel="inline" format="text/cybol-path" model=".counter"/>
    </node>

    <node name="initialise_break" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".counter.break"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>
    <node name="initialise_count" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".counter.count"/>
        <node name="source" channel="inline" format="number/integer" model="1"/>
    </node>
    <node name="initialise_maximum" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".counter.maximum"/>
        <node name="source" channel="inline" format="number/integer" model="3"/>
    </node>
    <node name="initialise_model" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="time_output_2/model.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".counter.model"/>
    </node>
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <node name="call_loop" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".counter.break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".counter.model"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>
