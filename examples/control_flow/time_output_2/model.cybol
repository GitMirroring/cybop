<node>

    <node name="save_current_time_in_file" channel="inline" format="run/run" model="">
        <node name="programme" channel="inline" format="text/plain" model="date +%X > time_output_2/time.txt"/>
    </node>

    <node name="print_stored_time_on_terminal" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="file" format="text/plain" model="time_output_2/time.txt"/>
    </node>

    <node name="increment_loop_count" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".counter.count"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
