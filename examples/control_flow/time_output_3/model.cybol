<node>

    <node name="execute_shell_script" channel="inline" format="run/run" model="">
        <node name="programme" channel="file" format="text/plain" model="time_output_3/sleep_timer.sh"/>
    </node>

    <node name="print_time" channel="inline" format="run/run" model="">
        <node name="programme" channel="inline" format="text/plain" model="date +%X"/>
    </node>

    <node name="increment_loop_count" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".counter.count"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
