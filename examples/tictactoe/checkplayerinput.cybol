//If-Abfrage q
    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.exit_flag"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.exit.exit_app"/>
        <node name="false" channel="inline" format="text/cybol-path" model=""/>
    </node>

