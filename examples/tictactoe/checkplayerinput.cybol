//Flag setzen Eingabe 1
    <node name="comparison1" channel="inline" format="check/equal" model="">
    <node name="left" channel="inline" format="text/cybol-path" model=".app.var.command"/>
    <node name="right" channel="inline" format="text/plain" model="1"/>
    <node name="result" channel="inline" format="text/cybol-path" model=".app.var.flag_field_1"/>
    </node>

//Empty-Field Flag rücksetzen
