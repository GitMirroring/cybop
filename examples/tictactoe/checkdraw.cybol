//Wingame Flag rücksetzen
    <node name="wingame" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.wingame"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="flag_selected_9" channel="inline" format="logify/or" model="">
