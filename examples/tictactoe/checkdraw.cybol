//Test auf draw, wenn nicht -> computerturn
    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.wingame"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.computerturn"/>
        <node name="false" channel="inline" format="text/cybol-path" model=".app.draw"/>
    </node>


</node>

