<model>

//Zeichen löschen
    <part name="reset_command" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".app.var.command"/>
        <property name="model" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>

//Speichern der Nachricht in Variable
    <part name="receive_command" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <!-- CAUTION! Do NOT use an encoding here, since terminal input is already in wide characters. -->
        <property name="language" channel="inline" format="meta/language" model="message/tui"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.var.command"/>
    </part>


//Ausgabe der Nachricht
    <part name="send_message" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="message/cli"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="path/knowledge" model=".app.var.command"/>
    <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>


//Flag setzen Eingabe yes
    <part name="comparison1" channel="inline" format="compare/equal" model="">
    <property name="left" channel="inline" format="path/knowledge" model=".app.var.command"/>
    <property name="right" channel="inline" format="text/plain" model="y"/>
    <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    <property name="result" channel="inline" format="path/knowledge" model=".app.var.newgame_flag"/>
    <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>

//Flag setzen Eingabe no
    <part name="comparison2" channel="inline" format="compare/equal" model="">
    <property name="left" channel="inline" format="path/knowledge" model=".app.var.command"/>
    <property name="right" channel="inline" format="text/plain" model="n"/>
    <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    <property name="result" channel="inline" format="path/knowledge" model=".app.var.no_newgame_flag"/>
    <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>

//Flag setzen Eingabe q
    <part name="comparison3" channel="inline" format="compare/equal" model="">
    <property name="left" channel="inline" format="path/knowledge" model=".app.var.command"/>
    <property name="right" channel="inline" format="text/plain" model="q"/>
    <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    <property name="result" channel="inline" format="path/knowledge" model=".app.var.exit_flag"/>
    <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>


//If-Abfrage yes
    <part name="if-then-else" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="path/knowledge" model=".app.var.newgame_flag"/>
        <property name="true" channel="inline" format="path/knowledge" model=".app.initialising"/>
        <property name="false" channel="inline" format="path/knowledge" model=".app.inputnewgame"/>
    </part>

//If-Abfrage no
    <part name="if-then-else" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="path/knowledge" model=".app.var.no_newgame_flag"/>
        <property name="true" channel="inline" format="path/knowledge" model=".app.exit.exit_app"/>
        <property name="false" channel="inline" format="path/knowledge" model=""/>
    </part>

//If-Abfrage q
    <part name="if-then-else" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="path/knowledge" model=".app.var.exit_flag"/>
        <property name="true" channel="inline" format="path/knowledge" model=".app.exit.exit_app"/>
        <property name="false" channel="inline" format="path/knowledge" model=""/>
    </part>

</model>
