<model>
    <part name="create_result" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="result"/>
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
    </part>
    <part name="add" channel="inline" type="operation/plain" model="add">
        <property name="abstraction" channel="inline" type="text/plain" model="integer"/>
        <property name="summand_1" channel="inline" type="number/integer" model="1"/>
        <property name="summand_2" channel="inline" type="number/integer" model="2"/>
        <property name="sum" channel="inline" type="path/knowledge" model=".result"/>
    </part>
    <part name="print_result" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="shell"/>
        <property name="language" channel="inline" type="text/plain" model="integer"/>
        <property name="message" channel="inline" type="path/knowledge" model=".result"/>
        <property name="new_line" channel="inline" type="logicvalue/boolean" model="true"/>
    </part>
    <part name="exit_application" channel="inline" type="operation/plain" model="exit"/>
</model>

<!--
    This example adds two integer values and prints the resulting sum on screen.
-->

