<node>

    <!-- Creation -->
    <node name="create_date" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="date"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>

    </node>
    <node name="create_duration" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="duration"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>

    </node>

    <!-- Initialisation -->
    <node name="initialise_date" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".date"/>
        <node name="source" channel="file" format="element/part" model="datetime/date.cybol"/>
    </node>
    <node name="initialise_duration" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".duration"/>
        <node name="source" channel="file" format="element/part" model="datetime/duration.cybol"/>
    </node>

    <!-- Service startup. -->
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>

    <!-- Print date examples. -->
    <node name="print_date_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Date:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_date_values" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".date"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_date_line_end" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model=""/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!-- Print special date example. -->
    <node name="print_special_date_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Special Date:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_special_date_values" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="datetime/jd"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".date.jd"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_special_date_line_end" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model=""/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!-- Print duration examples. -->
    <node name="print_duration_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Duration:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_duration_values" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".duration"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_duration_line_end" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model=""/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!-- Shutdown -->
    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example deserialises (parses) and serialises values
    in various "datetime" and "duration" formats.
-->
