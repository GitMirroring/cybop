<model>
    <!-- Since the "whole" property is not given the greeting model is added to the knowledge memory root. -->
    <part name="create_greeting" channel="inline" type="operation/plain" model="create">
        <property name="name" channel="inline" type="text/plain" model="greeting"/>
        <property name="abstraction" channel="inline" type="text/plain" model="compound"/>
        <property name="element" channel="inline" type="text/plain" model="part"/>
    </part>
    <part name="receive_greeting" channel="inline" type="operation/plain" model="receive">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/cybol"/>
        <property name="message" channel="inline" type="text/plain" model="helloworld/greeting.cybol"/>
        <property name="model" channel="inline" type="path/knowledge" model=".greeting"/>
    </part>
    <!-- Write knowledge tree into file. This is only for testing reasons and can also be deleted. -->

    <part name="test_knowledge_tree" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="file"/>
        <property name="language" channel="inline" type="text/plain" model="text/model-diagram"/>
        <property name="message" channel="inline" type="path/knowledge" model=".greeting"/>
        <property name="receiver" channel="inline" type="text/plain" model="TEST_HELLOWORLD.txt"/>
    </part>

    <part name="startup_gnu_linux_console" channel="inline" type="operation/plain" model="startup">
        <property name="service" channel="inline" type="text/plain" model="gnu-linux-console"/>
    </part>
    <part name="send_greeting_to_output" channel="inline" type="operation/plain" model="send">
        <property name="channel" channel="inline" type="text/plain" model="gnu-linux-console"/>
<!--
        <property name="language" channel="inline" type="text/plain" model="text/plain"/>
-->
        <property name="message" channel="inline" type="path/knowledge" model=".greeting"/>
        <property name="clean" channel="inline" type="logicvalue/boolean" model="true"/>
    </part>
<!--
    <part name="shutdown_gnu_linux_console" channel="inline" type="operation/plain" model="shutdown">
        <property name="service" channel="inline" type="text/plain" model="gnu-linux-console"/>
    </part>
-->
<!--
    <part name="destroy_greeting" channel="inline" type="operation/plain" model="destroy">
        <property name="model" channel="inline" type="path/knowledge" model=".greeting"/>
    </part>
-->
    <part name="exit_application" channel="inline" type="operation/plain" model="exit"/>
</model>

