<model>
    <!--
        Reset voltage buffer.
        CAUTION! This is necessary because the microcontroller does sometimes
        not return values, so that old values from former loop cycles would be used.
    -->
    <part name="reset_buffer" channel="inline" format="modify/empty" model="">
        <property name="part" channel="inline" format="path/knowledge" model=".settings.voltage_buffer"/>
        <property name="model" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="reset_count" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_count"/>
        <property name="source" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_count_default"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="reset_criterion" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_criterion"/>
        <property name="source" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_criterion_default"/>
        <property name="type" channel="inline" format="meta/type" model="logicvalue/boolean"/>
    </part>
    <part name="reset_high_byte" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_high_byte"/>
        <property name="source" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_high_byte_default"/>
        <property name="type" channel="inline" format="meta/type" model="number/byte"/>
    </part>
    <part name="reset_low_byte" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_low_byte"/>
        <property name="source" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_low_byte_default"/>
        <property name="type" channel="inline" format="meta/type" model="number/byte"/>
    </part>
    <part name="reset_checksum" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_checksum"/>
        <property name="source" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_checksum_default"/>
        <property name="type" channel="inline" format="meta/type" model="number/byte"/>
    </part>
</model>

