<node>
    <!-- Default values are given for those variables, which have to be reset or manipulated within the programme. -->
    <!-- device -->
    <node name="device" channel="inline" format="meta/channel" model="serial-port"/>
    <node name="device_filename" channel="inline" format="text/plain" model="/dev/ttyACM0"/>
    <node name="device_baudrate" channel="inline" format="number/integer" model="115200"/>
    <node name="device_channel" channel="inline" format="text/plain" model="c01"/>
    <!-- temperature -->
    <node name="temperature" channel="inline" format="number/fraction-decimal" model="0.0"/>
    <node name="temperature_summand" channel="inline" format="number/fraction-decimal" model="0.0"/>
    <node name="temperature_break" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="temperature_count" channel="inline" format="number/integer" model="0"/>
    <node name="temperature_maximum_count" channel="inline" format="number/integer" model="5"/>
    <node name="temperature_maximum_count_divisor" channel="inline" format="number/fraction-decimal" model="1.0"/>
    <node name="temperature_conversion_factor" channel="inline" format="number/fraction-decimal" model="10.0"/>
    <!-- voltage -->
    <!-- CAUTION! Do NOT use -1 as initial value since otherwise, the sum will be one too small. -->
    <node name="voltage" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_default" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_break" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="voltage_break_default" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="voltage_count" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_count_default" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_maximum_count" channel="inline" format="number/integer" model="21"/>
    <node name="voltage_high_byte" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_high_byte_default" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_low_byte" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_low_byte_default" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_byte_value" channel="inline" format="number/integer" model="256"/>
    <node name="voltage_criterion" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="voltage_criterion_default" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="voltage_error" channel="inline" format="text/plain" model="Error: The voltage is not valid."/>
    <!-- Sleep for 100 ms = 100,000 us = 100,000,000 ns. -->
    <node name="voltage_sleep" channel="inline" format="number/integer" model="100000000"/>
    <!-- voltage buffer -->
    <!-- The voltage buffer model initially has to be empty, since it gets filled when reading from serial port. -->
    <node name="voltage_buffer" channel="inline" format="number/byte" model=""/>
    <node name="voltage_buffer_minimum" channel="inline" format="number/integer" model="3"/>
    <node name="voltage_buffer_count" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_buffer_count_default" channel="inline" format="number/integer" model="0"/>
    <node name="voltage_buffer_criterion" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="voltage_buffer_criterion_default" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="voltage_buffer_high_byte" channel="inline" format="number/byte" model="0"/>
    <node name="voltage_buffer_high_byte_default" channel="inline" format="number/byte" model="0"/>
    <node name="voltage_buffer_low_byte" channel="inline" format="number/byte" model="0"/>
    <node name="voltage_buffer_low_byte_default" channel="inline" format="number/byte" model="0"/>
    <!-- QUESTION: Should checksum not be an integer, since it may be 255 + 255 which is greater than unsigned char? But the buffer may only contain elements of type unsigned char. -->
    <node name="voltage_buffer_checksum" channel="inline" format="number/byte" model="0"/>
    <node name="voltage_buffer_checksum_default" channel="inline" format="number/byte" model="0"/>
    <!-- checksum -->
    <!--
        CAUTION! Do NOT use -1 as initial value since otherwise, the sum will be one too small.
        Also, the format "number/byte" gets translated into type "unsigned char",
        which CANNOT hold negative values!
    -->
    <node name="checksum" channel="inline" format="number/byte" model="0"/>
    <node name="checksum_default" channel="inline" format="number/byte" model="0"/>
    <node name="checksum_criterion" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="checksum_criterion_default" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="checksum_error" channel="inline" format="text/plain" model="Error: The checksum is not valid."/>
</node>
