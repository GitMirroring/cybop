<model>
    <part name="read_voltage" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="file" format="element/part" model="indoor_climate/read_voltage.cybol"/>
    </part>
    <part name="add_voltage" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".settings.temperature"/>
        <property name="operand" channel="inline" format="path/knowledge" model=".settings.voltage"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="increment_loop_count" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".settings.temperature_count"/>
        <property name="operand" channel="inline" format="number/integer" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <part name="compare_loop_count" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".settings.temperature_break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".settings.temperature_count"/>
        <property name="right" channel="inline" format="path/knowledge" model=".settings.temperature_maximum_count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
</model>

