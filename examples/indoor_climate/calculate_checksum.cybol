<node>
    <node name="calculate_checksum_1" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.checksum"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_high_byte"/>
        <node name="type" channel="inline" format="meta/type" model="number/byte"/>
    </node>
    <node name="calculate_checksum_2" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.checksum"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_low_byte"/>
        <node name="type" channel="inline" format="meta/type" model="number/byte"/>
    </node>
</node>

