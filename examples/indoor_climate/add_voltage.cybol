<model>
    <part name="cast_voltage" channel="inline" format="cast/double" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.temperature_summand"/>
        <property name="source" channel="inline" format="path/knowledge" model=".settings.voltage"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <part name="add_voltage" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".settings.temperature"/>
        <property name="operand" channel="inline" format="path/knowledge" model=".settings.temperature_summand"/>
        <property name="type" channel="inline" format="meta/type" model="number/fraction-decimal"/>
    </part>
</model>

