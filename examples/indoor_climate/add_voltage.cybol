<node>
    <node name="cast_voltage" channel="inline" format="cast/double" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.temperature_summand"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".settings.voltage"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="add_voltage" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.temperature"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".settings.temperature_summand"/>
        <node name="type" channel="inline" format="meta/type" model="number/fraction-decimal"/>
    </node>
</node>

