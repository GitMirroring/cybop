<node>
    <node name="create_settings" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="settings"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="initialise_settings" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="indoor_climate/settings.cybol"/>
        <node name="message" channel="inline" format="path/knowledge" model=".settings"/>
    </node>
    <!-- Test knowledge tree by writing it into a file. -->
<!--
    <node name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="path/knowledge" model=".settings"/>
        <node name="receiver" channel="inline" format="text/plain" model="test_indoor_climate.txt"/>
    </node>
-->
    <node name="startup_terminal" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
    </node>
    <node name="startup_serial_port" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="path/knowledge" model=".settings.device"/>
        <node name="filename" channel="inline" format="path/knowledge" model=".settings.device_filename"/>
        <node name="baudrate" channel="inline" format="path/knowledge" model=".settings.device_baudrate"/>
    </node>
    <node name="read_temperature" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="file" format="element/part" model="indoor_climate/read_temperature.cybol"/>
    </node>
<!--
    <node name="read_status" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="file" format="element/part" model="indoor_climate/read_status.cybol"/>
    </node>
-->
    <!-- This call MIGHT BE OPTIONAL, since all services are shutdown implicitly in the "live/exit" operation. -->
    <node name="shutdown_serial_port" channel="inline" format="maintain/shutdown" model="">
        <node name="channel" channel="inline" format="path/knowledge" model=".settings.device"/>
    </node>
    <node name="exit_application" channel="inline" format="live/exit" model=""/>
</node>

<!--
    Copyright (C) 2012-2013. Ingolf Brunner, Ronny Mauersberger, Christian Heller.

    This knowledge model uses the Cybernetics Oriented Language (CYBOL).
    Cybernetics Oriented Programming (CYBOP) <http://www.cybop.org/>

    This programme reads the temperature from a microcontroller HB 627.
    Valid ranges:
    - voltage: 0 ... 4094 mV
    - temperature: +2 °C ... 150 °C

    The returned values have the following meaning:
    buffer[0] - high byte of measurement
    buffer[1] - low byte of measurement
    buffer[2] - checksum (buffer[0] + buffer[1])

    The voltage may be calculated by adding high byte and low byte:
    voltage = (buffer[0] * 256) + buffer[1];

    Mappings:
    200 mV = 20 °C
    230 mV = 23 °C
    234 mV = 23,4 °C

    @version Indoor Climate 1.0.0 2013-03-05
    @author Ingolf Brunner <ingolf.brunner@ba-leipzig.de>
    @author Ronny Mauersberger <mauigeyer2@web.de>
    @author Christian Heller <christian.heller@tuxtax.de>
-->
