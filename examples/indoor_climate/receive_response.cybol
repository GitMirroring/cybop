<model>
    <!--
        Reset buffer.
        CAUTION! This is necessary because the microcontroller does sometimes
        not return values, so that old values from former loop cycles would be used.
    -->
    <part name="reset_buffer" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_buffer"/>
        <property name="source" channel="inline" format="text/ascii" model="0,0,0"/>
        <property name="type" channel="inline" format="meta/type" model="text/ascii"/>
    </part>
    <part name="receive_response" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="path/knowledge" model=".settings.device"/>
        <property name="model" channel="inline" format="path/knowledge" model=".settings.voltage_buffer"/>
    </part>
    <part name="copy_high_byte" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_high_byte"/>
        <property name="source" channel="inline" format="path/knowledge" model=".settings.voltage_buffer"/>
        <property name="type" channel="inline" format="meta/type" model="text/ascii"/>
        <property name="count" channel="inline" format="number/integer" model="1"/>
        <property name="source_index" channel="inline" format="number/integer" model="0"/>
    </part>
    <part name="copy_low_byte" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_low_byte"/>
        <property name="source" channel="inline" format="path/knowledge" model=".settings.voltage_buffer"/>
        <property name="type" channel="inline" format="meta/type" model="text/ascii"/>
        <property name="count" channel="inline" format="number/integer" model="1"/>
        <property name="source_index" channel="inline" format="number/integer" model="1"/>
    </part>
    <part name="copy_checksum" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_checksum"/>
        <property name="source" channel="inline" format="path/knowledge" model=".settings.voltage_buffer"/>
        <property name="type" channel="inline" format="meta/type" model="text/ascii"/>
        <property name="count" channel="inline" format="number/integer" model="1"/>
        <property name="source_index" channel="inline" format="number/integer" model="2"/>
    </part>
</model>

