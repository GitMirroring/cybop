<node>
    <!--
        Reset checksum.
        CAUTION! This is necessary because the microcontroller does sometimes
        not return values, so that old values from former loop cycles would be used.
    -->
    <node name="reset_checksum" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.checksum"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".settings.checksum_default"/>
    </node>
    <node name="reset_criterion" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.checksum_criterion"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".settings.checksum_criterion_default"/>
    </node>
</node>
