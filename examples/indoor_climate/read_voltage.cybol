<model>
    <part name="receive_response" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="file" format="element/part" model="indoor_climate/receive_response.cybol"/>
    </part>
    <part name="TEST_VOLTAGE_BUFFER" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" format="path/knowledge" model=".settings.voltage_buffer"/>
        <property name="new_line" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="get_voltage_buffer_count" channel="inline" format="access/count" model="">
        <property name="count" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_count"/>
        <property name="part" channel="inline" format="path/knowledge" model=".settings.voltage_buffer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="TEST_VOLTAGE_BUFFER_COUNT" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="message" channel="inline" format="text/plain" model="TEST voltage buffer count:"/>
        <property name="new_line" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="TEST_VOLTAGE_BUFFER_COUNT_NUMBER" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="number/integer"/>
        <property name="message" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_count"/>
        <property name="new_line" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="compare_voltage_buffer_count" channel="inline" format="compare/greater" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_comparison"/>
        <property name="left" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_count"/>
        <property name="right" channel="inline" format="number/integer" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="branch" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="path/knowledge" model=".settings.voltage_buffer_comparison"/>
        <property name="true" channel="file" format="element/part" model="indoor_climate/evaluate_checksum.cybol"/>
        <!-- CAUTION! Do NOTHING here, since it is normal that not all returned values are valid.
        <property name="false" channel="file" format="element/part" model=""/>
    </part>
    <part name="increment_loop_count" channel="inline" format="calculate/add" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".settings.voltage_count"/>
        <property name="operand" channel="inline" format="number/integer" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
    </part>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <part name="compare_loop_count" channel="inline" format="compare/greater-or-equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".settings.voltage_break"/>
        <property name="left" channel="inline" format="path/knowledge" model=".settings.voltage_count"/>
        <property name="right" channel="inline" format="path/knowledge" model=".settings.voltage_maximum_count"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <!-- Sleep for 100 ms = 100000 us = 100000000 ns. -->
    <part name="sleep" channel="inline" format="run/sleep" model="">
        <property name="duration" channel="inline" format="number/integer" model="100000000"/>
    </part>
</model>

