<model>
    <part name="send_request" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="path/knowledge" model=".settings.device"/>
        <property name="message" channel="inline" format="path/knowledge" model=".settings.device_channel"/>
    </part>
    <part name="receive_response" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="path/knowledge" model=".settings.device"/>
        <property name="model" channel="inline" format="path/knowledge" model=".settings.voltage_buffer"/>
    </part>
    <part name="calculate_checksum" channel="inline" format="flow/sequence" model="">
        <property name="model" channel="file" format="element/part" model="indoor_climate/calculate_checksum.cybol"/>
    </part>
    <part name="compare_checksum" channel="inline" format="compare/equal" model="">
        <property name="result" channel="inline" format="path/knowledge" model=".settings.checksum_comparison"/>
        <property name="left" channel="inline" format="path/knowledge" model=".settings.checksum"/>
        <property name="right" channel="inline" format="path/knowledge" model=".settings.voltage_buffer[2]"/>
        <property name="type" channel="inline" format="meta/type" model="number/integer"/>
        <property name="selection" channel="inline" format="text/plain" model="all"/>
    </part>
    <part name="test_checksum" channel="inline" format="flow/branch" model="">
        <property name="criterion" channel="inline" format="path/knowledge" model=".settings.checksum_comparison"/>
        <property name="true" channel="file" format="element/part" model="indoor_climate/calculate_voltage.cybol"/>
        <property name="false" channel="file" format="element/part" model="indoor_climate/report_checksum_failure.cybol"/>
    </part>
</model>

