<node>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_loop_count" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".settings.temperature_break"/>
        <node name="left" channel="inline" format="path/knowledge" model=".settings.temperature_count"/>
        <node name="right" channel="inline" format="path/knowledge" model=".settings.temperature_maximum_count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
        <node name="selection" channel="inline" format="text/plain" model="all"/>
    </node>
    <node name="collect_voltages" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="path/knowledge" model=".settings.temperature_break"/>
        <node name="model" channel="file" format="element/part" model="indoor_climate/collect_voltages.cybol"/>
    </node>
    <node name="cast_temperature_maximum_count" channel="inline" format="cast/double" model="">
        <node name="destination" channel="inline" format="path/knowledge" model=".settings.temperature_maximum_count_divisor"/>
        <node name="source" channel="inline" format="path/knowledge" model=".settings.temperature_maximum_count"/>
        <node name="type" channel="inline" format="meta/type" model="number/integer"/>
    </node>
    <node name="calculate_average" channel="inline" format="calculate/divide" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".settings.temperature"/>
        <node name="operand" channel="inline" format="path/knowledge" model=".settings.temperature_maximum_count_divisor"/>
        <node name="type" channel="inline" format="meta/type" model="number/fraction-decimal"/>
    </node>
    <node name="calculate_temperature" channel="inline" format="calculate/divide" model="">
        <node name="result" channel="inline" format="path/knowledge" model=".settings.temperature"/>
        <node name="operand" channel="inline" format="path/knowledge" model=".settings.temperature_conversion_factor"/>
        <node name="type" channel="inline" format="meta/type" model="number/fraction-decimal"/>
    </node>
    <node name="print_temperature" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Current temperature rounded in degree Celsius:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_temperature_value" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <node name="message" channel="inline" format="path/knowledge" model=".settings.temperature"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
</node>

