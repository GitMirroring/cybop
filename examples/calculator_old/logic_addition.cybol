<model>
    <part name="add" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="+"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="add_2" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.operation_type"/>
        <property name="source" channel="inline" format="text/plain" model="add_second_number"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
</model>
