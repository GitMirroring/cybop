<model>
    <part name="enter" channel="file" format="element/part" model="calculator_old/logic_enter.cybol"/>
    <part name="space" channel="file" format="element/part" model="calculator_old/logic_space.cybol"/>
    <part name="clear_calculation" channel="file" format="element/part" model="calculator_old/logic_clear.cybol"/>
    <part name="exit" channel="inline" format="live/exit" model=""/>

    <!-- Numbers -->
    <part name="zero" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="0"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="one" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="1"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="two" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="2"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="three" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="3"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="four" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="4"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="five" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="5"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="six" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="6"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="seven" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="7"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="eight" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="8"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    <part name="nine" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.temp_letter"/>
        <property name="source" channel="inline" format="text/plain" model="9"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part>
    
    <!-- <!-- Branches after Space -->
    <part name="set_first_number" channel="inline" format="represent/deserialise" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.first_number_result"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.safetmp.temp_line"/>
        <property name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
    </part>
    <part name="set_new_operation" channel="inline" format="modify/overwrite" model="">
        <property name="destination" channel="inline" format="path/knowledge" model=".app.safetmp.operation"/>
        <property name="source" channel="inline" format="path/knowledge" model=".app.safetmp.temp_line"/>
        <property name="type" channel="inline" format="meta/type" model="text/plain"/>
    </part> -->
</model>
