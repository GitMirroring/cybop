<model>
    <part name="break" channel="inline" format="logicvalue/boolean" model="false"/>
    <part name="count" channel="inline" format="number/integer" model="1"/>
    <part name="maximum" channel="inline" format="number/integer" model="10"/>
    <part name="model" channel="file" format="element/part" model="counter_static_model/model.cybol"/>
</model>

