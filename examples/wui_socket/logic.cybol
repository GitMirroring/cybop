<model>

    <part name="handler" channel="file" format="text/cybol" model="wui_socket/logic/handler.cybol"/>

    <part name="send_index" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="socket"/>
        <property name="language" channel="inline" format="meta/language" model="message/http-response"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="knowledge/path" model=".app.wui.index"/>
        <property name="receiver" channel="inline" format="path/knowledge" model=".app.var.client_connexion_socket"/>
    </part>

    <part name="exit_programme" channel="inline" format="live/exit" model=""/>

</model>
