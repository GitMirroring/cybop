<model>
    <part name="create_temporary" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="temporary"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_logic" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="logic"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="create_wui" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="wui"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_temporary" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="wui_socket/temporary.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".temporary"/>
    </part>
    <part name="initialise_logic" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="wui_socket/logic.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".logic"/>
    </part>
    <part name="initialise_wui" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="text/plain" model="wui_socket/wui.cybol"/>
        <property name="model" channel="inline" format="path/knowledge" model=".wui"/>
    </part>
    <!-- Write knowledge tree into file. -->
    <part name="test_knowledge_tree" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <property name="format" channel="inline" format="meta/format" model="element/part"/>
        <property name="message" channel="inline" format="path/knowledge" model=".wui"/>
        <property name="receiver" channel="inline" format="text/plain" model="test_wui_socket.txt"/>
    </part>
    <part name="startup_www" channel="inline" format="maintain/startup" model="">
        <property name="channel" channel="inline" format="meta/channel" model="www"/>
        <property name="namespace" channel="inline" format="text/plain" model="ipv4"/>
        <property name="style" channel="inline" format="text/plain" model="stream"/>
        <property name="address" channel="inline" format="text/plain" model="any"/>
    </part>
    <!-- Sense http client requests. -->
    <!--
        CAUTION! Do use character and NOT wide_character as model here!
        The http message body may be encoded and has to be read as plain characters.
    -->
    <part name="sense_commands" channel="inline" format="live/sense" model="">
        <property name="channel" channel="inline" format="meta/channel" model="www"/>
        <property name="handler" channel="inline" format="path/knowledge" model=".logic.handler"/>
    </part>
</model>

<!--
    This example demonstrates socket communication.
-->

