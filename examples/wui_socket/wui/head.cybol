<model>

    <part name="http-equiv" channel="inline" format="text/plain" model="">
        <property name="tag" channel="inline" format="text/plain" model="meta"/>
        <property name="http-equiv" channel="inline" format="text/plain" model="content-type"/>
        <property name="content" channel="inline" format="text/plain" model="text/html; charset=utf-8"/>
    </part>
    <part name="author" channel="inline" format="text/plain" model="">
        <property name="tag" channel="inline" format="text/plain" model="meta"/>
        <property name="name" channel="inline" format="text/plain" model="author"/>
        <property name="content" channel="inline" format="text/plain" model="Generated by CYBOI; See http://www.cybop.org/"/>
    </part>
    <part name="title" channel="inline" format="text/plain" model="CYBOL WUI Socket Example">
        <property name="tag" channel="inline" format="text/plain" model="title"/>
    </part>

</model>
