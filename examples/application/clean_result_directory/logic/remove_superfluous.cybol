<node>

    <node name="count_elements" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model="#count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".list"/>
    </node>

    <!-- The break condition has to be GREATER-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_loop_index" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#count"/>
    </node>

    <node name="remove_element" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model="#break"/>
        <node name="model" channel="inline" format="text/cybol-path" model="#model"/>
    </node>

</node>
