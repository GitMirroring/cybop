<node>

        <node name="path" channel="inline" format="text/plain" model=".klaus_path"/>
--
    <node name="remove" channel="inline" format="command/remove" model="">
        <node name="path" channel="inline" format="text/cybol-path" model=".list.[#index]"/>
        <node name="force" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="interactive" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="recursive" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="verbose" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="increment_loop_count" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
