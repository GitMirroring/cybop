<node>

    <node name="compare_loop_count" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.adc_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".settings.adc_count"/>
        <node name="right" channel="inline" format="text/cybol-path" model=".settings.adc_maximum_count"/>
    </node>
    <node name="collect_voltages" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model=".settings.adc_break"/>
        <node name="model" channel="file" format="element/part" model="application/adc/collect_voltages.cybol"/>
    </node>

    <node name="cast_adc_maximum_count" channel="inline" format="cast/double" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.adc_maximum_count_divisor"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".settings.adc_maximum_count"/>
    </node>

    <node name="calculate_average" channel="inline" format="calculate/divide" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.adc"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".settings.adc_maximum_count_divisor"/>
    </node>
    <node name="calculate_adc" channel="inline" format="calculate/divide" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.adc"/>
        <node name="operand" channel="inline" format="text/cybol-path" model=".settings.adc_conversion_factor"/>
    </node>

    <node name="print_adc" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Current adc rounded in voltage:"/>
    </node>
    <node name="print_adc_value" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/fraction-decimal"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".settings.adc"/>
    </node>

</node>
