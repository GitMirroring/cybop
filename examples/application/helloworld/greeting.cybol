<node>

    <node name="greeting" channel="inline" format="text/plain" model="Hello, World!">
        <node name="position" channel="inline" format="number/integer" model="5,2"/>
        <node name="size" channel="inline" format="number/integer" model="60,4"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="green"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="underline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="cursor" channel="inline" format="text/plain" model="">
        <node name="position" channel="inline" format="number/integer" model="0,8"/>
    </node>

    <!-- Further windows and dialogues may follow here. -->

</node>
