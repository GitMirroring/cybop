<node>

//Zeichen löschen
    <node name="reset_sonder" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.sonder"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

//Speichern der Nachricht in Variable
    <node name="receive_sonder" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <!-- CAUTION! Do NOT use an encoding here, since terminal input is already in wide characters. -->
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.sonder"/>
    </node>

//Ausgabe der Nachricht
    <node name="send_message" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.sonder"/>
    <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>


    //Flag setzen Eingabe yes
    <node name="comparison1" channel="inline" format="check/equal" model="">
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.sonder"/>
        <node name="right" channel="inline" format="text/plain" model="y"/>
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.flag_sonder_y"/>
    </node>

    //Flag setzen Eingabe no
    <node name="comparison2" channel="inline" format="check/equal" model="">
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.sonder"/>
        <node name="right" channel="inline" format="text/plain" model="n"/>
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.flag_sonder_n"/>
    </node>


//If-Abfrage yes
    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.flag_sonder_y"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.auswahl"/>
        <node name="false" channel="inline" format="text/cybol-path" model="if-then-else2"/>
    </node>

//If-Abfrage no
    <node name="if-then-else2" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.flag_sonder_n"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.auswahl"/>
        <node name="false" channel="inline" format="text/cybol-path" model=""/>
    </node>

</node>
