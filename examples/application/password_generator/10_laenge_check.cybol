<node>

//Zeichen löschen
    <node name="reset_laenge" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.laenge"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

//Speichern der Nachricht in Variable
    <node name="receive_laenge" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <!-- CAUTION! Do NOT use an encoding here, since terminal input is already in wide characters. -->
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.laenge"/>
    </node>

    <node name="sub" channel="inline" format="calculate/subtract" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.laenge"/>
        <node name="operand" channel="inline" format="number/integer" model="48"/>
    </node>

//Ausgabe der Nachricht
    <node name="send_message" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app.var.laenge"/>
    <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

//Abfrage 1
    <node name="comparison1" channel="inline" format="compare/equal" model="">
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.laenge"/>
        <node name="right" channel="inline" format="number/integer" model="1"/>
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.flag_1"/>
    </node>

//Abfrage 2
    <node name="comparison2" channel="inline" format="compare/equal" model="">
        <node name="left" channel="inline" format="text/cybol-path" model=".app.var.laenge"/>
        <node name="right" channel="inline" format="number/integer" model="2"/>
        <node name="result" channel="inline" format="text/cybol-path" model=".app.var.flag_2"/>
    </node>

//Abfrage 3
    <node name="comparison3" channel="inline" format="compare/equal" model="">
