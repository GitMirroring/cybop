//If-Abfrage 1
    <node name="if-then-else" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".app.var.flag_1"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".app.11_klein"/>
        <node name="false" channel="inline" format="text/cybol-path" model="if-then-else2"/>
    </node>

