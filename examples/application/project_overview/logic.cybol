<node>

    <node name="create" channel="file" format="element/part" model="application/project_overview/logic/create.cybol"/>
    <node name="translate" channel="file" format="element/part" model="application/project_overview/logic/translate.cybol"/>
    <node name="generate" channel="file" format="element/part" model="application/project_overview/logic/generate.cybol"/>

    <node name="show_failure" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Error: Could not process project files. Possibly, they have a wrong format."/>
    </node>

    <node name="show_success" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Information: The project files seem to have a valid format. Processing ..."/>
    </node>

</node>
