<node>

    <node name="name" channel="inline" format="text/plain" model="digiweg"/>
    <node name="description" channel="inline" format="text/plain" model="Stadtführer zu bekannten Persönlichkeiten"/>
    <node name="technology" channel="inline" format="text/plain" model="App für Android und iOS; Alternative: Responsive Web App für alle Plattformen"/>
    <node name="licence" channel="inline" format="text/plain" model="GNU GPLv3"/>
