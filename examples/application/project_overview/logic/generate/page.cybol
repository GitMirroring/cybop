<node>

    <node name="get_page_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#page_name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".wui.[#page_index]"/>
    </node>

<!--
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="TEST page page name:"/>
    </node>
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#page_name"/>
    </node>
-->

    <node name="overwrite_page_file_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#page_file"/>
        <node name="source" channel="inline" format="text/plain" model="application/project_overview/file/"/>
    </node>
    <node name="overwrite_page_file_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#page_file"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#page_name"/>
    </node>
    <node name="append_page_file_suffix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#page_file"/>
        <node name="source" channel="inline" format="text/plain" model=".html"/>
    </node>

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/cybol-path" model="#page_file"/>
        <node name="mode" channel="inline" format="text/plain" model="write"/>
    </node>
    <node name="send_file" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/html">
            <node name="indentation" channel="inline" format="logicvalue/boolean" model="true"/>
        </node>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.(#page_name)"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <!-- Loop test. -->
    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#page_index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
