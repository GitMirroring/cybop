<node>

    <node name="create_wui_toc_project_link" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/cybol-path" model="#project_name"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
         
        <node name="whole" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.toc"/>
    </node>

    <node name="initialise_wui_toc_project_link" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="sender" channel="inline" format="text/plain" model="application/project_overview/wui/toc/link_properties.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.toc.(#project_name)"/>
    </node>

    <node name="overwrite_link_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.toc.(#project_name)"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#project_name"/>
    </node>
    <node name="overwrite_link_reference_with_sharp" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.toc.(#project_name):href"/>
        <node name="source" channel="inline" format="text/plain" model="#"/>
    </node>
    <!-- CAUTION! Use "append" and NOT "overwrite" here! -->
    <node name="overwrite_link_reference_with_project_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#category_name).body.toc.(#project_name):href"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#project_name"/>
    </node>

</node>
