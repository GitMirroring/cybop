        <node name="source" channel="inline" format="text/plain" model="application/repertoire/wui/all/body_row_model.cybol"/>
    </node>
    <node name="translate" channel="inline" format="text/cybol-path" model=".logic.translate.song.songs"/>

    <!-- Translate artist -->

    <node name="assign_initial_value" channel="inline" format="modify/overwrite" model="">
