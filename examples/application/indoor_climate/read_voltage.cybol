<node>
    <node name="reset_voltage_buffer" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="file" format="element/part" model="application/indoor_climate/reset_voltage_buffer.cybol"/>
    </node>
    <node name="receive_response" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="text/cybol-path" model=".settings.device"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer"/>
        <node name="minimum" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_minimum"/>
    </node>
    <node name="get_voltage_buffer_count" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer"/>
    </node>
<!--
    <node name="TEST_VOLTAGE_BUFFER_COUNT" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="TEST voltage buffer count:"/>
    </node>
    <node name="TEST_VOLTAGE_BUFFER_COUNT_NUMBER" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_count"/>
    </node>
-->
    <node name="compare_voltage_buffer_count" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_criterion"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_count"/>
        <node name="right" channel="inline" format="number/integer" model="0"/>
    </node>
    <node name="copy_response_elements" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_criterion"/>
        <node name="true" channel="file" format="element/part" model="application/indoor_climate/copy_response_elements.cybol"/>
        <!-- CAUTION! Do NOTHING here, since it is normal that not all returned values are valid. -->
        <node name="false" channel="file" format="element/part" model=""/>
    </node>
    <node name="evaluate_checksum" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".settings.voltage_buffer_criterion"/>
        <node name="true" channel="file" format="element/part" model="application/indoor_climate/evaluate_checksum.cybol"/>
        <!-- CAUTION! Do NOTHING here, since it is normal that not all returned values are valid. -->
        <node name="false" channel="file" format="element/part" model=""/>
    </node>

    <node name="increment_loop_count" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.voltage_count"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

    <!-- Sleep for 100 ms = 100,000 us = 100,000,000 ns. -->
    <node name="sleep" channel="inline" format="run/sleep-nano" model="">
        <node name="duration" channel="inline" format="text/cybol-path" model=".settings.voltage_sleep"/>
    </node>
</node>
