<node>

    <node name="reset_voltage" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="file" format="element/part" model="application/indoor_climate/reset_voltage.cybol"/>
    </node>
    <node name="read_voltage" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="file" format="element/part" model="application/indoor_climate/read_channel.cybol"/>
    </node>
    <node name="compare_voltage" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.voltage_criterion"/>
        <node name="left" channel="inline" format="text/cybol-path" model=".settings.voltage"/>
        <node name="right" channel="inline" format="number/integer" model="0"/>
    </node>
    <node name="branch_voltage" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".settings.voltage_criterion"/>
        <node name="true" channel="file" format="element/part" model="application/indoor_climate/add_voltage.cybol"/>
        <node name="false" channel="file" format="element/part" model="application/indoor_climate/report_voltage_failure.cybol"/>
    </node>

    <node name="increment_loop_count" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".settings.temperature_count"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
