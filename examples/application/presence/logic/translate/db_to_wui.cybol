<node>

    <node name="lecturers" channel="file" format="element/part" model="application/presence/logic/translate/db_to_wui/lecturers.cybol">
        <node name="break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="index" channel="inline" format="number/integer" model="0"/>
        <node name="count" channel="inline" format="number/integer" model="0"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.db_to_wui.lecturer"/>
    </node>

    <node name="lecturer" channel="file" format="element/part" model="application/presence/logic/translate/db_to_wui/lecturer.cybol">
        <node name="name" channel="inline" format="text/plain" model=""/>
    </node>

    <node name="path" channel="file" format="element/part" model="application/presence/logic/translate/db_to_wui/path.cybol"/>

    <node name="row" channel="file" format="element/part" model="application/presence/logic/translate/db_to_wui/row.cybol">
        <node name="column_break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="column_index" channel="inline" format="number/integer" model="0"/>
        <node name="column_count" channel="inline" format="number/integer" model="0"/>
        <node name="column_model" channel="inline" format="text/cybol-path" model=".logic.translate.db_to_wui.column"/>
    </node>

    <node name="column" channel="file" format="element/part" model="application/presence/logic/translate/db_to_wui/column.cybol">
        <node name="day" channel="inline" format="text/plain" model=""/>
        <node name="choice" channel="inline" format="text/plain" model=""/>
        <node name="empty" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="href" channel="inline" format="text/plain" model=""/>
    </node>

    <node name="cell" channel="file" format="element/part" model="application/presence/logic/translate/db_to_wui/cell.cybol"/>
    <node name="cell_default" channel="file" format="element/part" model="application/presence/logic/translate/db_to_wui/cell_default.cybol"/>

    <node name="href" channel="file" format="element/part" model="application/presence/logic/translate/db_to_wui/href.cybol"/>
    <node name="href_default" channel="file" format="element/part" model="application/presence/logic/translate/db_to_wui/href_default.cybol"/>

</node>
