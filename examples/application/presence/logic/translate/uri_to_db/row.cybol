<node>

    <node name="model" channel="inline" format="text/cybol-path" model=".logic.reset.db"/>

    <node name="count_weekdays" channel="inline" format="access/count" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".domain.weekdays"/>
    </node>

    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#count"/>
    </node>

    <!-- Fill database element. -->
    <node name="loop_columns" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model="#break"/>
        <node name="model" channel="inline" format="text/cybol-path" model="#model"/>
    </node>

    <node name="save_db_to_file" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.uri_to_db.file"/>
    </node>

</node>
