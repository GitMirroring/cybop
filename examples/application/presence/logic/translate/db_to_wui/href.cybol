<node>

    <!--
        Example uri:
        http://presence.ba-leipzig.de/?year=2015&week=11&lecturer=heller&day=monday&choice=holiday&action=update
    -->

    <!-- The standard parts. -->
    <node name="overwrite_scheme" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.scheme"/>
    </node>
    <node name="append_scheme_suffix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.scheme_suffix"/>
    </node>
    <node name="append_hostname_prefix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.hostname_prefix"/>
    </node>
    <node name="append_hostname" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.hostname"/>
    </node>
    <node name="append_port_prefix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.port_prefix"/>
    </node>
    <node name="append_port" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.port"/>
    </node>
    <node name="append_directory" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.directory"/>
    </node>
    <node name="append_parametre_prefix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_prefix"/>
    </node>

    <!-- The year parametre. -->
    <node name="append_parametre_year_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_year"/>
    </node>
    <node name="append_parametre_year_assignment" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_assignment"/>
    </node>
    <node name="append_parametre_year_value" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.var.year_string"/>
    </node>

    <!-- The week parametre. -->
    <node name="append_parametre_week_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_separator"/>
    </node>
    <node name="append_parametre_week_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_week"/>
    </node>
    <node name="append_parametre_week_assignment" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_assignment"/>
    </node>
    <node name="append_parametre_week_value" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.var.week_string"/>
    </node>

    <!-- The lecturer parametre. -->
    <node name="append_parametre_lecturer_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_separator"/>
    </node>
    <node name="append_parametre_lecturer_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_lecturer"/>
    </node>
    <node name="append_parametre_lecturer_assignment" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_assignment"/>
    </node>
    <node name="append_parametre_lecturer_value" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_lecturer.element.name"/>
    </node>

    <!-- The day parametre. -->
    <node name="append_parametre_day_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_separator"/>
    </node>
    <node name="append_parametre_day_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_day"/>
    </node>
    <node name="append_parametre_day_assignment" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_assignment"/>
    </node>
    <node name="append_parametre_day_value" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.day"/>
    </node>

    <!-- The choice parametre. -->
    <node name="append_parametre_choice_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_separator"/>
    </node>
    <node name="append_parametre_choice_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_choice"/>
    </node>
    <node name="append_parametre_choice_assignment" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_assignment"/>
    </node>
    <node name="append_parametre_choice_value" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.choices.(.app.var.unref):next"/>
    </node>

    <!-- The action parametre. -->
    <node name="append_parametre_action_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_separator"/>
    </node>
    <node name="append_parametre_action_name" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_action"/>
    </node>
    <node name="append_parametre_action_assignment" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.parametre_assignment"/>
    </node>
    <node name="append_parametre_action_value" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".app.var.db_to_wui_column.element.href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".app.domain.uri.action_update"/>
    </node>

</node>
