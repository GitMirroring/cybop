<node>

    <node name="overwrite_link" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.lecturers.table.(.var.db_to_wui_lecturer.element.name).(.var.db_to_wui_column.element.day).link"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".domain.choices.(.var.unref)"/>
    </node>
    <node name="translate_href" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.db_to_wui.href"/>
    </node>
    <node name="overwrite_href" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.lecturers.table.(.var.db_to_wui_lecturer.element.name).(.var.db_to_wui_column.element.day).link:href"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.db_to_wui_column.element.href"/>
    </node>
    <node name="overwrite_class" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.lecturers.table.(.var.db_to_wui_lecturer.element.name).(.var.db_to_wui_column.element.day):class"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.db.(.var.db_to_wui_column.element.day)"/>
    </node>

</node>
