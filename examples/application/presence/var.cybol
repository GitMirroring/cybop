<node>

    <!-- The db model. -->

    <node name="directory" channel="inline" format="text/plain" model=""/>
    <node name="file" channel="inline" format="text/plain" model=""/>
    <node name="unref" channel="inline" format="text/plain" model=""/>
    <node name="db" channel="inline" format="element/part" model=""/>
    <node name="empty" channel="inline" format="logicvalue/boolean" model="false"/>

    <!-- The calendar. -->

    <node name="year" channel="inline" format="number/integer" model="2015"/>
    <node name="week" channel="inline" format="number/integer" model="13"/>
<!--
    <node name="day" channel="inline" format="datetime/utc" model="2015-01-01T00:00:00"/>
-->

    <!--
        TODO: The year does NOT get serialised yet and therefore HAS TO BE assigned directly here.
        This might change in the future, when date and time are determined at runtime.
        In this case, the value assigned here may be left empty then.
    -->
    <node name="year_string" channel="inline" format="text/plain" model="2015"/>
    <node name="week_string" channel="inline" format="text/plain" model=""/>

    <!-- Request-response-cycle. -->

    <node name="request" channel="inline" format="element/part" model=""/>
    <node name="client_socket" channel="inline" format="number/integer" model="0"/>
    <!--
        CAUTION! Should the path format be "text/cybol-path" OR "text/plain"?
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handler.cybol" file.

        Alternative:
        <node name="path" channel="inline" format="text/cybol-path" model=""/>
        <node name="path" channel="inline" format="text/plain" model=""/>
    -->
    <node name="path" channel="inline" format="text/cybol-path" model=""/>

    <!-- The serialised webpage. -->

    <node name="webpage" channel="inline" format="text/plain" model="">
        <!--
            CAUTION! The necessary "encoding" is added here DIRECTLY,
            since it does NOT work adding it as constraint at the operation "send".
            The reason is that the format "text/cybol-path" is used there,
            which points to another (this) part ".webpage" whose properties are used.
        -->
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="server" channel="inline" format="text/cybol-path" model=".domain.server"/>
        <node name="connection" channel="inline" format="text/plain" model="close"/>
        <node name="content-type" channel="inline" format="text/plain" model="text/html"/>
    </node>

<!--
    <node name="css" channel="file" format="text/plain" model="application/presence/wui/formatting.css">
-->
        <!--
            CAUTION! The necessary "encoding" is added here DIRECTLY,
            since it does NOT work adding it as constraint at the operation "send".
            The reason is that the format "text/cybol-path" is used there,
            which points to another (this) part ".webpage" whose properties are used.
        -->
<!--
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    </node>
-->

</node>
