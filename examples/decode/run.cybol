<node>

    <node name="create_text" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="text"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
         
    </node>
    <node name="create_dest" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="dest"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
         
    </node>
    <node name="initialise_seed" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".text"/>
        <node name="source" channel="inline" format="text/plain" model="Ich bin ein Text!"/>
    </node>
    <node name="initialise_seed" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".dest"/>
        <node name="source" channel="inline" format="text/plain" model=""/>
    </node>

    <!-- Write knowledge tree into file.
    <node name="test_knowledge_tree_pre" channel="inline" format="communicate/send" model="">
        <node name="receiver" channel="inline" format="text/plain" model="test_copier_pre.txt"/>
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".app"/>
    </node>
    -->

    <node name="decode" channel="inline" format="convert/decode" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".dest"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".text"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example tests the copier functionality,
    i.e. shallow as well as deep cloning.
-->
