<model>
    <part name="print_value" channel="inline" encoding="utf-8" format="operation/plain" model="send">
        <property name="channel" channel="inline" encoding="utf-8" format="text/plain" model="shell"/>
        <property name="language" channel="inline" encoding="utf-8" format="text/plain" model="text/plain"/>
        <property name="message" channel="inline" encoding="utf-8" format="text/plain" model="true"/>
        <property name="new_line" channel="inline" encoding="utf-8" format="logicvalue/boolean" model="true"/>
    </part>
</model>

