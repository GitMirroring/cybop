<model>
    <part name="create_text" channel="inline" format="memorise/create" model="">
        <property name="name" channel="inline" format="text/plain" model="text"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="element" channel="inline" format="text/plain" model="part"/>
    </part>
    <part name="initialise_text" channel="inline" format="communicate/receive" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="iso-8859-15"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
        <property name="sender" channel="inline" format="text/plain" model="character_encoding/iso-8859-15.txt"/>
        <property name="message" channel="inline" format="path/knowledge" model=".text"/>
    </part>
    <!--
        Since printing on console does not display
        all unicode characters correctly,
        the output is sent to a utf-8-encoded text file here,
        in order to be tested for correctness.
    -->
    <part name="print_text" channel="inline" format="communicate/send" model="">
        <property name="channel" channel="inline" format="meta/channel" model="file"/>
        <property name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <property name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <property name="format" channel="inline" format="meta/format" model="text/plain"/>
<!--
        <property name="message" channel="inline" format="text/plain" model="Ä"/>
-->
        <property name="message" channel="inline" format="path/knowledge" model=".text"/>
        <property name="receiver" channel="inline" format="text/plain" model="TEST_CHARACTER_ENCODING.txt"/>
        <property name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </part>
    <part name="exit_application" channel="inline" format="live/exit" model=""/>
</model>
