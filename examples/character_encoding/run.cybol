<node>
    <node name="create_text" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="text"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
    </node>
    <node name="initialise_text" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="iso-8859-15"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="sender" channel="inline" format="text/plain" model="character_encoding/iso-8859-15.txt"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".text"/>
    </node>
    <!--
        Since printing on console does not display
        all unicode characters correctly,
        the output is sent to a utf-8-encoded text file here,
        in order to be tested for correctness.
    -->
    <node name="print_text" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
<!--
        <node name="message" channel="inline" format="text/plain" model="Ä"/>
-->
        <node name="message" channel="inline" format="text/cybol-path" model=".text"/>
        <node name="receiver" channel="inline" format="text/plain" model="TEST_CHARACTER_ENCODING.txt"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="exit_application" channel="inline" format="live/exit" model=""/>
</node>
