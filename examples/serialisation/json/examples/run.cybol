<node>

    <node name="create_id" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="id"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>
    <node name="create_data" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="data"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
    </node>

    <!-- Deserialise data -->

<!--
        Possible json files that can be used:
        _____________________________________

        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/basic/sample_1.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/basic/sample_2.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/basic/sample_3.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/basic/sample_4.json"/>

        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/json/glossary.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/json/menu.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/json/menu2.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/json/web-app.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/json/widget.json"/>

        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/scenario/db.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/scenario/default.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/scenario/google_markers.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/scenario/package-lock.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/scenario/package.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/scenario/production.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/scenario/products.json"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/scenario/youtube-search-results.json"/>
-->

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/scenario/package.json"/>
    </node>
    <node name="deserialise_data" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="application/json"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".data"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <!-- Write knowledge tree into file -->

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/json/examples/test_knowledge_tree.txt"/>
        <node name="mode" channel="inline" format="text/plain" model="write"/>
    </node>
    <node name="send_knowledge" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".data"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example deserialises a json file and writes the created
    knowledge tree into a model diagram text file.
-->
