<node>

    <node name="create_id" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="id"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>
    <node name="create_data" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="data"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
    </node>

    <!-- Deserialise data -->

<!--
        Possible xml files that can be used:
        _____________________________________

        <node name="device" channel="inline" format="text/plain" model="serialisation/xml/examples/xml/glossary.xml"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/xml/examples/xml/menu.xml"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/xml/examples/xml/menu2.xml"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/xml/examples/xml/web-app.xml"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/xml/examples/xml/widget.xml"/>
-->

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/xml/examples/xml/web-app.xml"/>
    </node>
    <node name="deserialise_data" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="application/xml"/>
        <node name="normalisation" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".data"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <!-- Write knowledge tree into file -->

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="serialisation/xml/examples/test_knowledge_tree.txt"/>
    </node>
    <node name="send_knowledge" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".data"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example deserialises an xml file and writes the created
    knowledge tree into a model diagram text file.
-->
