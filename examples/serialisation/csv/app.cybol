<node>

    <!-- Terminal -->

    <node name="stdout" channel="inline" format="number/integer" model="-1"/>

    <!-- Data Tables -->

    <node name="table_comma" channel="inline" format="element/part" model=""/>
    <node name="table_semicolon" channel="inline" format="element/part" model=""/>
    <node name="table_comma_space" channel="inline" format="element/part" model=""/>
    <node name="table_sequence" channel="inline" format="element/part" model=""/>
    <node name="table_quoted" channel="inline" format="element/part" model=""/>
    <node name="table_mixed" channel="inline" format="element/part" model=""/>
    <node name="table_header" channel="inline" format="element/part" model=""/>

    <!-- Test Logic -->

    <node name="test_comma" channel="file" format="element/part" model="serialisation/csv/read_file.cybol">
        <node name="filename" channel="inline" format="text/plain" model="serialisation/csv/test/comma.csv"/>
        <node name="table" channel="inline" format="text/cybol-path" model=".table_comma"/>
        <node name="delimiter" channel="inline" format="text/plain" model=","/>
    </node>
    <node name="test_semicolon" channel="file" format="element/part" model="serialisation/csv/read_file.cybol">
        <node name="filename" channel="inline" format="text/plain" model="serialisation/csv/test/semicolon.csv"/>
        <node name="table" channel="inline" format="text/cybol-path" model=".table_semicolon"/>
        <node name="delimiter" channel="inline" format="text/plain" model=";"/>
    </node>
    <node name="test_comma_space" channel="file" format="element/part" model="serialisation/csv/read_file.cybol">
        <node name="filename" channel="inline" format="text/plain" model="serialisation/csv/test/comma_space.csv"/>
        <node name="table" channel="inline" format="text/cybol-path" model=".table_comma_space"/>
        <node name="delimiter" channel="inline" format="text/plain" model=", "/>
    </node>
    <node name="test_sequence" channel="file" format="element/part" model="serialisation/csv/read_file.cybol">
        <node name="filename" channel="inline" format="text/plain" model="serialisation/csv/test/sequence.csv"/>
        <node name="table" channel="inline" format="text/cybol-path" model=".table_sequence"/>
        <node name="delimiter" channel="inline" format="text/plain" model="#?#"/>
    </node>
    <node name="test_quoted" channel="file" format="element/part" model="serialisation/csv/read_file.cybol">
        <node name="filename" channel="inline" format="text/plain" model="serialisation/csv/test/quoted.csv"/>
        <node name="table" channel="inline" format="text/cybol-path" model=".table_quoted"/>
        <node name="delimiter" channel="inline" format="text/plain" model=","/>
        <node name="quotation" channel="inline" format="text/plain" model="&#x22;"/>
    </node>
    <node name="test_mixed" channel="file" format="element/part" model="serialisation/csv/read_file.cybol">
        <node name="filename" channel="inline" format="text/plain" model="serialisation/csv/test/mixed.csv"/>
        <node name="table" channel="inline" format="text/cybol-path" model=".table_mixed"/>
        <node name="delimiter" channel="inline" format="text/plain" model=","/>
        <node name="quotation" channel="inline" format="text/plain" model="&#x22;"/>
    </node>
    <node name="test_header" channel="file" format="element/part" model="serialisation/csv/read_file.cybol">
        <node name="filename" channel="inline" format="text/plain" model="serialisation/csv/test/header.csv"/>
        <node name="table" channel="inline" format="text/cybol-path" model=".table_header"/>
        <node name="delimiter" channel="inline" format="text/plain" model=","/>
        <node name="header" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!-- Print Logic -->

    <node name="print_table" channel="file" format="element/part" model="serialisation/csv/print_table.cybol">
        <node name="row_break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="row_index" channel="inline" format="number/integer" model="0"/>
        <node name="row_count" channel="inline" format="number/integer" model="0"/>
        <node name="row_model" channel="inline" format="text/cybol-path" model=".print_row"/>
        <!-- The row path. -->
        <node name="row" channel="inline" format="text/cybol-path" model=""/>
        <node name="row_data" channel="inline" format="text/cybol-path" model="{#table}.[#row_index]"/>
        <node name="row_heading" channel="inline" format="text/cybol-path" model="{#table}:header"/>
    </node>

    <node name="print_row" channel="file" format="element/part" model="serialisation/csv/print_row.cybol">
        <node name="column_break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="column_index" channel="inline" format="number/integer" model="0"/>
        <node name="column_count" channel="inline" format="number/integer" model="0"/>
        <node name="column_model" channel="inline" format="text/cybol-path" model=".print_column"/>
    </node>

    <node name="print_column" channel="file" format="element/part" model="serialisation/csv/print_column.cybol"/>

</node>
