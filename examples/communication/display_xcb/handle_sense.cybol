<node>

    <node name="receive_event" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <!--
            CAUTION! Do NOT use ".window_id" here, but rather ".window".
            The correct action needs to be read from the window element hierarchy.
            So, the window id related to a windowing system (xcb) does not help here.
        -->
        <node name="sender" channel="inline" format="text/cybol-path" model=".window"/>
        <node name="language" channel="inline" format="meta/language" model="event/gui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".action"/>
    </node>

    <node name="send_refresh_window" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".window_id"/>
        <node name="language" channel="inline" format="meta/language" model="message/gui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".window"/>
    </node>

</node>
