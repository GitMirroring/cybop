<node>

    <node name="print_query_label" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Process request uri query action:"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>
    <node name="print_query" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/cli"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".request:uri:query.action"/>
        <node name="newline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!--
        Verify that uri query is NOT empty.

        CAUTION! This is necessary to filter out uri data which are not understood,
        e.g. a browser request for "favicon.ico" would result in the non-existing action path:
        .logic.actions./favicon.ico
    -->
    <node name="test_query" channel="inline" format="access/indicate-exists" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".query_exists"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".request:uri:query"/>
    </node>

    <node name="handle_query" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model=".query_exists"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".logic.handle.query"/>
        <node name="false" channel="inline" format="text/cybol-path" model=".logic.handle.pathtest"/>
    </node>

</node>
