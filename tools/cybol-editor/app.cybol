<node>

    <!-- The logical layers. -->
    <node name="wui" channel="file" format="element/part" model="cybol-editor/wui.cybol"/>

    <!-- The functionality. -->
    <node name="logic" channel="file" format="element/part" model="cybol-editor/logic.cybol"/>

    <!-- The terminal. -->

    <node name="stdout" channel="inline" format="number/integer" model="-1"/>

    <!-- Request-response-cycle. -->

    <node name="request" channel="inline" format="element/part" model=""/>
    <node name="client_socket" channel="inline" format="number/integer" model="0"/>

    <node name="path_exists" channel="inline" format="logicvalue/boolean" model="false"/>
    <node name="query_exists" channel="inline" format="logicvalue/boolean" model="false"/>

    <node name="path" channel="inline" format="text/plain" model=""/>
    <!--
        CAUTION! The format is "text/ascii" and NOT "text/plain",
        since some data, like images for instance, represent binary data.
    -->
<!--
    <node name="file" channel="inline" format="text/ascii" model=""/>
-->

    <node name="action_path" channel="inline" format="text/cybol-path" model=""/>

    <!--
        The serialised webpage.
        For the http response, the following headers are recommended:
        - Date
        - Server
        - Content-Length
        - Content-Type
    -->

    <node name="webpage" channel="inline" format="text/plain" model="">
        <node name="server" channel="inline" format="text/plain" model="CYBOL Editor/1.0 2022-04-09 (CYBOI/0.22.0 (Linux) CYBOL/2.0.0)"/>
        <node name="content-type" channel="inline" format="text/plain" model="text/html"/>
        <!--
            CAUTION! The necessary "encoding" is added here DIRECTLY,
            since it does NOT work adding it as constraint at the operation "send".
            The reason is that the format "text/cybol-path" is used there,
            which points to another (this) part ".webpage" whose properties are used.
        -->
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
    </node>

</node>
