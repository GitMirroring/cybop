<!--
    This application generates the CYBOL manual.
-->

<node>

    <node name="load_app" channel="file" format="element/part" model="manual-generator/library/load_library.cybol">
        <node name="destination" channel="inline" format="text/cybol-path" model="."/>
        <node name="source" channel="inline" format="text/plain" model="manual-generator/app.cybol"/>
    </node>

    <node name="open_stdout" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="device" channel="inline" format="text/plain" model="standard-output"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".stdout"/>
    </node>

<!--
    <node name="translate_to_wui" channel="inline" format="text/cybol-path" model=".logic.translate.languages"/>
-->

    <node name="close_stdout" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".stdout"/>
    </node>

    <node name="test_heap" channel="inline" format="text/cybol-path" model=".library.save_file">
        <node name="destination" channel="inline" format="text/plain" model="manual-generator/test_heap.txt"/>
        <node name="source" channel="inline" format="text/cybol-path" model="."/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
    </node>
    <node name="test_stack" channel="inline" format="text/cybol-path" model=".library.save_file">
        <node name="destination" channel="inline" format="text/plain" model="manual-generator/test_stack.txt"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
    </node>

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>
