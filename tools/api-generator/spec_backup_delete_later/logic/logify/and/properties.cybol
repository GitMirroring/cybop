        <node name="description" channel="inline" format="text/plain" model="the second input operand"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="type" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="type"/>
        <node name="description" channel="inline" format="text/plain" model="the type of both operands"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="meta/type"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
