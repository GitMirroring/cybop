<node>
    <node name="break" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="break"/>
        <node name="description" channel="inline" format="text/plain" model="the break flag; once set, the loop will be left (exited)"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>        
    <node name="model" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="model"/>
        <node name="description" channel="inline" format="text/plain" model="the logic knowledge model to be executed repeatedly by the loop"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | element/part"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
