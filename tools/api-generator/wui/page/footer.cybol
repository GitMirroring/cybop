<node>

    <node name="line" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="hr"/>
    </node>

    <node name="heading" channel="inline" format="text/plain" model="Contact">
        <node name="tag" channel="inline" format="text/plain" model="h3"/>
    </node>

    <node name="email" channel="inline" format="text/plain" model="cybop-developers@nongnu.org">
        <node name="tag" channel="inline" format="text/plain" model="a"/>
        <node name="href" channel="inline" format="text/plain" model="mailto:cybop-developers@nongnu.org"/>
    </node>

    <node name="mail_break" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="br"/>
    </node>

    <node name="web" channel="inline" format="text/plain" model="http://www.cybop.org/">
        <node name="tag" channel="inline" format="text/plain" model="a"/>
        <node name="href" channel="inline" format="text/plain" model="http://www.cybop.org/"/>
    </node>

    <node name="web_break" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="br"/>
    </node>

    <node name="copyright" channel="inline" format="text/plain" model="Copyright TODO">
        <node name="tag" channel="inline" format="text/plain" model="p"/>
    </node>

</node>
