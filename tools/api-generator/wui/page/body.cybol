<node>

    <node name="nav-left" channel="inline" format="element/part" model="api-generator/wui/page/nav-left.cybol">
        <node name="tag" channel="inline" format="text/plain" model="nav"/>
        <node name="class" channel="inline" format="text/plain" model="position-fixed nav-left"/>
    </node>

    <node name="nav-right" channel="inline" format="element/part" model="api-generator/wui/page/nav-right.cybol">
        <node name="tag" channel="inline" format="text/plain" model="nav"/>
        <node name="class" channel="inline" format="text/plain" model="position-fixed nav-right"/>
    </node>

    <node name="section" channel="inline" format="element/part" model="api-generator/wui/page/section-center.cybol">
        <node name="tag" channel="inline" format="text/plain" model="section"/>
        <node name="class" channel="inline" format="text/plain" model="position-fixed section-center"/>
    </node>

    <node name="javascript" channel="file" format="text/plain" model="api-generator/wui/file/api.js">
        <node name="tag" channel="inline" format="text/plain" model="script"/>
    </node>

</node>
