<node>

    <!-- Creation -->

    <node name="create_page" channel="inline" format="text/cybol-path" model=".logic.create.page"/>

    <!-- Translation -->

    <node name="assign_logic" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#topic_name"/>
        <node name="source" channel="inline" format="text/plain" model="logic"/>
    </node>
    <node name="translate_logic" channel="inline" format="text/cybol-path" model=".logic.translate.topic"/>

    <node name="assign_state" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#topic_name"/>
        <node name="source" channel="inline" format="text/plain" model="state"/>
    </node>
    <node name="translate_state" channel="inline" format="text/cybol-path" model=".logic.translate.topic"/>

    <!-- Feedback -->

    <node name="inform_user" channel="inline" format="text/cybol-path" model=".logic.show_success"/>

</node>
