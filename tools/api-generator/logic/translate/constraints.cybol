<node>

    <!-- Index comparison -->

    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#section_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#section_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#section_count"/>
    </node>

    <!-- Identification -->

    <node name="get_section_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#section_name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).[#category_index].[#part_index].[#section_index]"/>
    </node>

    <!-- Count comparison -->

    <node name="count_constraints" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model="#constraint_count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).[#category_index].[#part_index].[#section_index]"/>
    </node>

    <node name="compare_count" channel="inline" format="compare/greater" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#constraint_exists"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#constraint_count"/>
        <node name="right" channel="inline" format="number/integer" model="0"/>
    </node>

<!--
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#constraint_count"/>
    </node>
-->

    <!-- Creation -->

    <!-- CAUTION! Create constraints only if at least one constraint is available. -->
    <node name="create_section_constraints" channel="inline" format="flow/branch" model="">
        <node name="criterion" channel="inline" format="text/cybol-path" model="#constraint_exists"/>
        <node name="true" channel="inline" format="text/cybol-path" model=".logic.create.section_constraints"/>
    </node>

    <!-- Translation -->

    <node name="loop_constraints" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model="#constraint_break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.constraint"/>
    </node>

    <!-- Incrementation -->

    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#section_index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
