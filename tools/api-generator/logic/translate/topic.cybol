<node>

    <!-- Reset -->

    <!--
        CAUTION! The count has to be reset even though it gets calculated below.
        The reason is that calculation might fail for non-existing children,
        and using an invalid count of a previous child would lead to wrong results.
    -->

    <node name="reset_count" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#category_count"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>
    <node name="reset_index" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#category_index"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>
    <node name="reset_break" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#category_break"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <!-- Comparison -->

    <node name="count_categories" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model="#category_count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".spec.(#topic_name)"/>
    </node>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#category_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#category_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#category_count"/>
    </node>

    <!-- Translation -->

    <node name="loop_categories" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model="#category_break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.category"/>
    </node>

</node>
