<node>

    <!-- Identification. -->
    <node name="get_property_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#property_name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).[#category_index].[#part_index].properties.[#property_index]"/>
    </node>

    <!-- Loop reset. -->
    <!-- It is NOT necessary, since there are NO children. -->

    <!-- Model creation. -->
    <!-- There is NO toc entry for the properties. -->
    <node name="create_wui_content_properties" channel="inline" format="text/cybol-path" model=".logic.create.wui_content_properties"/>

    <!-- Child translation. -->
    <!-- It is NOT necessary, since there are NO children. -->

    <!-- Loop check. -->
    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#property_index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#property_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#property_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#property_count"/>
    </node>

</node>
