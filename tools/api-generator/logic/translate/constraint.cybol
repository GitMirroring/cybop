<node>

    <!-- Comparison -->

    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#constraint_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#constraint_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#constraint_count"/>
    </node>

    <!-- Identification -->

    <node name="get_constraint_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#constraint_name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).[#category_index].[#part_index].[#section_index].[#constraint_index]"/>
    </node>

    <!-- Creation -->

    <node name="create_section_constraint" channel="inline" format="text/cybol-path" model=".logic.create.section_constraint"/>

    <!-- Incrementation -->

    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#constraint_index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
