<node>

    <!-- Identification -->

    <node name="get_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#category_name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).[#category_index]"/>
    </node>

    <!-- Reset -->

    <!--
        CAUTION! The count has to be reset even though it gets calculated below.
        The reason is that calculation might fail for non-existing children,
        and using an invalid count of a previous child would lead to wrong results.
    -->

    <node name="reset_count" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#part_count"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>
    <node name="reset_index" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#part_index"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>
    <node name="reset_break" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#part_break"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <!-- Creation -->

    <node name="create_nav_category" channel="inline" format="text/cybol-path" model=".logic.create.nav_category"/>
    <!-- There is NO category headings in the CONTENT section, since it lists only parts. -->

    <!-- Comparison -->

    <node name="count_parts" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model="#part_count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".spec.(#topic_name).[#category_index]"/>
    </node>
    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#part_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#part_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#part_count"/>
    </node>

    <!-- Translation -->

    <node name="loop_parts" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model="#part_break"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.part"/>
    </node>

    <!-- Comparison -->

    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#category_index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>
    <!-- CAUTION! The break condition has to be GREATER-OR-EQUAL-tested AFTER having incremented the loop count, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#category_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#category_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#category_count"/>
    </node>

</node>
