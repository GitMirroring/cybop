<node>

    <node name="create_page" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="wui"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=""/>
    </node>

    <node name="initialise_page" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="api/wui/page/page.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui"/>
    </node>
    <node name="initialise_page_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="sender" channel="inline" format="text/plain" model="api/wui/page/page_properties.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui"/>
    </node>

    <node name="assign_page_title" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.head.title"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.title"/>
    </node>
    <node name="assign_page_content_heading" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.body.content.heading"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.title"/>
    </node>

</node>
