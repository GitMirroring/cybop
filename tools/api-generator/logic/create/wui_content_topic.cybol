<node>

    <node name="create_wui_content_topic" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/cybol-path" model="#topic_name"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="element" channel="inline" format="text/plain" model="part"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=".wui.body.content"/>
    </node>

    <node name="initialise_wui_content_topic_part" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="sender" channel="inline" format="text/plain" model="api/wui/content/topic.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name)"/>
    </node>
    <node name="initialise_wui_content_topic_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="sender" channel="inline" format="text/plain" model="api/wui/content/topic/topic_properties.cybol"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name)"/>
    </node>

    <node name="overwrite_heading" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).anchor.heading"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#topic_name"/>
    </node>
    <node name="overwrite_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.body.content.(#topic_name).anchor:name"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#topic_name"/>
    </node>

</node>
