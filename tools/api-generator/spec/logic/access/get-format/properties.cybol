<node>
    <node name="element" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="description" channel="inline" format="text/plain" model="The part's format as return value."/>
    </node>
    <node name="part" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="description" channel="inline" format="text/plain" model="The node whose format is to be retrieved."/>
    </node>
</node>
