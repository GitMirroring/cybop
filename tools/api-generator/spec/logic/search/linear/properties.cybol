<node>
    <node name="index" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="description" channel="inline" format="text/plain" model="The index of the found searchword. Left untouched if it could not be found within the list."/>
    </node>
    <node name="list" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | text/plain | number/integer | number/double | logicvalue/boolean | element/part"/>
        <node name="description" channel="inline" format="text/plain" model="The list to be searched through."/>
    </node>
    <node name="searchword" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | text/plain | number/integer | number/double | logicvalue/boolean | element/part"/>
        <node name="description" channel="inline" format="text/plain" model="The searchword to be searched for."/>
    </node>
    <node name="perfectmatch" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | logicvalue/boolean"/>
        <node name="description" channel="inline" format="text/plain" model="The flag indicating whether the searchword count and the count of the compared list child node's name (or model if model flag has been set) have to be equal. If null, the default is false (no perfect matching)."/>
    </node>
    <node name="model" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | logicvalue/boolean"/>
        <node name="description" channel="inline" format="text/plain" model="The flag indicating whether to search through the parts' name or model value. It makes sense only if the list is of format (type) element/part which means pointers to parts. If null, the default is false (name is used)."/>
    </node>
    <node name="backward" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | logicvalue/boolean"/>
        <node name="description" channel="inline" format="text/plain" model="The flag indicating whether to search forward or backward. If null, the default is false (forward search is used)."/>
    </node>
</node>
