<node>
    <node name="result" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="description" channel="inline" format="text/plain" model="The pseudo-random value delivered by the system."/>
    </node>
    <node name="minimum" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | number/integer"/>
        <node name="description" channel="inline" format="text/plain" model="The lower bound (inclusive) of the value to be generated. If null, the default is zero."/>
    </node>
    <node name="maximum" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | number/integer"/>
        <node name="description" channel="inline" format="text/plain" model="The upper bound (exclusive) of the value to be generated. If null, the default is RAND_MAX. The GNU C Library's RAND_MAX value 2147483647 is the largest signed integer representable in 32 bits."/>
    </node>
</node>
