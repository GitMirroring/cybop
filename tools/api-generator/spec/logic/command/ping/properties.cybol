<node>
    <node name="host" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="host"/>
        <node name="description" channel="inline" format="text/plain" model="the host to be pinged"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="count" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="count"/>
        <node name="description" channel="inline" format="text/plain" model="count of ping packets to send"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
    <node name="interface" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="interface"/>
        <node name="description" channel="inline" format="text/plain" model="interface to send packets on"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/plain"/>
        <node name="model" channel="inline" format="text/plain" model=""/>
    </node>
</node>
