<node>
    <node name="path" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | text/plain"/>
        <node name="description" channel="inline" format="text/plain" model="The file whose content is to be printed."/>
    </node>
    <node name="clear" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | logicvalue/boolean"/>
        <node name="description" channel="inline" format="text/plain" model="The flag indicating to clear the screen before display."/>
    </node>
    <node name="numbers" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | logicvalue/boolean"/>
        <node name="description" channel="inline" format="text/plain" model="The flag indicating that output lines shall be numbered."/>
    </node>
    <node name="squeeze" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | logicvalue/boolean"/>
        <node name="description" channel="inline" format="text/plain" model="The flag indicating that multiple blank lines shall be merged into a single line."/>
    </node>
</node>
