<node>
    <node name="result" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="description" channel="inline" format="text/plain" model="The bit at the given position of the value."/>
    </node>
    <node name="value" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="description" channel="inline" format="text/plain" model="The value which is to be manipulated."/>
    </node>
    <node name="position" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | number/integer"/>
        <node name="description" channel="inline" format="text/plain" model="The bit position within the value."/>
    </node>
    <node name="count" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | number/integer"/>
        <node name="description" channel="inline" format="text/plain" model="The number of values to be manipulated. If null, the default is the value count."/>
    </node>
    <node name="index" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | number/integer"/>
        <node name="description" channel="inline" format="text/plain" model="The index from which to start manipulating values. If null, the default is zero."/>
    </node>
</node>
