<node>
    <node name="name" channel="inline" format="text/plain" model="encode"/>
    <node name="description" channel="inline" format="text/plain" model="Encodes the source into the destination, according to the given encoding."/>
    <node name="example" channel="file" format="text/plain" model="api/spec/logic/convert/encode/example.txt"/>
    <node name="format" channel="inline" format="text/plain" model="convert/encode"/>
    <node name="properties" channel="file" format="element/part" model="api/spec/logic/convert/encode/properties.cybol"/>
</node>