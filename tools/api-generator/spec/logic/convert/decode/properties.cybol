<node>
    <node name="destination" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="description" channel="inline" format="text/plain" model="The destination wide character array consisting of elements of type "wchar_t"."/>
    </node>
    <node name="source" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="description" channel="inline" format="text/plain" model="The source byte array consisting of elements of type "char"."/>
    </node>
    <node name="encoding" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | meta/encoding"/>
        <node name="description" channel="inline" format="text/plain" model="The message encoding."/>
    </node>
</node>
