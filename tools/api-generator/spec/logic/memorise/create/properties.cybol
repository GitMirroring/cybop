<node>
    <node name="name" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | text/plain"/>
        <node name="description" channel="inline" format="text/plain" model="The name of the part to be created."/>
    </node>
    <node name="format" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | meta/format"/>
        <node name="description" channel="inline" format="text/plain" model="The format of the part to be created. The internal data type gets determined from it."/>
    </node>
    <node name="whole" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path"/>
        <node name="description" channel="inline" format="text/plain" model="The destination parent node to which to add the new part to. If null, the default is the knowledge memory root node."/>
    </node>
    <node name="properties" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | logicvalue/boolean"/>
        <node name="description" channel="inline" format="text/plain" model="The flag indicating whether to use the model or properties branch as destination. If null, the default is false (model branch)."/>
    </node>
</node>
