<node>
    <node name="times" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | number/integer"/>
        <node name="description" channel="inline" format="text/plain" model="The number of cycles the loop should run."/>
    </node>
    <node name="model" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | element/part"/>
        <node name="description" channel="inline" format="text/plain" model="The logic knowledge model (function) to be executed repeatedly by the loop."/>
    </node>
</node>
