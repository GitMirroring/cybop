<node>
    <node name="criterion" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | logicvalue/boolean"/>
        <node name="description" channel="inline" format="text/plain" model="The flag defining which of the two models to execute."/>
    </node>
    <node name="true" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | element/part"/>
        <node name="description" channel="inline" format="text/plain" model="The logic knowledge model to be executed if the criterion is true."/>
    </node>
    <node name="false" channel="inline" format="text/plain" model="">
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="text/cybol-path | element/part"/>
        <node name="description" channel="inline" format="text/plain" model="The logic knowledge model to be executed if the criterion is false."/>
    </node>
</node>
