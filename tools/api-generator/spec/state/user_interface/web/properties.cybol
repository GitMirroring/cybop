<node>
    <node name="tag" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="tag"/>
        <node name="description" channel="inline" format="text/plain" model="The html tag to use. Void tags are detected automatically."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | text/plain"/>
        <node name="model" channel="inline" format="text/plain" model="a valid html tag without arrow brackets"/>
    </node>
    <node name="class" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="class"/>
        <node name="description" channel="inline" format="text/plain" model="The 'class' html attribute."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | text/plain"/>
        <node name="model" channel="inline" format="text/plain" model="a css class as html attribute"/>
    </node>
    <node name="...(html attribute)..." channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="...(html attribute)..."/>
        <node name="description" channel="inline" format="text/plain" model="An arbitrary html attribute."/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | text/plain"/>
        <node name="model" channel="inline" format="text/plain" model="a valid html attribute"/>
    </node>
    <node name="preformatted" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="preformatted"/>
        <node name="description" channel="inline" format="text/plain" model="??"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | logicvalue/boolean"/>
        <node name="model" channel="inline" format="text/plain" model="??"/>
    </node>
    <node name="property" channel="inline" format="text/plain" model="">
        <node name="name" channel="inline" format="text/plain" model="property"/>
        <node name="description" channel="inline" format="text/plain" model="??"/>
        <node name="required" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="format" channel="inline" format="text/plain" model="path/* | text/plain"/>
        <node name="model" channel="inline" format="text/plain" model="??"/>
    </node>
</node>
