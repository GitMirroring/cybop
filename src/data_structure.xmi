         <classwidget linecolor="none" usesdiagramfillcolor="1" linewidth="none" showoperations="1" textcolor="none" usesdiagramusefillcolor="1" showpubliconly="1" showpackage="0" x="510" showattsigs="601" y="90" showattributes="1" font="Sans Serif,10,-1,5,75,0,0,0,0,0" width="49" isinstance="0" usefillcolor="1" fillcolor="none" xmi.id="j8V04zDCJp4z" showscope="1" height="29" showopsigs="601"/>
         <notewidget width="627" x="20" noteType="0" usesdiagramusefillcolor="1" y="200" usesdiagramfillcolor="1" isinstance="0" fillcolor="none" height="378" linecolor="none" xmi.id="iM3PIGx0UNoA" textcolor="none" usefillcolor="1" linewidth="none" font="Sans Serif,10,-1,5,50,0,0,0,0,0" text="Data structures of the CYBOI interpreter at runtime:&#xa;&#xa;part:&#xa;It contains a model which may be primitive data (like a number) or compound data (child parts).&#xa;The part keeps properties (meta information) about the model it points to.&#xa;Properties are always a (compound) part that contains other (property) parts.&#xa;Further, it keeps the type of the model and a unique name for it.&#xa;The internal type reflects the format.&#xa;A fraction number can be given in two different formats, a complex number as well.&#xa;But internally, they are mapped to the same type, for easier handling and calculation.&#xa;The references are an attribute that is only used in cyboi for rubbish (garbage) collection.&#xa;&#xa;item:&#xa;It ist just a pointer to data (an array) combined with&#xa;the size (maximum number of elements)&#xa;and count (current number of elements).&#xa;&#xa;array:&#xa;An allocated area in memory that contains values which may be&#xa;accessed via indices (calculated with pointer arithmetics).&#xa;&#xa;value:&#xa;Some primitive like an integer number, a double number, a void* pointer etc.&#xa;"/>
         <classwidget linecolor="none" usesdiagramfillcolor="1" linewidth="none" showoperations="1" textcolor="none" usesdiagramusefillcolor="1" showpubliconly="1" showpackage="0" x="620" showattsigs="601" y="90" showattributes="1" font="Sans Serif,10,-1,5,75,0,0,0,0,0" width="30" isinstance="0" usefillcolor="1" fillcolor="none" xmi.id="5Ks67bUnc6QZ" showscope="1" height="29" showopsigs="601"/>
