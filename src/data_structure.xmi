         <classwidget width="30" font="DejaVu Sans,9,-1,0,50,0,0,0,0,0,Oblique" showscope="1" autoresize="1" localid="I48B4yWCfwN2" fillcolor="none" showpackage="1" y="80" textcolor="none" showopsigs="601" linewidth="none" showoperations="1" usesdiagramfillcolor="1" isinstance="0" showattributes="1" showattsigs="601" linecolor="none" height="30" showpubliconly="0" usesdiagramusefillcolor="1" x="610" xmi.id="5Ks67bUnc6QZ" usefillcolor="1"/>
         <notewidget width="630" font="DejaVu Sans,9,-1,0,50,0,0,0,0,0,Oblique" autoresize="1" localid="kVH4BVOiHi9v" fillcolor="none" y="260" textcolor="none" linewidth="none" usesdiagramfillcolor="1" isinstance="0" linecolor="none" height="380" noteType="0" usesdiagramusefillcolor="1" x="20" text="Data structures of the CYBOI interpreter at runtime:&#xa;&#xa;part:&#xa;It contains a model which may be primitive data (like a number) or compound data (child parts).&#xa;The part keeps properties (meta information) about the model it points to.&#xa;Properties are always a (compound) part that contains other (property) parts.&#xa;Further, it keeps the type of the model and a unique name for it.&#xa;The internal type reflects the format.&#xa;A fraction number can be given in two different formats, a complex number as well.&#xa;But internally, they are mapped to the same type, for easier handling and calculation.&#xa;The references are an attribute that is only used in cyboi for rubbish (garbage) collection.&#xa;&#xa;item:&#xa;It ist just a pointer to data (an array) combined with&#xa;the size (maximum number of elements)&#xa;and count (current number of elements).&#xa;&#xa;array:&#xa;An allocated area in memory that contains values which may be&#xa;accessed via indices (calculated with pointer arithmetics).&#xa;&#xa;value:&#xa;Some primitive like an integer number, a double number, a void* pointer etc.&#xa;" xmi.id="iM3PIGx0UNoA" usefillcolor="1"/>
        </widgets>
