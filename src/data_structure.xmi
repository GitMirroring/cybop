         <classwidget linecolor="#ff0000" usesdiagramfillcolor="0" linewidth="none" showoperations="1" textcolor="none" usesdiagramusefillcolor="0" showpubliconly="1" showpackage="0" x="220" showattsigs="601" y="70" showattributes="1" font="Sans Serif,10,-1,5,50,0,0,0,0,0" localid="daNWGkxIKgGM" width="86" isinstance="0" usefillcolor="1" fillcolor="#ffffc0" xmi.id="8MeugsIa6ZvE" showscope="1" height="67" showopsigs="601"/>
