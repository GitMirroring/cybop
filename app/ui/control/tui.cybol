<node>

    <node name="main" channel="file" format="element/part" model="ui/control/tui/main/window.cybol">
        <node name="super" channel="inline" format="text/cybol-path" model=".settings.window"/>
        <node name="position" channel="inline" format="number/integer" model="0,0"/>
        <node name="size" channel="inline" format="number/integer" model="80,24"/>
        <node name="actions" channel="inline" format="text/plain" model=".tui.main_actions"/>
    </node>
    <node name="about" channel="file" format="element/part" model="ui/control/tui/about/window.cybol">
        <node name="super" channel="inline" format="text/cybol-path" model=".settings.window"/>
        <node name="position" channel="inline" format="number/integer" model="0,0"/>
        <node name="size" channel="inline" format="number/integer" model="80,24"/>
        <node name="actions" channel="inline" format="text/plain" model=".tui.about_actions"/>
    </node>

    <node name="main_actions" channel="file" format="element/part" model="ui/control/tui/main/actions.cybol"/>
    <node name="about_actions" channel="file" format="element/part" model="ui/control/tui/about/actions.cybol"/>

    <node name="cursor" channel="inline" format="text/plain" model="">
        <node name="position" channel="inline" format="number/integer" model="0,25"/>
    </node>

    <!-- The active window which is in front. -->
    <node name="active" channel="inline" format="text/plain" model=""/>

</node>
