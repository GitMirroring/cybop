<node>

    <node name="copy_background" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.selection.background"/>
        <node name="source" channel="inline" format="colour/terminal" model="green"/>
    </node>

    <node name="copy_foreground" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.selection.foreground"/>
        <node name="source" channel="inline" format="colour/terminal" model="black"/>
    </node>

    <node name="copy_bold" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".settings.selection.bold"/>
        <node name="source" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

</node>
