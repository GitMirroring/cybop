<node>

    <node name="window" channel="file" format="element/part" model="ui/all/tui/window.cybol">
        <node name="position" channel="inline" format="number/integer" model="0,0"/>
        <node name="size" channel="inline" format="number/integer" model="80,25"/>
        <node name="background" channel="inline" format="colour/terminal" model="white"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="green"/>
        <node name="border" channel="inline" format="text/plain" model="ascii"/>
    </node>

    <node name="cursor" channel="inline" format="text/plain" model="">
        <node name="position" channel="inline" format="number/integer" model="0,25"/>
    </node>

    <node name="actions" channel="file" format="element/part" model="ui/all/tui/actions.cybol"/>

    <!--
        CAUTION! The path format is "text/cybol-path" and NOT "text/plain".
        A knowledge path is treated like a character array anyway.
        So, text fragments may be added to it in the "handle" file.
    -->
    <node name="path" channel="inline" format="text/cybol-path" model=""/>
    <node name="command" channel="inline" format="text/plain" model=""/>

</node>
