<node>

    <node name="heading" channel="inline" format="text/plain" model="CYBOL User Interface (UI) Example">
        <node name="position" channel="inline" format="number/integer" model="5,2"/>
        <node name="size" channel="inline" format="number/integer" model="33,1"/>
        <node name="background" channel="inline" format="colour/terminal" model="white"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="green"/>
        <!-- This property is evaluated by win32 console only. -->
        <node name="intense" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="underline" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <node name="box" channel="file" format="element/part" model="ui/all/tui/box.cybol">
        <node name="position" channel="inline" format="number/integer" model="5,4"/>
        <node name="size" channel="inline" format="number/integer" model="70,12"/>
        <node name="background" channel="inline" format="colour/terminal" model="blue"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="yellow"/>
        <node name="bold" channel="inline" format="logicvalue/boolean" model="true"/>
        <!-- This property is evaluated by win32 console only. -->
        <node name="intense" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="border" channel="inline" format="text/plain" model="ascii"/>
    </node>

    <node name="control" channel="file" format="element/part" model="ui/all/tui/control.cybol">
        <node name="position" channel="inline" format="number/integer" model="5,17"/>
        <node name="size" channel="inline" format="number/integer" model="70,6"/>
        <node name="background" channel="inline" format="colour/terminal" model="white"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
    </node>

</node>
