<node>

    <!-- TODO: When using a pure string here, the positioning does NOT work. -->
    <node name="world_button" channel="file" format="element/part" model="ui/all/tui/world_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="0,0"/>
        <node name="size" channel="inline" format="number/integer" model="17,3"/>
        <node name="background" channel="inline" format="colour/terminal" model="yellow"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
        <node name="bold" channel="inline" format="logicvalue/boolean" model="false"/>
        <!-- This property is evaluated by win32 console only. -->
        <node name="intense" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="border" channel="inline" format="text/plain" model="ascii"/>
    </node>

    <!-- TODO: When using a pure string here, the positioning does NOT work. -->
    <node name="cybop_button" channel="file" format="element/part" model="ui/all/tui/cybop_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="18,0"/>
        <node name="size" channel="inline" format="number/integer" model="17,3"/>
        <node name="background" channel="inline" format="colour/terminal" model="yellow"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
        <node name="bold" channel="inline" format="logicvalue/boolean" model="false"/>
        <!-- This property is evaluated by win32 console only. -->
        <node name="intense" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="border" channel="inline" format="text/plain" model="ascii"/>
    </node>

    <!-- TODO: When using a pure string here, the positioning does NOT work. -->
    <node name="exit_button" channel="file" format="element/part" model="ui/all/tui/exit_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="36,0"/>
        <node name="size" channel="inline" format="number/integer" model="17,3"/>
        <node name="background" channel="inline" format="colour/terminal" model="yellow"/>
        <node name="foreground" channel="inline" format="colour/terminal" model="black"/>
        <node name="bold" channel="inline" format="logicvalue/boolean" model="false"/>
        <!-- This property is evaluated by win32 console only. -->
        <node name="intense" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="border" channel="inline" format="text/plain" model="ascii"/>
    </node>

    <!-- TODO: When using a pure string here, the positioning does NOT work. -->
    <node name="cybop_button" channel="file" format="element/part" model="ui/all/tui/button_label.cybol">
        <node name="position" channel="inline" format="number/integer" model="0,4"/>
        <node name="size" channel="inline" format="number/integer" model="40,1"/>
    </node>

    <!-- TODO: When using a pure string here, the positioning does NOT work. -->
    <node name="cybop_button" channel="file" format="element/part" model="ui/all/tui/exit_label.cybol">
        <node name="position" channel="inline" format="number/integer" model="0,5"/>
        <node name="size" channel="inline" format="number/integer" model="40,1"/>
    </node>

</node>
