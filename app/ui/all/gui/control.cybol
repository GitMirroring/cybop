<node>

    <node name="world_button" channel="file" format="element/part" model="ui/all/gui/world_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="0,0"/>
        <node name="size" channel="inline" format="number/integer" model="100,40"/>
        <!-- yellow -->
        <node name="foreground" channel="inline" format="colour/rgb" model="255,255,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.greet-world"/>
    </node>

    <node name="cybop_button" channel="file" format="element/part" model="ui/all/gui/cybop_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="120,0"/>
        <node name="size" channel="inline" format="number/integer" model="100,40"/>
        <!-- yellow -->
        <node name="foreground" channel="inline" format="colour/rgb" model="255,255,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.greet-cybop"/>
    </node>

    <node name="exit_button" channel="file" format="element/part" model="ui/all/gui/exit_button.cybol">
        <node name="position" channel="inline" format="number/integer" model="240,0"/>
        <node name="size" channel="inline" format="number/integer" model="100,40"/>
        <!-- yellow -->
        <node name="foreground" channel="inline" format="colour/rgb" model="255,255,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.exit"/>
    </node>

</node>
