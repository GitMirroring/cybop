<node>

    <!-- Terminal -->

    <node name="sense_terminal" channel="inline" format="feel/sense" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".stdin"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="handler" channel="inline" format="text/cybol-path" model=".logic.handle.terminal"/>
    </node>

    <!-- Display -->

    <node name="enable_display" channel="inline" format="activate/enable" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
    </node>

    <!--
        This operation "feel/sense" for channel "display" does NOT run in a separate thread.
        It is just used to hand over a specific handler for the window.
    -->
    <node name="sense_window" channel="inline" format="feel/sense" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <node name="server" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".window_id"/>
        <node name="handler" channel="inline" format="text/cybol-path" model=".logic.handle.display"/>
    </node>

    <!-- Socket -->

    <node name="enable_socket" channel="inline" format="activate/enable" model="">
        <node name="channel" channel="inline" format="meta/channel" model="socket"/>
        <node name="port" channel="inline" format="number/integer" model="1971"/>
        <node name="handler" channel="inline" format="text/cybol-path" model=".logic.handle.socket_enable"/>
    </node>

</node>
