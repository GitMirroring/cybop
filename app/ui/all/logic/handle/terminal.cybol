<node>

    <!-- The command HAS TO BE EMPTIED since otherwise, the new is appended to the old command in the receive operation below. -->
    <node name="reset_command" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".tui.command"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="receive_command" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".stdin"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".tui.command"/>
        <!-- Read data from buffer in which they got stored by the sensing thread before. -->
        <node name="asynchronicity" channel="inline" format="logicvalue/boolean" model="true"/>
    </node>

    <!-- CAUTION! Use "overwrite" here for initialisation and "append" only afterwards. -->
    <node name="overwrite_path" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".tui.path"/>
        <node name="source" channel="inline" format="text/plain" model=".tui.actions."/>
    </node>
    <node name="append_command" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".tui.path"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".tui.command"/>
    </node>

    <!-- CAUTION! The path is NOT a reference. -->
    <node name="execute_action" channel="inline" format="text/cybol-path" model=".tui.path"/>

</node>
