<node>

    <node name="copy_to_tui" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".tui.window.box.label"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".domain.greeting"/>
    </node>

    <node name="copy_to_gui" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.window.box.label.text"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".domain.greeting"/>
    </node>

    <node name="copy_to_wui" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.box"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".domain.greeting"/>
    </node>

</node>
