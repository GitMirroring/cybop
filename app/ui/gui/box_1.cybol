<node>

    <node name="box_2" channel="file" format="element/part" model="ui/gui/box_2.cybol">
        <node name="position" channel="inline" format="number/integer" model="5,5"/>
        <node name="size" channel="inline" format="number/integer" model="200,100"/>
        <!-- red -->
        <node name="foreground" channel="inline" format="colour/rgb" model="255,0,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
    </node>

    <node name="label" channel="inline" format="text/plain" model="Say Hello">
        <node name="position" channel="inline" format="number/integer" model="250,5"/>
        <node name="size" channel="inline" format="number/integer" model="100,100"/>
        <!-- blue -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,0,255"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="font" channel="inline" format="text/plain" model="7x13"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.say_hello"/>
    </node>

    <node name="exit_button" channel="inline" format="text/plain" model="Exit Application">
        <node name="position" channel="inline" format="number/integer" model="5,110"/>
        <node name="size" channel="inline" format="number/integer" model="150,30"/>
        <!-- blue on purple -->
        <node name="background" channel="inline" format="colour/rgb" model="255,255,255"/>
        <node name="foreground" channel="inline" format="colour/rgb" model="0,170,255"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="font" channel="inline" format="text/plain" model="7x13"/>
        <node name="button-release" channel="inline" format="text/plain" model=".logic.exit_programme"/>
    </node>

</node>
