<node>
    <node name="text" channel="inline" format="text/plain" model="Ein Beispieltext."/>
    <node name="numbers" channel="inline" format="element/part" model="<node>
    <node name="byte" channel="inline" format="text/plain" model="byte"/>
    <node name="integer" channel="inline" format="text/plain" model="integer"/>
    <node name="fraction-decimal" channel="inline" format="text/plain" model="fraction-decimal"/>
    <node name="fraction-vulgar" channel="inline" format="text/plain" model="fraction-vulgar"/>
    <node name="complex-cartesian" channel="inline" format="text/plain" model="complex-cartesian"/>
    <node name="complex-polar" channel="inline" format="text/plain" model="complex-polar">
        <node name="minus_sign" channel="inline" format="number/complex-polar" model="2.0000*exp(125.2644)"/>
    </node>
</node>
"/>
    <node name="properties" channel="inline" format="text/plain" model="properties">
        <node name="prop_1" channel="inline" format="text/plain" model="first property"/>
        <node name="prop_2" channel="inline" format="text/plain" model="second property"/>
    </node>
</node>
