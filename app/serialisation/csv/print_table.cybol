<node>

    <!-- Logging -->

    <node name="print_newline" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model=""/>
    </node>

    <node name="print_heading" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="Table:"/>
    </node>

    <!-- Heading -->

    <node name="assign_row" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#row"/>
        <node name="source" channel="inline" format="text/plain" model="#row_heading"/>
    </node>
<!-- ?? TODO:
    The problem is that the loop index gets incremented and the break flag set inside,
    so that the table data below are NOT processed in the loop anymore.
    Solve this as soon as the loop index incrementation is done in c code one day.
    <node name="print_table_heading" channel="inline" format="text/cybol-path" model="#row_model"/>
-->

    <!-- Data -->

    <node name="assign_row" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#row"/>
        <node name="source" channel="inline" format="text/plain" model="#row_data"/>
    </node>
    <node name="count_rows" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model="#row_count"/>
        <node name="part" channel="inline" format="text/cybol-path" model="{#table}"/>
    </node>
<!--
    <node name="TEST_count" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#row_count"/>
    </node>
-->

<!--
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#row_index"/>
    </node>
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="logicvalue/boolean"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#row_break"/>
    </node>
-->

    <!-- Loop -->

    <!-- The break condition has to be GREATER-OR-EQUAL-tested ONCE BEFORE calling the loop, since this is a post-test loop. -->
    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#row_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#row_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#row_count"/>
    </node>
    <node name="loop_rows" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model="#row_break"/>
        <node name="model" channel="inline" format="text/cybol-path" model="#row_model"/>
    </node>

    <!-- Logging -->

    <node name="print_newline" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model=""/>
    </node>

</node>
