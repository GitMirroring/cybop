<node>

    <!-- Terminal -->

    <node name="stdout" channel="inline" format="number/integer" model="-1"/>

    <!-- Deserialised data -->

    <node name="smtp_command" channel="inline" format="text/plain" model=""/>
    <node name="smtp_message_imf" channel="inline" format="text/plain" model=""/>
    <node name="smtp_response" channel="inline" format="number/integer" model=""/>
    <node name="pop3_command" channel="inline" format="text/plain" model=""/>
    <node name="pop3_reply" channel="inline" format="text/plain" model=""/>
    <node name="imap_command" channel="inline" format="text/plain" model=""/>
    <node name="imap_response" channel="inline" format="text/plain" model=""/>
    <node name="mbox" channel="inline" format="element/part" model=""/>
    <node name="base64" channel="inline" format="text/plain" model=""/>

    <node name="read_file" channel="file" format="element/part" model="serialisation/email/read_file.cybol"/>

