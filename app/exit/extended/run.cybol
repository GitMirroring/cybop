<!--
    This application sends an event to cyboi and reads the "exit" operation
    from an external file.
-->

<node>

    <node name="send_exit_signal" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="signal"/>
        <node name="message" channel="file" format="element/part" model="exit/extended/exit.cybol"/>
    </node>

</node>
