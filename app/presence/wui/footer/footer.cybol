<node>

    <node name="rule" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="hr"/>
    </node>
    <node name="image" channel="inline" format="text/plain" model="">
        <node name="tag" channel="inline" format="text/plain" model="img"/>
        <node name="src" channel="inline" format="text/plain" model="footer/logo.png"/>
        <node name="alt" channel="inline" format="text/plain" model="Logo"/>
    </node>
    <node name="text" channel="file" format="element/part" model="presence/wui/footer/text.cybol">
        <node name="tag" channel="inline" format="text/plain" model="span"/>
        <node name="class" channel="inline" format="text/plain" model="text"/>
    </node>

</node>
