<node>

    <node name="heading" channel="inline" format="text/plain" model="--">
        <node name="tag" channel="inline" format="text/plain" model="th"/>
        <node name="class" channel="inline" format="text/plain" model="left"/>
    </node>

    <node name="monday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <node name="tag" channel="inline" format="text/plain" model="td"/>
        <node name="class" channel="inline" format="text/plain" model="empty"/>
    </node>
    <node name="tuesday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <node name="tag" channel="inline" format="text/plain" model="td"/>
        <node name="class" channel="inline" format="text/plain" model="empty"/>
    </node>
    <node name="wednesday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <node name="tag" channel="inline" format="text/plain" model="td"/>
        <node name="class" channel="inline" format="text/plain" model="empty"/>
    </node>
    <node name="thursday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <node name="tag" channel="inline" format="text/plain" model="td"/>
        <node name="class" channel="inline" format="text/plain" model="empty"/>
    </node>
    <node name="friday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <node name="tag" channel="inline" format="text/plain" model="td"/>
        <node name="class" channel="inline" format="text/plain" model="empty"/>
    </node>
    <node name="saturday" channel="file" format="element/part" model="presence/wui/lecturers/link_data.cybol">
        <node name="tag" channel="inline" format="text/plain" model="td"/>
        <node name="class" channel="inline" format="text/plain" model="empty"/>
    </node>

</node>
