<node>

    <!-- Web page. -->
    <node name="send-index" channel="inline" format="text/cybol-path" model=".logic.send.index"/>

    <!-- Date navigation. -->
    <node name="navigate-backward" channel="inline" format="text/cybol-path" model=".logic.navigate.backward"/>
    <node name="navigate-forward" channel="inline" format="text/cybol-path" model=".logic.navigate.forward"/>

    <!-- User interface update. -->
    <node name="update" channel="inline" format="text/cybol-path" model=".logic.translate.uri_to_all"/>

    <!-- Programme exit. -->
    <node name="exit" channel="inline" format="live/exit" model=""/>

</node>
