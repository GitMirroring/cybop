<node>

    <!-- CAUTION! This is IMPORTANT since serialised values are appended below. -->
    <node name="empty_week" channel="inline" format="modify/empty" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.week_string"/>
        <node name="destination_properties" channel="inline" format="logicvalue/boolean" model="false"/>
    </node>

    <node name="serialise_week" channel="inline" format="represent/serialise" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.week_string"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.week"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>

    <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.cal_to_wui"/>
    <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.db_to_wui.lecturers"/>

    <!--
        CAUTION! Do NOT send index page in file "logic/navigate/week.cybol".
        It gets called on system startup before a socket was created,
        so that it MUST NOT try to send data yet.
        Therefore, the page is sent only when reacting to an action request, e.g. in:
        logic/navigate/backward.cybol
        logic/navigate/forward.cybol
    -->

</node>
