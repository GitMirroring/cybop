<node>

    <node name="row" channel="file" format="element/part" model="presence/logic/translate/uri_to_db/row.cybol">
        <node name="break" channel="inline" format="logicvalue/boolean" model="false"/>
        <node name="index" channel="inline" format="number/integer" model="0"/>
        <node name="count" channel="inline" format="number/integer" model="0"/>
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.uri_to_db.column"/>
    </node>

    <node name="column" channel="file" format="element/part" model="presence/logic/translate/uri_to_db/column.cybol">
        <node name="day" channel="inline" format="text/plain" model=""/>
    </node>

    <node name="directory_path" channel="file" format="element/part" model="presence/logic/translate/uri_to_db/directory_path.cybol"/>
    <node name="file_path" channel="file" format="element/part" model="presence/logic/translate/uri_to_db/file_path.cybol"/>

    <node name="file" channel="file" format="element/part" model="presence/logic/translate/uri_to_db/file.cybol"/>

</node>
