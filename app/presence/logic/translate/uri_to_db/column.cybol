<node>

    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#count"/>
    </node>

    <node name="get_weekday_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#day"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".domain.weekdays.[#index]"/>
    </node>

    <node name="overwrite_db_entry" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".db.(#day)"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".wui.index.body.lecturers.table.(.var.request:uri:query.lecturer).(#day):class"/>
    </node>

    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
