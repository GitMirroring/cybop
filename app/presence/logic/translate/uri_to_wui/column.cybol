<node>

    <!--
        Example uri:
        http://presence.cybop.org/?year=2015&week=11&lecturer=heller&day=monday&choice=holiday&action=update
    -->

    <node name="overwrite_link" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.lecturers.table.(.var.request:uri:query.lecturer).(.var.request:uri:query.day).link"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".domain.choices.(.var.request:uri:query.choice)"/>
    </node>
    <node name="translate_href" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.uri_to_wui.href"/>
    </node>
    <node name="overwrite_class" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.lecturers.table.(.var.request:uri:query.lecturer).(.var.request:uri:query.day):class"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.request:uri:query.choice"/>
    </node>

</node>
