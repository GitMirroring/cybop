        <node name="format" channel="inline" format="meta/format" model="datetime/jd"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".var.day"/>
    </node>
    <node name="get_calendar_week" channel="inline" format="represent/serialise" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.week"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.day"/>
        <node name="format" channel="inline" format="meta/format" model="datetime/year-week"/>
        <node name="language" channel="inline" format="meta/language" model="??/??"/>
    </node>
