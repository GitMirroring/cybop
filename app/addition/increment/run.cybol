<!--
    This application increments a given number.
-->

<node>

    <!-- Creation -->

    <node name="create_fileid" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="stdout"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>
    <node name="create_fileid" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="number"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>

    <!-- Initialisation -->

    <node name="open_stdout" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="device" channel="inline" format="text/plain" model="standard-output"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".stdout"/>
    </node>
    <!--
        The number has to get initialised using modify/overwrite since otherwiese,
        it remains empty "" and calculate/increment as well as calculate/add
        would bring up the error:
        Error: Could not apply calculate type. The result type and operand type are different.
        Error: Result type: -1. Operand type: 34.
    -->
    <node name="initialise_number" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".number"/>
        <node name="source" channel="inline" format="number/integer" model="0"/>
    </node>

    <!-- Addition -->

    <node name="increment_number" channel="inline" format="calculate/increment" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".number"/>
    </node>
<!--
    <node name="TEST" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model=".number"/>
        <node name="operand" channel="inline" format="number/integer" model="4"/>
    </node>
-->

    <!-- Printing -->

    <node name="print_result" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".number"/>
    </node>

    <!-- Shutdown -->

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>
