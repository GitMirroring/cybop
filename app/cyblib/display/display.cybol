<node>

    <node name="window_id" channel="inline" format="number/integer" model="-1"/>

    <!-- CAUTION! Colour values for the x window system have to be given as 16 bit values ranging from 0 to 255. -->
    <node name="window" channel="file" format="element/part" model="cyblib/display/window.cybol">
        <!-- This flag indicates that this is a window to which the properties are to be applied. -->
        <node name="window" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="title" channel="inline" format="text/plain" model="The Window Title"/>
        <node name="icon_title" channel="inline" format="text/plain" model="Iconised Window Title"/>
        <node name="position" channel="inline" format="number/integer" model="100,50"/>
        <node name="size" channel="inline" format="number/integer" model="640,480"/>
        <node name="foreground" channel="inline" format="colour/rgb" model="255,255,128"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="layout" channel="inline" format="text/plain" model="absolute"/>
        <node name="expose" channel="inline" format="text/plain" model=".cybol.display.refresh"/>
        <node name="close-window" channel="inline" format="text/plain" model=".cybol.display.exit"/>
    </node>

    <!-- This variable is used in file "handle.cybol". -->
    <node name="action" channel="inline" format="text/plain" model=""/>

    <node name="refresh" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <!-- This flag is IMPORTANT for finding the correct client entry in the server list. -->
        <node name="server" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".cybol.display.window_id"/>
        <node name="language" channel="inline" format="meta/language" model="message/gui-response"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".cybol.display.window"/>
    </node>

    <node name="handle" channel="file" format="element/part" model="cyblib/display/handle.cybol"/>

    <node name="exit" channel="inline" format="live/exit" model=""/>

</node>
