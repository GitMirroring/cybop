<node>

    <node name="startup_display" channel="inline" format="maintain/startup" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
    </node>

    <node name="initialise_cybol" channel="file" format="element/part" model="cyblib/initialise-modules.cybol"/>

    <node name="configure_title" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.window:title"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#title"/>
    </node>
    <node name="configure_position" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.window:position"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#position"/>
    </node>
    <node name="configure_size" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.window:size"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#size"/>
    </node>
    <node name="configure_text" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".gui.window"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#text"/>
    </node>

<!--
    <node name="TEST" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/model-diagram"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model="#"/>
        <node name="receiver" channel="inline" format="text/plain" model="test_cybol_print-gui_stack.txt"/>
    </node>
-->

    <node name="send_display" channel="inline" format="flow/sequence" model="">
        <node name="model" channel="inline" format="text/cybol-path" model=".logic.refresh_display"/>
    </node>

    <node name="sense_display" channel="inline" format="activate/enable" model="">
        <node name="channel" channel="inline" format="meta/channel" model="display"/>
        <node name="handler" channel="inline" format="text/cybol-path" model=".logic.handler"/>
        <node name="root" channel="inline" format="text/cybol-path" model=".gui.window"/>
    </node>

</node>
