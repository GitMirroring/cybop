<node>

    <node name="window" channel="file" format="element/part" model="starlike/gui/window.cybol">
        <!-- This flag indicates that this is a window to which the properties are to be applied. -->
        <node name="window" channel="inline" format="logicvalue/boolean" model="true"/>
        <node name="title" channel="inline" format="text/plain" model="CYBOL User Interface (UI) Example"/>
        <node name="icon_title" channel="inline" format="text/plain" model="Iconised GUI Example"/>
<!--
        <node name="icon" channel="file" format="png" model="starlike/gui/icon.png"/>
-->
        <node name="position" channel="inline" format="number/integer" model="20,20"/>
        <node name="size" channel="inline" format="number/integer" model="540,380"/>
        <node name="foreground" channel="inline" format="colour/rgb" model="255,255,255"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="layout" channel="inline" format="text/plain" model="absolute"/>
        <node name="expose" channel="inline" format="text/plain" model=".logic.send.send_gui"/>
        <node name="close-window" channel="inline" format="text/plain" model=".logic.exit"/>
    </node>

    <!-- This variable is used in file "handle.cybol". -->
    <node name="action" channel="inline" format="text/plain" model=""/>

</node>
