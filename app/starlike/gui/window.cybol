<node>

    <node name="heading" channel="file" format="element/part" model="starlike/gui/heading.cybol">
        <node name="position" channel="inline" format="number/integer" model="20,20"/>
        <node name="size" channel="inline" format="number/integer" model="400,40"/>
        <!-- green -->
        <node name="foreground" channel="inline" format="colour/rgb" model="0,255,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
    </node>

    <node name="box" channel="file" format="element/part" model="starlike/gui/box.cybol">
        <node name="position" channel="inline" format="number/integer" model="20,70"/>
        <node name="size" channel="inline" format="number/integer" model="400,150"/>
        <!-- yellow -->
        <node name="foreground" channel="inline" format="colour/rgb" model="255,255,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <!-- double-dash, on-off-dash, solid -->
        <node name="line-style" channel="inline" format="text/plain" model="on-off-dash"/>
    </node>

    <node name="control" channel="file" format="element/part" model="starlike/gui/control.cybol">
        <node name="position" channel="inline" format="number/integer" model="20,230"/>
        <node name="size" channel="inline" format="number/integer" model="400,60"/>
        <node name="foreground" channel="inline" format="colour/rgb" model="255,255,255"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
    </node>

</node>
