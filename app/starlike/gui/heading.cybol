<node>

    <node name="label" channel="inline" format="text/plain" model="CYBOL User Interface (UI) Example">
        <node name="position" channel="inline" format="number/integer" model="80,15"/>
        <node name="size" channel="inline" format="number/integer" model="200,10"/>
        <!-- black on green -->
        <node name="background" channel="inline" format="colour/rgb" model="0,255,0"/>
        <node name="foreground" channel="inline" format="colour/rgb" model="0,0,0"/>
        <node name="shape" channel="inline" format="text/plain" model="rectangle"/>
        <node name="font" channel="inline" format="text/plain" model="7x13"/>
    </node>

</node>
