<node>

    <node name="overwrite_link" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.lecturers.table.(#name).(#day).link"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".domain.choices.teaching"/>
    </node>

    <node name="model" channel="inline" format="text/cybol-path" model=".logic.translate.db_to_wui.href_default"/>

    <node name="overwrite_href" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.lecturers.table.(#name).(#day).link:href"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#href"/>
    </node>

    <node name="overwrite_class" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.lecturers.table.(#name).(#day):class"/>
        <node name="source" channel="inline" format="text/plain" model="teaching"/>
    </node>

</node>
