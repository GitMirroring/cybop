<node>

    <!--
        Example path:
        presence/db/2015/11/heller.cybol
    -->

    <node name="overwrite_directory" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.dbfile"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.directory"/>
    </node>

    <node name="append_lecturer_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.dbfile"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".domain.path.separator"/>
    </node>
    <node name="append_lecturer" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.dbfile"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".var.request:uri:query.lecturer"/>
    </node>

    <node name="append_suffix_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.dbfile"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".domain.path.suffix_separator"/>
    </node>
    <node name="append_file_suffix" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".var.dbfile"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".domain.path.file_suffix"/>
    </node>

</node>
