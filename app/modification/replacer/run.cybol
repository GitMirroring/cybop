<node>

    <!-- Creation -->

    <node name="create_id" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/plain" model="id"/>
        <node name="format" channel="inline" format="meta/format" model="number/integer"/>
    </node>

    <!-- Initialisation -->

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="modification/replacer/app.cybol"/>
    </node>
    <node name="initialise_app" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model="."/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <node name="open_stdout" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="device" channel="inline" format="text/plain" model="standard-output"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".stdout"/>
    </node>

    <!-- Functionality -->

    <node name="replace_letter_with_letter" channel="inline" format="modify/replace" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".letter-letter"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".test"/>
        <node name="target" channel="inline" format="text/plain" model="n"/>
        <node name="replacement" channel="inline" format="text/plain" model="X"/>
    </node>
    <node name="replace_letter_with_sequence" channel="inline" format="modify/replace" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".letter-sequence"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".test"/>
        <node name="target" channel="inline" format="text/plain" model="n"/>
        <node name="replacement" channel="inline" format="text/plain" model="NEW"/>
    </node>
    <node name="replace_sequence_with_letter" channel="inline" format="modify/replace" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".sequence-letter"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".test"/>
        <node name="target" channel="inline" format="text/plain" model="en"/>
        <node name="replacement" channel="inline" format="text/plain" model="X"/>
    </node>
    <node name="replace_sequence_with_sequence" channel="inline" format="modify/replace" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".sequence-sequence"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".test"/>
        <node name="target" channel="inline" format="text/plain" model="en"/>
        <node name="replacement" channel="inline" format="text/plain" model="NEW"/>
    </node>

    <!-- Output -->

    <node name="write_label_character" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="The result of replace character:"/>
    </node>
    <node name="write_value_character" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".character"/>
    </node>

    <node name="write_label_leading" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="The result of replace leading:"/>
    </node>
    <node name="write_value_leading" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".leading"/>
    </node>

    <node name="write_label_trailing" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="The result of replace trailing:"/>
    </node>
    <node name="write_value_trailing" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".trailing"/>
    </node>

    <node name="write_label_sequence" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/plain" model="The result of replace sequence:"/>
    </node>
    <node name="write_value_sequence" channel="inline" format="communicate/send" model="">
        <node name="channel" channel="inline" format="meta/channel" model="terminal"/>
        <node name="receiver" channel="inline" format="text/cybol-path" model=".stdout"/>
        <node name="language" channel="inline" format="meta/language" model="message/tui"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".sequence"/>
    </node>

    <!-- Shutdown -->

    <node name="exit_application" channel="inline" format="live/exit" model=""/>

</node>

<!--
    This example tests the replace operation with various data
    and writes the results to the terminal.
-->
