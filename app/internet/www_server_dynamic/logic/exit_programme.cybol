<node>

    <node name="overwrite_content" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.index.body.content"/>
        <node name="source" channel="inline" format="text/plain" model="The application was shut down successfully. Further requests will fail."/>
    </node>

    <node name="send_index" channel="inline" format="text/cybol-path" model=".logic.send_index"/>

    <node name="exit_programme" channel="inline" format="live/exit" model=""/>

</node>
