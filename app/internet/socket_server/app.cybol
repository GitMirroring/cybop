<node>

    <node name="stdout" channel="inline" format="number/integer" model="-1"/>
    <node name="datafile" channel="inline" format="number/integer" model="-1"/>

    <node name="logic" channel="file" format="element/part" model="internet/socket_server/logic.cybol"/>
    <node name="actions" channel="file" format="element/part" model="internet/socket_server/actions.cybol"/>

    <node name="request" channel="inline" format="application/octet-stream" model=""/>
    <node name="action" channel="inline" format="text/plain" model=""/>

    <node name="client_socket" channel="inline" format="number/integer" model="-1"/>

    <node name="path" channel="inline" format="text/plain" model=""/>

    <!--
        CAUTION! The format is "application/octet-stream" and NOT "text/plain",
        since this is binary data.
        They get loaded at application startup in file "run.cybol".
    -->
    <node name="data" channel="inline" format="application/octet-stream" model=""/>

</node>
