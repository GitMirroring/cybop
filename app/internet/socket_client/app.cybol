<node>

    <node name="stdout" channel="inline" format="number/integer" model="-1"/>
    <node name="datafile" channel="inline" format="number/integer" model="-1"/>

    <!--
        This is just a placeholder value.
        Inside cyboi, it gets filled with the correct server socket number,
        which gets created by the operating system through a low-level function call.
    -->
    <node name="server_socket" channel="inline" format="number/integer" model="-1"/>

    <node name="response" channel="inline" format="application/octet-stream" model=""/>

</node>
