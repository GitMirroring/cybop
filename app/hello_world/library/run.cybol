<!--
    This example prints the famous greeting "Hello World!" on console
    and then exits the application.
    In order to be very short, it uses the "cyblib" library.
-->

<node>

    <node name="load_cyblib" channel="file" format="element/part" model="cyblib/load.cybol"/>

<!--
    <node name="print" channel="file" format="element/part" model="cybol/terminal/print-newline.cybol">
-->
    <node name="print" channel="inline" format="text/cybol-path" model=".cybol.terminal.print-newline">
<!--
    TODO: How to provide stack variables in cyboi interpreter for operations which are called via cybol-path ??
-->
        <node name="text" channel="inline" format="text/plain" model="Hello World!"/>
    </node>

    <node name="exit" channel="inline" format="live/exit" model=""/>

</node>
