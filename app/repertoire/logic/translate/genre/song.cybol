<node>

    <!-- Loop test -->

    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#count"/>
    </node>

    <!-- Determine database node name -->

    <node name="get_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".db.(#source).[#index]"/>
    </node>

    <!-- Create wui genre song -->

    <node name="create_wui_song" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/cybol-path" model="#name"/>
        <node name="format" channel="inline" format="meta/format" model="text/plain"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=".wui.(#destination).(.db.(#source).[#index].genre).content"/>
    </node>

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="repertoire/wui/genre/list_item_properties.cybol"/>
    </node>
    <node name="initialise_wui_song_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.(#destination).(.db.(#source).[#index].genre).content.(#name)"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <!-- Fill wui genre song -->

    <node name="assign_artist" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#destination).(.db.(#source).[#index].genre).content.(#name)"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.(#source).[#index].artist"/>
    </node>
    <node name="assign_separator" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#destination).(.db.(#source).[#index].genre).content.(#name)"/>
        <node name="source" channel="inline" format="text/plain" model=" - "/>
    </node>
    <node name="assign_title" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#destination).(.db.(#source).[#index].genre).content.(#name)"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.(#source).[#index].title"/>
    </node>

    <!-- Incrementation -->

    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
