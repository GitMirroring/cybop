<node>

    <!-- Iterate through database -->

    <node name="count_nodes" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model="#count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".db.(#source)"/>
    </node>

    <node name="loop_nodes" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model="#break"/>
        <node name="model" channel="inline" format="text/cybol-path" model="#model"/>
    </node>

</node>
