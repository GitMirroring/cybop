<node>

    <!-- Loop test -->

    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#song_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#song_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#song_count"/>
    </node>

    <!-- Determine database node name -->

    <node name="get_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#song_name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".db.round.[#round_index].[#song_index]"/>
    </node>

    <!-- Remove node name from duplicated database "remain". If the name does not exist, then nothing will be done. -->

<!-- TODO: Add a search here in ".db.remain" for "#song_name" with found index as return value; then use it as "destination_index" below!

    <node name="reset_remain_index" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model="#remain_index"/>
        <node name="source" channel="inline" format="number/integer" model="-1"/>
    </node>

    TODO: CAUTION! Verify if "search" operation ignores index < 0 inside cyboi! It has to! Otherwise, change initial value above.

    <node name="search_node" channel="inline" format="search/TODO" model="">
        <node name="index" channel="inline" format="text/cybol-path" model="#remain_index"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".db.remain"/>
        <node name="name" channel="inline" format="text/cybol-path" model="#song_name"/>
    </node>

    <node name="remove_node" channel="inline" format="modify/remove" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".db.remain"/>
        <node name="destination_index" channel="inline" format="number/integer" model="#remain_index"/>
        <node name="count" channel="inline" format="number/integer" model="1"/>
    </node>
-->

    <!-- Create wui round song -->

    <node name="create_wui_song" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/cybol-path" model="#song_name"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content"/>
    </node>

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="repertoire/wui/round/row_model.cybol"/>
    </node>
    <node name="initialise_wui_node_model" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name)"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="repertoire/wui/round/row_properties.cybol"/>
    </node>
    <node name="initialise_wui_song_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name)"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <!-- Fill wui round song -->

    <node name="assign_number" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name).number"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#song_name"/>
    </node>
    <node name="assign_title" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name).title"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.song.(.db.round.[#round_index].[#song_index]).title"/>
    </node>
    <node name="assign_separator_begin" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name).title"/>
        <node name="source" channel="inline" format="text/plain" model=" ("/>
    </node>
    <node name="assign_artist" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name).title"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.song.(.db.round.[#round_index].[#song_index]).artist"/>
    </node>
    <node name="assign_separator_end" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name).title"/>
        <node name="source" channel="inline" format="text/plain" model=")"/>
    </node>

    <node name="assign_time" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name).time"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.song.(.db.round.[#round_index].[#song_index]).time"/>
    </node>
    <node name="assign_key" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name).key"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.song.(.db.round.[#round_index].[#song_index]).key"/>
    </node>
    <node name="assign_vocals" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name).vocals"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.song.(.db.round.[#round_index].[#song_index]).vocals"/>
    </node>
    <node name="assign_remark" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).content.(#song_name).remark"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.song.(.db.round.[#round_index].[#song_index]).remark"/>
    </node>

    <!-- Incrementation -->

    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#song_index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
