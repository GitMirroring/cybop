<node>

    <!-- Loop test -->

    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#round_break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#round_index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#round_count"/>
    </node>

    <!-- Determine round node name -->

    <!-- CAUTION! The name is used here instead of the index, since the latter starts from zero. -->
    <node name="get_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#round_name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".db.round.[#round_index]"/>
    </node>

    <!-- Create wui round section -->

    <node name="create_wui_section" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/cybol-path" model="#round_name"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=".wui.round"/>
    </node>

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="repertoire/wui/round/section_model.cybol"/>
    </node>
    <node name="initialise_section_model" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name)"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="repertoire/wui/round/section_properties.cybol"/>
    </node>
    <node name="initialise_section_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name)"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <!-- Fill wui round section -->

    <node name="assign_heading_name" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).heading"/>
        <node name="source" channel="inline" format="text/plain" model="Tanzrunde "/>
    </node>
    <node name="assign_heading_number" channel="inline" format="modify/append" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.round.(#round_name).heading"/>
        <node name="source" channel="inline" format="text/cybol-path" model="#round_name"/>
    </node>

    <!-- Iterate through songs -->

    <!-- TODO: Replace ONLY FOR LAST iteration:
        <node name="part" channel="inline" format="text/cybol-path" model=".db.round.[#round_index]"/>
        WITH:
        <node name="part" channel="inline" format="text/cybol-path" model=".db.remain"/>
        CAUTION! The "remain_index" must then NOT be reset in file "song.cybol". How to distinguish this?
    -->
    <node name="count_nodes" channel="inline" format="access/count" model="">
        <node name="count" channel="inline" format="text/cybol-path" model="#song_count"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".db.round.[#round_index]"/>
    </node>

    <node name="loop_nodes" channel="inline" format="flow/loop" model="">
        <node name="break" channel="inline" format="text/cybol-path" model="#song_break"/>
        <node name="model" channel="inline" format="text/cybol-path" model="#song_model"/>
    </node>

    <!-- Incrementation -->

    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#round_index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
