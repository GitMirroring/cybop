<node>

    <!-- Loop test -->

    <node name="compare_index" channel="inline" format="compare/greater-or-equal" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#break"/>
        <node name="left" channel="inline" format="text/cybol-path" model="#index"/>
        <node name="right" channel="inline" format="text/cybol-path" model="#count"/>
    </node>

    <!-- Determine list node name -->

    <node name="get_name" channel="inline" format="access/get-name" model="">
        <node name="element" channel="inline" format="text/cybol-path" model="#name"/>
        <node name="part" channel="inline" format="text/cybol-path" model=".db.(#list).[#index]"/>
    </node>

    <!-- Create wui table row -->

    <node name="create_wui_node" channel="inline" format="memorise/create" model="">
        <node name="name" channel="inline" format="text/cybol-path" model="#name"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="whole" channel="inline" format="text/cybol-path" model=".wui.(#list).body"/>
    </node>

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/cybol-path" model="#body"/>
    </node>
    <node name="initialise_wui_node_model" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/part"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name)"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <node name="open_file" channel="inline" format="dispatch/open" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="device" channel="inline" format="text/plain" model="repertoire/wui/song/body_row_properties.cybol"/>
    </node>
    <node name="initialise_wui_node_properties" channel="inline" format="communicate/receive" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="sender" channel="inline" format="text/cybol-path" model=".id"/>
        <node name="encoding" channel="inline" format="meta/encoding" model="utf-8"/>
        <node name="language" channel="inline" format="meta/language" model="text/cybol"/>
        <node name="format" channel="inline" format="meta/format" model="element/property"/>
        <node name="message" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name)"/>
    </node>
    <node name="close_file" channel="inline" format="dispatch/close" model="">
        <node name="channel" channel="inline" format="meta/channel" model="file"/>
        <node name="identification" channel="inline" format="text/cybol-path" model=".id"/>
    </node>

    <!-- Fill wui table row -->

    <node name="assign_artist" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name).artist"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.(#list).[#index].artist"/>
    </node>
    <node name="assign_title" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name).title"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.(#list).[#index].title"/>
    </node>
    <node name="assign_genre" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name).genre"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.genre.(.db.(#list).[#index].genre)"/>
    </node>
    <node name="assign_year" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name).year"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.(#list).[#index].year"/>
    </node>

    <node name="assign_time" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name).time"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.(#list).[#index].time"/>
    </node>
    <node name="assign_key" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name).key"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.(#list).[#index].key"/>
    </node>
    <node name="assign_vocals" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name).vocals"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.(#list).[#index].vocals"/>
    </node>
    <node name="assign_remark" channel="inline" format="modify/overwrite" model="">
        <node name="destination" channel="inline" format="text/cybol-path" model=".wui.(#list).body.(#name).remark"/>
        <node name="source" channel="inline" format="text/cybol-path" model=".db.(#list).[#index].remark"/>
    </node>

    <!-- Incrementation -->

    <node name="increment_index" channel="inline" format="calculate/add" model="">
        <node name="result" channel="inline" format="text/cybol-path" model="#index"/>
        <node name="operand" channel="inline" format="number/integer" model="1"/>
    </node>

</node>
