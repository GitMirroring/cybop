FROM debian:latest as build

RUN apt-get -y update && apt-get install -y g++ curl cmake freeglut3-dev clang-format doxygen graphviz lcov cppcheck

COPY ./build /cybop/build
COPY ./doc /cybop/doc
COPY ./src /cybop/src
COPY ./AUTHORS /cybop
COPY ./ChangeLog /cybop
COPY ./COPYING /cybop
COPY ./INSTALL /cybop
COPY ./NEWS /cybop
COPY ./README /cybop
COPY ./examples /cybop/examples
COPY ./test /cybop/test

WORKDIR /cybop/build

RUN cmake -DTARGET_GROUP=test .
#RUN make clangformat
#RUN make doc
#RUN make cppcheck
RUN make
#RUN make test
#RUN make codecoverage
#RUN make generatehtml

ENTRYPOINT ["tail", "-f", "/dev/null"]